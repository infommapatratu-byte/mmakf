node_modules/
dist/
.astro/
# Per-suite Astro caches: the two suites that boot a real `astro dev` each get
# their own, so they cannot race on data-store.json. See astro.config.mjs.
.astro-test-live/
# The cross-process mutex that keeps the three live suites from booting an
# astro dev at the same time. Never committed; reclaimed automatically if a
# worker dies holding it. See tests/helpers/astro-dev.ts.
.astro-dev-lock/
.astro-test-seo/
.vercel/
.env
.env.local
.env*.local
*.log
.DS_Store

.vercel
.env*.local

# local development database
# Local development databases.
#
# `.pgdata/` alone was not enough. Test runs and agents create SUFFIXED ones —
# .pgdata-eng, .pgdata-audit, .pgdata-t1 — and one of them was committed once:
# ~300 files of Postgres internals including a live postmaster.pid. The glob
# covers every variant.
.pgdata/
.pgdata-*/
.scratch/

# database dumps — never committed
backups/

# TLS material.
#
# A provider CA is PUBLIC, so this is not a secrecy rule. It is a tidiness rule
# with a security edge: a cert arrives in the project root as a download, no
# source references it, and the next `git add .` sweeps it into a commit where
# it lives for ever as a certificate nobody can date or attribute. The private
# half is covered by the same rule, because a *.key or *.pem holding a private
# key must never be committed and the difference is not visible in a filename.
*.crt
*.pem
*.key

# — EXCEPT the one the tooling depends on.
#
# scripts/db-session.ps1 loads this file BY NAME into DATABASE_CA_CERT, and it
# is the reason a database script can reach Supabase at all. Without this
# exemption the rule above would silently refuse to re-add it after any
# delete-and-restore, and that surfaces much later as a TLS failure nobody
# connects back to a line in .gitignore.
!supabase-root-2021.crt

# agent scratch files
*.tmp.mjs
.tmp-*/
.astro-test-smoke/
.astro-test-routes/

# Agent scratch pages.
#
# Components get built with a throwaway page to look at them in a browser, and
# three of those reached the working tree during one run — /zz-cp-probe,
# /zz-phtest, /zz-states-harness. Every one would have been a LIVE PUBLIC ROUTE:
# they sit at the root of src/pages, so the SEO classifier reads them as public
# and puts them in the sitemap.
#
# Ignored rather than policed, because deleting them by hand loses to whoever
# creates the next one. tests/layout-guards.test.ts additionally fails if any
# survive, so a harness cannot ship even from a working tree that has one.
src/pages/zz-*
src/pages/*probe*
src/pages/*harness*
src/pages/*scratch*
src/pages/*sandbox*

# Verification harness artefacts.
#
# A separate clean build is made into .verify-dist/ with its own config and
# cache, so a verification run cannot be answered by the working build. None of
# it is source, and .verify-dist/ alone is several thousand files.
.verify-dist/
.verify-cache/
astro.config.verify.mjs
.astro-smoke/

# Agent worktrees. EMBEDDED GIT REPOSITORIES — committing one stores a
# gitlink that no clone can resolve, so the outer repo ends up referencing a
# commit nobody else has.
.claude/worktrees/

# Timestamped copies of env files. `.env*.local` does not match these:
# the name must END in .local, and `.env.local.backup-192538` does not.
# It held live KV/Redis tokens and was one `git add -A` from being committed.
.env*.backup*
.env.local.backup-*
