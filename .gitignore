# Per-suite Astro caches: the two suites that boot a real `astro dev` each get
# their own, so they cannot race on data-store.json. See astro.config.mjs.
.astro-test-live/
.astro-test-seo/
.vercel/
.env
.env.local
.env*.local
*.log
.DS_Store

.vercel
