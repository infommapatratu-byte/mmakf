---
import '@/styles/global.css';
// Loaded AFTER global.css so the audit utilities (.sr-only, .skip-link) are
// defined once for every surface. See docs/ACCESSIBILITY.md.
import '@/styles/a11y.css';
import Crest from '@/components/Crest.astro';
import { get } from '@/lib/storage';
import { CREST_ABSOLUTE } from '@/lib/brand';
import {
  PUBLIC_NAV, PUBLIC_ACTIONS, LEARN_NAV, LEARN_ACTIONS,
  canonicalFor, href as surfaceHref, isIndexable, SURFACE_ORIGIN,
  type Surface,
} from '@/lib/surface';
import { isPrivatePath, breadcrumbGraph, type Crumb } from '@/lib/seo';

// Official channels, loaded here so every page footer links to them. The site
// previously had no outbound links at all, which is why none of the
// federation's real material ever surfaced alongside it.
const social = ((await get<any[]>('social')) || []).filter((a: any) => a?.url);

export interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  showFooter?: boolean;
  /**
   * The page's place in the hierarchy, excluding the site root.
   *
   *   breadcrumbs={[{ name: 'Training', url: '/training' },
   *                 { name: 'For schools', url: '/karate-for-schools' }]}
   *
   * The visible trail and the BreadcrumbList markup are BOTH generated from
   * this one array, so they cannot disagree — which matters, because Google's
   * structured-data guidance says markup must represent what the page actually
   * shows, and a trail that exists only in JSON-LD does not.
   *
   * A single entry produces NOTHING, deliberately. A breadcrumb describes a
   * hierarchy; "MMAKF > About" on a top-level page is one more block of markup
   * and no more information. See breadcrumbGraph().
   */
  breadcrumbs?: Crumb[];
}

const {
  breadcrumbs = [],
  title = 'MMAKF — Modern Martial Arts Karate-Do Federation of India',
  description = "Modern Martial Arts Karate-Do Federation of India (MMAKF). Established 1983. Shotokan Karate under Grandmaster Shihan Pramod Kumar Pathak. Patratu, Jharkhand. WKF international pathway.",
  showNav = true,
  showFooter = true,
} = Astro.props;

// ── Which surface is this? ─────────────────────────────────────────────────
//
// Set by the middleware from the Host header. Falls back to 'public' when the
// layout is rendered outside a request (a test, a prerender), which is the
// fail-safe direction — an unrecognised context gets the public federation.
const surface: Surface = (Astro.locals as any)?.surface ?? 'public';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// ── The navigation ─────────────────────────────────────────────────────────
//
// WAS: About · Governance · Programs · Schedule · Events · Affiliation ·
// Registration · Contact.
//
// That is a club's menu. It put a class timetable and an enrolment form at the
// same level as the constitution of a national body, and it had no place at all
// for athletes, rankings, officials, results, the network or credential
// verification — the things a federation exists to hold. The replacement is
// grouped the way a national federation is actually organised; see PUBLIC_NAV
// in src/lib/surface.ts, where every link is checked against the routes that
// exist by tests/navigation.test.ts.
const nav = surface === 'learn' ? LEARN_NAV : PUBLIC_NAV;
const actions = surface === 'learn' ? LEARN_ACTIONS : PUBLIC_ACTIONS;

// The internal path, which is what currentPath already is: the middleware
// rewrites before the page renders, so on learn.mmakf.in/schools this is
// /learn/schools. Links are written through surfaceHref() so the same
// definition serves every host.
const isCurrent = (target: string) =>
  currentPath === target || currentPath.startsWith(target + '/');

// ── Canonical ──────────────────────────────────────────────────────────────
//
// One page, one address. A page reachable at both www.mmakf.in/learn/schools
// and learn.mmakf.in/schools that names itself differently depending on how you
// arrived is two pages competing for the same content.
const SITE = SURFACE_ORIGIN[surface];
const canonical = canonicalFor(surface, currentPath);

/**
 * Indexability is decided by the HOST *and* the PATH, and it has to be both.
 *
 * The first version asked only `isIndexable(surface)`. On admin.mmakf.in that
 * is correct — and admin.mmakf.in DOES NOT EXIST YET. Every operations page is
 * reached today at www.mmakf.in/admin/…, where the surface resolves to
 * 'public', so the whole admin platform was being served with no noindex at
 * all. tests/routes-live.test.ts caught it by fetching the page rather than
 * reasoning about it.
 *
 * isPrivatePath() is the existing classifier that already keeps /admin, /api,
 * /my and /portal out of the sitemap. Asking it here means the page and the
 * sitemap cannot disagree about what is private.
 */
const indexable = isIndexable(surface) && !isPrivatePath(currentPath);

// Only on an indexable page. Emitting a breadcrumb for the operations platform
// would describe a hierarchy to a crawler that is being told, in the same
// <head>, not to index it.
const crumbs: Crumb[] = indexable ? (breadcrumbs ?? []).filter((c) => c && c.name && c.url) : [];
const crumbGraph = crumbs.length >= 2 ? breadcrumbGraph(crumbs, SITE) : null;

// Organization structured data — only facts the federation itself publishes.
const sameAs = social.map((a: any) => a.url);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'Modern Martial Arts Karate-Do Federation of India',
  // Both names are official and the federation uses them interchangeably:
  // "Bharat" is the constitutional name of India, so this is one body under two
  // correct names rather than an inconsistency. Declaring them lets search
  // engines resolve the Instagram account and the website to the same entity.
  alternateName: [
    'MMAKF',
    'Modern Martial Arts Karate-Do Federation, Bharat',
    'Modern Martial Arts Karate-Do Federation of India',
  ],
  url: SITE,
  logo: CREST_ABSOLUTE,
  foundingDate: '1983',
  sport: 'Shotokan Karate',
  // Links the site to the federation's verified channels, so search engines can
  // connect them. Every URL was fetched and confirmed live before publication.
  ...(sameAs.length ? { sameAs } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'MMAKF Headquarters, Patratu',
    addressRegion: 'Jharkhand',
    addressLocality: 'Ramgarh District',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
      // NO TELEPHONE. The number that was here is Sensei's personal mobile, and
      // the federation asked twice for it to be removed. Structured data is MORE
      // exposed than a page, not less — a search engine republishes it into a
      // knowledge panel, which is far harder to withdraw than a web page.
    email: 'admin@mmakf.in',
    contactType: 'customer service',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MMAKF — Modern Martial Arts Karate-Do Federation of India" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    {/* admin.mmakf.in is never indexed. The header is belt to robots.txt's
        braces — a header travels with the response, and cannot be missed by a
        crawler that never fetched robots.txt. */}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {crumbGraph && <script type="application/ld+json" set:html={JSON.stringify(crumbGraph)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script is:inline>
      // P1-15: only enable the hidden-until-revealed state when JS is running.
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <!-- WCAG 2.4.1 Bypass Blocks. First thing in the tab order on every
         surface; visible only while focused. -->
    <a class="skip-link" href="#main-content">Skip to content</a>

    {showNav && (
      <nav id="mainNav">
        <div class="nav-inner container">
          <a href={surface === 'public' ? '/' : surfaceHref(surface, surface === 'learn' ? '/learn' : '/admin')} class="nav-brand">
            <Crest size={44} />
            <div class="nav-name">
              <div class="nav-name-1">MMAKF</div>
              <div class="nav-name-2">
                {surface === 'learn'
                  ? 'National Training and Institutional Engagement'
                  : surface === 'admin'
                    ? 'Federation Operations'
                    : 'Modern Martial Arts Karate-Do Federation of India'}
              </div>
            </div>
          </a>

          <div class="nav-links" id="navLinks">
            {nav.map((item) => (
              <div class="nav-item">
                <a
                  href={surfaceHref(surface, item.href)}
                  class={isCurrent(item.href) ? 'active' : ''}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >{item.label}</a>
                {item.children && item.children.length > 0 && (
                  /* Rendered in the DOM, not built by script on hover. A menu
                     that only exists once JavaScript has run is a menu a
                     crawler never sees, and PART AN is explicit that discovery
                     content must be in the DOM. */
                  <div class="nav-sub">
                    {item.children.map((c) => (
                      <a href={surfaceHref(surface, c.href)} class={currentPath === c.href ? 'active' : ''}>{c.label}</a>
                    ))}
                  </div>
                )}
              </div>
            ))}
            {surface !== 'admin' && (
              <a href={surfaceHref(surface, '/search')} class="nav-search" aria-label="Search the federation" title="Search the federation">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
                </svg>
                <span class="nav-search-word">Search</span>
              </a>
            )}
            {/* WAS "Enroll", pointing at /contact#enroll — a dojo's call to
                action on a national federation's masthead. The federation's
                primary action is to register with it. */}
            {actions[0] && <a href={surfaceHref(surface, actions[0].href)} class="nav-enroll">{actions[0].label}</a>}
          </div>

          <button class="nav-hamburger" id="navHamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navLinks">
            <span></span><span></span><span></span>
          </button>
        </div>
      </nav>
    )}

    <main id="main-content" tabindex="-1">
      {crumbs.length >= 2 && (
        <nav class="crumbs container" aria-label="Breadcrumb">
          <ol>
            <li><a href={surfaceHref(surface, '/')}>MMAKF</a></li>
            {crumbs.map((c, i) => (
              <li>
                {i === crumbs.length - 1
                  ? <span aria-current="page">{c.name}</span>
                  : <a href={surfaceHref(surface, c.url)}>{c.name}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    {showFooter && (
      <footer>
        <div class="container">
          <div class="ft-grid">
            <div class="ft-col ft-brand">
              <div class="nav-brand">
                <Crest size={52} />
                <div class="nav-name">
                  <div class="nav-name-1">MMAKF</div>
                  <div class="nav-name-2">Est. 1983 · Patratu, Jharkhand</div>
                </div>
              </div>
              <p class="body-txt mt-6" style="font-size:.86rem;max-width:42ch">
                Modern Martial Arts Karate-Do Federation of India. Shotokan Karate-Do.
                Forging warriors through discipline, lineage, and purpose since 1983.
              </p>
            </div>

            <div class="ft-col ft-social">
              <div class="ft-h">Official channels</div>
              {social.map((a: any) => (
                <a href={a.url} target="_blank" rel="noopener noreferrer">
                  {a.platform}{a.primary === 'Yes' ? ' — main channel' : ''}
                </a>
              ))}
            </div>

            <div class="ft-col">
              <div class="ft-h">Training</div>
              <a href="/programs">Programs</a>
              <a href="/academy">Online Academy</a>
              <a href="/schedule">Class Schedule</a>
              <a href="/belt-system">Belt System & Syllabus</a>
              <a href="/facilities">Dojo Facilities</a>
              <a href="/faq">FAQ</a>
            </div>

            <div class="ft-col">
              <div class="ft-h">Federation</div>
              <a href="/search">Search the federation</a>
              <a href="/calendar">Federation calendar</a>
              <a href="/governance">Governance & Officials</a>
              <a href="/governance#documents">Documents & Policies</a>
              <a href="/registration">Member Registration</a>
              <a href="/registration#verify">Verify a Member ID</a>
              <a href="/affiliation">Affiliation & Certification</a>
              <a href="/events#results">Results</a>
              <a href="/gallery">Gallery</a>
              <a href="/shop">Shop</a>
            </div>

            <div class="ft-col">
              <div class="ft-h">Connect</div>
              <a href="mailto:admin@mmakf.in">admin@mmakf.in</a>
              <a href="mailto:karate.pramod@gmail.com">karate.pramod@gmail.com</a>
              <a href="/contact">Visit the dojo</a>
              <a href="/unit">Unit Portal →</a>
              <a href="/admin">Admin →</a>
            </div>
          </div>

          <div class="ft-bottom">
            <div>© {new Date().getFullYear()} MMAKF — Modern Martial Arts Karate-Do Federation of India.</div>
            <div class="text-muted">Shotokan Karate-Do · Established 1983</div>
          </div>
        </div>
      </footer>
    )}

    <div class="notif" id="notif" role="status" aria-live="polite"><span id="notif-txt"></span></div>

    <style is:global>
      /* Nav — white glass over any hero */
      nav#mainNav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-bottom: 1px solid var(--border);
        box-shadow: 0 1px 2px rgba(26, 23, 19, 0.04);
      }
      .nav-inner {
        display: flex; align-items: center; justify-content: space-between;
        min-height: 72px;          /* P1-13: was fixed height — clipped the
                                      wordmark at mobile widths */
        padding: 8px 0;
        gap: 12px;
      }
      .nav-brand { display: flex; align-items: center; gap: 13px; }
      .nav-name-1 {
        font-family: var(--font-display);
        font-size: 1.08rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--white);
        line-height: 1;
      }
      .nav-name-2 {
        font-family: var(--font-display);
        font-size: 0.5rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--gold-2);
        margin-top: 4px;
        font-weight: 500;
        max-width: 22ch;
        line-height: 1.35;
      }
      @media (max-width: 420px) { .nav-name-2 { max-width: 15ch; } }
      /* The visible trail. Rendered from the same array as the JSON-LD above,
         never separately — markup that describes a trail the page does not show
         is the kind Google's guidance calls misleading.

         The separator is a CSS ::before on all but the first item rather than a
         character in the markup, so a screen reader announces "MMAKF, Training,
         For schools" and not "MMAKF slash Training slash For schools". */
      .crumbs { padding: 96px 0 0; }
      .crumbs ol {
        list-style: none; margin: 0; padding: 0;
        display: flex; flex-wrap: wrap; align-items: center; gap: 0 4px;
        font-size: .82rem;
      }
      .crumbs li { display: flex; align-items: center; gap: 4px; color: var(--muted); }
      .crumbs li + li::before { content: '·'; color: var(--gold-dim); }
      .crumbs a { color: var(--muted); text-decoration: none; }
      .crumbs a:hover { color: var(--gold-2); text-decoration: underline; }
      .crumbs [aria-current='page'] { color: var(--gold-2); }
      /* The page below supplies its own top padding, so the trail replaces it
         rather than adding to it. */
      .crumbs + * > .container:first-child,
      .crumbs ~ * > header:first-child { padding-top: 24px; }
      @media (max-width: 640px) { .crumbs { padding-top: 78px; } }

      .nav-links { display: flex; align-items: center; gap: 2px; }

      /* ── Grouped navigation ────────────────────────────────────────────────
         The federation has more than eight things worth reaching, so the top
         level is six groups rather than eight destinations.

         THE SUBMENU IS IN THE DOM AND IS NOT BUILT BY SCRIPT. It is hidden with
         visibility/opacity rather than display:none so that it stays in the
         accessibility tree and in the crawler's view — PART AN is explicit that
         discovery content must be present in the markup.

         Opened by :hover AND :focus-within, so it works from the keyboard
         without a line of JavaScript. */
      .nav-item { position: relative; display: flex; align-items: center; }
      .nav-sub {
        position: absolute; top: 100%; left: -12px;
        min-width: 218px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-2);
        padding: 8px;
        display: flex; flex-direction: column;
        opacity: 0; visibility: hidden;
        transform: translateY(-4px);
        transition: opacity .16s ease, transform .16s ease, visibility 0s .16s;
      }
      .nav-item:hover > .nav-sub,
      .nav-item:focus-within > .nav-sub {
        opacity: 1; visibility: visible; transform: none;
        transition: opacity .16s ease, transform .16s ease, visibility 0s;
      }
      .nav-sub a {
        padding: 9px 12px; border-radius: 6px; white-space: nowrap;
        font-size: .86rem; letter-spacing: .01em; text-transform: none;
      }
      .nav-sub a:hover, .nav-sub a:focus-visible { background: var(--bg-2); }
      .nav-sub a.active { color: var(--gold-2); }
      .nav-sub a.active::after { display: none; }
      .nav-links a {
        font-family: var(--font-display);
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--off-white);
        padding: 8px 11px;
        transition: color .18s;
        position: relative;
      }
      .nav-links a:hover { color: var(--gold-2); }
      .nav-links a.active { color: var(--gold-2); }
      .nav-links a.active::after {
        content: '';
        position: absolute;
        left: 11px; right: 11px; bottom: 0;
        height: 2px;
        background: var(--gold-2);
      }
      .nav-search {
        display: inline-flex; align-items: center; gap: 7px;
        margin-left: 6px; padding: 8px 12px;
        border: 1px solid var(--border-2); border-radius: 999px;
      }
      .nav-search:hover { border-color: var(--gold-dim); }
      @media (min-width: 861px) and (max-width: 1080px) {
        .nav-search-word { display: none; }
      }
      .nav-links .nav-enroll {
        border: 1px solid var(--red-2);
        background: var(--red);
        color: #f5f0ea;
        margin-left: 10px;
        padding: 9px 20px;
        border-radius: var(--radius);
        letter-spacing: 0.2em;
      }
      .nav-links .nav-enroll:hover { background: var(--red-2); color: #fff; }
      .nav-links .nav-enroll.active::after { display: none; }

      .nav-hamburger {
        display: none;
        flex-direction: column; gap: 5px;
        background: transparent; border: 0; padding: 8px;
      }
      .nav-hamburger span {
        display: block; width: 22px; height: 1.6px; background: var(--white);
        transition: .3s;
      }
      .nav-hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(4px, 5px); }
      .nav-hamburger.open span:nth-child(2) { opacity: 0; }
      .nav-hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(4px, -5px); }

      @media (max-width: 1080px) {
        .nav-links {
          position: fixed; top: 72px; left: 0; right: 0;
          background: var(--bg);
          flex-direction: column;
          align-items: stretch;
          padding: 12px 18px 24px;
          border-bottom: 1px solid var(--border);
          transform: translateY(-120%);
          /* WCAG 2.4.7 / 2.4.3 (Q-28): `transform` alone hides the closed menu
             visually but leaves every link in the tab order. Measured at 375px:
             ten links took focus at y = -632 to -115 — off-screen, with a focus
             ring nobody can see, and the hamburger that is supposed to open
             them came AFTER them. `visibility: hidden` takes them out of the
             tab order and the accessibility tree; it is delayed by the length
             of the slide so the closing animation still plays. */
          visibility: hidden;
          transition: transform .3s, visibility 0s .3s;
        }
        .nav-links.open { transform: none; visibility: visible; transition: transform .3s, visibility 0s; }
        .nav-links a {
          padding: 14px 4px;
          border-bottom: 1px solid var(--border);
          font-size: 0.95rem;
        }
        .nav-links a:last-of-type { border: 0; }
        .nav-links a.active::after { display: none; }

        /* On a phone the drawer is a list, so the groups flatten into indented
           sections rather than becoming eight hover targets nobody can hit.
           Every destination is reachable by scrolling — no second tap needed to
           reveal a group, which is the pattern that makes mobile menus
           unusable one-handed. */
        .nav-item { display: block; }
        .nav-sub {
          position: static; opacity: 1; visibility: visible; transform: none;
          background: none; border: 0; box-shadow: none;
          padding: 0 0 6px 14px; min-width: 0;
          border-left: 2px solid var(--border);
          margin: 0 0 8px 4px;
        }
        .nav-sub a { padding: 8px 10px; font-size: .84rem; border: 0; opacity: .82; }
        .nav-search { border: 0; border-radius: 0; margin-left: 0; padding: 0; }
        .nav-links .nav-enroll { text-align: center; margin: 12px 0 0; }
        .nav-hamburger { display: flex; }
      }

      main { padding-top: 88px; min-height: 60vh; }
      @media (min-width: 1081px) { main { padding-top: 76px; } }

      /* Footer — dark institutional band with crest watermark */
      footer {
        background: #14120F;
        border-top: 3px solid var(--red);
        padding: 72px 0 30px;
        position: relative;
        overflow: hidden;
      }
      /* Soft crimson glow instead of an image watermark — the crest asset is an
         opaque JPEG and painted a visible grey square over the footer links. */
      footer::before {
        content: '';
        position: absolute;
        right: -120px; bottom: -160px;
        width: 520px; height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(142, 18, 18, 0.18), transparent 65%);
        pointer-events: none;
      }
      footer .nav-name-1 { color: #F5F2EC; }
      footer .nav-name-2 { color: #D9BC66; }
      footer .body-txt { color: #A9A296; }
      .ft-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        gap: 40px;
        margin-bottom: 56px;
      }
      @media (max-width: 800px) {
        .ft-grid { grid-template-columns: 1fr 1fr; }
        .ft-brand { grid-column: 1 / -1; }
      }
      @media (max-width: 480px) {
        .ft-grid { grid-template-columns: 1fr; }
      }
      .ft-col { display: flex; flex-direction: column; gap: 10px; }
      /* Explicit light values: the footer is a dark band, so the light-theme
         ink tokens (--off-white/--muted) must NOT be used here (P0-4: 2.0:1). */
      .ft-col a {
        font-size: 0.86rem;
        color: #D8D2C6;                    /* 10.4:1 on #14120F */
        padding: 3px 0;                    /* larger hit area */
      }
      .ft-col a:hover, .ft-col a:focus-visible { color: #E8D28F; }
      .ft-h {
        font-family: var(--font-display);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #D9BC66;                    /* 7.6:1 on #14120F */
        margin-bottom: 8px;
        font-weight: 600;
      }
      .ft-bottom {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.78rem;
        color: #A9A296;                    /* 5.4:1 on #14120F */
      }
      .ft-bottom .text-muted { color: #A9A296; }
    </style>

    <script>
      // Mobile nav
      const ham = document.getElementById('navHamburger');
      const links = document.getElementById('navLinks');
      ham?.addEventListener('click', () => {
        const open = ham.classList.toggle('open');
        links?.classList.toggle('open');
        ham.setAttribute('aria-expanded', String(open));
      });
      links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
        ham?.classList.remove('open');
        links?.classList.remove('open');
        ham?.setAttribute('aria-expanded', 'false');
      }));

      // WCAG 2.1.2: an open panel must be dismissible from the keyboard, and
      // focus has to come back to the control that opened it — otherwise the
      // next Tab resumes from a menu that is no longer on screen.
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (!links?.classList.contains('open')) return;
        ham?.classList.remove('open');
        links.classList.remove('open');
        ham?.setAttribute('aria-expanded', 'false');
        ham?.focus();
      });

      // Notif toast
      window.showNotif = (msg) => {
        const n = document.getElementById('notif');
        const t = document.getElementById('notif-txt');
        if (!n || !t) return;
        t.textContent = msg;
        n.classList.add('show');
        setTimeout(() => n.classList.remove('show'), 3500);
      };

      // Fade reveal
      const obs = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('vis')),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.fade').forEach((el) => obs.observe(el));

      // Service worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
