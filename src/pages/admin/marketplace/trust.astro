---
// /admin/marketplace/trust — moderation, counterfeits, fraud and quarantine.
//
// ═════════════════════════════════════════════════════════════════════════════
// FOUR ENGINES THAT WORKED AND HAD NO DOOR
// ═════════════════════════════════════════════════════════════════════════════
//
// Every one of these was built, tested and unreachable by any human being:
//
//   REVIEW MODERATION   `reviewQueue()` had no caller anywhere in src/. Reviews
//                       land as `pending`, refreshSellerRating() counts only
//                       PUBLISHED ones, and nothing could publish them — so a
//                       marketplace with review machinery would have shown
//                       every seller as unrated for ever.
//
//   AUTHENTICITY        openAuthenticityCase() and decideAuthenticityCase()
//                       were API-only, and nothing listed an open case. A
//                       trademark holder's complaint could be filed and then
//                       found by nobody.
//
//   FRAUD               raiseFraudSignal() had no caller at all;
//                       detectReviewPatterns() writes signals on a schedule
//                       into a table only sellerDossier() read, one seller at a
//                       time, for whoever already suspected them.
//
//   QUARANTINE          quarantineListing() and liftQuarantine() were API-only.
//                       Quarantine is designed to be applied fast on suspicion
//                       BECAUSE it is one reversible column — and the reversal
//                       was the half nobody could perform.
//
// ═════════════════════════════════════════════════════════════════════════════
// WHAT THIS PAGE WILL NOT DO
// ═════════════════════════════════════════════════════════════════════════════
//
// IT DOES NOT DECIDE ANYTHING ITSELF. Every control posts to /api/marketplace,
// which re-identifies the caller and re-checks the action against their scope.
// A control this page chose not to draw is a convenience, never the guard.
//
// A FRAUD SIGNAL IS NOT AN ACCUSATION. Severity is the detector's own number
// and is shown as one — no colour, no threshold, no "recommended action". An
// automated check presented as a verdict is how a system starts suspending
// people nobody looked at.
//
// AND NOTHING IS DELETED. A rejected review is `rejected` and still on file; a
// quarantined item keeps its orders, its reviews and its revisions. The
// federation may need the record, and a moderation surface that destroys
// evidence is worse than none.

import AdminShell from '@/components/AdminShell.astro';
import { identify } from '@/lib/session';
import { isConfigured, db } from '@/db';
import { canAnywhere } from '@/lib/rbac';
import { reviewQueue, fraudQueue, PERFORMANCE_NOT_COMPUTED } from '@/db/marketplace-trust';
import { authenticityQueue, quarantinedListings, openFlags } from '@/db/catalogue';

export const prerender = false;

const configured = isConfigured();
const identity = configured ? await identify(Astro.request.headers.get('cookie')) : null;
const principal = identity?.principal ?? null;
const mayReview = principal ? canAnywhere(principal, 'marketplace:review') : false;

let reviews: any = { product: [], seller: [] };
let cases: any[] = [];
let signals: any[] = [];
let quarantined: any[] = [];
let flags: any[] = [];
let loadError: string | null = null;

if (configured && principal && canAnywhere(principal, 'marketplace:read')) {
  try {
    reviews = await reviewQueue(db(), principal, 100);
    cases = await authenticityQueue(db(), principal, 100);
    signals = await fraudQueue(db(), principal, 100);
    quarantined = await quarantinedListings(db(), principal, 100);
    flags = await openFlags(db(), principal, 100);
  } catch (err: any) {
    console.error('[admin/marketplace/trust]', err);
    loadError = 'The moderation queues could not be read. The fault has been logged; nothing has been changed.';
  }
}

const date = (v: unknown) => (v ? new Date(String(v)).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—');
const titleCase = (v: unknown) => String(v ?? '').replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
// The reviews carry a 1-5 integer, not basis points — the seller ROW caches a
// bps average, and confusing the two would render every review as 0.00 / 5.
const stars = (n: number | null | undefined) => (n == null ? '—' : `${n} / 5`);

const pendingReviews = reviews.product.length + reviews.seller.length;
---

<AdminShell title="Trust and moderation" requires="marketplace:read">
  <section>
    <div class="container">
      <p><a href="/admin/marketplace">← Marketplace console</a></p>

      {loadError && <p class="error" role="alert">{loadError}</p>}

      {!mayReview && (
        <div class="card">
          <p class="muted">
            You can see these queues but not act on them. Moderating a review, deciding a case or
            lifting a quarantine takes <code>marketplace:review</code>.
          </p>
        </div>
      )}

      <div class="queues">
        <a class="card queue" href="#reviews"><div class="n">{pendingReviews}</div><div class="k">Reviews awaiting moderation</div></a>
        <a class="card queue" href="#authenticity"><div class="n">{cases.length}</div><div class="k">Authenticity cases</div></a>
        <a class="card queue" href="#fraud"><div class="n">{signals.length}</div><div class="k">Open fraud signals</div></a>
        <a class="card queue" href="#quarantine"><div class="n">{quarantined.length}</div><div class="k">Items quarantined</div></a>
      </div>

      {/* ── Reviews ──────────────────────────────────────────────────────
           First, because it is the queue with a public consequence for every
           day it is not worked: an unmoderated review is invisible, so a seller
           who has earned a rating does not have one. */}
      <h2 class="h3" id="reviews">Reviews awaiting moderation ({pendingReviews})</h2>
      {pendingReviews === 0 && (
        <div class="card"><p class="muted">Nothing waiting. Every review has been looked at.</p></div>
      )}

      {reviews.product.length > 0 && (
        <>
          <h3 class="h4">On items ({reviews.product.length})</h3>
          {reviews.product.map((r: any) => (
            <article class="card">
              <header class="row between">
                <div>
                  <strong>{r.listingTitle}</strong>
                  <p class="muted" style="margin:4px 0">
                    {date(r.review.createdAt)} · {stars(r.review.rating)} · {r.sellerName}
                    {/* Every product review carries a NOT NULL order line, so a
                        review that exists is a review of something bought. There
                        is no unverified kind to distinguish. */}
                    {' '}· verified purchase
                  </p>
                </div>
              </header>
              {r.review.title && <p><strong>{r.review.title}</strong></p>}
              <p>{r.review.body}</p>
              {mayReview && (
                <div class="row">
                  <button class="btn btn-primary btn-small" data-mod="published" data-kind="product" data-id={r.review.id}>Publish</button>
                  <button class="btn btn-small" data-mod="rejected" data-kind="product" data-id={r.review.id}>Reject</button>
                  <button class="btn btn-small" data-mod="hidden" data-kind="product" data-id={r.review.id}>Hide</button>
                </div>
              )}
            </article>
          ))}
        </>
      )}

      {reviews.seller.length > 0 && (
        <>
          <h3 class="h4">On sellers ({reviews.seller.length})</h3>
          {reviews.seller.map((r: any) => (
            <article class="card">
              <header class="row between">
                <div>
                  <strong>{r.sellerName}</strong>
                  <p class="muted" style="margin:4px 0">
                    {date(r.review.createdAt)} · {stars(r.review.ratingOverall)}
                  </p>
                </div>
              </header>
              <p>{r.review.body}</p>
              {mayReview && (
                <div class="row">
                  <button class="btn btn-primary btn-small" data-mod="published" data-kind="seller" data-id={r.review.id}>Publish</button>
                  <button class="btn btn-small" data-mod="rejected" data-kind="seller" data-id={r.review.id}>Reject</button>
                  <button class="btn btn-small" data-mod="hidden" data-kind="seller" data-id={r.review.id}>Hide</button>
                </div>
              )}
            </article>
          ))}
        </>
      )}

      {/* ── Authenticity ─────────────────────────────────────────────────── */}
      <h2 class="h3" id="authenticity">Authenticity cases ({cases.length})</h2>
      {cases.length === 0 && <div class="card"><p class="muted">No open cases.</p></div>}
      {cases.map((c: any) => (
        <article class="card">
          <header class="row between">
            <div>
              <h3 class="h4" style="margin:0">{c.kase.ref}</h3>
              <p class="muted" style="margin:4px 0">
                {date(c.kase.openedAt)} · {titleCase(c.kase.status)} · raised by {titleCase(c.kase.complainantKind)}
                {c.brandName ? ` · ${c.brandName}` : ''} · {c.sellerName} ({c.sellerRef})
              </p>
            </div>
            {c.kase.responseDueAt && !c.kase.sellerRespondedAt && (
              <span class="pill">Seller response due {date(c.kase.responseDueAt)}</span>
            )}
          </header>
          {c.listingRef && (
            <p class="muted">Item: <a href={`/shop/product/${c.listingRef}`}>{c.listingTitle}</a></p>
          )}
          <p><strong>Allegation:</strong> {c.kase.allegation}</p>
          {c.kase.sellerResponse
            ? <p><strong>Seller:</strong> {c.kase.sellerResponse}</p>
            : <p class="muted">The seller has not responded.</p>}

          {mayReview && (
            <details class="card">
              <summary>Decide this case</summary>
              <form class="case-decide" data-id={c.kase.id}>
                <label for={`cs-${c.kase.id}`}>Finding</label>
                <select id={`cs-${c.kase.id}`} name="status" required>
                  <option value="upheld">Upheld — the complaint is made out</option>
                  <option value="dismissed">Dismissed</option>
                </select>
                <label for={`cd-${c.kase.id}`}>Decision — the complainant and the seller both read this</label>
                <textarea id={`cd-${c.kase.id}`} name="decision" rows="3" required maxlength="4000"></textarea>
                <p class="hint">
                  Upholding a case does not itself suspend anybody or pull anything. Quarantine the
                  item and restrict or suspend the seller as separate, recorded acts — an enforcement
                  that happened as a side effect is one nobody can account for afterwards.
                </p>
                <button class="btn btn-primary btn-small" type="submit">Record the decision</button>
              </form>
            </details>
          )}
        </article>
      ))}

      {/* ── Fraud ────────────────────────────────────────────────────────── */}
      <h2 class="h3" id="fraud">Open fraud signals ({signals.length})</h2>
      <p class="hint">
        A signal is a detector's finding, not a verdict. The severity is the detector's own number and
        nothing here acts on it: every enforcement in this marketplace is taken by a person, against a
        record, with a reason.
      </p>
      {signals.length === 0 && <div class="card"><p class="muted">No open signals.</p></div>}
      {signals.length > 0 && (
        <table class="card">
          <caption class="sr-only">Open fraud signals</caption>
          <thead>
            <tr>
              <th scope="col">Raised</th><th scope="col">Subject</th><th scope="col">Seller</th>
              <th scope="col">Kind</th><th scope="col" class="num">Severity</th>
              <th scope="col">Detail</th><th scope="col">Detector</th><th scope="col">Decide</th>
            </tr>
          </thead>
          <tbody>
            {signals.map((f: any) => (
              <tr>
                <td>{date(f.signal.raisedAt)}</td>
                <td>{titleCase(f.signal.subjectType)} {f.signal.subjectId}</td>
                <td>{f.sellerName ?? '—'}</td>
                <td>{titleCase(f.signal.kind)}</td>
                <td class="num">{f.signal.severity}</td>
                <td>{f.signal.detail}</td>
                <td class="muted">{f.signal.detector}</td>
                <td>
                  {mayReview
                    ? <div class="row">
                        <button class="btn btn-small" data-fraud="actioned" data-id={f.signal.id}>Actioned</button>
                        <button class="btn btn-small" data-fraud="dismissed" data-id={f.signal.id}>Dismiss</button>
                        <button class="btn btn-small" data-fraud="false_positive" data-id={f.signal.id}>False positive</button>
                      </div>
                    : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Quarantine ───────────────────────────────────────────────────── */}
      <h2 class="h3" id="quarantine">Items quarantined ({quarantined.length})</h2>
      <p class="hint">
        A quarantined item is off every public surface at once and keeps its orders, reviews and
        revisions. It is meant to be applied quickly and lifted just as quickly.
      </p>
      {quarantined.length === 0 && <div class="card"><p class="muted">Nothing is quarantined.</p></div>}
      {quarantined.length > 0 && (
        <table class="card">
          <caption class="sr-only">Quarantined items</caption>
          <thead>
            <tr>
              <th scope="col">Item</th><th scope="col">Seller</th>
              <th scope="col">Since</th><th scope="col">Why</th><th scope="col">Lift</th>
            </tr>
          </thead>
          <tbody>
            {quarantined.map((q: any) => (
              <tr>
                <th scope="row">{q.listing.title}<br /><span class="muted">{q.listing.ref}</span></th>
                <td>{q.sellerName}</td>
                <td>{date(q.listing.quarantinedAt)}</td>
                <td>{q.listing.quarantineReason ?? '—'}</td>
                <td>
                  {mayReview
                    ? <button class="btn btn-small" data-unquarantine={q.listing.id}>Lift</button>
                    : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Flagged items ────────────────────────────────────────────────── */}
      <h2 class="h3" id="flags">Flagged items ({flags.length})</h2>
      <p class="hint">
        Flags are decided on the <a href="/admin/marketplace">marketplace console</a>. Quarantining is
        the faster remedy while a flag is being looked at, and it is offered here.
      </p>
      {flags.length === 0 && <div class="card"><p class="muted">No open flags.</p></div>}
      {flags.length > 0 && (
        <table class="card">
          <caption class="sr-only">Flagged items</caption>
          <thead>
            <tr>
              <th scope="col">Item</th><th scope="col">Kind</th>
              <th scope="col">Detail</th><th scope="col">Quarantine</th>
            </tr>
          </thead>
          <tbody>
            {flags.map((f: any) => (
              <tr>
                <th scope="row">{f.listingTitle ?? `Listing ${f.flag?.listingId ?? ''}`}</th>
                <td>{titleCase(f.flag?.kind)}</td>
                <td>{f.flag?.detail}</td>
                <td>
                  {mayReview && f.flag?.listingId
                    ? <button class="btn btn-small" data-quarantine={f.flag.listingId}>Quarantine</button>
                    : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <h2 class="h3">Seller performance</h2>
      <p class="muted">{PERFORMANCE_NOT_COMPUTED}</p>
      <p class="hint">
        Performance is computed for one seller over one stated period, from their own orders. It is
        run from a seller's dossier — <a href="/admin/marketplace">find the seller</a> and open it
        there — because a period chosen on a page listing every seller is a period nobody chose.
      </p>

      <p id="page-error" class="error" role="alert" hidden></p>
    </div>
  </section>
</AdminShell>

<script>
  const pageError = document.getElementById('page-error');
  const say = (m: string) => {
    if (!pageError) { window.alert(m); return; }
    pageError.textContent = m; pageError.hidden = false;
    pageError.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown> = {}) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }
  const reloadOr = (res: any, fallback: string) => {
    if (res.ok) { window.location.reload(); return; }
    say(res.body.error || fallback);
  };

  // Publishing needs no reason; refusing or hiding somebody's words does, and
  // the engine takes an optional one either way. Asking only where it matters
  // keeps the prompt meaningful rather than something to click through.
  document.querySelectorAll('[data-mod]').forEach((b) => b.addEventListener('click', async () => {
    const el = b as HTMLElement;
    const status = el.dataset.mod!;
    let reason: string | null = null;
    if (status !== 'published') {
      reason = window.prompt('Why is this review not being published? The author is told.');
      if (!reason) return;
    }
    reloadOr(await post('review/moderate', {
      kind: el.dataset.kind, reviewId: Number(el.dataset.id), status, reason,
    }), 'Could not moderate the review.');
  }));

  document.querySelectorAll('.case-decide').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form as HTMLFormElement);
      reloadOr(await post('authenticity/decide', {
        caseId: Number((form as HTMLElement).dataset.id),
        status: f.get('status'),
        decision: f.get('decision'),
      }), 'Could not record the decision.');
    });
  });

  document.querySelectorAll('[data-fraud]').forEach((b) => b.addEventListener('click', async () => {
    const el = b as HTMLElement;
    const reason = window.prompt('Why? This is the record of what MMAKF concluded about this signal.');
    if (!reason) return;
    let actionTaken: string | null = null;
    if (el.dataset.fraud === 'actioned') {
      actionTaken = window.prompt('What was actually done? Name the act — the signal itself does nothing.');
      if (!actionTaken) return;
    }
    reloadOr(await post('fraud/review', {
      signalId: Number(el.dataset.id), status: el.dataset.fraud, reason, actionTaken,
    }), 'Could not record the review.');
  }));

  document.querySelectorAll('[data-quarantine]').forEach((b) => b.addEventListener('click', async () => {
    const reason = window.prompt('Quarantining this item takes it off every public surface at once. Why?');
    if (!reason) return;
    reloadOr(await post('listing/quarantine', {
      listingId: Number((b as HTMLElement).dataset.quarantine), reason,
    }), 'Could not quarantine the item.');
  }));

  document.querySelectorAll('[data-unquarantine]').forEach((b) => b.addEventListener('click', async () => {
    const reason = window.prompt('Lifting the quarantine puts this item back on sale. Why?');
    if (!reason) return;
    reloadOr(await post('listing/unquarantine', {
      listingId: Number((b as HTMLElement).dataset.unquarantine), reason,
    }), 'Could not lift the quarantine.');
  }));
</script>

<style>
  .queues { display: grid; gap: 12px; grid-template-columns: 1fr; margin: 18px 0; }
  @media (min-width: 720px) { .queues { grid-template-columns: repeat(4, 1fr); } }
  .queue { text-decoration: none; display: block; }
  .queue .n { font-size: 1.8rem; font-weight: 700; }
  .queue .k { font-size: 0.9em; opacity: 0.8; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .row.between { justify-content: space-between; align-items: flex-start; }
  .pill { padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; white-space: nowrap; }
  .muted { opacity: 0.75; }
  .hint { font-size: 0.9em; opacity: 0.8; }
  .error { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .btn-small { padding: 4px 10px; font-size: 0.9em; }
  label { display: block; margin-top: 10px; font-size: 0.9em; }
  input, select, textarea { width: 100%; max-width: 520px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
