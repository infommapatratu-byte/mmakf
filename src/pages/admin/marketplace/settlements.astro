---
// /admin/marketplace/settlements — closing periods and releasing payouts.
//
// ─── THE FOUR-STEP, AND WHY IT IS FOUR ──────────────────────────────────────
//
//   OPEN      accruing; lines may still be added
//   CLOSED    the period is sealed and the net is final
//   APPROVED  a human has released it for payment
//   PAID      the transfer landed
//
// Closing and approving are separate acts so that the person who seals the
// figures and the person who releases the money can be two people. Both take
// `marketplace:settle`, so MMAKF can split them by appointing a second officer
// — and the audit records which of them did which either way.
//
// ─── AND THE REFUSAL THIS PAGE MAKES VISIBLE ────────────────────────────────
//
// A settlement holding a sale whose commission MMAKF has not set CANNOT be
// closed. The button is absent and the server refuses regardless. A statement
// closed over an unknown rate is a wrong figure made final, and once a seller
// has printed it the disagreement is permanent.

import AdminShell from '@/components/AdminShell.astro';
import { identify } from '@/lib/session';
import { isConfigured, db } from '@/db';
import { and, asc, desc, eq, inArray, sql } from 'drizzle-orm';
import * as s from '@/db/schema';
import { canAnywhere } from '@/lib/rbac';

export const prerender = false;

const configured = isConfigured();
const identity = configured ? await identify(Astro.request.headers.get('cookie')) : null;
const principal = identity?.principal ?? null;
const maySettle = principal ? canAnywhere(principal, 'marketplace:settle') : false;

let rows: any[] = [];
let payouts: any[] = [];
let loadError: string | null = null;

if (configured && principal && canAnywhere(principal, 'marketplace:read')) {
  try {
    rows = await db().select({ st: s.sellerSettlements, sellerName: s.sellers.tradingName, sellerRef: s.sellers.ref })
      .from(s.sellerSettlements)
      .innerJoin(s.sellers, eq(s.sellerSettlements.sellerId, s.sellers.id))
      .orderBy(desc(s.sellerSettlements.periodStart), asc(s.sellers.tradingName))
      .limit(200);

    payouts = await db().select({ p: s.sellerPayouts, sellerName: s.sellers.tradingName })
      .from(s.sellerPayouts)
      .innerJoin(s.sellers, eq(s.sellerPayouts.sellerId, s.sellers.id))
      .where(inArray(s.sellerPayouts.status, ['pending', 'queued', 'processing', 'failed']))
      .orderBy(desc(s.sellerPayouts.createdAt)).limit(100);
  } catch (err: any) {
    console.error('[admin/marketplace/settlements]', err);
    loadError = 'The settlements could not be read. The fault has been logged; nothing has been changed.';
  }
}

const money = (m: number | null | undefined) => {
  if (m == null) return '—';
  const sign = m < 0 ? '−' : '';
  const abs = Math.abs(Math.round(m));
  return `${sign}₹${Math.floor(abs / 100).toLocaleString('en-IN')}.${String(abs % 100).padStart(2, '0')}`;
};
const date = (v: unknown) => (v ? new Date(String(v)).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—');
const titleCase = (v: unknown) => String(v ?? '').replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

const open = rows.filter((r: any) => r.st.status === 'open');
const closed = rows.filter((r: any) => r.st.status === 'closed');
const approved = rows.filter((r: any) => ['approved', 'paying'].includes(r.st.status));
const done = rows.filter((r: any) => ['paid', 'on_hold', 'cancelled'].includes(r.st.status));
const blocked = open.filter((r: any) => r.st.hasUnresolvedCommission);
---

<AdminShell title="Settlements" action="marketplace:read">
  <section>
    <div class="container">
      <p><a href="/admin/marketplace">← Marketplace console</a></p>

      {loadError && <div class="card" role="alert"><p>{loadError}</p></div>}

      {blocked.length > 0 && (
        <div class="card tone-wait">
          <div class="eyebrow">Cannot be closed</div>
          <h2 class="h3">{blocked.length} period{blocked.length === 1 ? '' : 's'} contain a sale with no published commission.</h2>
          <p>
            Closing one would make a wrong figure final, so the act is refused — by the server, not only by
            this page. Publish a rate covering the held sales and re-check them on the
            {' '}<a href="/admin/marketplace/commissions">commission page</a>; these periods will then close.
          </p>
        </div>
      )}

      {/* ── Open ────────────────────────────────────────────────────────── */}
      <h2 class="h3">Accruing ({open.length})</h2>
      {open.length === 0 ? (
        <div class="card"><p class="muted">Nothing accruing. A sale reaches a settlement when it is delivered.</p></div>
      ) : (
        <table class="card">
          <caption class="sr-only">Open settlement periods</caption>
          <thead><tr>
            <th scope="col">Seller</th><th scope="col">From</th><th scope="col">Orders</th>
            <th scope="col" class="num">Gross</th><th scope="col" class="num">Commission</th>
            <th scope="col" class="num">Refunds</th><th scope="col" class="num">Net</th><th scope="col"></th>
          </tr></thead>
          <tbody>
            {open.map((r: any) => (
              <tr>
                <th scope="row">{r.sellerName}<div class="muted">{r.st.ref}</div></th>
                <td>{date(r.st.periodStart)}</td>
                <td>{r.st.orderCount}</td>
                <td class="num">{money(r.st.grossMinor)}</td>
                <td class="num">−{money(r.st.commissionMinor)}</td>
                <td class="num">−{money(r.st.refundMinor)}</td>
                <td class="num"><strong>{money(r.st.netPayableMinor)}</strong></td>
                <td>
                  {r.st.hasUnresolvedCommission
                    ? <span class="pill pill-wait">Held — no rate</span>
                    : maySettle
                      ? <button class="btn btn-small" data-close={r.st.id}>Close the period</button>
                      : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Closed, awaiting release ────────────────────────────────────── */}
      <h2 class="h3">Sealed, awaiting release ({closed.length})</h2>
      {closed.length === 0 ? (
        <div class="card"><p class="muted">Nothing waiting for release.</p></div>
      ) : (
        <table class="card">
          <caption class="sr-only">Closed settlements awaiting approval</caption>
          <thead><tr>
            <th scope="col">Seller</th><th scope="col">Period</th>
            <th scope="col" class="num">Net payable</th><th scope="col">Sealed</th><th scope="col"></th>
          </tr></thead>
          <tbody>
            {closed.map((r: any) => (
              <tr>
                <th scope="row">{r.sellerName}<div class="muted">{r.st.ref}</div></th>
                <td>{date(r.st.periodStart)} — {date(r.st.periodEnd)}</td>
                <td class="num"><strong>{money(r.st.netPayableMinor)}</strong></td>
                <td>{date(r.st.closedAt)}</td>
                <td>{maySettle && <button class="btn btn-small btn-primary" data-approve={r.st.id}>Release for payment</button>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Approved ────────────────────────────────────────────────────── */}
      <h2 class="h3">Released ({approved.length})</h2>
      {approved.length === 0 ? (
        <div class="card"><p class="muted">Nothing released.</p></div>
      ) : (
        <table class="card">
          <caption class="sr-only">Approved settlements</caption>
          <thead><tr>
            <th scope="col">Seller</th><th scope="col">Period</th>
            <th scope="col" class="num">Amount</th><th scope="col">State</th><th scope="col"></th>
          </tr></thead>
          <tbody>
            {approved.map((r: any) => (
              <tr>
                <th scope="row">{r.sellerName}<div class="muted">{r.st.ref}</div></th>
                <td>{date(r.st.periodStart)} — {date(r.st.periodEnd)}</td>
                <td class="num">{money(r.st.netPayableMinor)}</td>
                <td>{titleCase(r.st.status)}</td>
                <td>{maySettle && r.st.status === 'approved' && (
                  <button class="btn btn-small" data-payout={r.st.id}>Create the payout instruction</button>
                )}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Payouts in flight ───────────────────────────────────────────── */}
      <h2 class="h3">Payouts in flight ({payouts.length})</h2>
      <div class="card">
        <p class="muted">
          Creating a payout writes the <strong>instruction</strong>, not the transfer. It carries an
          idempotency key the database enforces, so a retried request collides on the index rather than
          sending a second payment — the one operation here that no status change could undo.
        </p>
        {payouts.length === 0 ? (
          <p class="muted">None in flight.</p>
        ) : (
          <table>
            <caption class="sr-only">Payouts awaiting confirmation</caption>
            <thead><tr>
              <th scope="col">Reference</th><th scope="col">Seller</th>
              <th scope="col" class="num">Amount</th><th scope="col">State</th><th scope="col"></th>
            </tr></thead>
            <tbody>
              {payouts.map((x: any) => (
                <tr>
                  <th scope="row">{x.p.ref}</th>
                  <td>{x.sellerName}</td>
                  <td class="num">{money(x.p.amountMinor)}</td>
                  <td>{titleCase(x.p.status)}{x.p.failureReason ? ` — ${x.p.failureReason}` : ''}</td>
                  <td>{maySettle && <button class="btn btn-small" data-paid={x.p.id}>Record as paid</button>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <h2 class="h3">Finished ({done.length})</h2>
      {done.length > 0 && (
        <table class="card">
          <caption class="sr-only">Completed settlements</caption>
          <thead><tr><th scope="col">Seller</th><th scope="col">Period</th><th scope="col" class="num">Net</th><th scope="col">State</th></tr></thead>
          <tbody>
            {done.map((r: any) => (
              <tr>
                <th scope="row">{r.sellerName}</th>
                <td>{date(r.st.periodStart)} — {date(r.st.periodEnd)}</td>
                <td class="num">{money(r.st.netPayableMinor)}</td>
                <td>{titleCase(r.st.status)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <p id="page-error" class="error" role="alert" hidden></p>
    </div>
  </section>
</AdminShell>

<script>
  const pageError = document.getElementById('page-error');
  const say = (m: string) => {
    if (!pageError) { window.alert(m); return; }
    pageError.textContent = m; pageError.hidden = false;
    pageError.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown> = {}) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }
  const reloadOr = (res: any, fallback: string) => {
    if (res.ok) { window.location.reload(); return; }
    say(res.body.error || fallback);
  };

  document.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', async () => {
    if (!window.confirm('Seal this period? Nothing can be added to it afterwards — later refunds land in the next period as an adjustment.')) return;
    reloadOr(await post('settlement/close', { settlementId: Number((b as HTMLElement).dataset.close) }),
      'Could not close the period.');
  }));

  document.querySelectorAll('[data-approve]').forEach((b) => b.addEventListener('click', async () => {
    if (!window.confirm('Release this settlement for payment?')) return;
    reloadOr(await post('settlement/approve', { settlementId: Number((b as HTMLElement).dataset.approve) }),
      'Could not release the settlement.');
  }));

  document.querySelectorAll('[data-payout]').forEach((b) => b.addEventListener('click', async () => {
    const res = await post('payout/create', { settlementId: Number((b as HTMLElement).dataset.payout) });
    if (res.ok && res.body.result?.alreadyExisted) {
      window.alert('A payout instruction for this settlement already existed; the idempotency key stopped a second one being created.');
    }
    reloadOr(res, 'Could not create the payout.');
  }));

  document.querySelectorAll('[data-paid]').forEach((b) => b.addEventListener('click', async () => {
    const utr = window.prompt('Bank reference (UTR) for this transfer, if you have it:');
    if (utr === null) return;
    reloadOr(await post('payout/paid', {
      payoutId: Number((b as HTMLElement).dataset.paid), utr: utr || null,
    }), 'Could not record the payment.');
  }));
</script>

<style>
  .pill { padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; white-space: nowrap; }
  .muted { opacity: 0.75; }
  .error { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .btn-small { padding: 4px 10px; font-size: 0.9em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
