---
// /admin/marketplace/returns — the federation's half of the returns chain.
//
// ═════════════════════════════════════════════════════════════════════════════
// WHAT WAS UNREACHABLE BEFORE THIS PAGE
// ═════════════════════════════════════════════════════════════════════════════
//
// The engine could take a return the whole way — request, decision, RMA,
// inspection, restock, refund, ledger, two notifications — and the federation
// could not see a single one of them. `returnQueue()` did not exist, and
// `dispute/decide`, the action that ends a buyer/seller dispute, had no control
// anywhere in the tree. A dispute could be raised by a buyer, answered by a
// seller, and then it sat there: `raiseDispute()` sets a response clock and
// nothing in MMAKF could stop it.
//
// ═════════════════════════════════════════════════════════════════════════════
// THE DIVISION OF LABOUR, WHICH THIS PAGE DOES NOT BLUR
// ═════════════════════════════════════════════════════════════════════════════
//
// THE SELLER DECIDES THEIR OWN RETURNS. decideReturn() resolves the caller's
// own seller row and filters on it in SQL, so a federation officer cannot
// authorise or refuse a return however senior they are — and that is right:
// the contract of sale is the seller's. This page therefore SHOWS the queue and
// offers no approve button, rather than drawing one that would always fail.
//
// THE FEDERATION CAN POST A REFUND, and refundReturn() says so: not the seller,
// then `marketplace:dispute`. That is the support desk's remedy for a seller
// who has gone quiet on a return they authorised, and it is the one write this
// page makes against a return.
//
// AND ONLY THE FEDERATION DECIDES A DISPUTE. decideDispute() takes
// `marketplace:dispute` and nothing else, because a dispute is precisely the
// case where the two parties could not agree.
//
// ═════════════════════════════════════════════════════════════════════════════
// WHAT IT REFUSES TO INVENT
// ═════════════════════════════════════════════════════════════════════════════
//
// NO PENALTY IS SUGGESTED. decideDispute() accepts a penalty against a seller
// and requires its own separate reason; this page leaves the field empty and
// unpriced, because a default penalty is a fine the federation never set,
// applied by whoever pressed the button hardest.
//
// AND NO REFUND FIGURE IS PROPOSED on a return the federation did not inspect.
// The assessed amount is the seller's inspection, shown as what it is; leaving
// the amount blank refunds exactly that, and the engine refuses anything above
// it.

import AdminShell from '@/components/AdminShell.astro';
import { identify } from '@/lib/session';
import { isConfigured, db } from '@/db';
import { canAnywhere } from '@/lib/rbac';
import { returnQueue, returnItemsForAdmin, disputeQueue } from '@/db/returns';

export const prerender = false;

const configured = isConfigured();
const identity = configured ? await identify(Astro.request.headers.get('cookie')) : null;
const principal = identity?.principal ?? null;
const mayDecide = principal ? canAnywhere(principal, 'marketplace:dispute') : false;

let returns: any[] = [];
let items = new Map<number, any[]>();
let disputes: any[] = [];
let loadError: string | null = null;

if (configured && principal && canAnywhere(principal, 'marketplace:read')) {
  try {
    returns = await returnQueue(db(), principal, 200);
    items = await returnItemsForAdmin(db(), principal, returns.map((r: any) => r.request.id));
    disputes = await disputeQueue(db(), principal, 200);
  } catch (err: any) {
    console.error('[admin/marketplace/returns]', err);
    loadError = 'The returns queue could not be read. The fault has been logged; nothing has been changed.';
  }
}

const money = (m: number | null | undefined) => {
  if (m == null) return '—';
  const sign = m < 0 ? '−' : '';
  const abs = Math.abs(Math.round(m));
  return `${sign}₹${Math.floor(abs / 100).toLocaleString('en-IN')}.${String(abs % 100).padStart(2, '0')}`;
};
const date = (v: unknown) => (v ? new Date(String(v)).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—');
const titleCase = (v: unknown) => String(v ?? '').replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());

/** What the SELLER's inspection assessed, summed from the rows they wrote. */
function assessed(returnRequestId: number): number | null {
  const rows = items.get(returnRequestId);
  if (!rows || rows.length === 0) return null;
  const n = rows.reduce((acc: number, i: any) => acc + (i.approvedRefundMinor ?? 0), 0);
  return n > 0 ? n : null;
}

/** Returns nobody has moved: authorised, sent, and still not inspected. */
const awaitingSeller = returns.filter((r: any) =>
  ['authorised', 'in_transit', 'received'].includes(r.request.status));
const undecided = returns.filter((r: any) => r.request.status === 'requested');
const refundable = returns.filter((r: any) =>
  ['inspected', 'received', 'refund_pending'].includes(r.request.status) && assessed(r.request.id) != null);
---

<AdminShell title="Returns and disputes" requires="marketplace:read">
  <section>
    <div class="container">
      <p><a href="/admin/marketplace">← Marketplace console</a></p>

      {loadError && <p class="error" role="alert">{loadError}</p>}

      {!mayDecide && (
        <div class="card">
          <p class="muted">
            You can see this queue but not act on it. Deciding a dispute or posting a refund on a
            seller's behalf takes <code>marketplace:dispute</code>.
          </p>
        </div>
      )}

      {/* ── Disputes first ────────────────────────────────────────────────
           They are first because they are the only queue here with a clock on
           it that MMAKF itself has to answer: a seller has responded and is
           waiting for the federation to say who is right. */}
      <h2 class="h3">Disputes ({disputes.length})</h2>
      {disputes.length === 0 && <div class="card"><p class="muted">No open disputes.</p></div>}
      {disputes.map((d: any) => (
        <article class="card">
          <header class="row between">
            <div>
              <h3 class="h4" style="margin:0">{d.dispute.ref}</h3>
              <p class="muted" style="margin:4px 0">
                {date(d.dispute.raisedAt)} · {titleCase(d.dispute.kind)} · {titleCase(d.dispute.status)}
                {' '}· {d.sellerName} ({d.sellerRef}) · order {d.orderNo}
              </p>
            </div>
            {d.dispute.respondBy && !d.dispute.sellerRespondedAt && (
              <span class="pill">Seller response due {date(d.dispute.respondBy)}</span>
            )}
          </header>

          <p><strong>Buyer:</strong> {d.dispute.summary}</p>
          {d.dispute.sellerResponse
            ? <p><strong>Seller:</strong> {d.dispute.sellerResponse}</p>
            : <p class="muted">The seller has not responded.</p>}

          {mayDecide && (
            <details class="card">
              <summary>Decide this dispute</summary>
              <form class="dispute-decide" data-id={d.dispute.id}>
                <label for={`out-${d.dispute.id}`}>Outcome</label>
                <select id={`out-${d.dispute.id}`} name="outcome" required>
                  <option value="buyer_upheld">Buyer upheld</option>
                  <option value="seller_upheld">Seller upheld</option>
                  <option value="partial">Partly upheld</option>
                  <option value="no_fault">No fault on either side</option>
                </select>

                <label for={`dr-${d.dispute.id}`}>Reason — both parties read this</label>
                <textarea id={`dr-${d.dispute.id}`} name="reason" rows="3" required maxlength="4000"></textarea>

                <label for={`ref-${d.dispute.id}`}>Refund in rupees (optional)</label>
                <input id={`ref-${d.dispute.id}`} name="refundRupees" type="number" min="0" step="0.01" />

                <label for={`fund-${d.dispute.id}`}>Refund funded by</label>
                <select id={`fund-${d.dispute.id}`} name="refundFundedBy">
                  <option value="seller">The seller</option>
                  <option value="platform">MMAKF</option>
                </select>

                <label for={`pen-${d.dispute.id}`}>Penalty against the seller in rupees (optional)</label>
                <input id={`pen-${d.dispute.id}`} name="penaltyRupees" type="number" min="0" step="0.01" />
                <label for={`pr-${d.dispute.id}`}>Penalty reason — required if a penalty is set</label>
                <input id={`pr-${d.dispute.id}`} name="penaltyReason" type="text" maxlength="500" />
                <p class="hint">
                  Nothing is suggested here. A penalty is a charge the federation has decided to make,
                  and a figure this page proposed would be a fine nobody approved.
                </p>

                <button class="btn btn-primary btn-small" type="submit">Record the decision</button>
              </form>
            </details>
          )}
        </article>
      ))}

      {/* ── Returns ─────────────────────────────────────────────────────── */}
      <h2 class="h3">Returns in flight ({returns.length})</h2>
      <p class="muted">
        {undecided.length} awaiting a seller decision · {awaitingSeller.length} authorised and not yet
        inspected · {refundable.length} inspected and not yet refunded.
      </p>
      <p class="hint">
        A return is authorised or refused by its SELLER — that decision is theirs and this page does
        not offer it. What the federation can do from here is post a refund the seller has not.
      </p>

      {returns.length === 0 && <div class="card"><p class="muted">No returns are in flight.</p></div>}

      {returns.length > 0 && (
        <table class="card">
          <caption class="sr-only">Returns in flight</caption>
          <thead>
            <tr>
              <th scope="col">Return</th>
              <th scope="col">Raised</th>
              <th scope="col">Seller</th>
              <th scope="col">Order</th>
              <th scope="col">Status</th>
              <th scope="col" class="num">Assessed</th>
              <th scope="col">Refund</th>
            </tr>
          </thead>
          <tbody>
            {returns.map((r: any) => (
              <tr>
                <th scope="row">{r.request.ref}</th>
                <td>{date(r.request.requestedAt)}</td>
                <td>{r.sellerName}</td>
                <td>{r.sellerOrderNo}</td>
                <td>{titleCase(r.request.status)}</td>
                <td class="num">{assessed(r.request.id) == null ? '—' : money(assessed(r.request.id))}</td>
                <td>
                  {mayDecide && assessed(r.request.id) != null
                    ? <button class="btn btn-small" data-refund={r.request.id}>Post refund</button>
                    : <span class="muted">
                        {assessed(r.request.id) == null ? 'Not inspected' : '—'}
                      </span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <p id="page-error" class="error" role="alert" hidden></p>
    </div>
  </section>
</AdminShell>

<script>
  const pageError = document.getElementById('page-error');
  const say = (m: string) => {
    if (!pageError) { window.alert(m); return; }
    pageError.textContent = m; pageError.hidden = false;
    pageError.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown> = {}) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }
  const reloadOr = (res: any, fallback: string) => {
    if (res.ok) { window.location.reload(); return; }
    say(res.body.error || fallback);
  };

  document.querySelectorAll('.dispute-decide').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form as HTMLFormElement);
      const num = (k: string) => {
        const raw = String(f.get(k) ?? '').trim();
        return raw === '' ? null : Number(raw);
      };
      // Optional fields are OMITTED when blank rather than sent as zero. A zero
      // refund and "no refund" are different instructions, and the second is
      // what an empty box means.
      const body: Record<string, unknown> = {
        disputeId: Number((form as HTMLElement).dataset.id),
        outcome: f.get('outcome'),
        reason: f.get('reason'),
      };
      const refund = num('refundRupees');
      if (refund != null) {
        body.refundRupees = refund;
        body.refundFundedBy = f.get('refundFundedBy') || 'seller';
      }
      const penalty = num('penaltyRupees');
      if (penalty != null) {
        body.penaltyRupees = penalty;
        const pr = String(f.get('penaltyReason') ?? '').trim();
        if (pr) body.penaltyReason = pr;
      }
      reloadOr(await post('dispute/decide', body), 'Could not record the decision.');
    });
  });

  document.querySelectorAll('[data-refund]').forEach((b) => b.addEventListener('click', async () => {
    const reason = window.prompt(
      'Posting this refund on the seller’s behalf. Why is MMAKF doing it rather than the seller? ' +
      'Both the seller and the buyer see this.'
    );
    if (!reason) return;
    // No amount is sent, so the engine refunds exactly what the inspection
    // assessed. A figure typed here could only be lower — refundReturn()
    // refuses anything above the assessment — and a support officer reducing a
    // seller's own assessment is an adjustment, not a refund.
    reloadOr(await post('return/refund', {
      returnRequestId: Number((b as HTMLElement).dataset.refund),
      fundedBy: 'platform',
      reason,
    }), 'Could not post the refund.');
  }));
</script>

<style>
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .row.between { justify-content: space-between; align-items: flex-start; }
  .pill { padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; white-space: nowrap; }
  .muted { opacity: 0.75; }
  .hint { font-size: 0.9em; opacity: 0.8; }
  .error { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .btn-small { padding: 4px 10px; font-size: 0.9em; }
  label { display: block; margin-top: 10px; font-size: 0.9em; }
  input, select, textarea { width: 100%; max-width: 520px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
