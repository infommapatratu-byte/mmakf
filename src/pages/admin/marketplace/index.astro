---
// /admin/marketplace — the federation's marketplace console.
//
// ─── WHAT THIS PAGE IS FOR ──────────────────────────────────────────────────
//
// Every queue MMAKF has to work, in one place, with the number in each. A queue
// nobody can see is a queue nobody works, and an unworked moderation queue
// approves everything by default.
//
// ─── AND THE ONE IT LEADS WITH ──────────────────────────────────────────────
//
// COMMISSION GAPS. Sales the federation has not told the system how to charge
// for. They are first because they are the only queue where the backlog costs
// somebody money every day it is not worked: each held sale is a seller waiting
// to be paid, and the hold is correct — settling at a rate nobody approved
// would be worse — but it is not something to leave running.
//
// AUTHORISATION IS ASKED ON EVERY QUERY, not once at the top. The counts below
// are read through functions that each assert their own action against the
// caller's scope; a state officer sees their own state's sellers because
// visibleScopes() filtered the SQL, not because this page filtered afterwards.

import AdminShell from '@/components/AdminShell.astro';
import { identify } from '@/lib/session';
import { isConfigured, db } from '@/db';
import { and, desc, eq, inArray, isNull, sql } from 'drizzle-orm';
import * as s from '@/db/schema';
import { canAnywhere } from '@/lib/rbac';
import { sellerQueue, listingQueue, COMMISSION_NOT_SET } from '@/db/marketplace';
import { heldForCommission } from '@/db/marketplace-finance';
import { disputeQueue } from '@/db/returns';
import { openFlags } from '@/db/catalogue';
import { expiringVerifications } from '@/db/seller-registry';

export const prerender = false;

const configured = isConfigured();
const identity = configured ? await identify(Astro.request.headers.get('cookie')) : null;
const principal = identity?.principal ?? null;

const may = (a: any) => (principal ? canAnywhere(principal, a) : false);

let sellers: any[] = [];
let listings: any[] = [];
let gaps: any[] = [];
let disputes: any[] = [];
let flags: any[] = [];
let expiring: any[] = [];
let taxonomyAdopted = 0;
let commissionPublished = 0;
let loadError: string | null = null;

/**
 * Each queue is read INDEPENDENTLY and a failure in one does not blank the
 * others. An officer who cannot see the dispute queue because the seller query
 * timed out has been told nothing useful about either.
 */
async function safely<T>(what: string, fn: () => Promise<T>, fallback: T): Promise<T> {
  try { return await fn(); } catch (err: any) {
    console.error(`[admin/marketplace] ${what}`, err);
    loadError = 'One or more queues could not be read. The fault has been logged; the rest of this page is unaffected.';
    return fallback;
  }
}

if (configured && principal) {
  if (may('marketplace:read')) {
    sellers = await safely('sellers', () => sellerQueue(db(), principal, { status: 'applied' }), []);
    listings = await safely('listings', () => listingQueue(db(), principal, { status: 'submitted' }), []);
    disputes = await safely('disputes', () => disputeQueue(db(), principal, 50), []);
    flags = await safely('flags', () => openFlags(db(), principal, 50), []);
    expiring = await safely('verifications', () => expiringVerifications(db(), principal, 45), []);
    gaps = await safely('commission gaps', () => heldForCommission(db(), principal, 50), []);

    taxonomyAdopted = await safely('taxonomy', async () =>
      (await db().select({ n: sql<number>`count(*)::int` }).from(s.marketplaceCategories))[0]?.n ?? 0, 0);
    commissionPublished = await safely('commission', async () =>
      (await db().select({ n: sql<number>`count(*)::int` })
        .from(s.commissionRuleVersions)
        .where(sql`${s.commissionRuleVersions.publishedAt} is not null`))[0]?.n ?? 0, 0);
  }
}

const heldValue = gaps.reduce((n: number, g: any) => n + (g.gap?.amountAtRiskMinor ?? 0), 0);
const money = (m: number) => `₹${Math.floor(Math.abs(m) / 100).toLocaleString('en-IN')}.${String(Math.abs(m) % 100).padStart(2, '0')}`;
const titleCase = (v: unknown) => String(v ?? '').replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
---

<AdminShell title="Marketplace" action="marketplace:read">
  <section>
    <div class="container">

      {loadError && <div class="card" role="alert"><p>{loadError}</p></div>}

      {/* ── The configuration the marketplace is waiting on ─────────────── */}
      {(taxonomyAdopted === 0 || commissionPublished === 0) && (
        <div class="card tone-wait">
          <div class="eyebrow">Awaiting a federation decision</div>
          <h2 class="h3">The marketplace is running without some of its rules.</h2>
          <ul>
            {taxonomyAdopted === 0 && (
              <li>
                <strong>No product taxonomy.</strong> Product policy — what needs a certificate, an age
                statement or a brand authorisation — attaches to categories, and there are none. The list
                from the federation's own brief is available to adopt in one act; every category arrives
                requiring review, and nothing arrives as permitted.
                {may('marketplace:review') && <> <button class="btn btn-small" id="adopt-taxonomy">Adopt the proposed taxonomy</button></>}
              </li>
            )}
            {commissionPublished === 0 && (
              <li>
                <strong>No commission is published.</strong> {COMMISSION_NOT_SET} Every sale is recorded and
                held; nothing is charged at a rate this system chose.
                {may('marketplace:commission') && <> <a class="btn btn-small" href="/admin/marketplace/commissions">Set commission</a></>}
              </li>
            )}
          </ul>
        </div>
      )}

      {/* ── The queues ──────────────────────────────────────────────────── */}
      <div class="grid">
        <a class="card queue" href="#sellers"><div class="n">{sellers.length}</div><div class="k">Seller applications</div></a>
        <a class="card queue" href="#listings"><div class="n">{listings.length}</div><div class="k">Items awaiting review</div></a>
        <a class="card queue" href="#gaps"><div class="n">{gaps.length}</div><div class="k">Sales held for commission</div></a>
        <a class="card queue" href="#disputes"><div class="n">{disputes.length}</div><div class="k">Open disputes</div></a>
        <a class="card queue" href="#flags"><div class="n">{flags.length}</div><div class="k">Flagged items</div></a>
        <a class="card queue" href="#expiring"><div class="n">{expiring.length}</div><div class="k">Verifications lapsing</div></a>
      </div>

      <p class="row">
        <a class="btn" href="/admin/marketplace/commissions">Commission</a>
        <a class="btn" href="/admin/marketplace/settlements">Settlements</a>
        <a class="btn" href="/admin/listings">Listing review</a>
      </p>

      {/* ── Held for commission ─────────────────────────────────────────── */}
      <h2 class="h3" id="gaps">Sales held for commission ({gaps.length})</h2>
      {gaps.length === 0 ? (
        <div class="card"><p class="muted">Nothing held. Every sale has a published rate behind it.</p></div>
      ) : (
        <div class="card">
          <p class="warn">
            {money(heldValue)} across {gaps.length} sale{gaps.length === 1 ? '' : 's'} cannot be settled.
            Each is a seller waiting to be paid. The hold is correct — the alternative is charging a rate
            nobody approved — but it is not something to leave running.
          </p>
          <table>
            <caption class="sr-only">Sales with no published commission</caption>
            <thead><tr>
              <th scope="col">Seller</th><th scope="col">Order</th>
              <th scope="col">At risk</th><th scope="col">Why</th>
            </tr></thead>
            <tbody>
              {gaps.map((g: any) => (
                <tr>
                  <th scope="row">{g.sellerName}</th>
                  <td>{g.sellerOrderNo}</td>
                  <td>{money(g.gap.amountAtRiskMinor ?? 0)}</td>
                  <td>{titleCase(g.gap.reason)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {may('marketplace:commission') && (
            <p><button class="btn btn-small" id="reresolve">Re-check every held sale against the published rules</button></p>
          )}
        </div>
      )}

      {/* ── Seller applications ─────────────────────────────────────────── */}
      <h2 class="h3" id="sellers">Seller applications ({sellers.length})</h2>
      {sellers.length === 0 ? (
        <div class="card"><p class="muted">Nothing waiting.</p></div>
      ) : (
        <table class="card">
          <caption class="sr-only">Seller applications awaiting review</caption>
          <thead><tr>
            <th scope="col">Reference</th><th scope="col">Trading name</th>
            <th scope="col">Kind</th><th scope="col">Applied</th><th scope="col"></th>
          </tr></thead>
          <tbody>
            {sellers.map((x: any) => (
              <tr>
                <th scope="row">{x.ref}</th>
                <td>{x.tradingName}</td>
                <td>{titleCase(x.sellerType) || '—'}</td>
                <td>{x.appliedAt ? new Date(x.appliedAt).toLocaleDateString('en-IN') : '—'}</td>
                <td><a class="btn btn-small" href={`/admin/marketplace/${x.id}`}>Open</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Verifications lapsing ───────────────────────────────────────── */}
      <h2 class="h3" id="expiring">Verifications lapsing within 45 days ({expiring.length})</h2>
      {expiring.length === 0 ? (
        <div class="card"><p class="muted">None. A verification with no expiry date never appears here.</p></div>
      ) : (
        <div class="card">
          <p class="muted">
            A verification is a fact about a date. The ordinary failure of a register like this is that it
            checks once and never looks again; this is the list that stops that happening.
          </p>
          <table>
            <caption class="sr-only">Verifications approaching expiry</caption>
            <thead><tr><th scope="col">Seller</th><th scope="col">Check</th><th scope="col">Expires</th><th scope="col"></th></tr></thead>
            <tbody>
              {expiring.map((e: any) => (
                <tr>
                  <th scope="row">{e.tradingName}</th>
                  <td>{titleCase(e.verification.check)}</td>
                  <td>{e.verification.expiresAt ? new Date(e.verification.expiresAt).toLocaleDateString('en-IN') : '—'}</td>
                  <td><a class="btn btn-small" href={`/admin/marketplace/${e.verification.sellerId}`}>Open</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* ── Disputes ────────────────────────────────────────────────────── */}
      <h2 class="h3" id="disputes">Open disputes ({disputes.length})</h2>
      {disputes.length === 0 ? (
        <div class="card"><p class="muted">No open disputes.</p></div>
      ) : disputes.map((d: any) => (
        <article class="card">
          <header class="row between">
            <div>
              <h3 class="h4" style="margin:0">{d.dispute.ref} — {titleCase(d.dispute.kind)}</h3>
              <p class="muted" style="margin:4px 0">
                {d.sellerName} · order {d.orderNo} · {titleCase(d.dispute.status)}
              </p>
            </div>
            {d.dispute.respondBy && !d.dispute.sellerRespondedAt && (
              <span class="pill">Seller response due {new Date(d.dispute.respondBy).toLocaleDateString('en-IN')}</span>
            )}
          </header>
          <p><strong>Buyer:</strong> {d.dispute.summary}</p>
          {d.dispute.sellerResponse && <p><strong>Seller:</strong> {d.dispute.sellerResponse}</p>}

          {may('marketplace:dispute') && (
            <form class="dispute-decide" data-id={d.dispute.id}>
              <div class="row">
                <label class="sr-only" for={`out-${d.dispute.id}`}>Outcome</label>
                <select id={`out-${d.dispute.id}`} name="outcome" required>
                  <option value="">Decide…</option>
                  <option value="buyer_upheld">Buyer upheld</option>
                  <option value="seller_upheld">Seller upheld</option>
                  <option value="partial">Partial</option>
                  <option value="no_fault">No fault</option>
                </select>
                <label class="sr-only" for={`ref-${d.dispute.id}`}>Refund, in rupees</label>
                <input id={`ref-${d.dispute.id}`} name="refundRupees" inputmode="decimal" placeholder="Refund ₹ (optional)" />
                <label class="sr-only" for={`fund-${d.dispute.id}`}>Who funds the refund</label>
                <select id={`fund-${d.dispute.id}`} name="refundFundedBy">
                  <option value="seller">Seller funds it</option>
                  <option value="platform">MMAKF funds it</option>
                </select>
              </div>
              <label for={`why-${d.dispute.id}`}>Reason — both parties read this</label>
              <textarea id={`why-${d.dispute.id}`} name="reason" rows="2" required maxlength="2000"></textarea>
              <p class="hint">
                A penalty is not calculated by this system. If MMAKF is charging one, it is entered
                deliberately with its own reason, on the seller's page.
              </p>
              <button class="btn btn-primary btn-small" type="submit">Record the decision</button>
            </form>
          )}
        </article>
      ))}

      {/* ── Flags ───────────────────────────────────────────────────────── */}
      <h2 class="h3" id="flags">Flagged items ({flags.length})</h2>
      {flags.length === 0 ? (
        <div class="card"><p class="muted">No open flags.</p></div>
      ) : (
        <table class="card">
          <caption class="sr-only">Open moderation flags</caption>
          <thead><tr>
            <th scope="col">Item</th><th scope="col">Seller</th><th scope="col">Concern</th>
            <th scope="col">Raised by</th><th scope="col"></th>
          </tr></thead>
          <tbody>
            {flags.map((f: any) => (
              <tr>
                <th scope="row">{f.listingTitle}<div class="muted">{f.listingRef}</div></th>
                <td>{f.sellerName}</td>
                <td>{titleCase(f.flag.kind)}<div class="muted">{f.flag.detail}</div></td>
                <td>{f.flag.raisedBySystem ? 'An automated check' : 'A person'}</td>
                <td>
                  {may('marketplace:review') && (
                    <div class="row">
                      <button class="btn btn-small" data-flag-uphold={f.flag.id}>Uphold</button>
                      <button class="btn btn-small" data-flag-dismiss={f.flag.id}>Dismiss</button>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ── Listings ────────────────────────────────────────────────────── */}
      <h2 class="h3" id="listings">Items awaiting review ({listings.length})</h2>
      <div class="card">
        <p class="muted">
          Each item is reviewed separately from its seller. Approving a seller says who they are; approving
          an item says MMAKF has seen <em>this</em> item, at <em>this</em> price, with <em>these</em>
          photographs.
        </p>
        <p><a class="btn" href="/admin/listings">Work the listing queue</a></p>
      </div>

      <p id="page-error" class="error" role="alert" hidden></p>
    </div>
  </section>
</AdminShell>

<script>
  const pageError = document.getElementById('page-error');
  const say = (m: string) => {
    if (!pageError) { window.alert(m); return; }
    pageError.textContent = m; pageError.hidden = false;
    pageError.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown> = {}) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }
  const reloadOr = (res: any, fallback: string) => {
    if (res.ok) { window.location.reload(); return; }
    say(res.body.error || fallback);
  };

  document.getElementById('adopt-taxonomy')?.addEventListener('click', async () => {
    if (!window.confirm(
      'Adopt the product taxonomy from the federation’s brief?\n\n' +
      'Every category arrives requiring review — adoption accepts a list of names, it does not decide ' +
      'that anything on it may be sold unexamined. Nothing already configured is overwritten.'
    )) return;
    reloadOr(await post('taxonomy/adopt'), 'Could not adopt the taxonomy.');
  });

  document.getElementById('reresolve')?.addEventListener('click', async () => {
    const res = await post('commission/reresolve');
    if (res.ok) {
      window.alert(`Examined ${res.body.result?.examined ?? 0} held sales; ${res.body.result?.resolved ?? 0} now have a published rate.`);
      window.location.reload();
      return;
    }
    say(res.body.error || 'Could not re-check the held sales.');
  });

  document.querySelectorAll('.dispute-decide').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form as HTMLFormElement);
      const refund = String(f.get('refundRupees') ?? '').trim();
      reloadOr(await post('dispute/decide', {
        disputeId: Number((form as HTMLElement).dataset.id),
        outcome: f.get('outcome'),
        reason: f.get('reason'),
        ...(refund ? { refundRupees: refund, refundFundedBy: f.get('refundFundedBy') } : {}),
      }), 'Could not record the decision.');
    });
  });

  const flagDecide = async (id: number, status: 'upheld' | 'dismissed') => {
    const reason = window.prompt(`Reason for marking this flag ${status}:`);
    if (!reason) return;
    reloadOr(await post('flag/decide', { flagId: id, status, reason }), 'Could not record the decision.');
  };
  document.querySelectorAll('[data-flag-uphold]').forEach((b) =>
    b.addEventListener('click', () => flagDecide(Number((b as HTMLElement).dataset.flagUphold), 'upheld')));
  document.querySelectorAll('[data-flag-dismiss]').forEach((b) =>
    b.addEventListener('click', () => flagDecide(Number((b as HTMLElement).dataset.flagDismiss), 'dismissed')));
</script>

<style>
  .grid { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; margin: 18px 0; }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .queue { text-decoration: none; display: block; }
  .queue .n { font-size: 2rem; font-weight: 700; line-height: 1; }
  .queue .k { opacity: 0.75; margin-top: 4px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .row.between { justify-content: space-between; align-items: flex-start; }
  .pill { padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; }
  .muted { opacity: 0.75; }
  .warn { font-weight: 600; }
  .hint { font-size: 0.9em; opacity: 0.8; }
  .error { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); vertical-align: top; }
  .btn-small { padding: 4px 10px; font-size: 0.9em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
