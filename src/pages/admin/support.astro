---
// The support desk.
//
// Ordered escalated-first, then oldest-first — not by priority alone. Priority
// is a judgement made at intake and an old normal-priority ticket has usually
// become the more urgent thing.
//
// Confidential tickets are national-desk work: supportDesk() excludes them for
// any scoped administrator in the WHERE clause, not by filtering afterwards.

import AdminShell from '@/components/AdminShell.astro';
import { isConfigured, db } from '@/db';
import { identify } from '@/lib/session';
import { canAnywhere } from '@/lib/rbac';
import { supportDesk, supportCounts, SUPPORT_CATEGORIES } from '@/db/support';
import { href as surfaceHref, type Surface } from '@/lib/surface';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);

const identity = await identify(Astro.request.headers.get('cookie'));
const principal = identity?.principal ?? null;

const category = Astro.url.searchParams.get('category') || '';
const unassignedOnly = Astro.url.searchParams.get('unassigned') === '1';
const breachedOnly = Astro.url.searchParams.get('breached') === '1';

let rows: any[] = [];
let counts = { open: 0, unassigned: 0, escalated: 0, awaitingMember: 0, breached: 0 };
let unavailable: string | null = null;

if (principal && canAnywhere(principal, 'support:read')) {
  if (!isConfigured()) {
    unavailable = 'The federation database is not reachable from this deployment, so the desk cannot be listed.';
  } else {
    try {
      rows = await supportDesk(db(), principal, {
        category: category || undefined,
        unassignedOnly,
        breachedOnly,
        limit: 200,
      });
      counts = await supportCounts(db(), principal);
    } catch (err: any) {
      unavailable = String(err?.message ?? err);
    }
  }
}

const fmt = (v: unknown) => {
  if (!v) return '—';
  const d = new Date(v as string);
  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
};
const age = (v: unknown) => {
  if (!v) return '';
  const d = new Date(v as string);
  if (Number.isNaN(d.getTime())) return '';
  const days = Math.floor((Date.now() - d.getTime()) / 86_400_000);
  return days <= 0 ? 'today' : days === 1 ? '1 day' : `${days} days`;
};
---

<AdminShell
  title="Support desk"
  requires="support:read"
  intro="Tickets from members, institutions and the public. Ordered by escalation and then by age, because an old ticket nobody answered is usually the more urgent one."
>
  <dl class="stats">
    <div><dt>Open</dt><dd>{counts.open}</dd></div>
    <div><dt>Unassigned</dt><dd>{counts.unassigned}</dd></div>
    <div><dt>Escalated</dt><dd class={counts.escalated ? 'warn' : ''}>{counts.escalated}</dd></div>
    <div><dt>Waiting on member</dt><dd>{counts.awaitingMember}</dd></div>
    <div>
      <dt>Past a published deadline</dt>
      <dd class={counts.breached ? 'warn' : ''}>{counts.breached}</dd>
    </div>
  </dl>

  <p class="sla-note">
    The last figure counts only tickets that have a deadline. MMAKF has
    published no response standard, so most tickets have none — and a ticket
    with no deadline is unmeasured, not met. Counting it as met would put work
    that never happened into a success rate.
  </p>

  <nav class="filters" aria-label="Filter tickets">
    <a href={h('/admin/support')} class={!category && !unassignedOnly && !breachedOnly ? 'on' : ''}>All</a>
    <a href={`${h('/admin/support')}?unassigned=1`} class={unassignedOnly ? 'on' : ''}>Unassigned</a>
    <a href={`${h('/admin/support')}?breached=1`} class={breachedOnly ? 'on' : ''}>Past deadline</a>
    {SUPPORT_CATEGORIES.map((c) => (
      <a href={`${h('/admin/support')}?category=${c.value}`} class={category === c.value ? 'on' : ''}>{c.label}</a>
    ))}
  </nav>

  {unavailable ? (
    <p class="note" role="alert">{unavailable}</p>
  ) : rows.length === 0 ? (
    <p class="note">No tickets match.</p>
  ) : (
    <ul class="tix">
      {rows.map((t) => (
        <li class={t.status === 'escalated' ? 'esc' : ''}>
          <div>
            <p class="t-sub">{t.subject}</p>
            <p class="t-meta">
              <code>{t.ticketNo}</code>
              · {String(t.category).replace(/_/g, ' ')}
              {t.department && <> · {t.department}</>}
              {t.assignedToUserId == null && <> · <span class="muted">unassigned</span></>}
              {t.institutionId && <> · institution #{t.institutionId}</>}
            </p>
          </div>
          <div class="t-side">
            <span class="pill"><span class="pill-dot"></span>{String(t.status).replace(/_/g, ' ')}</span>
            <span class="t-age">{age(t.createdAt)} old</span>
            {(t.escalationLevel ?? 0) > 0 && <span class="t-esc">escalated ×{t.escalationLevel}</span>}
          </div>
        </li>
      ))}
    </ul>
  )}
</AdminShell>

<style>
  .stats { display: flex; flex-wrap: wrap; gap: 0 36px; margin: 0 0 14px; }
  .stats dt { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); max-width: 14ch; line-height: 1.4; }
  .stats dd {
    margin: 5px 0 0; font-family: var(--font-display); font-size: 1.7rem;
    font-variant-numeric: tabular-nums; line-height: 1;
  }
  .stats .warn { color: var(--red); }

  .sla-note {
    margin: 0 0 24px; padding: 14px 18px; border-left: 2px solid var(--gold);
    background: var(--bg-2); color: var(--muted); font-size: .87rem;
    line-height: 1.65; max-width: 66ch;
  }

  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .filters a {
    padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px;
    font-size: .78rem; text-decoration: none; color: var(--muted);
  }
  .filters a.on { background: var(--gold); color: #1a1713; border-color: var(--gold); }

  .note {
    padding: 20px 22px; border-left: 3px solid var(--gold);
    background: var(--card); color: var(--muted); line-height: 1.7; max-width: 62ch;
  }

  .tix { list-style: none; margin: 0; padding: 0; }
  .tix li {
    display: flex; justify-content: space-between; gap: 20px; align-items: flex-start;
    padding: 15px 0 15px 14px; border-bottom: 1px solid var(--border);
    border-left: 2px solid transparent;
  }
  .tix li.esc { border-left-color: var(--red); }
  .t-sub { margin: 0; font-family: var(--font-display); font-size: 1rem; line-height: 1.4; }
  .t-meta { margin: 4px 0 0; font-size: .8rem; color: var(--muted); }
  .t-side { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
  .t-age { font-size: .78rem; color: var(--muted); }
  .t-esc { font-size: .72rem; color: var(--red); }
  .muted { color: var(--muted); }
  code { font-family: var(--font-accent, monospace); font-size: .95em; }

  @media (max-width: 700px) {
    .stats { gap: 0 22px; }
    .stats dd { font-size: 1.3rem; }
    .tix li { flex-direction: column; gap: 8px; }
    .t-side { flex-direction: row; align-items: center; gap: 10px; flex-wrap: wrap; }
  }
</style>
