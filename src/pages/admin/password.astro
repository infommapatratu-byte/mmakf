---
/**
 * CHANGE YOUR OWN PASSWORD — /admin/password
 *
 * The other half of src/pages/api/auth/change-password.ts. Until both existed,
 * an account created by scripts/create-user.ts was flagged
 * must_change_password and had no way to comply: the only rotation the
 * federation had was another CLI reset by whoever holds the connection string,
 * so a credential generated in a terminal could never be replaced by one only
 * its holder knows.
 *
 * Its own page rather than a panel on the console, because it must be reachable
 * by somebody who has just signed in with a credential they were handed and
 * want to replace before doing anything else.
 */
import Base from '@/layouts/Base.astro';
import { identify } from '@/lib/session';

export const prerender = false;

const identity = await identify(Astro.request.headers.get('cookie'));

// Two refusals, and they are different facts. Not signed in at all sends you to
// the door; signed in on a SHARED credential means there is no password here to
// change — it lives in configuration, not in the register, and no row belongs
// to you.
const signedIn = !!identity;
const personal = identity?.via === 'user' && identity.userId != null;
const label = identity?.principal?.label ?? '';
---

<Base title="Change your password — MMAKF Admin" showNav={false} showFooter={false}>
  <section style="min-height:90vh;display:flex;align-items:center;justify-content:center;padding:64px 24px">
    <div style="width:100%;max-width:460px">
      <div style="text-align:center;margin-bottom:32px">
        <div style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;letter-spacing:.06em">MMAKF</div>
        <div style="font-family:var(--font-display);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-top:6px">Administration</div>
      </div>

      {!signedIn ? (
        <div class="card" style="padding:32px">
          <h1 class="card-title" style="font-size:1.15rem">You are not signed in</h1>
          <p class="card-body" style="margin-top:10px">
            <a href="/admin" class="text-gold">Sign in</a>, then come back here.
          </p>
        </div>
      ) : !personal ? (
        <div class="card" style="padding:32px">
          <h1 class="card-title" style="font-size:1.15rem">Nothing to change here</h1>
          <p class="card-body" style="margin-top:10px;line-height:1.7">
            You are signed in with a <strong>shared credential</strong> — the office password or a
            unit access code. Those live in the deployment&rsquo;s configuration rather than in the
            register, so there is no password of yours to change and no record of who used it.
          </p>
          <p class="card-body" style="margin-top:10px;line-height:1.7">
            Ask a federation officer for a personal account. Every action then carries your name.
          </p>
          <a class="btn btn-ghost" href="/admin" style="margin-top:18px">Back to the console &rarr;</a>
        </div>
      ) : (
        <form id="pwForm" class="card" style="padding:32px">
          <h1 class="card-title" style="font-size:1.15rem;margin-bottom:6px">Change your password</h1>
          <p class="card-body" style="margin-bottom:22px;font-size:.8rem">Signed in as {label}</p>

          <label class="input-label" for="cur">Current password</label>
          <input class="input" type="password" id="cur" name="currentPassword"
                 autocomplete="current-password" required />

          <label class="input-label" for="nw" style="margin-top:14px">New password</label>
          <input class="input" type="password" id="nw" name="newPassword"
                 autocomplete="new-password" minlength="12" required />

          <label class="input-label" for="nw2" style="margin-top:14px">New password again</label>
          <input class="input" type="password" id="nw2" name="confirm"
                 autocomplete="new-password" minlength="12" required />

          <p class="card-body" style="margin-top:12px;font-size:.74rem;color:var(--muted)">
            At least 12 characters. A phrase you can remember beats a short string you cannot.
          </p>

          <div id="pwErr" role="alert" style="color:var(--red-2);font-size:.85rem;margin-top:12px;display:none"></div>
          <div id="pwOk" role="status" style="color:var(--gold);font-size:.85rem;margin-top:12px;display:none"></div>

          <button type="submit" class="btn btn-primary" style="width:100%;margin-top:20px;justify-content:center">
            Change password
          </button>

          <p class="card-body" style="margin-top:18px;font-size:.74rem;color:var(--muted);line-height:1.7">
            Every other session for your account is signed out when you do this. This one stays.
          </p>
        </form>
      )}
    </div>
  </section>

  <script>
    const f = document.getElementById('pwForm');
    if (f) {
      const err = document.getElementById('pwErr');
      const ok = document.getElementById('pwOk');
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.style.display = 'none';
        ok.style.display = 'none';

        const fd = new FormData(f);
        const currentPassword = String(fd.get('currentPassword') || '');
        const newPassword = String(fd.get('newPassword') || '');
        const confirm = String(fd.get('confirm') || '');

        // Checked here as well as on the server, because the server cannot see
        // a typo the operator made twice differently — it only ever receives
        // one of the two.
        if (newPassword !== confirm) {
          err.textContent = 'The two new passwords do not match.';
          err.style.display = 'block';
          return;
        }

        const btn = f.querySelector('button[type=submit]');
        if (btn) { btn.disabled = true; btn.textContent = 'Changing…'; }

        const r = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ currentPassword, newPassword }),
        }).catch(() => null);

        if (btn) { btn.disabled = false; btn.textContent = 'Change password'; }

        const body = r ? await r.json().catch(() => null) : null;

        if (r && r.ok && body && body.ok) {
          // The prompt is satisfied, so the flag that raises it goes.
          try { sessionStorage.removeItem('mmakf_must_change_password'); } catch (x) {}
          f.reset();
          ok.textContent = body.signedOut
            ? 'Password changed. You have been signed out — sign in again with the new one.'
            : 'Password changed. Every other session has been signed out.';
          ok.style.display = 'block';
          return;
        }

        err.textContent = (body && body.error)
          || (r && r.status === 429 ? 'Too many attempts. Wait a minute and try again.' : '')
          || 'The password could not be changed.';
        err.style.display = 'block';
      });
    }
  </script>
</Base>
