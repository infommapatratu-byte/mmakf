---
// The coach pipeline.
//
// Recruitment is a sequence of recorded stages, and this screen is where they
// are read. Nothing here appoints anybody: the assignment engine recommends
// with reasons, and only confirmAssignment() — which takes a principal and
// writes an audit row — can put a coach on a programme.
//
// ─────────────────────────────────────────────────────────────────────────────
// ADOPTING THE SHARED SYSTEM
// ─────────────────────────────────────────────────────────────────────────────
//
// The heading block, the stage strip, the status pills and the empty and error
// blocks are now the shared components: AdminShell's `header` (§12), Status
// (§102), EmptyState and ErrorState. The QUERY IS UNCHANGED — same stage
// filter, same scope predicate, same sixty-day qualification horizon — and
// `?status=` still means what it meant.
//
// WHAT DID NOT BECOME A TABLE, AND WHY. A candidate row is a name, a reference,
// a grade, a stage — and the recorded reason a decision went the way it did.
// That reason is prose and it is the substance of the screen: a stage without
// the reason behind it is a status nobody can act on. Forced into a cell it
// truncates. §97 asks for the shared table where a page has a table; this page
// has a pipeline of people, and it stays a list.

import AdminShell from '@/components/AdminShell.astro';
import Status from '@/components/Status.astro';
import EmptyState from '@/components/states/EmptyState.astro';
import ErrorState from '@/components/states/ErrorState.astro';
import { isConfigured, db } from '@/db';
import { identify, clientIp } from '@/lib/session';
import { rateLimit } from '@/lib/ratelimit';
import { canAnywhere, ForbiddenError } from '@/lib/rbac';
import type { AuditContext } from '@/db/federation';
import { readSubmission } from '@/lib/form-intake';
import {
  coachPipeline, expiringQualifications, COACH_STATUSES,
  advanceCoachApplication, activateApprovedCoach, isCoachError, COACH_TRANSITIONS,
  type CoachStatus,
} from '@/db/coaches';
import { statusOf } from '@/lib/status';
import { href as surfaceHref, type Surface } from '@/lib/surface';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);
const SELF = h('/admin/coaches');
// The stage machine itself, so the control can never offer a move the module
// refuses. One definition, in src/db/coaches.ts.
const NEXT_STAGES = COACH_TRANSITIONS;

const identity = await identify(Astro.request.headers.get('cookie'));
const principal = identity?.principal ?? null;

// ─── The write path this screen never had ───────────────────────────────────
//
// This page's own frontmatter used to say "neither has a screen yet", and it
// was right: `advanceCoachApplication()` and `activateCoach()` were written,
// tested and CALLED BY NOTHING. The consequence was not a missing button — it
// was that `/teachers` could never contain a single instructor, because
// `publicFaculty()` reads only ACTIVE coach profiles and nothing could create
// one. However many coaches MMAKF approved, the public faculty page stayed
// empty and nothing failed.
//
// TWO ACTIONS, TWO PERMISSIONS, DELIBERATELY.
//
//   `coach:review`  moves a candidate between recorded stages.
//   `coach:write`   turns an approved candidate into a coach, which creates a
//                   `persons` row and puts them on a public page.
//
// The module enforces both; this re-checks them so the refusal is a sentence
// rather than a bare 403, and so the controls are not drawn for somebody who
// cannot use them.
const mayReview = Boolean(principal) && canAnywhere(principal!, 'coach:review');
const mayActivate = Boolean(principal) && canAnywhere(principal!, 'coach:write');

const DONE_MESSAGES: Record<string, string> = {
  advanced: 'The candidate has moved on, and the stage is recorded with who moved them.',
  rejected: 'The candidate is turned down, with your reason recorded against the application.',
  activated: 'The coach is active. They now appear on the public teaching faculty, and a person record exists for them in the federation register.',
};

let actionError: string | null = null;

// Posts to this page rather than to /api/: the middleware requires
// application/json on /api/ paths and a form cannot send one, while the
// same-origin check that answers CSRF applies here identically.
if (Astro.request.method === 'POST') {
  const form = await readSubmission(Astro.request);
  const get = (k: string) => String(form.get(k) ?? '').trim();
  const act = get('act');
  const reason = get('reason');
  const applicationId = Number(get('applicationId'));

  const rl = await rateLimit(Astro.request, 'coach-decide', 40, 60);

  if (!rl.ok) {
    Astro.response.status = 429;
    actionError = `Too many decisions in a short time. Nothing was changed. Try again in ${rl.retryAfterSeconds} seconds.`;
  } else if (!identity) {
    Astro.response.status = 401;
    actionError = 'Your session has ended. Sign in again — nothing was changed.';
    // isConfigured() rather than the `configured` const, which is declared
    // below this block — the read setup runs after the write, so that a
    // successful act redirects before anything is queried.
  } else if (!isConfigured()) {
    Astro.response.status = 503;
    actionError = 'The federation database is not reachable from this deployment, so there is nothing to record against.';
  } else if (!Number.isInteger(applicationId) || applicationId <= 0) {
    Astro.response.status = 400;
    actionError = 'Name the candidate to act on.';
  } else {
    const ctx: AuditContext = {
      principal: identity.principal,
      ip: clientIp(Astro.request),
      authority: identity.shared ? `shared:${identity.via}` : 'user',
      reason: reason || null,
    };
    try {
      if (act === 'advance') {
        if (!mayReview) {
          Astro.response.status = 403;
          actionError = 'Moving a candidate between stages requires coach:review, which this account does not hold in any scope.';
        } else {
          const to = get('to') as CoachStatus;
          if (!(COACH_STATUSES as readonly string[]).includes(to)) {
            Astro.response.status = 400;
            actionError = 'That is not a recorded stage.';
          } else {
            await advanceCoachApplication(db(), ctx, applicationId, to, { reason: reason || null });
            return Astro.redirect(
              `${h('/admin/coaches')}?done=${to === 'rejected' ? 'rejected' : 'advanced'}`, 303
            );
          }
        }
      } else if (act === 'activate') {
        if (!mayActivate) {
          Astro.response.status = 403;
          actionError = 'Activating a coach requires coach:write, which this account does not hold. Moving somebody through the stages and putting them on the public faculty are separate authorities.';
        } else {
          await activateApprovedCoach(db(), ctx, applicationId);
          return Astro.redirect(`${h('/admin/coaches')}?done=activated`, 303);
        }
      } else {
        Astro.response.status = 400;
        actionError = 'Unknown action.';
      }
    } catch (err: any) {
      if (err instanceof ForbiddenError) {
        Astro.response.status = 403;
        actionError = 'Your credential does not hold the authority this act requires at that scope.';
      } else if (isCoachError(err)) {
        // The module's refusals are written for the person reading them — "a
        // candidate cannot go from screening to approved" — so they are shown
        // as they are rather than replaced with a generic message.
        Astro.response.status = 400;
        actionError = err.message;
      } else {
        console.error('[admin/coaches] act failed', err);
        Astro.response.status = 500;
        actionError = 'Nothing was changed.';
      }
    }
  }
}

const done = Astro.url.searchParams.get('done');
const doneMessage = done && DONE_MESSAGES[done] ? DONE_MESSAGES[done] : null;

// Only a stage the enum actually holds reaches the query. `?status=` is a URL
// people type and share, and an unrecognised value used to travel all the way
// to a Postgres enum comparison and come back as a failed read — an error
// screen for a typo, with the raw SQL behind it. An unknown stage is no filter.
//
// COACH_STATUSES, not PIPELINE: withdrawn, rejected, suspended and inactive are
// real recorded stages that this screen does not put in its strip, and a link
// to one of them should still work.
const requestedStatus = Astro.url.searchParams.get('status') || '';
const filter = (COACH_STATUSES as readonly string[]).includes(requestedStatus)
  ? requestedStatus
  : '';

let rows: any[] = [];
let expiring: any[] = [];

// A deployment with no database has not failed at anything; a query that threw
// has. They were one variable and they are two, because only one of them is
// worth telling somebody to retry.
const configured = isConfigured();
let failure: string | null = null;
// Whether the pipeline was actually read. Nothing derived from `rows` is a
// figure until this is true — an empty array from a deployment with no database
// is not a pipeline with nobody in it.
let queried = false;

if (principal && canAnywhere(principal, 'coach:read')) {
  if (configured) {
    try {
      rows = await coachPipeline(db(), principal, {
        status: (filter || undefined) as CoachStatus | undefined,
        limit: 200,
      });
      expiring = await expiringQualifications(db(), principal, 60);
      queried = true;
    } catch (err: any) {
      failure = String(err?.message ?? err);
    }
  }
}

// The order the federation described. Rendered as a pipeline rather than a
// status dropdown, because the sequence is the point: an approval means the
// stages before it actually happened.
const PIPELINE: CoachStatus[] = [
  'candidate', 'screening', 'interview', 'technical_review',
  'document_check', 'approved', 'active',
];

const countIn = (s: CoachStatus) => rows.filter((r) => r.status === s).length;
const fmt = (v: unknown) => {
  if (!v) return '—';
  const d = new Date(v as string);
  return Number.isNaN(d.getTime()) ? '—' : d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
};

/**
 * When a stage count is a real answer.
 *
 * The old strip printed one under every stage unconditionally, and it was wrong
 * in two ways it never admitted. Under a stage filter the query returns only
 * that stage, so every OTHER stage read zero — six stages reporting empty when
 * they were not. And the query is capped at two hundred rows, so past that the
 * counts describe the first two hundred candidates rather than the pipeline.
 *
 * There is no coachCounts() to ask instead, so the honest move is to print the
 * numbers when they are complete and print none when they are not. A count
 * nobody could stand behind is worse than no count: the reader cannot tell
 * which kind they are looking at.
 *
 * `queried` is the third condition and the one this screen was caught on: with
 * no DATABASE_URL — which is what production has — nothing was read, and an
 * empty array counted stage by stage printed eight confident zeroes for a
 * pipeline nobody had looked at.
 */
const countsAreComplete = queried && !filter && rows.length < 200;

const tabs = [
  ...PIPELINE.map((s) => ({
    label: statusOf(s, 'coach').label,
    href: `${h('/admin/coaches')}?status=${s}`,
    count: countsAreComplete ? countIn(s) : undefined,
  })),
  {
    label: 'All',
    href: h('/admin/coaches'),
    count: countsAreComplete ? rows.length : undefined,
  },
];

// §104: an absence names its kind and offers a way out.
const emptyTitle = filter
  ? `No candidate is at the ${statusOf(filter, 'coach').label.toLowerCase()} stage.`
  : 'No coach has applied yet.';
const emptyAction = filter
  ? { label: 'See every candidate', href: h('/admin/coaches') }
  : { label: 'Back to the operations console', href: h('/admin') };
---

<AdminShell
  title="Coaches"
  requires="coach:read"
  intro="Candidates and instructors. The stages are recorded in order and cannot be skipped, so an approval always means the screening, the interview and the technical review took place."
  header={{
    breadcrumbs: [
      { name: 'Operations', url: h('/admin') },
      { name: 'Coaches', url: h('/admin/coaches') },
    ],
    /* The stage strip, as real links. It was already one — the same hrefs, the
       same ?status= — and it stays in pipeline order because the order is the
       claim this screen makes.

       No action bar. Nothing on this page advances a candidate or appoints
       anybody: advanceCoachApplication() and confirmAssignment() both take a
       principal and write an audit row, and neither has a screen yet. §13's one
       dominant action is not a licence to draw a button for a route that does
       not exist. */
    tabs,
  }}
>
  {!configured ? (
    /* Neither EmptyState nor ErrorState. Nothing failed and nobody has been
       turned away — this deployment has no database to hold a coach record,
       which is a fourth kind of absence and is what production renders today. */
    <p class="unconfigured">
      The federation database is not reachable from this deployment, so the
      coach pipeline cannot be listed. That is not an empty pipeline and not a
      failure: the candidates live in the federation's database, and this
      deployment has no connection to one.
    </p>
  ) : failure ? (
    <ErrorState
      title="The coach pipeline could not be read."
      safe="Nothing has been changed. This was a read, so no candidate was advanced, approved or rejected, and no coach was assigned to anything."
      detail={failure}
    />
  ) : (
    <>
      {doneMessage && <p class="c-ok" role="status">{doneMessage}</p>}
      {actionError && <p class="c-bad" role="alert">{actionError}</p>}

      {expiring.length > 0 && (
        <section class="expiring" role="status">
          <h2 class="sec-h">Qualifications lapsing within sixty days</h2>
          <p class="sec-p">
            A coach whose clearance has lapsed is excluded from work with
            children automatically. Told now, rather than on the morning they
            turn up at a school and cannot teach.
          </p>
          <ul>
            {expiring.map((e: any) => (
              <li>
                <strong>{e.fullName}</strong> — {e.qualification.title}
                <span class="muted"> expires {fmt(e.qualification.expiresOn)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {rows.length === 0 ? (
        <EmptyState
          title={emptyTitle}
          body="Applications arrive through the training platform and create a screening task for the coach manager automatically."
          action={emptyAction}
        />
      ) : (
        <ul class="cands">
          {rows.map((r) => (
            <li>
              <div>
                <p class="c-name">{r.fullName}</p>
                <p class="c-meta">
                  <code>{r.ref}</code>
                  {r.danGrade && <> · {r.danGrade}</>}
                  {r.teachingYears != null && <> · {r.teachingYears} years teaching</>}
                  {r.city && <> · {r.city}</>}
                </p>
                {r.decisionReason && <p class="c-reason">{r.decisionReason}</p>}
              </div>
              <div class="c-side">
                {/* `active` means something different for a coach than for a
                    membership — available for assignment, not paid up — which
                    is exactly what the domain argument is for. */}
                <Status value={r.status} domain="coach" />
                <span class="c-when">{fmt(r.submittedAt)}</span>

                {/* THE STAGES, AS THE MACHINE ALLOWS THEM.
                    Only the transitions COACH_TRANSITIONS actually permits are
                    offered, so the screen cannot suggest a move the module will
                    refuse. The module re-checks regardless — this is the
                    courteous half of a gate that holds either way. */}
                {mayReview && NEXT_STAGES[r.status as CoachStatus]?.length > 0 && (
                  <form method="post" action={SELF} class="c-act">
                    <input type="hidden" name="act" value="advance" />
                    <input type="hidden" name="applicationId" value={String(r.id)} />
                    <label class="sr-only" for={`to-${r.id}`}>Move {r.fullName} to</label>
                    <select class="input input-sm" id={`to-${r.id}`} name="to" required>
                      <option value="">Move to…</option>
                      {NEXT_STAGES[r.status as CoachStatus].map((s) => (
                        <option value={s}>{statusOf(s, 'coach').label}</option>
                      ))}
                    </select>
                    <label class="sr-only" for={`why-${r.id}`}>Reason</label>
                    <input class="input input-sm" id={`why-${r.id}`} name="reason"
                           placeholder="Reason (required to reject)" maxlength="400" />
                    <button class="btn btn-sm" type="submit">Record</button>
                  </form>
                )}

                {/* ACTIVATION — the act that makes somebody a member of the
                    public teaching faculty, and the one that was missing. */}
                {mayActivate && r.status === 'approved' && (
                  <form method="post" action={SELF} class="c-act">
                    <input type="hidden" name="act" value="activate" />
                    <input type="hidden" name="applicationId" value={String(r.id)} />
                    <button class="btn btn-sm btn-primary" type="submit">
                      Activate as coach
                    </button>
                    <span class="c-note">
                      {r.personId
                        ? 'Creates their coach profile and puts them on /teachers.'
                        : 'Creates their federation person record and their coach profile, and puts them on /teachers.'}
                    </span>
                  </form>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}

      <p class="c-standing">
        <strong>Activating a coach publishes them.</strong> It creates a coach
        profile, and <code>/teachers</code> lists every active profile — so this
        is the moment a name and a grade appear on the public federation site.
        A candidate who is not activated never enters the federation's people
        register at all, which is why an unsuccessful applicant cannot inflate
        the membership count.
        <br />
        <strong>A stated grade is not a verified one.</strong> The Dan grade on
        an application is what the candidate wrote about themselves.
        <code>/teachers</code> shows it separately from, and visibly weaker
        than, a grade the federation's own examination register holds — and only
        <a href={h('/admin/grading')}> a recorded grading</a> produces the
        second.
      </p>
    </>
  )}
</AdminShell>

<style>
  .c-ok, .c-bad {
    padding: 0.7rem 1rem; border-radius: var(--radius, 6px);
    border: 1px solid var(--c-border, #ddd); margin-bottom: 1rem; max-width: 72ch;
  }
  .c-bad { border-color: var(--c-bad-border, #c66); }

  .c-act { display: flex; gap: 0.35rem; flex-wrap: wrap; align-items: center; margin-top: 0.45rem; }
  .input-sm { font-size: 0.78rem; padding: 0.2rem 0.4rem; max-width: 11rem; }
  .btn-sm { font-size: 0.78rem; padding: 0.2rem 0.6rem; }
  .c-note { font-size: 0.75rem; color: var(--c-muted, #777); flex: 1 1 100%; }

  .c-standing {
    margin-top: 1.75rem; padding: 0.85rem 1rem;
    border: 1px solid var(--c-border, #ddd); border-radius: var(--radius, 6px);
    font-size: 0.9rem; max-width: 76ch;
  }

  /* Labels for the per-row controls: the row already names the candidate, so a
     visible label on every select would be noise — but a control with no
     accessible name is unusable with a screen reader. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .expiring {
    padding: 20px 22px; border-left: 3px solid var(--red);
    background: var(--card); color: var(--muted); line-height: 1.7; max-width: 66ch;
    margin: 0 0 26px;
  }
  .sec-h { font-family: var(--font-display); font-size: 1rem; margin: 0 0 8px; color: var(--off-white, inherit); }
  .sec-p { margin: 0 0 12px; font-size: .9rem; }
  .expiring ul { margin: 0; padding-left: 18px; }
  .expiring li { margin: 4px 0; font-size: .9rem; }

  .unconfigured {
    color: var(--muted);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }

  .cands { list-style: none; margin: 0; padding: 0; }
  .cands li {
    display: flex; justify-content: space-between; gap: 20px; align-items: flex-start;
    padding: 16px 0; border-bottom: 1px solid var(--border);
  }
  .c-name { margin: 0; font-family: var(--font-display); font-size: 1.05rem; }
  .c-meta { margin: 4px 0 0; font-size: .82rem; color: var(--muted); }
  .c-reason { margin: 7px 0 0; font-size: .87rem; color: var(--muted); max-width: 60ch; line-height: 1.6; }
  .c-side { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; flex-shrink: 0; }
  .c-when { font-size: .78rem; color: var(--muted); }
  .muted { color: var(--muted); }
  code { font-family: var(--font-accent, monospace); font-size: .95em; }

  @media (max-width: 700px) {
    .cands li { flex-direction: column; gap: 8px; }
    .c-side { flex-direction: row; align-items: center; gap: 10px; }
  }
</style>
