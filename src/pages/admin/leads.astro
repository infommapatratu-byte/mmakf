---
// The lead pipeline — every enquiry the federation has received, and the
// channel that introduced it.
//
// A LEAD AND AN INSTITUTIONAL APPLICATION ARE NOT THE SAME OBJECT, and this
// page must never present them as one. An application (/admin/applications) is
// a school formally asking for a programme, and submitting one also records the
// enquiry here — though NOT always as a new row. submitApplication() calls
// captureLead(), which folds the enquiry into the applicant's open lead when
// they already have one, and which is wrapped in a try/catch: an application
// whose lead could not be written is filed with a `lead_failed` event against
// itself and never appears here at all. So the count of applications and the
// count of leads are not two views of one number, and this page must not be
// read as if they were.
// A lead can exist with no application behind it at all — somebody who found a
// video, sent one email, and has filled in nothing. Collapsing the two screens
// would either hide those enquiries or imply an application nobody submitted.
// They are shown as linked, never as equal: a lead's training requests appear
// on its detail panel, and an application reaches this page only as the lead it
// was folded into.
//
// A LEAD IS ALSO NOT A MEMBER. Until somebody identifies it against a canonical
// institution or person, an enquiry is an enquiry — it is not on the register
// /verify answers from. The detail panel says which of the two a row is.
//
// Rows are scope-filtered in SQL by leadPipeline(); nothing here filters an
// array to decide who may see what. A lead with no unit attached is national-
// only by that function's fail-closed reading, which is why a state account can
// see fewer leads than it might expect.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT THIS PAGE NOW RENDERS THROUGH THE SHARED SYSTEM, AND WHY
// ─────────────────────────────────────────────────────────────────────────────
//
// PageHeader (§12) carries the pipeline as its tab strip. The nine stages were
// a bespoke `.pipe` list with its own counting, its own colours and its own
// idea of what "current" meant; they are real links to real querystrings, which
// is exactly what PageHeader's tabs are, and the counts on them are counted
// from rows this page actually read.
//
// Status.astro (§102) draws every status. The old `.pill` here painted `won`,
// `lost` and `dormant` in one grey, so a pipeline could not be triaged at a
// glance — which is the entire job of a pipeline.
//
// DataTable (§97, PART AL) is the register. It replaces a wide table AND a
// duplicate card list that had to be edited twice for every change, and it is
// what supplies filtering, ordering, paging and the phone layout.
//
// ONE BEHAVIOUR CHANGED, DELIBERATELY. The filtered list used to be a SECOND
// SQL query with its own limit, while the stage counts came from the first.
// Two windows, presented as one screen: selecting `qualified` could list a lead
// that the counts above it had never seen. There is now one read, the counts
// and the rows come from it, and its size is stated on the table rather than
// implied.

import AdminShell from '@/components/AdminShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import Status from '@/components/Status.astro';
import Table from '@/components/DataTable/Table.astro';
import ErrorState from '@/components/states/ErrorState.astro';
import type { Column, Filter } from '@/components/DataTable/types';
import { readTableQuery, type TableQuery } from '@/components/DataTable/query';
import { isConfigured, db } from '@/db';
import * as s from '@/db/schema';
import { eq } from 'drizzle-orm';
import { identify, clientIp } from '@/lib/session';
import { rateLimit } from '@/lib/ratelimit';
import type { AuditContext } from '@/db/federation';
import { canAnywhere, visibleScopes, ForbiddenError } from '@/lib/rbac';
import {
  leadPipeline, leadDetail, sourceAttribution, isEngagementError,
  setLeadStatus, assignLeadOwner, addLeadActivity,
  LEAD_TRANSITIONS, TERMINAL_LEAD_STATUSES, LEAD_ACTIVITY_KINDS,
  LEAD_SOURCES, AUDIENCES, type Audience,
} from '@/db/engagement';
// Whether a fee framework is published is a fact about the database, and
// /admin/fees can change it. Read it rather than assert it — see below.
import { activeFramework } from '@/db/fees';
import { href as surfaceHref, type Surface } from '@/lib/surface';
import { readSubmission } from '@/lib/form-intake';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);

const identity = await identify(Astro.request.headers.get('cookie'));
const principal = identity?.principal ?? null;

// Held in ANY scope. Whether it covers the particular lead is decided by the
// module against that lead's own placement, which is the only check that stays
// correct — this one decides whether to draw the controls at all.
const mayWrite = Boolean(principal) && canAnywhere(principal!, 'engagement:write');

// The nine states, in the order the schema declares them — which is the order a
// lead travels. Sorting this strip by volume would put the fullest column first
// and stop it being a pipeline.
const PIPELINE = [
  'new', 'qualifying', 'qualified', 'quoted', 'proposed',
  'won', 'lost', 'dormant', 'disqualified',
] as const;

// Both filters are validated against the enum rather than passed through, so a
// hand-typed query string cannot reach the SQL builder — or the table's own
// filtering — with a value the column has never held.
const statusParam = Astro.url.searchParams.get('status') ?? '';
const status = (PIPELINE as readonly string[]).includes(statusParam) ? statusParam : '';
const audienceParam = Astro.url.searchParams.get('audience') ?? '';
const audience: Audience | '' =
  (AUDIENCES as readonly string[]).includes(audienceParam) ? (audienceParam as Audience) : '';

const leadParam = Astro.url.searchParams.get('lead') ?? '';
const leadId = /^[0-9]{1,9}$/.test(leadParam) ? Number(leadParam) : null;


// ─────────────────────────────────────────────────────────────────────────────
// THE ACTS — added because this page could read the pipeline and not touch it
// ─────────────────────────────────────────────────────────────────────────────
//
// Every enquiry the federation had received sat at the status the capture path
// gave it. There was no POST handler on this file at all, and src/db/engagement.ts
// exposed no function that could move a lead: captureLead() sets the status on
// the way in, identifyLead() nudges `new` to `qualifying` as a side effect, and
// that was the whole of it. So the nine-column pipeline strip above was, in
// practice, one column — and a board that shows work and cannot record that the
// work was done teaches its users to keep the real state in a spreadsheet the
// federation cannot audit.
//
// POSTS TO THIS PAGE, NOT TO /api/. The middleware requires application/json on
// /api/ paths and a form without JavaScript cannot send one; the same-origin
// check that answers CSRF applies here identically. This is the same choice
// /admin/guardianships made, for the same reason.
//
// AUTHORITY IS RE-CHECKED ON EVERY ACT, and the scope is re-derived from the
// stored lead inside setLeadStatus() / assignLeadOwner() / addLeadActivity()
// rather than from anything in the form. A lead id posted by hand therefore
// reaches the same refusal that opening it would.

const DONE_MESSAGES: Record<string, string> = {
  moved: 'The lead has moved, with your reason recorded against it and in the audit.',
  assigned: 'The lead is assigned. The owner can be changed again at any time.',
  unassigned: 'The lead has no owner. It stays in the pipeline and stays visible.',
  noted: 'Recorded against the lead.',
};

let actError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await readSubmission(Astro.request);
  const get = (k: string) => String(form.get(k) ?? '').trim();
  const act = get('act');
  const target = Number(get('leadId'));

  // A lead moves at human speed. This is generous enough for an afternoon of
  // pipeline work and tight enough that a script cannot walk the identifiers.
  const rl = await rateLimit(Astro.request, 'lead-act', 60, 60);
  const backTo = (done: string) =>
    `${h('/admin/leads')}?lead=${target}&done=${done}`;

  if (!rl.ok) {
    Astro.response.status = 429;
    actError = `Too many changes in a short time. Nothing was changed. Try again in ${rl.retryAfterSeconds} seconds.`;
  } else if (!principal) {
    Astro.response.status = 401;
    actError = 'Your session has ended. Sign in again — nothing was changed.';
  } else if (!isConfigured()) {
    Astro.response.status = 503;
    actError = 'The federation database is not configured on this deployment, so there is nothing to change.';
  } else if (!canAnywhere(principal, 'engagement:write')) {
    // The controls are not rendered without this, and the check is repeated
    // here because rendered markup is not an authorisation system.
    Astro.response.status = 403;
    actError = 'Changing a lead requires engagement:write, which this account does not hold in any scope.';
  } else if (!Number.isInteger(target) || target <= 0 || target > 2147483647) {
    Astro.response.status = 400;
    actError = 'Name the lead to act on.';
  } else {
    const ctx: AuditContext = {
      principal,
      ip: clientIp(Astro.request),
      authority: identity!.shared ? `shared:${identity!.via}` : 'user',
      reason: get('reason') || null,
    };
    try {
      if (act === 'move') {
        await setLeadStatus(db(), ctx, {
          leadId: target,
          status: get('status'),
          reason: get('reason'),
        });
        return Astro.redirect(backTo('moved'), 303);
      } else if (act === 'assign') {
        // An empty select is "nobody", which is a legitimate destination — a
        // lead whose owner has left must be returnable to the unassigned pool
        // rather than stuck with them.
        const raw = get('ownerUserId');
        const ownerUserId = raw === '' ? null : Number(raw);
        if (ownerUserId !== null && (!Number.isInteger(ownerUserId) || ownerUserId <= 0)) {
          Astro.response.status = 400;
          actError = 'That is not an account this federation holds.';
        } else {
          await assignLeadOwner(db(), ctx, { leadId: target, ownerUserId, reason: get('reason') || undefined });
          return Astro.redirect(backTo(ownerUserId === null ? 'unassigned' : 'assigned'), 303);
        }
      } else if (act === 'note') {
        await addLeadActivity(db(), ctx, {
          leadId: target,
          kind: get('kind') || 'note',
          summary: get('summary'),
        });
        return Astro.redirect(backTo('noted'), 303);
      } else {
        Astro.response.status = 400;
        actError = 'That is not something this page does.';
      }
    } catch (err: any) {
      if (err instanceof ForbiddenError) {
        Astro.response.status = 403;
        actError = 'This lead is outside the scope your credential covers, so it was not changed.';
      } else if (isEngagementError(err)) {
        // The module's refusals are sentences written for this reader — the
        // illegal transition, the terminal status, the disabled account. They
        // are shown as they are rather than flattened into "invalid".
        Astro.response.status = 400;
        actError = err.message;
      } else {
        console.error('[admin/leads] act failed', err);
        Astro.response.status = 500;
        actError = 'Nothing was changed.';
      }
    }
  }
}

const done = Astro.url.searchParams.get('done');
const doneMessage = done && DONE_MESSAGES[done] ? DONE_MESSAGES[done] : null;

const BOARD_LIMIT = 500;   // leadPipeline() caps here anyway

interface Attribution { source: string; total: number; won: number; wonOf: string }

let board: any[] = [];
let boardTruncated = false;
let scope: 'all' | 'scoped' | 'none' = 'none';
let attribution: Attribution[] = [];
let attributionExact = true;
let detail: any = null;
let detailProblem: string | null = null;
let ownerLabel: string | null = null;
let detailFailure: string | null = null;

// THREE ABSENCES, NOT ONE (CONTENT-ARCHITECTURE §5.4). "There is no database on
// this deployment", "the read failed" and "there are no leads" are different
// facts and are told in different words by different components. They used to
// share one `unavailable` string, which meant an unconfigured deployment —
// the state production is actually in — was reported as a fault.
let notConfigured = false;
let readError: string | null = null;

// Three states, not two. "Could not tell" is a real answer here: the pipeline
// does not depend on the fee framework, so a failure to read it must not take
// the page down — and it must not be reported as "none is published" either.
let framework: 'published' | 'none' | 'unknown' = 'unknown';

if (principal && canAnywhere(principal, 'engagement:read')) {
  if (!isConfigured()) {
    notConfigured = true;
  } else {
    try {
      // ONE read, scoped in SQL. The stage counts, the attribution and the rows
      // in the table are all taken from it, so the three cannot disagree.
      // Filtering by stage or audience is then done by the table over the same
      // rows rather than by a second query with its own window.
      const all = await leadPipeline(db(), principal, { limit: BOARD_LIMIT });
      board = all.rows;
      boardTruncated = all.truncated;
      scope = all.scope;

      // ── Attribution, and why there are two paths to it ──────────────────
      // sourceAttribution() aggregates every lead in the table with no scope
      // predicate. That is right for a national account and wrong for a state
      // one: it would tell one state how many enquiries another received.
      // A scoped account therefore has its figures counted from rows the SQL
      // scope predicate has already returned — and the price of that honesty
      // is that they stop at BOARD_LIMIT, which is declared to the reader
      // rather than hidden.
      const scopes = visibleScopes(principal, 'engagement:read');
      if (scopes.kind === 'all') {
        attribution = await sourceAttribution(db(), principal);
        attributionExact = true;
      } else {
        const by = new Map<string, { total: number; won: number }>();
        for (const r of board) {
          const key = String(r.firstSource ?? 'unknown');
          const entry = by.get(key) ?? { total: 0, won: 0 };
          entry.total += 1;
          if (r.status === 'won') entry.won += 1;
          by.set(key, entry);
        }
        attribution = [...by.entries()]
          .map(([source, v]) => ({ source, total: v.total, won: v.won, wonOf: `${v.won} of ${v.total}` }))
          .sort((a, b) => b.total - a.total);
        attributionExact = !boardTruncated;
      }

      if (leadId != null) {
        try {
          detail = await leadDetail(db(), principal, leadId);
          // The owner is stored as an account id and shown as a name. Resolved
          // here rather than joined inside leadDetail(), because the pipeline
          // list does not need it and the module should not carry a join for
          // one panel. Failure is not fatal: an unresolvable owner is reported
          // as the id it is, which is still more than the column alone says.
          if (detail?.lead?.ownerUserId != null) {
            try {
              const [o] = await db()
                .select({ email: s.users.email, name: s.persons.fullName })
                .from(s.users)
                .leftJoin(s.persons, eq(s.persons.id, s.users.personId))
                .where(eq(s.users.id, detail.lead.ownerUserId))
                .limit(1);
              ownerLabel = o?.name ?? o?.email ?? null;
            } catch {
              ownerLabel = null;
            }
          }
        } catch (err: any) {
          if (isEngagementError(err) || err instanceof ForbiddenError) {
            // ONE message for "no such lead" and for "outside your scope". They
            // are different failures and telling them apart would let anyone
            // with engagement:read count the federation's leads in states that
            // are not theirs by walking the identifiers.
            //
            // This is a BOUNDARY, so it is prose and not an ErrorState: nothing
            // failed, and dressing a refusal as a fault sends the reader to
            // report a bug that does not exist.
            detailProblem = 'No lead with that identifier is visible to this account.';
          } else {
            // Anything else is the read failing, which is not a judgement about
            // the lead. Reporting it as "not visible to this account" would be a
            // claim about authorisation that nothing here established.
            detailFailure = String(err?.message ?? err);
          }
        }
      }
    } catch (err: any) {
      readError = String(err?.message ?? err);
    }

    // Separate from the pipeline read, and deliberately after it: the page is
    // about leads, and a fee framework that cannot be read is a footnote rather
    // than a reason to show nothing. Skipped once the pipeline itself has
    // failed, since the sentence it feeds is not rendered on that branch.
    if (!readError) {
      try {
        framework = (await activeFramework(db(), new Date().toISOString().slice(0, 10)))
          ? 'published'
          : 'none';
      } catch {
        framework = 'unknown';
      }
    }
  }
}

const label = (v: unknown) => String(v ?? '').replace(/_/g, ' ');
const countIn = (s: string) => board.filter((r) => r.status === s).length;

const asDate = (v: unknown) => {
  if (!v) return null;
  const d = new Date(v as string);
  return Number.isNaN(d.getTime()) ? null : d;
};
const fmt = (v: unknown) => {
  const d = asDate(v);
  return d ? d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
};
const fmtAt = (v: unknown) => {
  const d = asDate(v);
  return d
    ? d.toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '—';
};

/** Filters are preserved across every link, so opening a lead does not lose the view. */
const listHref = (over: { status?: string; audience?: string; lead?: number }) => {
  const q = new URLSearchParams();
  const st = over.status !== undefined ? over.status : status;
  const au = over.audience !== undefined ? over.audience : audience;
  if (st) q.set('status', st);
  if (au) q.set('audience', au);
  if (over.lead) q.set('lead', String(over.lead));
  const qs = q.toString();
  return `${h('/admin/leads')}${qs ? `?${qs}` : ''}${over.lead ? '#lead' : ''}`;
};

// Channels the enum knows about that have introduced nobody. Worth naming: a
// channel with no leads is a finding about the federation's outreach, and it is
// invisible if the table only lists the channels that did produce something.
//
// It is only SAID when the counts behind it are complete. A channel missing
// from the 500 most recently changed leads has not been shown to have
// introduced nobody — it has been shown to be absent from a sample — and
// printing "no lead has arrived through youtube" on that basis would be a
// finding this page invented. Hence the attributionExact guard at the call
// site, and the scoped wording below.
const heard = new Set(attribution.map((a) => a.source));
const silent = LEAD_SOURCES.filter((s) => !heard.has(s));
const silentLead = scope === 'scoped'
  ? 'No lead in this account’s own states and districts has arrived through'
  : 'No lead has arrived through';

/** utm is open JSON; only string-able, non-empty entries are shown. */
const utmEntries = (v: unknown): [string, string][] =>
  v && typeof v === 'object' && !Array.isArray(v)
    ? Object.entries(v as Record<string, unknown>)
        .filter(([, x]) => x !== null && x !== undefined && x !== '')
        .map(([k, x]) => [k, String(x)] as [string, string])
    : [];

// ─── The table ──────────────────────────────────────────────────────────────
//
// The contact's email address and telephone number are deliberately NOT
// columns. They are on the detail panel instead, because a list gets
// photographed on a phone and forwarded, and a register of contact details is a
// different disclosure from a register of enquiries.
const leadColumns: Column[] = [
  {
    key: 'ref', header: 'Reference', primary: true, sortable: true,
    href: (r: any) => listHref({ lead: r.id }),
  },
  {
    key: 'contactName', header: 'Contact', primary: true, sortable: true,
    // "not given" rather than an em dash. A blank in this column means the
    // enquiry arrived without a name, which is a fact about the enquiry.
    render: (r: any) => r.contactName ?? 'not given',
  },
  { key: 'audience', header: 'Audience', render: (r: any) => label(r.audience) },
  // The city as it was typed. leadPipeline returns unit IDs, not unit names,
  // and "state 7" tells an administrator nothing — so the id is not printed as
  // if it were a place.
  { key: 'city', header: 'City', render: (r: any) => r.city ?? 'not given' },
  { key: 'status', header: 'Status', status: { domain: 'lead' } },
  { key: 'firstSource', header: 'Introduced by', render: (r: any) => label(r.firstSource) },
  { key: 'lastSource', header: 'Last touch', render: (r: any) => label(r.lastSource) },
  {
    key: 'updatedAt', header: 'Last change', sortable: true, initialDir: 'desc',
    render: (r: any) => fmt(r.updatedAt),
  },
];

const leadFilters: Filter[] = [
  {
    key: 'status', label: 'Stage', type: 'select', anyLabel: 'Every stage',
    options: PIPELINE.map((s) => ({ value: s, label: label(s) })),
  },
  {
    key: 'audience', label: 'Audience', type: 'select', anyLabel: 'All audiences',
    options: AUDIENCES.map((a) => ({ value: a, label: label(a) })),
  },
];

// The table reads its own sort, page and page-size out of the URL, and then the
// FILTER values are replaced with the ones validated against the enum above.
// Left alone, `?status=nonsense` would match no row and empty the table under a
// header saying no filter had been applied — the same divergence between what a
// screen claims and what it shows that this page has been bitten by before.
const leadQuery: TableQuery = {
  ...readTableQuery(Astro.url, {
    sortable: ['ref', 'contactName', 'updatedAt'],
    filters: ['status', 'audience'],
    defaultSort: { key: 'updatedAt', dir: 'desc' },
  }),
  filters: {
    ...(status ? { status } : {}),
    ...(audience ? { audience } : {}),
  },
};

const attributionColumns: Column[] = [
  { key: 'source', header: 'Channel', primary: true, render: (r: any) => label(r.source) },
  { key: 'total', header: 'Leads', numeric: true, sortable: true, initialDir: 'desc' },
  // The fraction, with its denominator. One of one and three hundred of three
  // hundred are both a hundred per cent and mean entirely different things.
  { key: 'wonOf', header: 'Won', align: 'end' },
];

const pipelineTabs = [
  ...PIPELINE.map((s) => ({
    label: label(s),
    href: listHref({ status: s }),
    count: countIn(s),
    current: status === s,
  })),
  {
    label: 'All stages',
    href: listHref({ status: '' }),
    count: board.length,
    current: !status,
  },
];
---

<AdminShell
  title="Leads"
  requires="engagement:read"
  intro="Every enquiry the federation has received, where it has reached, and which channel introduced it. A lead is an enquiry — it becomes a client institution or a member only when somebody identifies it as one."
>
  {notConfigured ? (
    <p class="note">
      The federation database is not reachable from this deployment, so no leads
      can be listed. Enquiries are still arriving wherever the site is served
      from a configured environment; this deployment simply cannot read them.
      Nothing has been lost and nothing is waiting here.
    </p>
  ) : readError ? (
    <ErrorState
      title="The lead pipeline could not be read."
      safe="Nothing has been changed. This was a read that failed, so no enquiry was altered, moved or lost — every lead is still where it was."
      detail={readError}
    />
  ) : scope === 'none' ? (
    <p class="note">
      This account holds <code>engagement:read</code>, but not over any state or
      district. A lead is located by the unit it belongs to, so a binding at
      institution or dojo scope matches none of them and this page shows
      nothing. That is the intended reading rather than a fault: an enquiry that
      has not been placed in a state could belong to any of them.
    </p>
  ) : (
    <>
      {/* AdminShell prints the h1, so this header prints an h2 — a page with
          two h1s gives a screen-reader user two competing titles. It does not
          stick, because it heads a section rather than the page and a sticky
          band here would cover the intro above it on the way back up. */}
      <PageHeader
        title="Pipeline"
        headingLevel="h2"
        sticky={false}
        description="Nothing reaches quoted on its own: a lead is quoted when somebody prepares and sends a quotation. Won, lost and disqualified are closed — a further enquiry from the same contact opens a new lead rather than reviving one of these."
        secondary={[
          {
            label: 'Applications',
            href: h('/admin/applications'),
          },
          {
            label: 'Fee framework',
            href: h('/admin/fees'),
          },
        ]}
        tabs={pipelineTabs}
      >
        <Fragment slot="meta">
          {/* Counted, not estimated. The number is the rows this page read. */}
          <span class="meta-chip">
            {board.length}{boardTruncated ? '+' : ''} in scope
          </span>
          {scope === 'scoped' && (
            <span class="meta-chip">this account’s own states and districts</span>
          )}
        </Fragment>
      </PageHeader>

      {/* The outcome of an act, told once, at the top, where a reader who has
          just pressed a button is looking. `actError` carries the module's own
          refusal sentence — an illegal transition, a terminal status, a disabled
          account — rather than a flattened "invalid", because the module is the
          only thing that knows which rule was broken. */}
      {actError && (
        <p class="act-msg act-msg-bad" role="alert">{actError}</p>
      )}
      {doneMessage && !actError && (
        <p class="act-msg act-msg-ok">{doneMessage}</p>
      )}

      <p class="legend">
        Counted over {boardTruncated ? `the ${BOARD_LIMIT} most recently changed leads in scope` : 'the leads in scope'},
        which is also the set the table below filters.
        {framework === 'none' && (
          <> No fee framework is published for today, so every quotation this
          pipeline reaches is prepared by hand.</>
        )}
        {framework === 'unknown' && (
          <> Whether a fee framework is published could not be read just now, so
          nothing is claimed here about how a quotation would be produced.</>
        )}
      </p>

      <Table
        id="leads"
        caption="Leads in scope"
        columns={leadColumns}
        filters={leadFilters}
        rows={board}
        query={leadQuery}
        note={boardTruncated
          ? `The ${BOARD_LIMIT} most recently changed leads in scope. Filtering and ordering happen over those, not over the whole register.`
          : null}
        emptyTitle="No lead has been recorded in this scope."
        emptyBody="A lead is recorded when somebody enquires — through an enquiry path on the site, or alongside an institutional application. An application does not always add a row here: an enquiry from a contact who already has an open lead is folded into that lead, and an application whose lead could not be written is filed against the application itself. Nothing on this page is seeded or sampled, so an empty pipeline is a fact about the enquiries the federation has received and not a fact about the database."
        emptyAction={{ label: 'Check applications', href: h('/admin/applications') }}
      />

      <section class="attr" aria-labelledby="attr-h">
        <h2 class="sec-h" id="attr-h">Where these enquiries came from</h2>
        <p class="sec-p">
          Counted on <strong>first touch</strong> — the channel that introduced
          somebody, not the one they happened to return through. That is the one
          worth deciding about.
        </p>

        {attribution.length === 0 ? (
          <p class="sec-p">
            Nothing to attribute yet: no lead has been recorded in this scope, so
            there is no evidence here about which channels work and none is
            estimated.
          </p>
        ) : (
          <>
            <Table
              id="attribution"
              caption="Leads by the channel that introduced them"
              columns={attributionColumns}
              rows={attribution}
              paramPrefix="a"
              defaultSort={{ key: 'total', dir: 'desc' }}
              pageSize={false}
              savedViews={false}
            />

            {silent.length > 0 && attributionExact && (
              <p class="sec-p">
                {silentLead} {silent.map(label).join(', ')}.
              </p>
            )}
            {!attributionExact && (
              <p class="sec-p">
                Counted from the {BOARD_LIMIT} most recently changed leads this
                account can see. There are more, so read these as a floor rather
                than a total.
              </p>
            )}
            {scope === 'scoped' && (
              <p class="sec-p">
                Counted over this account's own states and districts. The
                national figures are deliberately not shown here: one unit's
                enquiry volume is not another unit's to read.
              </p>
            )}
          </>
        )}
      </section>

      {leadId != null && (
        <section class="detail" id="lead" aria-labelledby="detail-h">
          {detailFailure ? (
            <>
              <h2 class="sec-h" id="detail-h">Lead not shown</h2>
              <ErrorState
                title="That lead could not be read."
                safe="Nothing has been changed. The lead itself is untouched — this was a read that failed."
                detail={detailFailure}
                secondary={{ label: 'Back to the pipeline', href: listHref({}) }}
              />
            </>
          ) : detailProblem || !detail ? (
            <>
              <h2 class="sec-h" id="detail-h">Lead not shown</h2>
              <p class="sec-p">{detailProblem ?? 'That lead could not be read.'}</p>
              <p><a class="btn btn-ghost" href={listHref({})}>Back to the pipeline</a></p>
            </>
          ) : (
            <>
              <h2 class="sec-h" id="detail-h"><code>{detail.lead.ref}</code></h2>
              <p class="d-top">
                <Status value={detail.lead.status} domain="lead" />
                <span class="muted">{label(detail.lead.audience)}</span>
              </p>

              <dl class="d-list">
                <div><dt>Contact</dt><dd>{detail.lead.contactName ?? 'not given'}</dd></div>
                <div><dt>Email</dt><dd>{detail.lead.contactEmail ?? 'not given'}</dd></div>
                <div><dt>Telephone</dt><dd>{detail.lead.contactPhone ?? 'not given'}</dd></div>
                <div><dt>City</dt><dd>{detail.lead.city ?? 'not given'}</dd></div>
                <div><dt>Introduced by</dt><dd>{label(detail.lead.firstSource)}</dd></div>
                <div><dt>Landed on</dt><dd>{detail.lead.firstLandingPath ?? 'not recorded'}</dd></div>
                <div><dt>Last touch</dt><dd>{label(detail.lead.lastSource)}</dd></div>
                <div><dt>First seen</dt><dd>{fmt(detail.lead.createdAt)}</dd></div>
                <div><dt>Last change</dt><dd>{fmt(detail.lead.updatedAt)}</dd></div>
                {detail.lead.lostReason && (
                  <div><dt>Reason</dt><dd>{detail.lead.lostReason}</dd></div>
                )}
              </dl>

              {utmEntries(detail.lead.utm).length > 0 && (
                <>
                  <h3 class="sec-h3">Campaign parameters, as they arrived</h3>
                  <dl class="d-list">
                    {utmEntries(detail.lead.utm).map(([k, v]) => (
                      <div><dt>{k}</dt><dd>{v}</dd></div>
                    ))}
                  </dl>
                </>
              )}

              {/* The identification state, said plainly, because it is the
                  difference between a prospect and a record the federation
                  stands behind. */}
              {detail.lead.institutionId || detail.lead.personId ? (
                <p class="sec-p">
                  Identified against
                  {detail.lead.institutionId && <> an institution record (#{detail.lead.institutionId})</>}
                  {detail.lead.institutionId && detail.lead.personId && <> and</>}
                  {detail.lead.personId && <> a person record (#{detail.lead.personId})</>}.
                </p>
              ) : (
                <p class="sec-p">
                  Not identified against a canonical record. Until somebody
                  identifies it, this is an enquiry: it is not a client
                  institution and it is not on the member register.
                </p>
              )}

              <h3 class="sec-h3">Training requests</h3>
              <p class="sec-p">
                What this lead has actually asked the federation to deliver. An
                institutional application arrives as one of these; a lead may
                have none, and an enquiry with none is still a lead.
              </p>
              {detail.requests.length === 0 ? (
                <p class="sec-p muted">No training request has been recorded against this lead.</p>
              ) : (
                <ul class="reqs">
                  {detail.requests.map((q: any) => (
                    <li>
                      <p class="r-top"><code>{q.ref}</code> <Status value={q.status} size="sm" /></p>
                      <p class="r-meta">
                        {label(q.audience)}
                        {q.mode ? <> · {label(q.mode)}</> : <> · <span class="muted">delivery mode not stated</span></>}
                        {q.preferredStartOn
                          ? <> · preferred start {fmt(q.preferredStartOn)}</>
                          : <> · <span class="muted">no preferred start given</span></>}
                        {' · '}submitted {fmt(q.createdAt)}
                      </p>
                    </li>
                  ))}
                </ul>
              )}

              <h3 class="sec-h3">Activity</h3>
              {detail.activities.length === 0 ? (
                <p class="sec-p muted">Nothing has been recorded against this lead.</p>
              ) : (
                <ol class="acts">
                  {detail.activities.map((a: any) => (
                    <li>
                      <p class="a-s">{a.summary}</p>
                      <p class="a-m">{label(a.kind)} · {fmtAt(a.at)}</p>
                    </li>
                  ))}
                </ol>
              )}

              {/* ── The acts ────────────────────────────────────────────────
                  Rendered only for a caller who holds engagement:write
                  somewhere. Whether it covers THIS lead is decided by the
                  module against the lead's own placement when the form is
                  posted, so a reader who can see a lead outside their write
                  scope is offered the controls and refused by name — which is
                  the honest order, because the alternative is a page that
                  silently drops controls with no explanation. */}
              <h3 class="sec-h3">Act on this lead</h3>

              {!mayWrite ? (
                <p class="sec-p muted">
                  Changing a lead needs <code>engagement:write</code>, which this
                  account does not hold. This page is read-only for you — the
                  controls are absent rather than disabled, because a button that
                  refuses is a button somebody presses twice.
                </p>
              ) : (
                <div class="acts-panel">
                  {TERMINAL_LEAD_STATUSES.includes(detail.lead.status) ? (
                    <p class="sec-p muted">
                      This lead is <strong>{label(detail.lead.status)}</strong>, which is
                      final. It cannot be moved back into the pipeline: reopening
                      it would lose the fact that it closed, and the first-touch
                      attribution with it. A returning enquiry is recorded as a
                      new lead.
                    </p>
                  ) : (
                    <form method="POST" class="act-form">
                      <input type="hidden" name="act" value="move" />
                      <input type="hidden" name="leadId" value={String(detail.lead.id)} />
                      <p class="act-t">Move it along</p>
                      <label class="input-label" for="mv-status">To</label>
                      <select class="input" id="mv-status" name="status" required>
                        {(LEAD_TRANSITIONS[detail.lead.status] ?? []).map((next: string) => (
                          <option value={next}>{label(next)}</option>
                        ))}
                      </select>
                      <label class="input-label" for="mv-reason">Reason</label>
                      <input class="input" id="mv-reason" name="reason" required maxlength="500" />
                      <p class="act-hint">
                        Required for every move, not only the unhappy ones. It is
                        written to the activity trail and to the audit, and for a
                        loss it becomes the lead's recorded reason.
                      </p>
                      <button type="submit" class="btn btn-primary">Move</button>
                    </form>
                  )}

                  <form method="POST" class="act-form">
                    <input type="hidden" name="act" value="assign" />
                    <input type="hidden" name="leadId" value={String(detail.lead.id)} />
                    <p class="act-t">Owner</p>
                    <p class="act-now">
                      {detail.lead.ownerUserId == null
                        ? <span class="muted">Nobody owns this lead.</span>
                        : <>Currently {ownerLabel ?? <>account #{detail.lead.ownerUserId}</>}</>}
                    </p>
                    <label class="input-label" for="as-user">Assign to account id</label>
                    <input class="input" id="as-user" name="ownerUserId" inputmode="numeric" pattern="[0-9]*" />
                    <p class="act-hint">
                      An account id, not a name picked from a list. There is no
                      dropdown deliberately: enumerating every account that could
                      own a lead would hand the federation's staff list to anyone
                      holding <code>engagement:write</code> in one district. A
                      wrong id is refused by name, not by a database error.
                      Leave it empty and press Assign to return the lead to the
                      unassigned pool.
                    </p>
                    <button type="submit" class="btn btn-ghost">Assign</button>
                  </form>

                  <form method="POST" class="act-form">
                    <input type="hidden" name="act" value="note" />
                    <input type="hidden" name="leadId" value={String(detail.lead.id)} />
                    <p class="act-t">Record a contact</p>
                    <label class="input-label" for="nt-kind">Kind</label>
                    <select class="input" id="nt-kind" name="kind">
                      {LEAD_ACTIVITY_KINDS.map((k: string) => (
                        <option value={k}>{label(k)}</option>
                      ))}
                    </select>
                    <label class="input-label" for="nt-summary">What happened</label>
                    <textarea class="input" id="nt-summary" name="summary" rows="3" required maxlength="2000"></textarea>
                    <p class="act-hint">
                      Goes to the activity trail above, not to the audit — a note
                      is correspondence, and burying the acts that matter under
                      it would make the audit unreadable. A status change cannot
                      be written here: those rows are written only by the act
                      that changes the status, so the trail cannot claim a
                      transition the lead's own column disagrees with.
                    </p>
                    <button type="submit" class="btn btn-ghost">Record</button>
                  </form>
                </div>
              )}

              <p><a class="btn btn-ghost" href={listHref({})}>Back to the pipeline</a></p>
            </>
          )}
        </section>
      )}
    </>
  )}
</AdminShell>

<style>
  /* The acts panel — added with the write path. Three forms in one column on a
     phone and side by side once there is room, because a lead is worked on from
     a phone as often as from a desk. */
  .act-msg { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; font-size: 0.95rem; }
  .act-msg-ok { background: var(--ok-bg, #e8f5ed); color: var(--ok-fg, #14532d); }
  .act-msg-bad { background: var(--bad-bg, #fdeaea); color: var(--bad-fg, #7f1d1d); }
  .acts-panel { display: grid; gap: 14px; margin: 10px 0 18px; }
  @media (min-width: 900px) { .acts-panel { grid-template-columns: repeat(3, 1fr); align-items: start; } }
  .act-form { border: 1px solid var(--line, #e3e3e3); border-radius: 10px; padding: 12px; }
  .act-t { margin: 0 0 8px; font-weight: 600; }
  .act-now { margin: 0 0 8px; font-size: 0.92rem; }
  .act-hint { margin: 8px 0 10px; font-size: 0.85rem; color: var(--muted-fg, #666); }
  .act-form .input { width: 100%; }
  .act-form textarea.input { resize: vertical; }

  .note {
    padding: 20px 22px; border-left: 3px solid var(--gold);
    background: var(--card); color: var(--muted); line-height: 1.7; max-width: 66ch;
  }
  .note code { font-family: var(--font-accent, monospace); }

  /* The meta chips carry counts this page actually took. They are not statuses
     and are deliberately not drawn as one — a chip that looks like a Status
     chip and is not would teach the reader to misread both. */
  .meta-chip {
    font-size: var(--text-xs);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    line-height: 1.5;
  }

  .legend { color: var(--muted); font-size: .87rem; line-height: 1.7; max-width: 66ch; margin: 18px 0 22px; }

  .muted { color: var(--muted); }
  code { font-family: var(--font-accent, monospace); font-size: .9em; }

  .attr, .detail { margin-top: 34px; border-top: 1px solid var(--border); padding-top: 24px; }
  .sec-h { font-family: var(--font-display); font-size: 1.05rem; margin: 0 0 10px; }
  .sec-h3 { font-family: var(--font-display); font-size: .95rem; margin: 24px 0 8px; }
  .sec-p { color: var(--muted); font-size: .88rem; line-height: 1.7; max-width: 66ch; margin: 0 0 14px; }

  .d-top { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; text-transform: capitalize; }
  .d-list { margin: 0 0 8px; display: grid; gap: 5px; max-width: 52rem; }
  .d-list > div { display: grid; grid-template-columns: 15ch minmax(0, 1fr); gap: 14px; font-size: .88rem; }
  .d-list dt { color: var(--muted); }
  .d-list dd { margin: 0; overflow-wrap: anywhere; }

  .reqs, .acts { list-style: none; margin: 0; padding: 0; }
  .reqs li, .acts li { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .r-top { display: flex; align-items: center; gap: 10px; margin: 0 0 4px; }
  .r-meta, .a-m { margin: 4px 0 0; font-size: .8rem; color: var(--muted); text-transform: capitalize; }
  .a-s { margin: 0; font-size: .9rem; line-height: 1.6; }

  .btn { margin-top: 18px; }

  @media (max-width: 900px) {
    .d-list > div { grid-template-columns: 1fr; gap: 0; }
    .d-list dt { font-size: .78rem; }
  }
</style>
