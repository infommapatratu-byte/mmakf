  /* ── The headline ────────────────────────────────────────────────────────
     Weighted like a statement of fact, NOT like an error. No red, no warning
     triangle: the federation not having published its fees is a decision it has
     not yet taken, and dressing it as a fault sends somebody hunting for a bug
     that does not exist. */
  .headline {
    border: 1px solid var(--border); border-left: 3px solid var(--gold);
