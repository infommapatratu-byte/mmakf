  }
  .claim strong { color: var(--white); }
  .claim-loud { border-left-color: var(--gold); background: var(--card); }

  /* ── The chain ───────────────────────────────────────────────────────────
     A list of stages REACHED, drawn as a ladder rather than a funnel. A funnel
     implies each stage drains into the next and that the numbers must decline;
     these are seven independent predicates over one set of rows, and a
     re-quoted application legitimately sits in two of them. */
  .chain { list-style: none; margin: 0; padding: 0; max-width: 780px; }
  .chain-step {
