  .chain-label { margin: 0; font-size: .98rem; }
  .chain-label a { color: inherit; }
  .chain-ev { margin: 4px 0 0; font-size: .78rem; color: var(--muted); line-height: 1.6; }

  /* ── A queue is a list of decisions, not a table of values ─────────────── */
  .queue { list-style: none; margin: 0; padding: 0; max-width: 900px; }
