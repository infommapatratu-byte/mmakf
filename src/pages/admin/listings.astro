---
// /admin/listings — the two gates that stand between a seller and the public.
//
// GATE ONE is the seller: an account that has applied to sell cannot list
// anything until MMAKF approves the SELLER.
// GATE TWO is the item: an approved seller still cannot put an item in front of
// the public until MMAKF approves THAT ITEM.
//
// They are separate on purpose, and both are visible on this page, because the
// federation asked for exactly that: "if onboarded they can list their items
// after approval by our people in admin."
//
// WHAT A REVIEWER IS ACTUALLY APPROVING, and why the page says so out loud:
// approval is recorded as a HASH of the content in front of them — title,
// description, category, price and photographs. If the seller edits any of it,
// the stored hash stops matching, the item leaves the public shop in the same
// instant, and it comes back to this queue. That is the rule that gets
// forgotten, and it is the whole point of listing approval: otherwise a plain
// karate-gi is approved on Monday and edited into something MMAKF never saw on
// Tuesday, under Monday's approval.
//
// THIS PAGE DECIDES NOTHING ITSELF. Every control calls a function in
// src/db/marketplace.ts, which re-checks authority against the SELLER's scope,
// refuses a reviewer deciding their own shop or their own item, refuses a
// reasonless decision, and claims each decision with a conditional UPDATE so two
// reviewers pressing the button together produce one decision and one loser who
// is told so. The POST handler below re-identifies the caller from the cookie
// and re-checks before calling any of it: a control this page chose not to draw
// is a convenience, never the control.
//
// NOTHING HERE DELETES ANYTHING. Suspending a seller withdraws every one of
// their listings from public view immediately — one status change, applied in
// SQL through the shared public predicate, to an unbounded number of items —
// and reinstating brings back exactly what was approved. A suspension is
// reversible; a deletion is not, and the federation may need the record.

import Base from '@/layouts/Base.astro';
import { identify, clientIp } from '@/lib/session';
import { isConfigured, db, schema as s } from '@/db';
import { rateLimit, tooManyRequests } from '@/lib/ratelimit';
import { canAnywhere, ForbiddenError, visibleScopes } from '@/lib/rbac';
import type { AuditContext } from '@/db/federation';
import { formatINR } from '@/db/fees';
import { asc, eq, inArray } from 'drizzle-orm';
import {
  listingQueue,
  reviewListing,
  delistListing,
  sellerQueue,
  approveSeller,
  rejectSeller,
  suspendSeller,
  reinstateSeller,
  mySellerAccount,
  isMarketplaceError,
  COMMISSION_NOT_SET,
  SELLER_REQUIREMENTS_NOT_SET,
  LISTING_REVIEW_TURNAROUND_NOT_SET,
  LISTING_CATEGORIES,
} from '@/db/marketplace';

export const prerender = false;

const configured = isConfigured();
const identity = await identify(Astro.request.headers.get('cookie'));

function json(body: unknown, status: number) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
  });
}

/** MarketplaceError code → HTTP status. A refusal of authority is 403, a state clash 409. */
function statusFor(code: string): number {
  switch (code) {
    case 'unknown_seller':
    case 'unknown_listing': return 404;
    case 'forbidden':
    case 'self_review':
    case 'not_signed_in': return 403;
    case 'bad_transition':
    case 'already_decided': return 409;
    default: return 400;
  }
}

/**
 * The actions this screen may take, and the module each one delegates to.
 *
 * Written as a table rather than an if-chain so that "what can this page do?"
 * is answerable by reading nine lines, and so that an action not in the table
 * is refused rather than falling into an "other" branch. There is no create,
 * no edit and no delete here: the reviewable content belongs to the seller and
 * has exactly one write path, in updateListing().
 */
const ACTIONS = {
  listing_approve: (dbi: any, ctx: AuditContext, id: number, reason: string) =>
    reviewListing(dbi, ctx, id, { decision: 'approve', reason }),
  listing_reject: (dbi: any, ctx: AuditContext, id: number, reason: string) =>
    reviewListing(dbi, ctx, id, { decision: 'reject', reason }),
  listing_delist: (dbi: any, ctx: AuditContext, id: number, reason: string) =>
    delistListing(dbi, ctx, id, reason),
  seller_approve: (dbi: any, ctx: AuditContext, id: number, reason: string) => approveSeller(dbi, ctx, id, reason),
  seller_reject: (dbi: any, ctx: AuditContext, id: number, reason: string) => rejectSeller(dbi, ctx, id, reason),
  seller_suspend: (dbi: any, ctx: AuditContext, id: number, reason: string) => suspendSeller(dbi, ctx, id, reason),
  seller_reinstate: (dbi: any, ctx: AuditContext, id: number, reason: string) => reinstateSeller(dbi, ctx, id, reason),
} as const;

type ActionName = keyof typeof ACTIONS;

// ─── The action ─────────────────────────────────────────────────────────────
//
// CSRF is already handled: src/middleware.ts refuses any mutating request that
// is not same-origin before this line runs.

if (Astro.request.method === 'POST') {
  const rl = await rateLimit(Astro.request, 'marketplace-decide', 60, 60);
  if (!rl.ok) return tooManyRequests(rl.retryAfterSeconds);

  if (!identity) {
    return json({ error: 'Your session has ended. Sign in again — nothing was changed.' }, 401);
  }
  if (!configured) {
    return json({
      error: 'The federation database is not configured on this deployment. There is no marketplace register to decide against.',
      code: 'unavailable',
    }, 503);
  }

  // RE-CHECKED SERVER-SIDE ON EVERY ACTION, against the session rather than
  // against what the page drew. This is the coarse gate; the module then checks
  // the precise one — marketplace:review or marketplace:suspend IN THE SELLER'S
  // OWN SCOPE — which is the check that actually contains a state office.
  if (!canAnywhere(identity.principal, 'marketplace:read')) {
    return json({
      error: 'Reviewing the marketplace requires marketplace:read. Your credential does not hold it, in any scope.',
      code: 'forbidden',
    }, 403);
  }

  let body: Record<string, unknown>;
  try {
    const raw = await Astro.request.text();
    if (raw.length > 8192) return json({ error: 'Request too large.' }, 413);
    body = JSON.parse(raw);
  } catch {
    return json({ error: 'Invalid request.' }, 400);
  }
  if (!body || typeof body !== 'object' || Array.isArray(body)) {
    return json({ error: 'Invalid request.' }, 400);
  }

  const action = String(body.action ?? '') as ActionName;
  if (!Object.prototype.hasOwnProperty.call(ACTIONS, action)) {
    return json({ error: 'Unknown marketplace action.' }, 404);
  }

  // An id of a listing or a seller — never an id of WHOSE record to read. What
  // may be done to it is decided from the row the server loads, against the
  // session the server resolved.
  const id = Number(body.id);
  if (!Number.isInteger(id) || id <= 0) return json({ error: 'Give the record to decide.' }, 400);

  const reason = typeof body.reason === 'string' ? body.reason.trim().slice(0, 2000) : '';
  if (!reason) {
    return json({
      error: 'Every decision here requires a recorded reason — approval, refusal, suspension and delisting alike. Without one the register cannot answer "why?" a year later.',
      code: 'reason_required',
    }, 400);
  }

  const ctx: AuditContext = {
    principal: identity.principal,
    ip: clientIp(Astro.request),
    reason,
    authority: identity.shared ? `shared:${identity.via}` : 'user',
  };

  try {
    const result = await ACTIONS[action](db(), ctx, id, reason);
    return json({ ok: true, result }, 200);
  } catch (err: any) {
    if (err instanceof ForbiddenError) {
      return json({
        error: 'Your credential does not hold the authority this decision requires, in this seller’s scope.',
        code: 'forbidden',
      }, 403);
    }
    if (isMarketplaceError(err)) {
      return json({ error: err.message, code: err.code }, statusFor(err.code));
    }
    console.error('[admin/listings] decision failed', action, err);
    return json({ error: 'The decision was not recorded. Nothing was changed.' }, 500);
  }
}

// ─── The read ───────────────────────────────────────────────────────────────

type Row = Record<string, any>;

const mayRead = Boolean(identity) && canAnywhere(identity!.principal, 'marketplace:read');
const mayReview = Boolean(identity) && canAnywhere(identity!.principal, 'marketplace:review');
const maySuspend = Boolean(identity) && canAnywhere(identity!.principal, 'marketplace:suspend');

let pending: Row[] = [];
let pendingTruncated = false;
let approvedListings: Row[] = [];
let sellersApplied: Row[] = [];
let sellersApproved: Row[] = [];
let sellersSuspended: Row[] = [];
let media = new Map<number, Array<{ url: string; alt: string | null; sortOrder: number }>>();
let ownListingsWithheld = 0;
let ownSellerWithheld = false;
let readError: string | null = null;

if (identity && configured && mayRead) {
  try {
    // The caller's OWN seller record, resolved from the session with no id — the
    // only way to know which rows are theirs without ever accepting "whose?"
    // from the request. Rule 2's counterpart on this page: nobody decides their
    // own shop or their own item, so those rows are withheld and counted.
    const mine = await mySellerAccount(db(), identity.principal);
    const myselfSellerId: number | null = mine?.id ?? null;

    const q = await listingQueue(db(), identity.principal, { limit: 100 });
    pendingTruncated = q.truncated;
    ownListingsWithheld = q.rows.filter((r: Row) => myselfSellerId != null && r.sellerId === myselfSellerId).length;
    pending = q.rows.filter((r: Row) => !(myselfSellerId != null && r.sellerId === myselfSellerId));

    const approved = await listingQueue(db(), identity.principal, { statuses: ['approved'], limit: 50 });
    approvedListings = approved.rows.filter((r: Row) => !(myselfSellerId != null && r.sellerId === myselfSellerId));

    const withhold = (rows: Row[]) => {
      const kept = rows.filter((r: Row) => !(myselfSellerId != null && r.id === myselfSellerId));
      if (kept.length !== rows.length) ownSellerWithheld = true;
      return kept;
    };

    sellersApplied = withhold((await sellerQueue(db(), identity.principal, { statuses: ['applied'], limit: 50 })).rows);
    sellersApproved = withhold((await sellerQueue(db(), identity.principal, { statuses: ['approved'], limit: 50 })).rows);
    sellersSuspended = withhold((await sellerQueue(db(), identity.principal, { statuses: ['suspended'], limit: 50 })).rows);

    // Media for exactly the listings the SCOPED query already returned. The ids
    // come from that query and never from the request, so this read cannot be
    // steered at a listing outside the reader's scope.
    const ids = [...pending, ...approvedListings].map((r) => r.id as number);
    if (ids.length) {
      const rows = await db()
        .select({
          listingId: s.listingMedia.listingId,
          url: s.listingMedia.url,
          alt: s.listingMedia.alt,
          sortOrder: s.listingMedia.sortOrder,
        })
        .from(s.listingMedia)
        .where(inArray(s.listingMedia.listingId, ids))
        .orderBy(asc(s.listingMedia.sortOrder), asc(s.listingMedia.id));
      for (const m of rows as any[]) {
        const list = media.get(m.listingId) ?? [];
        list.push({ url: m.url, alt: m.alt ?? null, sortOrder: m.sortOrder });
        media.set(m.listingId, list);
      }
    }
  } catch (err: any) {
    readError = isMarketplaceError(err)
      ? err.message
      : 'The marketplace queues could not be read. The fault has been logged for the federation office; nothing has been changed.';
    if (!isMarketplaceError(err)) console.error('[admin/listings] queue read failed', err);
  }
}

const scopes = identity ? visibleScopes(identity.principal, 'marketplace:read') : { kind: 'none' as const };
const scopeReach =
  scopes.kind === 'all'
    ? 'Your binding is national, so every seller and every listing in the country is in scope for you.'
    : scopes.kind === 'none'
      ? 'You hold marketplace:read in no scope at all, so no seller and no listing is in scope for you.'
      : `Your reach is limited in SQL to ${[
          scopes.states.length ? `state unit${scopes.states.length > 1 ? 's' : ''} ${scopes.states.join(', ')}` : '',
          scopes.districts.length ? `district unit${scopes.districts.length > 1 ? 's' : ''} ${scopes.districts.join(', ')}` : '',
          scopes.dojos.length ? `dojo${scopes.dojos.length > 1 ? 's' : ''} ${scopes.dojos.join(', ')}` : '',
        ].filter(Boolean).join('; ')}. A seller placed in no unit at all is reachable only from a national binding — the fail-closed reading — so those are withheld from you too.`;

const signedInAs = identity
  ? identity.shared
    ? `${identity.principal.label} — shared credential (${identity.via}), not attributable to a person`
    : `${identity.principal.label} — personal account #${identity.userId}`
  : '';

const fmt = (v: unknown): string => {
  if (v == null || v === '') return '—';
  const d = v instanceof Date ? v : new Date(String(v));
  return Number.isNaN(d.getTime())
    ? String(v)
    : d.toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};

function placement(row: Row): string {
  const bits: string[] = [];
  if (row.stateUnitId != null) bits.push(`state unit #${row.stateUnitId}`);
  if (row.districtUnitId != null) bits.push(`district unit #${row.districtUnitId}`);
  if (row.dojoId != null) bits.push(`dojo #${row.dojoId}`);
  return bits.length ? bits.join(', ') : 'No unit recorded — reachable only from a national binding';
}
---

<Base title="MMAKF Admin — Marketplace review" showNav={false} showFooter={false}>
  {!identity ? (
    <section class="signin-wrap">
      <div class="signin-box">
        <div class="signin-brand">
          <div class="signin-brand-1">MMAKF</div>
          <div class="signin-brand-2">Marketplace review</div>
        </div>
        <form id="loginForm" class="card signin-card">
          <h1 class="card-title signin-h">Sign in</h1>
          <label class="input-label" for="login-email">Email address</label>
          <input class="input" type="email" id="login-email" name="email" autocomplete="username"
                 autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="you@mmakf.in" />
          <label class="input-label" for="login-password" style="margin-top:14px">Password</label>
          <input class="input" type="password" id="login-password" name="password" autocomplete="current-password" required />
          <div id="loginErr" role="alert" class="signin-err" hidden></div>
          <button type="submit" class="btn btn-primary signin-btn">Sign in</button>
          <p class="signin-note">
            Approving what may be offered for sale under the federation's name is an editorial decision,
            and it is attributed to whoever took it.
          </p>
        </form>
      </div>
    </section>
  ) : (
    <div class="admin-wrap">
      <aside class="admin-side">
        <div class="admin-brand">
          <div class="admin-brand-1">MMAKF</div>
          <div class="admin-brand-2">Marketplace review</div>
        </div>
        <nav class="admin-nav" aria-label="Sections">
          <a href="#listings">Items waiting</a>
          <a href="#sellers">Seller applications</a>
          <a href="#standing">Seller standing</a>
          <a href="#onsale">On sale now</a>
          <a href="#withheld">What is not shown</a>
          <a href="#unset">What the federation has not set</a>
          <a href="/admin/onboarding" class="nav-sep">Onboarding queue →</a>
          <a href="/admin/approvals">Two-person control →</a>
          <a href="/admin">← Content admin</a>
        </nav>
        <div class="admin-foot">
          <button class="btn btn-ghost admin-foot-btn" id="logoutBtn">Logout</button>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-panel admin-panel-first">
          <h1 class="admin-h">Marketplace review</h1>
          <p class="admin-sub">
            Two gates, not one. A person approved as a seller still cannot put an item in front of the
            public until that item is approved — and an approved item leaves the shop the moment its
            seller edits it, because what was approved is recorded as a hash of the content, not as a
            flag on a row that can change underneath it.
          </p>
          <p class="a-signed">Signed in as {signedInAs}</p>

          {!configured && (
            <div class="a-warn" role="alert">
              <strong>The federation database is not configured on this deployment.</strong>
              Sellers and listings live in Postgres; there is nothing to read and nothing to decide
              against until <code>DATABASE_URL</code> is set.
            </div>
          )}

          {configured && !mayRead && (
            <div class="a-warn" role="alert">
              <strong>This account cannot review the marketplace.</strong>
              Reading these queues requires <code>marketplace:read</code>, and your bindings hold it in
              no scope. You are told this rather than shown an empty page, because an empty page looks
              like "nothing is waiting" and this is not that.
            </div>
          )}

          {configured && mayRead && !mayReview && (
            <div class="a-warn" role="alert">
              <strong>You may read these queues but not decide them.</strong>
              Approving or refusing a seller or an item requires <code>marketplace:review</code>. No
              decision control is drawn below, and the server would refuse one anyway.
            </div>
          )}

          {readError && (
            <div class="a-warn" role="alert"><strong>The queues could not be read.</strong> {readError}</div>
          )}
        </header>

        {configured && mayRead && (
          <>
          <!-- ─── Items waiting ──────────────────────────────────────── -->
          <section class="admin-panel" id="listings">
            <h2 class="admin-h2">Items waiting for review</h2>
            <p class="admin-sub">
              Submitted items, oldest first, with every photograph the seller attached. What you see
              here is exactly what the approval will cover: change any of it and the item comes back.
            </p>

            {pendingTruncated && (
              <div class="a-warn" role="alert">
                <strong>This list is INCOMPLETE.</strong> More submitted items match your scope than
                this page draws at once.
              </div>
            )}

            {pending.length === 0 ? (
              <p class="a-empty">No item is waiting for review inside your scope. {scopeReach}</p>
            ) : (
              <div class="a-items">
                {pending.map((row) => {
                  const shots = media.get(row.id) ?? [];
                  return (
                    <article class="a-item" id={`listing-${row.id}`}>
                      <header class="a-item-head">
                        <div>
                          <h3 class="a-item-title">{row.title}</h3>
                          <p class="a-mono">{row.ref} · revision {row.revision}</p>
                        </div>
                        <span class={`a-tag a-tag-${row.status}`}>{row.status}</span>
                      </header>

                      <dl class="a-dl">
                        <div><dt>Seller</dt><dd>{row.tradingName} <span class="a-mono">{row.sellerRef}</span> — {row.sellerStatus}</dd></div>
                        <div><dt>Category</dt><dd>{row.category}</dd></div>
                        <div><dt>Price</dt><dd>{formatINR(row.priceMinor)} <span class="a-mono">({row.priceMinor} paise, {row.currency})</span></dd></div>
                        <div><dt>Stock</dt><dd>{row.stockQty} — stock is not part of what you approve, so a seller selling three of these does not push the item back into this queue.</dd></div>
                        <div><dt>Submitted</dt><dd>{fmt(row.submittedAt)}</dd></div>
                        <div><dt>Description</dt><dd class="a-reason">{row.description ? row.description : 'The seller supplied no description.'}</dd></div>
                      </dl>

                      <div class="a-ev">
                        <h4 class="a-ev-h">Photographs ({shots.length})</h4>
                        {shots.length === 0 ? (
                          <p class="a-hint">
                            The seller attached no photographs. MMAKF has published no rule requiring
                            one, so this is a fact for you to weigh, not a defect the page will refuse
                            on your behalf.
                          </p>
                        ) : (
                          <div class="a-shots">
                            {shots.map((m, i) => (
                              <figure class="a-shot">
                                <img src={m.url} alt={m.alt ?? ''} loading="lazy" />
                                <figcaption>
                                  {m.alt
                                    ? m.alt
                                    : 'No alternative text was supplied for this photograph. An absent alt stays absent rather than being filled in with something invented.'}
                                  <span class="a-mono a-shot-url">{m.url}</span>
                                </figcaption>
                              </figure>
                            ))}
                          </div>
                        )}
                      </div>

                      {mayReview ? (
                        <div class="a-controls">
                          <form class="a-form" data-act="listing_approve" data-id={row.id}>
                            <p class="a-hint">
                              Approving records a hash of exactly the title, description, category, price
                              and photographs above. If the seller changes any of them, the item stops
                              matching, leaves the public shop immediately, and returns to this queue.
                            </p>
                            <label class="input-label" for={`l-approve-${row.id}`}>Reason for approving (required)</label>
                            <textarea class="input" id={`l-approve-${row.id}`} name="reason" rows="2" required></textarea>
                            <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                            <button type="submit" class="btn btn-primary a-submit">Approve this item</button>
                          </form>
                          <form class="a-form" data-act="listing_reject" data-id={row.id}>
                            <label class="input-label" for={`l-reject-${row.id}`}>Reason for refusing (required)</label>
                            <textarea class="input" id={`l-reject-${row.id}`} name="reason" rows="2" required></textarea>
                            <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                            <button type="submit" class="btn btn-ghost a-submit">Refuse this item</button>
                          </form>
                        </div>
                      ) : (
                        <p class="a-hint" role="note">
                          No decision control is offered — deciding an item requires
                          <code> marketplace:review</code> in this seller's scope.
                        </p>
                      )}
                    </article>
                  );
                })}
              </div>
            )}
          </section>

          <!-- ─── Seller applications ────────────────────────────────── -->
          <section class="admin-panel" id="sellers">
            <h2 class="admin-h2">Seller applications</h2>
            <p class="admin-sub">
              Gate one. Until a seller is approved they cannot create a listing at all — the refusal is
              in createListing(), not in a screen. Commercial details are captured and their absence is
              reported; nobody is refused for a requirement MMAKF has not stated.
            </p>

            {sellersApplied.length === 0 ? (
              <p class="a-empty">No seller application is waiting inside your scope.</p>
            ) : (
              <div class="a-items">
                {sellersApplied.map((row) => (
                  <article class="a-item" id={`seller-${row.id}`}>
                    <header class="a-item-head">
                      <div>
                        <h3 class="a-item-title">{row.tradingName}</h3>
                        <p class="a-mono">{row.ref} · account #{row.userId}</p>
                      </div>
                      <span class={`a-tag a-tag-${row.status}`}>{row.status}</span>
                    </header>

                    <dl class="a-dl">
                      <div><dt>Contact</dt><dd>{[row.contactEmail, row.contactPhone].filter(Boolean).join(' · ') || 'None recorded'}</dd></div>
                      <div><dt>Where</dt><dd>{[row.city, placement(row)].filter(Boolean).join(' — ')}</dd></div>
                      <div><dt>Applied</dt><dd>{fmt(row.appliedAt)}</dd></div>
                      <div><dt>GSTIN</dt><dd>{row.gstin || 'Not supplied'}</dd></div>
                      <div><dt>PAN</dt><dd>{row.pan || 'Not supplied'}</dd></div>
                      <div><dt>Bank</dt><dd>{row.bankAccountName ? `${row.bankAccountName}${row.bankIfsc ? ` · IFSC ${row.bankIfsc}` : ''}` : 'Not supplied'} — the account number is never displayed on any screen, to its owner or to a reviewer.</dd></div>
                      <div>
                        <dt>Absent details</dt>
                        <dd>
                          {row.commercialDetails?.missing?.length
                            ? row.commercialDetails.missing.join(', ')
                            : 'None — every commercial field was supplied.'}
                          <br />
                          <span class="a-mono">{row.commercialDetails?.note ?? SELLER_REQUIREMENTS_NOT_SET}</span>
                        </dd>
                      </div>
                    </dl>

                    {mayReview ? (
                      <div class="a-controls">
                        <form class="a-form" data-act="seller_approve" data-id={row.id}>
                          <label class="input-label" for={`s-approve-${row.id}`}>Reason for approving (required)</label>
                          <textarea class="input" id={`s-approve-${row.id}`} name="reason" rows="2" required></textarea>
                          <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                          <button type="submit" class="btn btn-primary a-submit">Approve as a seller</button>
                        </form>
                        <form class="a-form" data-act="seller_reject" data-id={row.id}>
                          <label class="input-label" for={`s-reject-${row.id}`}>Reason for refusing (required)</label>
                          <textarea class="input" id={`s-reject-${row.id}`} name="reason" rows="2" required></textarea>
                          <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                          <button type="submit" class="btn btn-ghost a-submit">Refuse this application</button>
                        </form>
                      </div>
                    ) : (
                      <p class="a-hint" role="note">No decision control is offered — deciding a seller requires <code>marketplace:review</code> in their scope.</p>
                    )}
                  </article>
                ))}
              </div>
            )}
          </section>

          <!-- ─── Seller standing ────────────────────────────────────── -->
          <section class="admin-panel" id="standing">
            <h2 class="admin-h2">Seller standing</h2>
            <p class="admin-sub">
              Suspending a seller takes every one of their listings out of the public shop in the same
              instant, without deleting anything: the public query requires the seller to be approved,
              so one status change withdraws an unbounded number of items. Reinstating brings back
              exactly what was approved and nothing else, and the suspension stays on the record.
            </p>

            {!maySuspend && (
              <p class="a-hint" role="note">
                No suspension control is drawn for this account: suspending or reinstating a seller
                requires <code>marketplace:suspend</code>, which your bindings do not hold.
              </p>
            )}

            {sellersApproved.length === 0 && sellersSuspended.length === 0 ? (
              <p class="a-empty">No approved or suspended seller sits inside your scope.</p>
            ) : (
              <div class="a-items">
                {sellersApproved.map((row) => (
                  <article class="a-item" id={`standing-${row.id}`}>
                    <header class="a-item-head">
                      <div>
                        <h3 class="a-item-title">{row.tradingName}</h3>
                        <p class="a-mono">{row.ref} · {placement(row)}</p>
                      </div>
                      <span class={`a-tag a-tag-${row.status}`}>{row.status}</span>
                    </header>
                    {maySuspend && (
                      <div class="a-controls">
                        <form class="a-form" data-act="seller_suspend" data-id={row.id}>
                          <label class="input-label" for={`s-suspend-${row.id}`}>Reason for suspending (required)</label>
                          <textarea class="input" id={`s-suspend-${row.id}`} name="reason" rows="2" required></textarea>
                          <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                          <button type="submit" class="btn btn-ghost a-submit">Suspend this seller</button>
                        </form>
                      </div>
                    )}
                  </article>
                ))}
                {sellersSuspended.map((row) => (
                  <article class="a-item" id={`standing-${row.id}`}>
                    <header class="a-item-head">
                      <div>
                        <h3 class="a-item-title">{row.tradingName}</h3>
                        <p class="a-mono">{row.ref} · {placement(row)}</p>
                      </div>
                      <span class={`a-tag a-tag-${row.status}`}>{row.status}</span>
                    </header>
                    <p class="a-hint">
                      Every listing of this seller's is out of public view for as long as this
                      suspension stands. Nothing has been deleted.
                    </p>
                    {maySuspend && (
                      <div class="a-controls">
                        <form class="a-form" data-act="seller_reinstate" data-id={row.id}>
                          <label class="input-label" for={`s-reinstate-${row.id}`}>Reason for reinstating (required)</label>
                          <textarea class="input" id={`s-reinstate-${row.id}`} name="reason" rows="2" required></textarea>
                          <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                          <button type="submit" class="btn btn-primary a-submit">Reinstate this seller</button>
                        </form>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            )}
          </section>

          <!-- ─── On sale now ────────────────────────────────────────── -->
          <section class="admin-panel" id="onsale">
            <h2 class="admin-h2">On sale now</h2>
            <p class="admin-sub">
              Approved items inside your scope. Delisting is the federation taking an item down; it is
              deliberately a different act from the seller withdrawing it, because a register that
              records both the same way cannot say whether a shop took an item off sale or was told to.
            </p>
            {approvedListings.length === 0 ? (
              <p class="a-empty">No approved item sits inside your scope.</p>
            ) : (
              <div class="a-items">
                {approvedListings.map((row) => (
                  <article class="a-item" id={`onsale-${row.id}`}>
                    <header class="a-item-head">
                      <div>
                        <h3 class="a-item-title">{row.title}</h3>
                        <p class="a-mono">{row.ref} · {row.tradingName} · revision {row.revision}</p>
                      </div>
                      <span class={`a-tag a-tag-${row.status}`}>{row.status}</span>
                    </header>
                    <dl class="a-dl">
                      <div><dt>Price</dt><dd>{formatINR(row.priceMinor)}</dd></div>
                      <div><dt>Category</dt><dd>{row.category}</dd></div>
                      <div><dt>Seller standing</dt><dd>{row.sellerStatus} — an approved item whose seller is not approved is not on public sale, whatever this row says.</dd></div>
                    </dl>
                    {maySuspend && (
                      <div class="a-controls">
                        <form class="a-form" data-act="listing_delist" data-id={row.id}>
                          <label class="input-label" for={`l-delist-${row.id}`}>Reason for delisting (required)</label>
                          <textarea class="input" id={`l-delist-${row.id}`} name="reason" rows="2" required></textarea>
                          <div class="a-ok" hidden></div><div class="a-err" role="alert" hidden></div>
                          <button type="submit" class="btn btn-ghost a-submit">Delist this item</button>
                        </form>
                      </div>
                    )}
                  </article>
                ))}
              </div>
            )}
          </section>

          <!-- ─── What is withheld ───────────────────────────────────── -->
          <section class="admin-panel" id="withheld">
            <h2 class="admin-h2">What these queues are not showing you</h2>
            <p class="admin-sub">A queue that quietly omits things teaches its readers to believe it is complete. These are the omissions, named.</p>
            <ul class="a-list-block">
              <li>
                <strong>Sellers and items outside your scope are withheld.</strong> {scopeReach} They are
                filtered out by the query, not hidden by this template, and a listing is scoped by where
                its SELLER sits rather than by anything the listing itself claims.
              </li>
              <li>
                <strong>
                  {ownListingsWithheld === 0 && !ownSellerWithheld
                    ? 'Your own shop would be withheld — you have none in these queues.'
                    : `Your own record is withheld${ownListingsWithheld > 0 ? `, including ${ownListingsWithheld} item${ownListingsWithheld > 1 ? 's' : ''} of your own` : ''}.`}
                </strong>
                {' '}Nobody decides their own seller record or their own item, whatever authority they
                hold. The server refuses it against identity; this page does not offer it.
              </li>
              <li>
                <strong>Draft items are not here and never will be.</strong> A draft has not been
                submitted, so there is nothing to decide. Rejected, withdrawn and delisted items are
                likewise absent from the working queue — the seller may resubmit, and it returns.
              </li>
              <li>
                <strong>An edited item disappears from "on sale" without anybody acting.</strong> It is
                not hidden from you: it has genuinely left the public shop and is back in the review
                queue above, because the approval covered content that no longer matches.
              </li>
            </ul>
          </section>

          <!-- ─── Unset policy ───────────────────────────────────────── -->
          <section class="admin-panel" id="unset">
            <h2 class="admin-h2">What the federation has not set</h2>
            <p class="admin-sub">
              Printed rather than filled in. A commission rate or a "reviewed within 48 hours" promise
              invented here would be indistinguishable from a real one to everybody who read it.
            </p>
            <dl class="a-dl">
              <div><dt>Commission or platform fee</dt><dd>{COMMISSION_NOT_SET}</dd></div>
              <div><dt>Seller requirements</dt><dd>{SELLER_REQUIREMENTS_NOT_SET}</dd></div>
              <div><dt>Review turnaround</dt><dd>{LISTING_REVIEW_TURNAROUND_NOT_SET}</dd></div>
              <div><dt>Categories</dt><dd>{LISTING_CATEGORIES.join(', ')} — exactly the four the federation's own material already uses, and no more. A seller cannot extend the list by typing.</dd></div>
            </dl>
          </section>
          </>
        )}
      </div>
    </div>
  )}
</Base>

<script>
  const loginForm = document.getElementById('loginForm');
  if (loginForm instanceof HTMLFormElement) {
    const loginErr = document.getElementById('loginErr');
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginErr) loginErr.hidden = true;
      const fd = new FormData(loginForm);
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      const r = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(email ? { email, password } : { password }),
      }).catch(() => null);
      if (r && r.ok) { location.reload(); return; }
      const body = r ? await r.json().catch(() => null) : null;
      if (loginErr) {
        loginErr.hidden = false;
        loginErr.textContent = (body && body.error) ? String(body.error) : 'Sign-in failed. Check your details and try again.';
      }
    });
  }

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' }).catch(() => null);
    location.reload();
  });

  // One listener for every decision on the page. It posts to this same URL and
  // the page's own POST handler answers with JSON. The reason check below is a
  // courtesy; the server and the module both refuse a reasonless decision.
  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) return;
    const act = form.getAttribute('data-act');
    if (!act) return;
    event.preventDefault();

    const id = Number(form.getAttribute('data-id') || '0');
    const ok = form.querySelector('.a-ok');
    const err = form.querySelector('.a-err');
    const button = form.querySelector('.a-submit');
    const reasonEl = form.querySelector('textarea[name=reason]');
    if (ok instanceof HTMLElement) { ok.hidden = true; ok.textContent = ''; }
    if (err instanceof HTMLElement) { err.hidden = true; err.textContent = ''; }

    const fail = (message, focus) => {
      if (err instanceof HTMLElement) { err.hidden = false; err.textContent = message; }
      if (focus instanceof HTMLElement) focus.focus();
    };

    const reason = reasonEl instanceof HTMLTextAreaElement ? reasonEl.value.trim() : '';
    if (!reason) {
      fail('This decision must state its reason. Nothing has been sent to the server.', reasonEl);
      return;
    }

    const label = button instanceof HTMLButtonElement ? button.textContent : '';
    if (button instanceof HTMLButtonElement) { button.disabled = true; button.textContent = 'Recording…'; }

    const response = await fetch(location.pathname, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: act, id, reason }),
    }).catch(() => null);

    if (button instanceof HTMLButtonElement) { button.disabled = false; button.textContent = label; }

    if (!response) { fail('Could not reach the server. NOTHING was recorded. Check your connection and try again.'); return; }

    const body = await response.json().catch(() => null);

    if (response.ok && body && body.ok) {
      const result = body.result || {};
      if (ok instanceof HTMLElement) {
        ok.hidden = false;
        ok.textContent = 'Recorded by the server. This record is now "' + String(result.status) +
          '". Reload to see the queues as they now stand.';
      }
      form.querySelectorAll('button, textarea').forEach((el) => {
        if (el instanceof HTMLButtonElement || el instanceof HTMLTextAreaElement) el.disabled = true;
      });
      return;
    }

    let message = (body && body.error) ? String(body.error) : '';
    if (!message) {
      if (response.status === 401) message = 'Your session has ended.';
      else if (response.status === 429) message = 'Too many decisions in a short time. Wait a minute and try again.';
      else message = 'The server refused this (HTTP ' + response.status + ').';
    }
    fail(message + ' NOTHING was changed.');
  });
</script>

