---
import Base from '@/layouts/Base.astro';
import ListPanel from '@/components/ListPanel.astro';
import { getAll } from '@/lib/storage';
import { identify } from '@/lib/session';
import { canAnywhere } from '@/lib/rbac';

export const prerender = false;

// THE FRONT DOOR ONLY ACCEPTED THE SHARED OFFICE PASSWORD.
//
// This read isAuthenticated(), which checks the mmakf_admin cookie and nothing
// else — the LEGACY shared-password session. A per-person account signs in to a
// mmakf_user cookie, so the sequence was: correct email, correct password, 200
// from /api/auth/login, cookie set, location.reload() — and this page rendering
// the sign-in form again, because it had never heard of that cookie.
//
// Nothing reported it. The console had no error to show: from here the caller
// simply was not signed in. An officer with a valid SUPER_ADMIN account and the
// right password could reissue that password all evening and never see anything
// but the form. Every OTHER page under /admin already went through identify()
// (§75); only the door you land on did not.
//
// GATED ON content:write, NOT content:read, and the difference is the whole
// security of the change. content:read is held by every legacy unit code down
// to club level, so gating on it would hand the national editorial console to a
// dojo's access code. content:write is held by the legacy admin principal and
// by SUPER_ADMIN, and by no unit level at all — so this admits exactly who it
// admitted before, plus the real accounts that were always meant to replace
// them. Verified against GRANTS rather than assumed.
const identity = await identify(Astro.request.headers.get('cookie'));
const authed = !!identity?.principal && canAnywhere(identity.principal, 'content:write');
const data = authed ? await getAll() : null;

let leadList: any[] = [];
let regList: any[] = [];
let subList: any[] = [];
let unitAccessList: any[] = [];
let eventRegList: any[] = [];
if (authed) {
  const { get, getList } = await import('@/lib/storage');
  leadList = await getList('leads', 500);
  regList = await getList('registrations', 300);
  subList = await getList('submissions', 300);
  unitAccessList = (await get<any[]>('unitAccess')) || [];
  eventRegList = await getList('eventRegs', 300);
}
---

<Base title="MMAKF Admin" showNav={false} showFooter={false}>
  {!authed ? (
    <section style="min-height:90vh;display:flex;align-items:center;justify-content:center;padding:64px 24px">
      <div style="width:100%;max-width:420px">
        <div style="text-align:center;margin-bottom:36px">
          <div style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;letter-spacing:.06em">MMAKF</div>
          <div style="font-family:var(--font-display);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-top:6px">Administration</div>
        </div>
        <form id="loginForm" class="card" style="padding:32px">
          <h1 class="card-title" style="font-size:1.2rem;margin-bottom:24px">Sign in</h1>

          <label class="input-label" for="login-email">Email address</label>
          <input class="input" type="email" id="login-email" name="email" autocomplete="username"
                 autocapitalize="off" autocorrect="off" spellcheck="false" autofocus
                 placeholder="you@mmakf.in" />

          <label class="input-label" for="login-password" style="margin-top:14px">Password</label>
          <div style="position:relative">
            <input class="input" type="password" id="login-password" name="password"
                   autocomplete="current-password" required style="padding-right:74px" />
            <button type="button" id="pwToggle" aria-controls="login-password" aria-pressed="false"
                    style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:0;padding:8px;font-family:var(--font-display);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);cursor:pointer">Show</button>
          </div>

          <div id="loginErr" role="alert" style="color:var(--red-2);font-size:.85rem;margin-top:12px;display:none"></div>
          <button type="submit" class="btn btn-primary" style="width:100%;margin-top:20px;justify-content:center">Sign in</button>

          <!--
            Recovery, stated rather than hidden — and SHORT.

            This was a hundred and fifty words on a sign-in page: why there is
            no reset link, why a security question would be weaker than the
            password it replaced, what the reset does to existing sessions.
            Every sentence true, and none of it what somebody staring at a
            rejected password can act on. A page that explains itself at length
            to a person who is locked out is not being helpful, it is being read
            past — and the one line that mattered, the command, was buried in
            the fourth sentence of the second paragraph.

            The reasoning still exists; it lives beside the rule it explains, in
            src/lib/auth.ts and docs/DEPLOYMENT.md. What is left here is what the
            reader can do about it.
          -->
          <details style="margin-top:18px">
            <summary style="cursor:pointer;font-size:.78rem;color:var(--gold);font-family:var(--font-display);letter-spacing:.04em">Forgotten your password?</summary>
            <div style="margin-top:10px;font-size:.75rem;color:var(--muted);line-height:1.7">
              <p style="margin:0">
                No self-service reset — this console sends no mail. A federation officer
                reissues it:
                <code style="font-size:.72rem">npm run user:reset-password -- --email you@mmakf.in</code>
              </p>
              <p style="margin:8px 0 0;opacity:.8">
                Leave the email blank only when bootstrapping a deployment that has no
                accounts yet.
              </p>
            </div>
          </details>

          <p style="margin-top:20px;font-size:.75rem;color:var(--muted);text-align:center;line-height:1.6">
            Authorised personnel only. Every action is recorded against your account.
          </p>
        </form>
      </div>
    </section>

    <script>
      // The Quick-links buttons. Delegated so the markup carries no inline
      // JavaScript — see the note beside them for what inline cost here.
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest('[data-scroll-to]');
        if (!btn) return;
        const target = document.getElementById(btn.getAttribute('data-scroll-to') || '');
        // A missing section is not an error worth throwing at the operator: the
        // button simply does nothing, which is what it did before and is now
        // deliberate rather than accidental.
        if (!target) return;
        window.scrollTo({ top: target.offsetTop - 20, behavior: 'smooth' });
      });

      // REVEAL THE PASSWORD.
      //
      // This form's only error is deliberately generic — "Invalid email or
      // password" — because saying which one was wrong tells a stranger whether
      // an account exists. The cost of that correct decision falls on the
      // legitimate operator: a mistyped character and a wrong account produce
      // the identical sentence, and a 27-character generated credential is
      // exactly the kind nobody types correctly first time. Being able to LOOK
      // is the difference between one attempt and five.
      //
      // type="button" so it cannot submit the form, and aria-pressed so a screen
      // reader announces the state rather than just the word on the button.
      const pw = document.getElementById('login-password') as HTMLInputElement | null;
      const pwBtn = document.getElementById('pwToggle');
      pwBtn?.addEventListener('click', () => {
        if (!pw) return;
        const revealed = pw.type === 'text';
        pw.type = revealed ? 'password' : 'text';
        pwBtn.textContent = revealed ? 'Show' : 'Hide';
        pwBtn.setAttribute('aria-pressed', String(!revealed));
        // Return focus to the field so the keyboard user is not left on the
        // button having to tab back to carry on typing.
        pw.focus();
      });

      const f = document.getElementById('loginForm');
      const err = document.getElementById('loginErr');
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        // Re-mask before anything else. A browser restoring this page from the
        // back/forward cache restores the field as it was left, and a password
        // left readable on a shared office screen is the one failure this
        // control could introduce.
        if (pw && pw.type === 'text') {
          pw.type = 'password';
          if (pwBtn) { pwBtn.textContent = 'Show'; pwBtn.setAttribute('aria-pressed', 'false'); }
        }
        err.style.display = 'none';
        const btn = f.querySelector('button[type=submit]');
        const data = new FormData(f);
        const email = String(data.get('email') || '').trim();
        const password = String(data.get('password') || '');
        if (btn) { btn.disabled = true; btn.textContent = 'Signing in…'; }

        const r = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // An empty email means the legacy shared-password path; the server
          // decides whether that is still permitted, never the client.
          body: JSON.stringify(email ? { email, password } : { password }),
        }).catch(() => null);

        if (btn) { btn.disabled = false; btn.textContent = 'Sign in'; }

        if (r && r.ok) {
          const body = await r.json().catch(() => ({}));
          if (body && body.mustChangePassword) {
            sessionStorage.setItem('mmakf_must_change_password', '1');
          }
          location.reload();
          return;
        }

        // Surface the server's reason — a lockout has to be explained, or the
        // user retries into a longer lock.
        let message = 'Sign-in failed. Check your details and try again.';
        if (r) {
          const body = await r.json().catch(() => null);
          if (body && body.error) message = body.error;
          else if (r.status === 429) message = 'Too many attempts. Wait a minute and try again.';
        } else {
          message = 'Could not reach the server. Check your connection.';
        }
        err.textContent = message;
        err.style.display = 'block';
        f.querySelector('input[name=password]').select();
      });
    </script>
  ) : (
    <div class="admin-wrap">
      <aside class="admin-side">
        <div class="admin-brand">
          <div class="admin-brand-1">MMAKF</div>
          <div class="admin-brand-2">Admin</div>
        </div>
        <nav class="admin-nav" aria-label="Content sections">
          <a href="#dashboard" class="active">Dashboard</a>
          <a href="#federation">Federation Profile</a>
          <a href="#leadership">Leadership</a>
          <a href="#programs">Programs</a>
          <a href="#schedule">Schedule</a>
          <a href="#events">Events</a>
          <a href="#news">News</a>
          <a href="#facilities">Facilities</a>
          <a href="#faqs">FAQs</a>
          <a href="#gallery">Gallery</a>
          <a href="#syllabus">Syllabus</a>
          <a href="#stats">Homepage Statistics</a>
          <a href="#kyuGrades">Kyu Ranks & Fees</a>
          <a href="#danGrades">Dan Ranks</a>
          <a href="#courses">Academy Courses</a>
          <a href="#lessons">Academy Lessons</a>
          <a href="#circulars">Circulars</a>
          <a href="#members">Members Register</a>
          <a href="#applications">Applications</a>
          <a href="#eventRegs">Event Entries</a>
          <a href="#unitAccess">Unit Access</a>
          <a href="#submissions">Unit Submissions</a>
          <a href="#documents">Documents</a>
          <a href="#results">Results</a>
          <a href="#stateUnits">State Units</a>
          <a href="#branches">Branches</a>
          <a href="#products">Shop Products</a>
          <a href="#achievements">Achievements</a>
          <a href="#testimonials">Testimonials</a>
          <a href="#leads">Enrolment Leads</a>
        </nav>
        <div style="padding:16px;border-top:1px solid var(--border)">
          <a class="btn btn-ghost" href="/admin/password" style="width:100%;justify-content:center;margin-bottom:8px">Change password</a>
          <button class="btn btn-ghost" style="width:100%;justify-content:center" id="logoutBtn">Logout</button>
          <a href="/" target="_blank" class="btn-link" style="display:block;text-align:center;margin-top:10px">View Site →</a>
        </div>
      </aside>

      <div class="admin-main">
        <h1 class="sr-only">MMAKF content administration</h1>
        <div class="admin-toast" id="toast" role="status" aria-live="polite">Saved</div>

        <section id="dashboard" class="admin-panel">
          <h2 class="admin-h">Dashboard</h2>
          <div class="grid grid-4" style="margin-top:24px">
            <div class="card"><div class="card-eyebrow">Programs</div><div class="admin-stat">{data!.programs.length}</div></div>
            <div class="card"><div class="card-eyebrow">Events</div><div class="admin-stat">{data!.events.length}</div></div>
            <div class="card"><div class="card-eyebrow">News</div><div class="admin-stat">{data!.news.length}</div></div>
            <div class="card"><div class="card-eyebrow">Products</div><div class="admin-stat">{data!.products.length}</div></div>
          </div>
          <div class="card" style="margin-top:24px">
            <div class="card-eyebrow">Quick links</div>
            {/* DELEGATED, NOT onclick. These four carried
                `document.getElementById('news')!.offsetTop` in an onclick
                attribute. The `!` is a TypeScript non-null assertion, and an
                inline handler is parsed as plain JavaScript by the browser — no
                compiler ever sees it. Every one of the four threw SyntaxError
                on click and did nothing at all, silently, because a handler
                that fails to parse reports nothing to the person pressing it.

                A data attribute and one listener in the page's compiled script
                cannot have that failure: there is no inline JavaScript left to
                mis-parse. */}
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px">
              <button class="btn btn-ghost" type="button" data-scroll-to="news">Post News</button>
              <button class="btn btn-ghost" type="button" data-scroll-to="events">Add Event</button>
              <button class="btn btn-ghost" type="button" data-scroll-to="schedule">Edit Schedule</button>
              <button class="btn btn-ghost" type="button" data-scroll-to="leads">View Leads</button>
            </div>
          </div>
        </section>

        <section id="federation" class="admin-panel">
          <h2 class="admin-h">Federation Profile</h2>
          <p class="admin-sub">Identity shown across the public site.</p>
          <form data-key="federation" class="admin-form" data-mode="object" style="margin-top:20px">
            <div class="grid grid-2">
              <div><label class="input-label" for="fed-name">Full name</label><input class="input" id="fed-name" name="name" value={data!.federation.name} /></div>
              <div><label class="input-label" for="fed-shortName">Short name</label><input class="input" id="fed-shortName" name="shortName" value={data!.federation.shortName} /></div>
              <div style="grid-column:1/-1"><label class="input-label" for="fed-tagline">Tagline</label><input class="input" id="fed-tagline" name="tagline" value={data!.federation.tagline} /></div>
              <div><label class="input-label" for="fed-founded">Founded</label><input class="input" id="fed-founded" name="founded" value={data!.federation.founded} /></div>
              <div><label class="input-label" for="fed-style">Style</label><input class="input" id="fed-style" name="style" value={data!.federation.style} /></div>
              <div><label class="input-label" for="fed-lineage">Lineage</label><input class="input" id="fed-lineage" name="lineage" value={data!.federation.lineage} /></div>
              <div><label class="input-label" for="fed-headquarters">Headquarters</label><input class="input" id="fed-headquarters" name="headquarters" value={data!.federation.headquarters} /></div>
              <div><label class="input-label" for="fed-affiliation">Affiliation</label><input class="input" id="fed-affiliation" name="affiliation" value={data!.federation.affiliation} /></div>
              <div><label class="input-label" for="fed-upi">UPI ID</label><input class="input" id="fed-upi" name="upi" value={data!.federation.upi} /></div>
              <div><label class="input-label" for="fed-contact-email">Email</label><input class="input" id="fed-contact-email" name="contact.email" value={data!.federation.contact.email} /></div>
              <div><label class="input-label" for="fed-contact-phone">Phone</label><input class="input" id="fed-contact-phone" name="contact.phone" value={data!.federation.contact.phone} /></div>
              <div style="grid-column:1/-1"><label class="input-label" for="fed-contact-address">Address</label><input class="input" id="fed-contact-address" name="contact.address" value={data!.federation.contact.address} /></div>
              <div style="grid-column:1/-1"><label class="input-label" for="fed-contact-hours">Office hours</label><input class="input" id="fed-contact-hours" name="contact.hours" value={data!.federation.contact.hours} /></div>
              <div style="grid-column:1/-1"><label class="input-label" for="fed-contact-hours-sunday">Sunday class timings</label><input class="input" id="fed-contact-hours-sunday" name="contact.hoursSunday" value={data!.federation.contact.hoursSunday ?? ''} /></div>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:18px">Save Profile</button>
          </form>
        </section>

        <ListPanel id="leadership" title="Leadership & Governance" subtitle="Office bearers, committees and faculty — drives the /governance page, homepage table and hero card." apiKey="leadership"
          rows={data!.leadership} fields={[
            {n:'name',l:'Name'},{n:'role',l:'Designation'},{n:'rank',l:'Grade / Credential'},{n:'since',l:'Serving since'},{n:'specialty',l:'Specialty'},{n:'img',l:'Portrait URL (optional)',full:true},{n:'note',l:'Short note',full:true},{n:'bio',l:'Full biography',full:true,textarea:true}
          ]} />

        <ListPanel id="programs" title="Programs" subtitle="Training programs shown on the public site." apiKey="programs"
          rows={data!.programs} fields={[
            {n:'icon',l:'Icon (e.g. karate-gi, kata)'},{n:'name',l:'Name'},{n:'lvl',l:'Level'},{n:'mode',l:'Mode'},{n:'fee',l:'Fee (₹/mo)',type:'number'},{n:'desc',l:'Description',full:true}
          ]} />

        <ListPanel id="schedule" title="Schedule" subtitle="Weekly class schedule." apiKey="schedule"
          rows={data!.schedule} fields={[
            {n:'day',l:'Day'},{n:'t',l:'Time'},{n:'d',l:'Discipline'},{n:'lvl',l:'Level'},{n:'ins',l:'Instructor'},{n:'mode',l:'Mode (dojo/online)'}
          ]} />

        <ListPanel id="events" title="Events & Tournaments" subtitle="Upcoming events shown on the public site." apiKey="events"
          rows={data!.events} fields={[
            {n:'day',l:'Day'},{n:'mo',l:'Month'},{n:'year',l:'Year'},{n:'type',l:'Type'},{n:'fee',l:'Fee'},{n:'t',l:'Title',full:true},{n:'loc',l:'Location',full:true}
          ]} />

        <ListPanel id="news" title="News & Announcements" subtitle="Posts shown in the News section. Add an image URL for a photo card." apiKey="news"
          rows={data!.news} fields={[
            {n:'title',l:'Title',full:true},{n:'date',l:'Date'},{n:'type',l:'Type'},{n:'img',l:'Image URL (optional)',full:true},{n:'body',l:'Body',full:true,textarea:true}
          ]} />

        <ListPanel id="facilities" title="Dojo Facilities" subtitle="Facilities shown on the /facilities page." apiKey="facilities"
          rows={data!.facilities} fields={[
            {n:'icon',l:'Icon (e.g. mat, water, cctv)'},{n:'name',l:'Name'},{n:'tag',l:'Tag'},{n:'desc',l:'Description',full:true,textarea:true}
          ]} />

        <ListPanel id="faqs" title="FAQs" subtitle="Questions shown on the /faq page." apiKey="faqs"
          rows={data!.faqs} fields={[
            {n:'q',l:'Question',full:true},{n:'a',l:'Answer',full:true,textarea:true}
          ]} />

        <ListPanel id="gallery" title="Gallery" subtitle="Items shown on the /gallery page." apiKey="gallery"
          rows={data!.gallery} fields={[
            {n:'title',l:'Title'},{n:'cat',l:'Category'},{n:'icon',l:'Icon (fallback)'},{n:'img',l:'Image URL',full:true},{n:'desc',l:'Caption',full:true}
          ]} />

        <ListPanel id="syllabus" title="Grading Syllabus" subtitle="Kata syllabus rows on the /belt-system page." apiKey="syllabus"
          rows={data!.syllabus} fields={[
            {n:'grade',l:'Grading (e.g. 10th → 9th Kyu)'},{n:'belt',l:'Belt'},{n:'kumite',l:'Kumite'},{n:'kihon',l:'Kihon',full:true},{n:'kata',l:'Kata',full:true}
          ]} />

        <ListPanel id="stats" title="Homepage Statistics" subtitle="The five headline figures in the hero band. Publish only figures the federation can evidence." apiKey="stats"
          rows={data!.stats} fields={[
            {n:'value',l:'Value (e.g. 1983, 130+)'},{n:'label',l:'Label',full:true}
          ]} />

        <ListPanel id="kyuGrades" title="Grading — Kyu Ranks & Fees" subtitle="Coloured-belt ranks shown on /belt-system. Order top to bottom = 10th Kyu upward." apiKey="beltGrading.kyu"
          rows={data!.beltGrading.kyu} fields={[
            {n:'rank',l:'Rank (e.g. 9th Kyu — Yellow)',full:true},{n:'fee',l:'Examination fee (₹)',type:'number'}
          ]} />

        <ListPanel id="danGrades" title="Grading — Dan Ranks" subtitle="Black-belt ranks shown on /belt-system." apiKey="beltGrading.dan"
          rows={data!.beltGrading.dan} fields={[
            {n:'rank',l:'Rank (e.g. Shodan — I Dan)',full:true},{n:'note',l:'Eligibility note',full:true},{n:'wkf',l:'Pathway note',full:true}
          ]} />

        <ListPanel id="courses" title="Academy — Courses" subtitle="Course catalogue on /academy. Lessons attach by exact course title." apiKey="courses"
          rows={data!.courses} fields={[
            {n:'id',l:'Short id'},{n:'title',l:'Course title',full:true},{n:'belt',l:'Belt range (e.g. 10th – 9th Kyu)'},{n:'level',l:'Level label'},{n:'desc',l:'Description',full:true,textarea:true}
          ]} />

        <ListPanel id="lessons" title="Academy — Lessons" subtitle="Paste a video URL to activate the Watch link. Access: Free or Members." apiKey="lessons"
          rows={data!.lessons} fields={[
            {n:'course',l:'Course title (exact match)',full:true},{n:'title',l:'Lesson title',full:true},{n:'dur',l:'Duration (e.g. 18 min)'},{n:'access',l:'Access (Free/Members)'},{n:'video',l:'Video URL (optional)',full:true}
          ]} />

        <ListPanel id="circulars" title="Circulars" subtitle="Official notices to all units — shown in the Unit Portal." apiKey="circulars"
          rows={data!.circulars} fields={[
            {n:'no',l:'Circular no. (MMAKF/CIR/2026-08)'},{n:'date',l:'Date'},{n:'title',l:'Title',full:true},{n:'body',l:'Body',full:true,textarea:true}
          ]} />

        <ListPanel id="members" title="Members Register" subtitle="The national register powering public ID verification. Add a member here after approving their application. ID format: MMAKF-A/I/D/O-YYYY-NNNNN." apiKey="members"
          rows={data!.members} fields={[
            {n:'id',l:'Member ID (MMAKF-A-2026-00001)'},{n:'name',l:'Name'},{n:'type',l:'Type (Athlete/Instructor/Dojo/Official)'},{n:'grade',l:'Grade'},{n:'state',l:'State'},{n:'unit',l:'Unit / Centre'},{n:'status',l:'Status (Active/Suspended/Expired)'},{n:'validTill',l:'Valid till'}
          ]} />

        <section id="applications" class="admin-panel">
          <h2 class="admin-h">Registration Applications</h2>
          <p class="admin-sub">Submitted from /registration. Verify with the unit, collect the fee, then add the member to the Members Register above. Most recent first.</p>
          <div class="card" style="margin-top:20px;padding:0;overflow:hidden">
            {regList.length === 0 ? (
              <div style="padding:32px;text-align:center;color:var(--muted)">No applications yet.</div>
            ) : (
              <div style="overflow-x:auto">
                <table class="schedule-tbl" style="min-width:760px">
                  <thead><tr><th scope="col">When</th><th scope="col">App No.</th><th scope="col">Name</th><th scope="col">Phone</th><th scope="col">Type</th><th scope="col">State / District</th><th scope="col">Grade</th></tr></thead>
                  <tbody>
                    {regList.slice(0, 200).map((r: any) => (
                      <tr>
                        <td class="text-muted" style="font-size:.78rem">{new Date(r.ts).toLocaleString('en-IN')}</td>
                        <td class="text-gold" style="font-family:var(--font-display);white-space:nowrap">{r.appNo}</td>
                        <td>{r.name}</td>
                        <td>{r.phone}</td>
                        <td>{r.type}</td>
                        <td class="text-muted">{r.state}{r.district ? ` · ${r.district}` : ''}</td>
                        <td class="text-muted">{r.grade || '—'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </section>

        <section id="eventRegs" class="admin-panel">
          <h2 class="admin-h">Event Entries</h2>
          <p class="admin-sub">Registrations submitted from /events. Confirm category, eligibility and entry fee with each entrant. Most recent first.</p>
          <div class="card" style="margin-top:20px;padding:0;overflow:hidden">
            {eventRegList.length === 0 ? (
              <div style="padding:32px;text-align:center;color:var(--muted)">No entries yet.</div>
            ) : (
