  </style>

  <script is:inline define:vars={{ data: { ...data, unitAccess: unitAccessList } }}>
    // Toast
    function toast(msg) {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg || 'Saved';
      t.classList.add('show');
      clearTimeout(window._tt);
      window._tt = setTimeout(() => t.classList.remove('show'), 1800);
    }

    // THE "MUST CHANGE THIS PASSWORD" PROMPT.
    //
    // /api/auth/login has always returned mustChangePassword, and this page
    // has always written it to sessionStorage — where NOTHING read it. So an
    // account handed a generated credential was told, in the register and
    // nowhere a human could see, to replace it.
    //
    // Raised client-side from that existing flag rather than from a fresh
    // query, because the alternative is reading users.must_change_password on
    // every admin request to render one banner.
    try {
      if (sessionStorage.getItem('mmakf_must_change_password') === '1') {
        const wrap = document.querySelector('.admin-main') || document.body;
        const bar = document.createElement('div');
        bar.setAttribute('role', 'status');
        bar.style.cssText =
          'border:1px solid var(--gold);border-radius:var(--radius);padding:14px 18px;' +
          'margin-bottom:20px;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap';
        bar.innerHTML =
          '<span style="font-size:.86rem">This account is still using a password somebody else generated for it.</span>' +
          '<a class="btn btn-primary" href="/admin/password" style="font-size:.7rem">Set your own</a>';
        wrap.prepend(bar);
      }
    } catch (e) { /* private mode, or storage refused: the page still works */ }

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.reload();
    });

    // Object form (federation)
    function setNested(obj, path, val) {
      const ks = path.split('.');
      let o = obj;
      for (let i = 0; i < ks.length - 1; i++) {
        if (!o[ks[i]] || typeof o[ks[i]] !== 'object') o[ks[i]] = {};
        o = o[ks[i]];
      }
      o[ks[ks.length - 1]] = val;
    }
    document.querySelectorAll('form.admin-form[data-mode="object"]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const key = form.dataset.key;
        const btn = form.querySelector('button[type=submit]');
        const fd = new FormData(form);
        const out = JSON.parse(JSON.stringify(data[key]));
        fd.forEach((v, k) => setNested(out, k, v));
        if (btn) btn.disabled = true;
        const r = await fetch('/api/data/' + key, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(out),
        }).catch(() => null);
        if (btn) btn.disabled = false;
        if (r && r.ok) { data[key] = out; toast('Profile saved'); }
        else toast('Save failed');
      });
    });

    // List panels
    document.querySelectorAll('section[data-key][data-fields]').forEach((panel) => {
      const key = panel.dataset.key;
      const fields = JSON.parse(panel.dataset.fields);
      const listEl = panel.querySelector('.lp-list');
      const addForm = panel.querySelector('.lp-form');

      // A panel may target a nested list, e.g. "beltGrading.kyu". Reads take
      // the sub-list; writes POST the whole parent object with that sub-list
      // replaced, because the API stores one value per top-level key.
      const [rootKey, subKey] = key.split('.');
      const readRows = () => (subKey ? (data[rootKey] || {})[subKey] : data[rootKey]) || [];
      const bodyFor = (rows) =>
        subKey ? JSON.stringify({ ...(data[rootKey] || {}), [subKey]: rows }) : JSON.stringify(rows);
      const commit = (rows) => {
        if (subKey) data[rootKey] = { ...(data[rootKey] || {}), [subKey]: rows };
        else data[rootKey] = rows;
      };

      // WHICH ROW IS OPEN FOR EDITING, or -1.
      //
      // One at a time, deliberately. Every write here POSTs the WHOLE array
      // back — the store holds one value per key — so two forms open at once
      // would race, and whichever saved second would silently discard the
      // other's change, with no error anywhere to say so.
      let editIdx = -1;

      // One writer for all four operations. Add, edit, delete and reorder are
      // the same write, and they were not going to stay in step written out
      // four times.
      async function save(rows, okMsg, failMsg) {
        const r = await fetch('/api/data/' + rootKey, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: bodyFor(rows),
        }).catch(() => null);
        if (r && r.ok) { commit(rows); render(); toast(okMsg); return true; }
        toast(failMsg);
        return false;
      }

      // WHICH HOSTS AN IMAGE MAY ACTUALLY COME FROM.
      //
      // Mirrors img-src in the Content-Security-Policy in vercel.json. A URL
      // from anywhere else is not "probably fine" — the browser REFUSES to
      // load it, on the public site and in here, and the only trace is a
      // console warning no editor will ever read. Pasting a link and seeing
      // nothing appear, with no explanation, is the failure this list exists
      // to turn into a sentence.
      const IMG_HOSTS = ['images.unsplash.com'];
      const IMG_HOST_SUFFIX = '.public.blob.vercel-storage.com';

      function imageFieldLabel(f) {
        return /img|image|photo|thumb|logo|cover/i.test(f.n) || /image|photo/i.test(f.l);
      }

      // null when it is not usable as an image at all; otherwise the URL and
      // whether the policy will let it load.
      function imageInfo(v) {
        const url = String(v == null ? '' : v).trim();
        if (!url) return null;
        if (url.startsWith('/') || url.startsWith('data:')) return { url: url, allowed: true, host: '' };
        let u;
        try { u = new URL(url); } catch (err) { return null; }
        if (u.protocol !== 'https:' && u.protocol !== 'http:') return null;
        const allowed = IMG_HOSTS.indexOf(u.host) >= 0 || u.host.endsWith(IMG_HOST_SUFFIX);
        return { url: url, allowed: allowed, host: u.host };
      }

      function previewHtml(info) {
        if (!info) return '';
        if (!info.allowed) {
          return '<div class="lp-img-warn">This host is not allowed by the site policy, so the image will not load. '
            + 'Allowed: images.unsplash.com, or a file under /public referenced as /name.jpg. '
            + 'Host given: ' + esc(info.host) + '</div>';
        }
        return '<img class="lp-img-prev" src="' + esc(info.url) + '" alt="" loading="lazy" />';
      }

      function fieldControl(f, value, idx) {
        const cid = panel.id + '-edit-' + idx + '-' + f.n;
        const v = esc(String(value == null ? '' : value));
        const label = '<label class="input-label" for="' + cid + '">' + esc(f.l) + '</label>';
        const control = f.textarea
          ? '<textarea class="input" id="' + cid + '" name="' + f.n + '" rows="3">' + v + '</textarea>'
          : '<input class="input" id="' + cid + '" name="' + f.n + '" type="' + (f.type || 'text') + '" value="' + v + '" />';
        // A FILE PICKER BESIDE THE URL BOX, not instead of it. A link to an
        // image somebody else already hosts is still legitimate; what was
        // missing was any way to put a file on this federation's own domain
        // without a developer and a git commit.
        const picker = imageFieldLabel(f)
          ? '<div class="lp-upload"><label class="lp-upload-btn">Upload a file'
            + '<input type="file" accept="image/jpeg,image/png,image/webp" data-upload-for="' + f.n + '" hidden />'
            + '</label><span class="lp-upload-note" data-note-for="' + f.n + '"></span></div>'
          : '';
        const prev = imageFieldLabel(f)
          ? '<div class="lp-img-slot" data-for="' + f.n + '">' + previewHtml(imageInfo(value)) + '</div>'
          : '';
        return '<div class="' + (f.full ? 'full' : '') + '">' + label + control + picker + prev + '</div>';
      }

      function render() {
        const rows = readRows();
        listEl.innerHTML = rows.map((r, i) => {
          // THE ROW BEING EDITED BECOMES THE FORM, in place. Not a modal: the
          // rest of this console asks as little of JavaScript as it can, and a
          // dialog needs focus trapping and an escape route before it is usable
          // by anybody on a keyboard.
          if (i === editIdx) {
            return '<form class="lp-item lp-edit" data-idx="' + i + '" style="display:block">'
              + '<div class="lp-form-grid">' + fields.map((f) => fieldControl(f, r[f.n], i)).join('') + '</div>'
              + '<div style="margin-top:14px;display:flex;gap:10px">'
              + '<button type="submit" class="btn btn-primary">Save</button>'
              + '<button type="button" class="btn btn-ghost lp-btn-cancel">Cancel</button>'
              + '</div></form>';
          }
          const main = fields.length ? fields[0].n : '';
          const secondary = fields.filter((f, idx) => idx > 0 && r[f.n] !== undefined && r[f.n] !== '').map((f) => esc(String(r[f.n]).slice(0, 70))).slice(0, 3).join(' · ');
          const thumbField = fields.filter(imageFieldLabel)[0];
          const thumb = thumbField ? imageInfo(r[thumbField.n]) : null;
          return '<div class="lp-item">'
            + (thumb && thumb.allowed ? '<img class="lp-thumb" src="' + esc(thumb.url) + '" alt="" loading="lazy" />' : '')
            + '<div class="lp-item-body">'
            + '<div class="lp-item-name">' + esc(String(r[main] == null ? '' : r[main])) + '</div>'
            + '<div class="lp-item-meta">' + secondary + '</div>'
            + '</div>'
            + '<div class="lp-item-actions">'
            + '<button class="lp-btn-move" data-idx="' + i + '" data-dir="-1" title="Move up" aria-label="Move up"' + (i === 0 ? ' disabled' : '') + '>&uarr;</button>'
            + '<button class="lp-btn-move" data-idx="' + i + '" data-dir="1" title="Move down" aria-label="Move down"' + (i === rows.length - 1 ? ' disabled' : '') + '>&darr;</button>'
            + '<button class="lp-btn-edit" data-idx="' + i + '">Edit</button>'
            + '<button class="lp-btn-del" data-idx="' + i + '">Delete</button>'
            + '</div></div>';
        }).join('');

        listEl.querySelectorAll('button.lp-btn-edit').forEach((b) => {
          b.addEventListener('click', () => { editIdx = +b.dataset.idx; render(); });
        });

        listEl.querySelectorAll('button.lp-btn-cancel').forEach((b) => {
          b.addEventListener('click', () => { editIdx = -1; render(); });
        });

        // ORDER IS CONTENT. These arrays render in order on the public site, so
        // without this the only way to move an entry was to delete it and retype
        // it — which is how a phone number gets lost.
        listEl.querySelectorAll('button.lp-btn-move').forEach((b) => {
          b.addEventListener('click', async () => {
            const idx = +b.dataset.idx;
            const to = idx + (+b.dataset.dir);
            const next = readRows().slice();
            if (to < 0 || to >= next.length) return;
            const moved = next.splice(idx, 1)[0];
            next.splice(to, 0, moved);
            b.disabled = true;
            editIdx = -1;
            await save(next, 'Moved', 'Move failed');
          });
        });

        const editForm = listEl.querySelector('form.lp-edit');
        if (editForm) {
          editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const idx = +editForm.dataset.idx;
            const fd = new FormData(editForm);
            const next = readRows().slice();
            // SPREAD THE EXISTING ROW FIRST. These objects carry keys this panel
            // never renders — ids, image paths, flags set elsewhere — and
            // rebuilding from the form alone would drop every one of them.
            const item = Object.assign({}, next[idx]);
            fields.forEach((f) => {
              let v = fd.get(f.n);
              if (v == null) v = '';
              if (f.type === 'number') v = Number(v) || 0;
              item[f.n] = v;
            });
            next[idx] = item;
            const btn = editForm.querySelector('button[type=submit]');
            if (btn) btn.disabled = true;
            editIdx = -1;
            const ok = await save(next, 'Saved', 'Save failed');
            // A failed save must not look like a cancelled one: the form comes
            // back with the operator's typing still in it.
            if (!ok) { editIdx = idx; render(); }
          });
          // The preview follows the field as it is typed, so a wrong host or a
          // broken link is visible before Save rather than after publishing.
          editForm.querySelectorAll('input, textarea').forEach((el) => {
            const slot = editForm.querySelector('.lp-img-slot[data-for="' + el.name + '"]');
            if (!slot) return;
            el.addEventListener('input', () => { slot.innerHTML = previewHtml(imageInfo(el.value)); });
          });
          editForm.querySelectorAll('input[data-upload-for]').forEach((fileEl) => {
            const target = editForm.querySelector('[name="' + fileEl.dataset.uploadFor + '"]');
            const note = editForm.querySelector('.lp-upload-note[data-note-for="' + fileEl.dataset.uploadFor + '"]');
            const slot = editForm.querySelector('.lp-img-slot[data-for="' + fileEl.dataset.uploadFor + '"]');
            fileEl.addEventListener('change', async () => {
              const file = fileEl.files && fileEl.files[0];
              if (!file) return;
              if (note) note.textContent = 'Uploading ' + file.name + '...';
              const dataUrl = await new Promise((resolve, reject) => {
                const fr = new FileReader();
                fr.onload = () => resolve(String(fr.result || ''));
                fr.onerror = () => reject(fr.error);
                fr.readAsDataURL(file);
              }).catch(() => null);
              if (!dataUrl) { if (note) note.textContent = 'That file could not be read.'; return; }
              const res = await fetch('/api/uploads/image', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ filename: file.name, contentType: file.type, data: dataUrl }),
              }).catch(() => null);
              const payload = res ? await res.json().catch(() => null) : null;
              if (res && res.ok && payload && payload.url) {
                // The field is filled in for the operator; the row is NOT saved
                // yet. Storing a file and publishing it are two decisions, and
                // Save is still the one that publishes.
                if (target) target.value = payload.url;
                if (slot) slot.innerHTML = previewHtml(imageInfo(payload.url));
                if (note) note.textContent = 'Uploaded. Press Save to publish it.';
              } else {
                if (note) note.textContent = (payload && payload.error) || 'Upload failed.';
              }
              fileEl.value = '';
            });
          });
          const first = editForm.querySelector('input, textarea');
          if (first) first.focus();
        }

        listEl.querySelectorAll('button.lp-btn-del').forEach((b) => {
          b.addEventListener('click', async () => {
            if (!confirm('Delete this item?')) return;
            const idx = +b.dataset.idx;
            const next = readRows().slice();
            next.splice(idx, 1);
            b.disabled = true;
            editIdx = -1;
            await save(next, 'Deleted', 'Delete failed');
          });
        });
      }

      addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = addForm.querySelector('button[type=submit]');
        const fd = new FormData(addForm);
        const item = {};
        fields.forEach((f) => {
          let v = fd.get(f.n);
          if (v == null) v = '';
          if (f.type === 'number') v = Number(v) || 0;
          item[f.n] = v;
        });
        if (key === 'news') item.id = Date.now();
        if (key === 'products') item.id = Date.now();
        const rows = readRows().slice();
        rows.unshift(item);
        if (btn) btn.disabled = true;
        const r = await fetch('/api/data/' + rootKey, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: bodyFor(rows),
        }).catch(() => null);
        if (btn) btn.disabled = false;
        if (r && r.ok) { commit(rows); addForm.reset(); render(); toast('Added'); }
        else toast('Add failed');
      });

      render();
    });

    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  </script>
)}
