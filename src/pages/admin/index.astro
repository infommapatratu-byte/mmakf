    // Toast
    function toast(msg, ms) {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg || 'Saved';
      t.classList.remove('is-error');
      t.classList.add('show');
      clearTimeout(window._tt);
      window._tt = setTimeout(() => t.classList.remove('show'), ms || 1800);
    }

    // WHY A WRITE FAILED, IN WORDS, WHERE THE OPERATOR IS LOOKING.
    //
    // Every write on this page reported the same two words — "Save failed" —
    // whatever had actually happened. The routes it calls do not answer that
    // way: /api/data/[key] says "You do not have authority to edit federation
    // content" when an account holds editorial rights at a unit but not
    // nationally, and names the key and the shape it must keep when a list is
    // posted as an object. /api/uploads/image says the file is 6.2 MB and the
    // limit is 3, or that no media store is linked to this deployment.
    //
    // None of it reached the screen. A refusal, an expired session and an
    // outage were one indistinguishable message, so the only way to tell them
    // apart was the browser's network tab — which is not a thing a federation
    // officer is going to open, and is why this is reported as "the admin panel
    // does not work" rather than as any of the six separate things it can be.
    function toastError(msg) {
      const t = document.getElementById('toast');
      if (!t) return;
      t.textContent = msg;
      t.classList.add('is-error');
      t.classList.add('show');
      clearTimeout(window._tt);
      // Longer than a success: this one has to be read, not merely noticed.
      window._tt = setTimeout(() => t.classList.remove('show'), 9000);
    }

    /** The server's own sentence where it sent one, and a useful reading where it did not. */
    function reasonFrom(res, payload, fallback) {
      if (!res) return fallback + ' — the request never reached the server. Check the connection and try again.';
      const said = payload && typeof payload.error === 'string' ? payload.error : '';
      if (said) return fallback + ' — ' + said;
      if (res.status === 401) return fallback + ' — this session has expired. Sign in again.';
      if (res.status === 403) return fallback + ' — this account may not edit federation content.';
      if (res.status === 413) return fallback + ' — that was too large to send in one request.';
      return fallback + ' — the server answered ' + res.status + '.';
    }

    async function reasonFor(res, fallback) {
      const payload = res ? await res.json().catch(() => null) : null;
      return reasonFrom(res, payload, fallback);
    }

    // THE "MUST CHANGE THIS PASSWORD" PROMPT.
    //
    // /api/auth/login has always returned mustChangePassword, and this page
    // has always written it to sessionStorage — where NOTHING read it. So an
    // account handed a generated credential was told, in the register and
    // nowhere a human could see, to replace it.
    //
    // Raised client-side from that existing flag rather than from a fresh
    // query, because the alternative is reading users.must_change_password on
    // every admin request to render one banner.
    try {
      if (sessionStorage.getItem('mmakf_must_change_password') === '1') {
        const wrap = document.querySelector('.admin-main') || document.body;
        const bar = document.createElement('div');
        bar.setAttribute('role', 'status');
        bar.style.cssText =
          'border:1px solid var(--gold);border-radius:var(--radius);padding:14px 18px;' +
          'margin-bottom:20px;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap';
        bar.innerHTML =
          '<span style="font-size:.86rem">This account is still using a password somebody else generated for it.</span>' +
          '<a class="btn btn-primary" href="/admin/password" style="font-size:.7rem">Set your own</a>';
        wrap.prepend(bar);
      }
    } catch (e) { /* private mode, or storage refused: the page still works */ }

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      location.reload();
    });

    // Object form (federation)
    function setNested(obj, path, val) {
      const ks = path.split('.');
      let o = obj;
      for (let i = 0; i < ks.length - 1; i++) {
        if (!o[ks[i]] || typeof o[ks[i]] !== 'object') o[ks[i]] = {};
        o = o[ks[i]];
      }
      o[ks[ks.length - 1]] = val;
    }
    document.querySelectorAll('form.admin-form[data-mode="object"]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const key = form.dataset.key;
        const btn = form.querySelector('button[type=submit]');
        const fd = new FormData(form);
        const out = JSON.parse(JSON.stringify(data[key]));
        fd.forEach((v, k) => setNested(out, k, v));
        if (btn) btn.disabled = true;
        const r = await fetch('/api/data/' + key, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(out),
        }).catch(() => null);
        if (btn) btn.disabled = false;
        if (r && r.ok) { data[key] = out; toast('Profile saved'); }
        else toastError(await reasonFor(r, 'The profile was not saved'));
      });
    });

    // List panels
    document.querySelectorAll('section[data-key][data-fields]').forEach((panel) => {
      const key = panel.dataset.key;
      const fields = JSON.parse(panel.dataset.fields);
      const listEl = panel.querySelector('.lp-list');
      const addForm = panel.querySelector('.lp-form');

      // A panel may target a nested list, e.g. "beltGrading.kyu". Reads take
      // the sub-list; writes POST the whole parent object with that sub-list
      // replaced, because the API stores one value per top-level key.
      const [rootKey, subKey] = key.split('.');
      const readRows = () => (subKey ? (data[rootKey] || {})[subKey] : data[rootKey]) || [];
      const bodyFor = (rows) =>
        subKey ? JSON.stringify({ ...(data[rootKey] || {}), [subKey]: rows }) : JSON.stringify(rows);
      const commit = (rows) => {
        if (subKey) data[rootKey] = { ...(data[rootKey] || {}), [subKey]: rows };
        else data[rootKey] = rows;
      };

      // WHICH ROW IS OPEN FOR EDITING, or -1.
      //
      // One at a time, deliberately. Every write here POSTs the WHOLE array
      // back — the store holds one value per key — so two forms open at once
      // would race, and whichever saved second would silently discard the
      // other's change, with no error anywhere to say so.
      let editIdx = -1;

      // One writer for all four operations. Add, edit, delete and reorder are
      // the same write, and they were not going to stay in step written out
      // four times.
      async function save(rows, okMsg, failMsg) {
        const r = await fetch('/api/data/' + rootKey, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: bodyFor(rows),
        }).catch(() => null);
        if (r && r.ok) { commit(rows); render(); toast(okMsg); return true; }
        toastError(await reasonFor(r, failMsg));
        return false;
      }

      // WHICH HOSTS AN IMAGE MAY ACTUALLY COME FROM.
      //
      // Mirrors img-src in the Content-Security-Policy in vercel.json. A URL
      // from anywhere else is not "probably fine" — the browser REFUSES to
      // load it, on the public site and in here, and the only trace is a
      // console warning no editor will ever read. Pasting a link and seeing
      // nothing appear, with no explanation, is the failure this list exists
      // to turn into a sentence.
      const IMG_HOSTS = ['images.unsplash.com'];
      const IMG_HOST_SUFFIX = '.public.blob.vercel-storage.com';

      function imageFieldLabel(f) {
        // A select or a JSON box is never an image field, whatever it is
        // called. `own` on a gallery row is a Yes/No whose label has to say
        // the word "photograph" to be understood, and that must not make a
        // file picker appear underneath it.
        if (f.type === 'bool' || f.type === 'json') return false;
        return /img|image|photo|thumb|logo|cover/i.test(f.n) || /image|photo/i.test(f.l);
      }

      // null when it is not usable as an image at all; otherwise the URL and
      // whether the policy will let it load.
      function imageInfo(v) {
        const url = String(v == null ? '' : v).trim();
        if (!url) return null;
        if (url.startsWith('/') || url.startsWith('data:')) return { url: url, allowed: true, host: '' };
        let u;
        try { u = new URL(url); } catch (err) { return null; }
        if (u.protocol !== 'https:' && u.protocol !== 'http:') return null;
        const allowed = IMG_HOSTS.indexOf(u.host) >= 0 || u.host.endsWith(IMG_HOST_SUFFIX);
        return { url: url, allowed: allowed, host: u.host };
      }

      function previewHtml(info) {
        if (!info) return '';
        if (!info.allowed) {
          return '<div class="lp-img-warn">This host is not allowed by the site policy, so the image will not load. '
            + 'Allowed: images.unsplash.com, or a file under /public referenced as /name.jpg. '
            + 'Host given: ' + esc(info.host) + '</div>';
        }
        return '<img class="lp-img-prev" src="' + esc(info.url) + '" alt="" loading="lazy" />';
      }

      /**
       * THE CONTROL FOR ONE FIELD, CHOSEN BY THE SHAPE OF THE DATA UNDER IT.
       *
       * Two kinds beyond plain text, and each exists because a text box was the
       * wrong shape for what it was editing:
       *
       *  · `bool` — /gallery reads a row's provenance as `own === true` and
       *    `own === false`, strictly. A text box storing the STRING "true"
       *    satisfies neither test, so the honest label the page prints
       *    ("Federation photograph" / "Illustrative") would vanish with nothing
       *    anywhere to say why. A three-state select keeps the real boolean and
       *    keeps "not stated" as the distinct third answer it already is.
       *
       *  · `json` — a leader's titles, honours, authority and lineage are
       *    lists of objects that /people renders as structured sections. The
       *    panel had NO control for them at all, so the founder's own honours
       *    could be corrected by a developer with a commit and by nobody else.
       *    A validated JSON box is not a beautiful editor. It is an editor, and
       *    it refuses to store anything that would empty the page.
       */
      function controlHtml(f, cid, value) {
        if (f.type === 'bool') {
          const stated = value === true || value === false;
          return '<select class="input" id="' + cid + '" name="' + f.n + '">'
            + '<option value=""' + (stated ? '' : ' selected') + '>Not stated</option>'
            + '<option value="true"' + (value === true ? ' selected' : '') + '>Yes</option>'
            + '<option value="false"' + (value === false ? ' selected' : '') + '>No</option>'
            + '</select>';
        }
        if (f.type === 'json') {
          const text = value === undefined || value === null || value === '' ? '' : JSON.stringify(value, null, 2);
          return '<textarea class="input lp-json" id="' + cid + '" name="' + f.n + '" rows="8" spellcheck="false">' + esc(text) + '</textarea>';
        }
        const v = esc(String(value == null ? '' : value));
        return f.textarea
          ? '<textarea class="input" id="' + cid + '" name="' + f.n + '" rows="3">' + v + '</textarea>'
          : '<input class="input" id="' + cid + '" name="' + f.n + '" type="' + (f.type || 'text') + '" value="' + v + '" />';
      }

      /**
       * Read one field off a submitted form, in the type the store must hold.
       *
       * Returns {ok, value} / {ok, omit} / {error}. A JSON field that will not
       * parse STOPS the save rather than posting the text: writing the raw
       * string back would replace four honours with a sentence, and /people
       * guards on Array.isArray — so the section would render empty and correct
       * and there would be nothing at all to say what had happened.
       */
      function readField(f, fd, previous) {
        let raw = fd.get(f.n);
        if (raw == null) raw = '';
        if (f.type === 'number') return { ok: true, value: Number(raw) || 0 };
        if (f.type === 'bool') {
          if (raw === 'true') return { ok: true, value: true };
          if (raw === 'false') return { ok: true, value: false };
          return { ok: true, omit: true };
        }
        if (f.type === 'json') {
          const text = String(raw).trim();
          if (!text) return { ok: true, omit: true };
          let parsed;
          try {
            parsed = JSON.parse(text);
          } catch (err) {
            return { error: '"' + f.l + '" is not valid JSON — ' + err.message + '. Nothing was saved.' };
          }
          if (parsed === null || typeof parsed !== 'object') {
            return { error: '"' + f.l + '" has to be a list or an object, not a single value. Nothing was saved.' };
          }
          if (previous && typeof previous === 'object' && Array.isArray(previous) !== Array.isArray(parsed)) {
            return {
              error: '"' + f.l + '" is stored as ' + (Array.isArray(previous) ? 'a list' : 'an object')
                + ' and has to stay that way. Nothing was saved.',
            };
          }
          return { ok: true, value: parsed };
        }
        return { ok: true, value: raw };
      }

      function fieldControl(f, value, idx) {
        const cid = panel.id + '-edit-' + idx + '-' + f.n;
        const label = '<label class="input-label" for="' + cid + '">' + esc(f.l) + '</label>';
        const control = controlHtml(f, cid, value);
        // A FILE PICKER BESIDE THE URL BOX, not instead of it. A link to an
        // image somebody else already hosts is still legitimate; what was
        // missing was any way to put a file on this federation's own domain
        // without a developer and a git commit.
        const picker = imageFieldLabel(f) ? pickerHtml(f.n) : '';
        const prev = imageFieldLabel(f) ? slotHtml(f.n, previewHtml(imageInfo(value))) : '';
        return '<div class="' + (f.full ? 'full' : '') + '">' + label + control + picker + prev + '</div>';
      }

      function pickerHtml(name) {
        return '<div class="lp-upload"><label class="lp-upload-btn">Upload a file'
          + '<input type="file" accept="image/jpeg,image/png,image/webp" data-upload-for="' + name + '" hidden />'
          + '</label><span class="lp-upload-note" data-note-for="' + name + '"></span></div>';
      }

      function slotHtml(name, inner) {
        return '<div class="lp-img-slot" data-for="' + name + '">' + (inner || '') + '</div>';
      }

      // ─── A PHOTOGRAPH OFF A PHONE DOES NOT FIT THROUGH THIS CONSOLE ────────
      //
      // /api/uploads/image caps a file at 3 MB, and it says why: a serverless
      // request body is limited to about 4.5 MB and base64 adds a third, so a
      // larger file is cut off by the platform before the route ever sees it —
      // which reaches the browser as a failure with no sentence attached.
      //
      // A current handset writes 4-12 MB per frame. So the ordinary case — take
      // a photograph of the new instructor and put it on the site — was refused
      // every single time, and the only repair the console offered was to go
      // and resize the file somewhere else first. Most people stop there, and
      // reasonably conclude that uploading does not work.
      //
      // The browser can do that resizing, so it does. Nothing here is ever
      // shown larger than a portrait card, and 1600px on the long edge is more
      // than that has ever needed.
      //
      // A FILE THAT ALREADY FITS IS SENT UNTOUCHED. Re-encoding one that was
      // fine would throw away quality for nothing.
      const UPLOAD_FIT_BYTES = 2.4 * 1024 * 1024;

      async function shrinkForUpload(file) {
        if (file.size <= UPLOAD_FIT_BYTES) return file;
        if (typeof createImageBitmap !== 'function') return file;
        let bmp;
        try { bmp = await createImageBitmap(file); } catch (e) { return file; }
        const attempts = [[1600, 0.85], [1200, 0.75], [900, 0.7]];
        try {
          for (let i = 0; i < attempts.length; i++) {
            const edge = attempts[i][0], quality = attempts[i][1];
            const scale = Math.min(1, edge / Math.max(bmp.width, bmp.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.max(1, Math.round(bmp.width * scale));
            canvas.height = Math.max(1, Math.round(bmp.height * scale));
            const ctx = canvas.getContext('2d');
            if (!ctx) return file;
            // A JPEG carries no alpha and an unpainted canvas is transparent
            // black, so a PNG logo with a clear background would arrive as a
            // black rectangle. White is what these sit on.
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(bmp, 0, 0, canvas.width, canvas.height);
            const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
            if (blob && blob.size <= UPLOAD_FIT_BYTES) {
              const base = String(file.name || 'photo').replace(/\.[^.]+$/, '');
              return new File([blob], base + '.jpg', { type: 'image/jpeg' });
            }
          }
          // Three passes and still too large — send the original and let the
          // route say so in its own words rather than guessing at one here.
          return file;
        } finally {
          if (bmp && typeof bmp.close === 'function') bmp.close();
        }
      }

      // The preview follows the field as it is typed, so a wrong host or a
      // broken link is visible before Save rather than after publishing.
      function wirePreviews(scope) {
        scope.querySelectorAll('input, textarea').forEach((el) => {
          const slot = scope.querySelector('.lp-img-slot[data-for="' + el.name + '"]');
          if (!slot) return;
          el.addEventListener('input', () => { slot.innerHTML = previewHtml(imageInfo(el.value)); });
        });
      }

      function wireUploads(scope) {
        scope.querySelectorAll('input[data-upload-for]').forEach((fileEl) => {
          const name = fileEl.dataset.uploadFor;
          const target = scope.querySelector('[name="' + name + '"]');
          const note = scope.querySelector('.lp-upload-note[data-note-for="' + name + '"]');
          const slot = scope.querySelector('.lp-img-slot[data-for="' + name + '"]');
          const say = (msg, bad) => {
            if (!note) return;
            note.textContent = msg;
            if (bad) note.classList.add('is-error'); else note.classList.remove('is-error');
          };
          fileEl.addEventListener('change', async () => {
            const picked = fileEl.files && fileEl.files[0];
            if (!picked) return;
            say('Preparing ' + picked.name + '...', false);
            const file = await shrinkForUpload(picked).catch(() => picked);
            const resized = file !== picked;
            say('Uploading ' + picked.name
              + (resized ? ' - resized to ' + (file.size / 1048576).toFixed(1) + ' MB' : '') + '...', false);
            const dataUrl = await new Promise((resolve, reject) => {
              const fr = new FileReader();
              fr.onload = () => resolve(String(fr.result || ''));
              fr.onerror = () => reject(fr.error);
              fr.readAsDataURL(file);
            }).catch(() => null);
            if (!dataUrl) { say('That file could not be read.', true); fileEl.value = ''; return; }
            const res = await fetch('/api/uploads/image', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ filename: file.name, contentType: file.type, data: dataUrl }),
            }).catch(() => null);
            const payload = res ? await res.json().catch(() => null) : null;
            if (res && res.ok && payload && payload.url) {
              // The field is filled in for the operator; the row is NOT saved
              // yet. Storing a file and publishing it are two decisions, and
              // Save is still the one that publishes.
              if (target) target.value = payload.url;
              if (slot) slot.innerHTML = previewHtml(imageInfo(payload.url));
              say(resized
                ? 'Uploaded, resized to fit. Press Save to publish it.'
                : 'Uploaded. Press Save to publish it.', false);
            } else {
              say(reasonFrom(res, payload, 'The file was not stored'), true);
            }
            fileEl.value = '';
          });
        });
      }

      // THE "ADD NEW" FORM HAD NO PICKER AT ALL.
      //
      // Only the edit form is built in JavaScript, so only the edit form got
      // one. A new instructor, event or news item could therefore be given a
      // photograph only by being saved without one and then opened again —
      // which is not a sequence anybody discovers, and reads exactly like "I
      // cannot upload a picture here".
      //
      // The markup is grafted on from the same field list the panel already
      // carries, so both forms behave identically and there is one
      // implementation of the upload rather than two that drift apart.
      function graftAddPickers() {
        if (!addForm) return;
        fields.filter(imageFieldLabel).forEach((f) => {
          const input = addForm.querySelector('[name="' + f.n + '"]');
          const cell = input && input.parentNode;
          if (!cell || cell.querySelector('.lp-upload')) return;
          cell.insertAdjacentHTML('beforeend', pickerHtml(f.n) + slotHtml(f.n, ''));
        });
        wirePreviews(addForm);
        wireUploads(addForm);
      }

      function clearAddPreviews() {
        if (!addForm) return;
        addForm.querySelectorAll('.lp-img-slot').forEach((el) => { el.innerHTML = ''; });
        addForm.querySelectorAll('.lp-upload-note').forEach((el) => {
          el.textContent = '';
          el.classList.remove('is-error');
        });
      }

      function render() {
        const rows = readRows();
        listEl.innerHTML = rows.map((r, i) => {
          // THE ROW BEING EDITED BECOMES THE FORM, in place. Not a modal: the
          // rest of this console asks as little of JavaScript as it can, and a
          // dialog needs focus trapping and an escape route before it is usable
          // by anybody on a keyboard.
          if (i === editIdx) {
            return '<form class="lp-item lp-edit" data-idx="' + i + '" style="display:block">'
              + '<div class="lp-form-grid">' + fields.map((f) => fieldControl(f, r[f.n], i)).join('') + '</div>'
              + '<div style="margin-top:14px;display:flex;gap:10px">'
              + '<button type="submit" class="btn btn-primary">Save</button>'
              + '<button type="button" class="btn btn-ghost lp-btn-cancel">Cancel</button>'
              + '</div></form>';
          }
          const main = fields.length ? fields[0].n : '';
          // Structured fields are skipped here on purpose: String() on a list
          // of honours produces "[object Object],[object Object]", which is
          // worse than saying nothing.
          const secondary = fields
            .filter((f, idx) => idx > 0 && f.type !== 'json' && r[f.n] !== undefined && r[f.n] !== '' && typeof r[f.n] !== 'object')
            .map((f) => esc(String(r[f.n]).slice(0, 70)))
            .slice(0, 3)
            .join(' · ');
          const thumbField = fields.filter(imageFieldLabel)[0];
          const thumb = thumbField ? imageInfo(r[thumbField.n]) : null;
          return '<div class="lp-item">'
            + (thumb && thumb.allowed ? '<img class="lp-thumb" src="' + esc(thumb.url) + '" alt="" loading="lazy" />' : '')
            + '<div class="lp-item-body">'
            + '<div class="lp-item-name">' + esc(String(r[main] == null ? '' : r[main])) + '</div>'
            + '<div class="lp-item-meta">' + secondary + '</div>'
            + '</div>'
            + '<div class="lp-item-actions">'
            + '<button class="lp-btn-move" data-idx="' + i + '" data-dir="-1" title="Move up" aria-label="Move up"' + (i === 0 ? ' disabled' : '') + '>&uarr;</button>'
            + '<button class="lp-btn-move" data-idx="' + i + '" data-dir="1" title="Move down" aria-label="Move down"' + (i === rows.length - 1 ? ' disabled' : '') + '>&darr;</button>'
            + '<button class="lp-btn-edit" data-idx="' + i + '">Edit</button>'
            + '<button class="lp-btn-del" data-idx="' + i + '">Delete</button>'
            + '</div></div>';
        }).join('');

        listEl.querySelectorAll('button.lp-btn-edit').forEach((b) => {
          b.addEventListener('click', () => { editIdx = +b.dataset.idx; render(); });
        });

        listEl.querySelectorAll('button.lp-btn-cancel').forEach((b) => {
          b.addEventListener('click', () => { editIdx = -1; render(); });
        });

        // ORDER IS CONTENT. These arrays render in order on the public site, so
        // without this the only way to move an entry was to delete it and retype
        // it — which is how a phone number gets lost.
        listEl.querySelectorAll('button.lp-btn-move').forEach((b) => {
          b.addEventListener('click', async () => {
            const idx = +b.dataset.idx;
            const to = idx + (+b.dataset.dir);
            const next = readRows().slice();
            if (to < 0 || to >= next.length) return;
            const moved = next.splice(idx, 1)[0];
            next.splice(to, 0, moved);
            b.disabled = true;
            editIdx = -1;
            await save(next, 'Moved', 'Move failed');
          });
        });

        const editForm = listEl.querySelector('form.lp-edit');
        if (editForm) {
          editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const idx = +editForm.dataset.idx;
            const fd = new FormData(editForm);
            const next = readRows().slice();
            // SPREAD THE EXISTING ROW FIRST. These objects carry keys this panel
            // never renders — ids, image paths, flags set elsewhere — and
            // rebuilding from the form alone would drop every one of them.
            const item = Object.assign({}, next[idx]);
            const before = next[idx] || {};
            let refusal = null;
            fields.forEach((f) => {
              const read = readField(f, fd, before[f.n]);
              if (read.error) { refusal = refusal || read.error; return; }
              if (read.omit) delete item[f.n];
              else item[f.n] = read.value;
            });
            // A REFUSAL LEAVES THE FORM EXACTLY WHERE IT IS — open, with the
            // operator's typing still in it, and nothing posted.
            if (refusal) { toastError(refusal); return; }
            next[idx] = item;
            const btn = editForm.querySelector('button[type=submit]');
            if (btn) btn.disabled = true;
            editIdx = -1;
            const ok = await save(next, 'Saved', 'Save failed');
            // A failed save must not look like a cancelled one: the form comes
            // back with the operator's typing still in it.
            if (!ok) { editIdx = idx; render(); }
          });
          wirePreviews(editForm);
          wireUploads(editForm);
          const first = editForm.querySelector('input, textarea');
          if (first) first.focus();
        }

        listEl.querySelectorAll('button.lp-btn-del').forEach((b) => {
          b.addEventListener('click', async () => {
            if (!confirm('Delete this item?')) return;
            const idx = +b.dataset.idx;
            const next = readRows().slice();
            next.splice(idx, 1);
            b.disabled = true;
            editIdx = -1;
            await save(next, 'Deleted', 'Delete failed');
          });
        });
      }

      addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = addForm.querySelector('button[type=submit]');
        const fd = new FormData(addForm);
        const item = {};
        let refusal = null;
        fields.forEach((f) => {
          const read = readField(f, fd, undefined);
          if (read.error) { refusal = refusal || read.error; return; }
          if (!read.omit) item[f.n] = read.value;
        });
        if (refusal) { toastError(refusal); return; }
        if (key === 'news') item.id = Date.now();
        if (key === 'products') item.id = Date.now();
        const rows = readRows().slice();
        rows.unshift(item);
        if (btn) btn.disabled = true;
        const r = await fetch('/api/data/' + rootKey, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: bodyFor(rows),
        }).catch(() => null);
        if (btn) btn.disabled = false;
        if (r && r.ok) {
          commit(rows);
          addForm.reset();
          clearAddPreviews();
          render();
          toast('Added');
        } else {
          toastError(await reasonFor(r, 'Nothing was added'));
        }
      });

      graftAddPickers();
      render();
    });

    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  </script>
)}
