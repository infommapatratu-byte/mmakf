---
// THE NATIONAL COMMAND CENTRE — Q-18.
//
// One screen that answers two questions for the federation office: what does
// the register currently say, and what work is outstanding.
//
// WHAT THIS PAGE IS NOT: it is not a summary, an estimate, a projection or a
// roll-up of anything cached. Every figure below is a COUNT OF ROWS produced by
// src/db/analytics.ts, and every one carries the table and the WHERE clause
// that produced it — printed on the page under "How this was counted", so a
// reader who doubts a total can reconstruct it against the database.
//
// THREE RULES THAT OUTRANK THE LAYOUT:
//
//  1. ZERO IS SHOWN AS ZERO. An empty federation shows zeros, and that is the
//     honest answer on day one. Nothing here hides an empty state.
//  2. A FIGURE THAT WAS NOT PRODUCED IS NOT A ZERO. analytics.ts withholds a
//     figure when the caller may not read the rows behind it, and every such
//     withholding is rendered with its reason instead of a number.
//  3. NO DATABASE, NO PAGE. When DATABASE_URL is unset there are no rows to
//     count, so this page says so and renders nothing else. A grid of zeros
//     drawn against a database that does not exist would be a fabricated
//     measurement, which is the one defect this project treats as unforgivable.
//
// The DATA QUALITY panel is deliberately placed above the totals. A count of
// 4,900 members means nothing if 3,000 of them have no date of birth, so the
// federation is told how trustworthy its own numbers are before it is told what
// they are.

import Base from '@/layouts/Base.astro';
import StatCard from '@/components/StatCard.astro';
import DataTable from '@/components/DataTable.astro';
import { identify } from '@/lib/session';
import { ForbiddenError } from '@/lib/rbac';
import { isConfigured, db } from '@/db';
import {
  nationalDashboard,
  dataQuality,
  type Dashboard,
  type DataQualityReport,
  type Source,
} from '@/db/analytics';
import { pendingApprovals, type PendingApprovalQueue } from '@/lib/approvals';
import { expiringLicences } from '@/db/officials';
import { QUEUES, queueSummary, type QueueName } from '@/lib/queue';

export const prerender = false;

// identify() is the only way this page learns who is asking (§75). A user
// cookie that no longer resolves returns null rather than falling back to a
// shared credential, so a revoked account lands on the sign-in prompt.
const identity = await identify(Astro.request.headers.get('cookie'));
const configured = isConfigured();

// ─── Panel state ────────────────────────────────────────────────────────────
//
// Each module call can end three ways and the page has to distinguish them: it
// worked, the caller is not allowed, or it failed. Collapsing the last two into
// an empty table would report "no records" for rows that exist and are merely
// out of reach — a lie the reader has no way to detect.

type Panel<T> =
  | { state: 'ready'; value: T; message: null }
  | { state: 'denied'; value: null; message: string }
  | { state: 'error'; value: null; message: string };

/** Error classes whose messages were written to be read by a human. */
const SPEAKING_ERRORS = new Set([
  'AnalyticsError', 'OfficialsError', 'ApprovalError', 'QueueError', 'CompetitionError',
]);

async function attempt<T>(what: string, fn: () => Promise<T>): Promise<Panel<T>> {
  try {
    return { state: 'ready', value: await fn(), message: null };
  } catch (err: any) {
    if (err instanceof ForbiddenError) {
      return {
        state: 'denied',
        value: null,
        message:
          `Reading ${what} requires the "${err.action}" authority, which this credential does not hold ` +
          'in any scope. Records may well exist here; they are simply not yours to read.',
      };
    }
    if (err && SPEAKING_ERRORS.has(String(err.name)) && typeof err.message === 'string') {
      return { state: 'error', value: null, message: err.message };
    }
    // Never leak a stack trace to the browser; the server log keeps the detail.
    console.error(`[admin/command] ${what} failed`, err);
    return {
      state: 'error',
      value: null,
      message:
        `${what} could not be read. Nothing is shown rather than a zero that would look like a ` +
        'measurement. The failure is in this deployment’s server log.',
    };
  }
}

let national: Panel<Dashboard> | null = null;
let quality: Panel<DataQualityReport> | null = null;
let approvals: Panel<PendingApprovalQueue> | null = null;
let licences: Panel<Array<Record<string, unknown>>> | null = null;
let queues: Array<{ name: QueueName; label: string; open: number | null; total: number | null; error: string | null }> = [];

if (identity && configured) {
  const principal = identity.principal;
  const conn = db();

  national = await attempt('the national dashboard', () => nationalDashboard(conn, principal));
  quality = await attempt('the data-quality report', () => dataQuality(conn, principal, { kind: 'national' }));
  approvals = await attempt('the two-person approval queue', () => pendingApprovals(conn, principal, { limit: 50 }));
  // expiringLicences() gates on `user:read` held ANYWHERE and applies no scope
  // filter of its own, so it is a national list by construction. That is why it
  // appears here and not on the scoped dashboard.
  licences = await attempt('expiring officials’ licences', () => expiringLicences(conn, principal, 90));

  // The three editorial queues are Redis-backed and independent of the register
  // above. They are shown because "open work" is not open work until every
  // source of it is on one screen.
  queues = await Promise.all(
    (Object.keys(QUEUES) as QueueName[]).map(async (name) => {
      const meta = QUEUES[name];
      try {
        const summary = await queueSummary(name);
        const total = Object.values(summary).reduce((n, v) => n + (v || 0), 0);
        const closed = (meta.terminal as readonly string[]).reduce((n, s) => n + (summary[s] ?? 0), 0);
        return { name, label: meta.label, open: total - closed, total, error: null };
      } catch (err) {
        console.error(`[admin/command] queue ${name} failed`, err);
        return { name, label: meta.label, open: null, total: null, error: 'This queue could not be read.' };
      }
    })
  );
}

// ─── Reading a figure out of the dashboard ──────────────────────────────────
//
// `counts` carries what was measured and `withheld` carries what was not, with
// the reason. This joins the two so a missing key can never silently render as
// a zero.

interface Figure {
  value: number | null;
  unavailable: string | null;
  source: Source | null;
}

function figure(d: Dashboard | null, key: string): Figure {
  if (!d) {
    return { value: null, unavailable: 'The dashboard was not produced for this request.', source: null };
  }
  const withheld = d.withheld.find((w) => w.key === key);
  if (withheld) return { value: null, unavailable: withheld.detail, source: null };
  if (!(key in d.counts)) {
    return {
      value: null,
      unavailable: `analytics.ts produced no figure called "${key}" and gave no reason. Report this.`,
      source: null,
    };
  }
  return { value: d.counts[key], unavailable: null, source: d.sources[key] ?? null };
}

const dash = national?.state === 'ready' ? national.value : null;

/** A grouped breakdown, rendered as rows rather than as an unlabelled chart. */
function statusRows(counts: Record<string, number>): Array<Record<string, unknown>> {
  return Object.entries(counts)
    .map(([status, count]) => ({ status, count }))
    .sort((a, b) => Number(b.count) - Number(a.count) || String(a.status).localeCompare(String(b.status)));
}

const dojoStatusRows = dash ? statusRows(dash.dojosByStatus) : [];
const eventStatusRows = dash ? statusRows(dash.eventsByStatus) : [];

/**
 * Events whose results are still open.
 *
 * Read out of the zero-filled `eventsByStatus` breakdown rather than counted
 * again here, so the headline and the table below it can never disagree. The
 * key's PRESENCE is tested rather than defaulted with `?? 0`: analytics.ts
 * zero-fills every value the enum permits, so a missing key would mean the
 * breakdown was not produced — and answering that with a 0 is exactly the
 * invented measurement this page exists to avoid.
 */
const eventsWithheld = dash?.withheld.find((w) => w.key === 'eventsByStatus') ?? null;
const resultsPending: Figure = !dash
  ? { value: null, unavailable: 'The dashboard was not produced for this request.', source: null }
  : eventsWithheld
    ? { value: null, unavailable: eventsWithheld.detail, source: null }
    : 'results_pending' in dash.eventsByStatus
      ? { value: dash.eventsByStatus['results_pending'], unavailable: null, source: dash.sources.eventsByStatus ?? null }
      : {
          value: null,
          source: null,
          unavailable: 'The event-status breakdown carried no results_pending bucket, so this figure was not measured.',
        };

const qualityRows =
  quality?.state === 'ready'
    ? quality.value.items.map((i) => ({
        check: i.description,
        count: i.count,
        total: i.total,
        table: i.source.table,
        filter: i.source.filter,
      }))
    : [];

// The gaps that are actually biting, ordered by size. A zero is still listed in
// the table above — this only decides which get a card.
const topGaps =
  quality?.state === 'ready'
    ? [...quality.value.items].sort((a, b) => b.count - a.count).slice(0, 4)
    : [];

const approvalRows =
  approvals?.state === 'ready'
    ? approvals.value.items.map((i) => ({
        request: i.label,
        action: i.action,
        requires: i.requires,
        requestedBy: i.requester.label,
        requestedAt: i.requestedAt.slice(0, 16).replace('T', ' '),
        agreed: `${i.approvals.length} of ${i.approvalsRequired}`,
        expires: i.expiry.configured ? i.expiry.expiresAt : 'No window set by the federation',
      }))
    : [];

const licenceRows =
  licences?.state === 'ready'
    ? licences.value.map((r: any) => ({
        registry: r.registry,
        person: r.fullName,
        federationId: r.federationId,
        level: r.level,
        expiresOn: r.expiresOn,
        daysRemaining: r.daysRemaining,
        standing: r.lapsed ? 'LAPSED' : 'Expiring',
      }))
    : [];

const lapsedCount =
  licences?.state === 'ready' ? licences.value.filter((r: any) => r.lapsed).length : null;

const queueOpenTotal = queues.length && queues.every((q) => q.open != null)
  ? queues.reduce((n, q) => n + (q.open ?? 0), 0)
  : null;

const signedInAs = identity
  ? identity.shared
    ? `${identity.principal.label} — shared credential (${identity.via}), not attributable to a person`
    : `${identity.principal.label} — personal account #${identity.userId}`
  : '';

const NAV = [
  { href: '#open-work', label: 'Open work' },
  { href: '#data-quality', label: 'Data quality' },
  { href: '#membership', label: 'Membership' },
  { href: '#units', label: 'Units' },
  { href: '#grading', label: 'Grading & certificates' },
  { href: '#competition', label: 'Competition' },
  { href: '#academy', label: 'Academy' },
  { href: '#casework', label: 'Casework' },
  { href: '#health', label: 'System health' },
];
---

<Base title="MMAKF Admin — National Command Centre" showNav={false} showFooter={false}>
  {!identity ? (
    <section style="min-height:90vh;display:flex;align-items:center;justify-content:center;padding:64px 24px">
      <div style="width:100%;max-width:420px">
        <div style="text-align:center;margin-bottom:36px">
          <div style="font-family:var(--font-display);font-size:1.8rem;font-weight:700;letter-spacing:.06em">MMAKF</div>
          <div style="font-family:var(--font-display);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-top:6px">National Command Centre</div>
        </div>
        <form id="loginForm" class="card" style="padding:32px">
          <h1 class="card-title" style="font-size:1.2rem;margin-bottom:24px">Sign in</h1>

          <label class="input-label" for="login-email">Email address</label>
          <input class="input" type="email" id="login-email" name="email" autocomplete="username"
                 autocapitalize="off" autocorrect="off" spellcheck="false" autofocus
                 placeholder="you@mmakf.in" />

          <label class="input-label" for="login-password" style="margin-top:14px">Password</label>
          <input class="input" type="password" id="login-password" name="password"
                 autocomplete="current-password" required />

          <div id="loginErr" role="alert" style="color:var(--red-2);font-size:.85rem;margin-top:12px;display:none"></div>
          <button type="submit" class="btn btn-primary" style="width:100%;margin-top:20px;justify-content:center;min-height:44px">Sign in</button>

          <p style="margin-top:20px;font-size:.75rem;color:var(--muted);text-align:center;line-height:1.6">
            Authorised personnel only. Every figure on this screen is read under the authority of the
            credential you sign in with.
          </p>
        </form>
      </div>
    </section>
  ) : (
    <div class="admin-wrap">
      <aside class="admin-side">
        <div class="admin-brand">
          <div class="admin-brand-1">MMAKF</div>
          <div class="admin-brand-2">Command Centre</div>
        </div>
        <nav class="admin-nav" aria-label="Sections">
          {configured && NAV.map((n) => (<a href={n.href}>{n.label}</a>))}
          <a href="/admin/dashboard" style="margin-top:12px">Scoped dashboard →</a>
          <a href="/admin/queue">Approval queue →</a>
          <a href="/admin">Content admin →</a>
        </nav>
        <div style="padding:16px;border-top:1px solid var(--border)">
          <button class="btn btn-ghost" style="width:100%;justify-content:center;min-height:44px" id="logoutBtn">Logout</button>
          <a href="/" target="_blank" rel="noopener" class="btn-link" style="display:flex;align-items:center;justify-content:center;min-height:44px;margin-top:6px">View Site →</a>
        </div>
      </aside>

      <main class="admin-main">
        <header class="admin-panel" style="padding-top:0">
          <h1 class="admin-h">National command centre</h1>
          <p class="admin-sub">
            Every number on this page is a count of rows in the federation register, produced by
            <code>src/db/analytics.ts</code>, with the table and the filter that produced it printed
            beneath it. Nothing is estimated, projected, rounded or carried over. A figure this
            credential may not read is shown as a withholding with its reason, never as a zero.
          </p>
          <p class="q-signed">Signed in as {signedInAs}</p>
        </header>

        {!configured ? (
          <section class="admin-panel">
            <h2 class="admin-h">The federation database is not configured</h2>
            <div class="q-warn" role="alert" style="margin-top:18px">
              <strong>There is nothing to count.</strong>
              <p style="margin-top:10px">
                <code>DATABASE_URL</code> is not set for this deployment, so the register that every
                figure on this page is counted from does not exist here. The command centre renders
                no figures at all rather than a grid of zeros: a zero drawn against an absent
                database is indistinguishable from a real measurement of an empty federation, and
                the difference matters more than the layout.
              </p>
              <p style="margin-top:10px">
                Set <code>DATABASE_URL</code>, run the migrations, and reload. The provisioning
                runbook is <code>docs/FEDERATION-ARCHITECTURE.md §10.1</code>; live status is at
                <a href="/api/health" style="color:var(--red-2);text-decoration:underline">/api/health</a>.
              </p>
            </div>
            <p class="admin-sub" style="margin-top:18px">
              The Redis-backed editorial queues do not depend on the register and are still workable
              at <a href="/admin/queue" style="color:var(--gold-2)">the approval queue</a>.
            </p>
          </section>
        ) : national && national.state !== 'ready' ? (
          <section class="admin-panel">
            <h2 class="admin-h">This view is not open to your credential</h2>
            <p class="admin-sub" role="alert" style="margin-top:12px">{national.message}</p>
            <p class="admin-sub" style="margin-top:14px">
              The national totals require a national binding — that is the check that stops a state
              administrator reading the federation's figures. Your own scope is on the
              <a href="/admin/dashboard" style="color:var(--gold-2)"> scoped dashboard</a>, which
              shows the same measurements narrowed to the units you hold authority over.
            </p>
          </section>
        ) : (
          <>
            {/* ── OPEN WORK ─────────────────────────────────────────────── */}
            <section id="open-work" class="admin-panel">
              <h2 class="admin-h">Open work</h2>
              <p class="admin-sub">
                What the federation currently owes a decision on. Each figure is counted where the
                work actually lives, not aggregated into a single invented "tasks" number.
              </p>

              <div class="cmd-grid" style="margin-top:22px">
                <StatCard
                  label="Approvals awaiting a second person"
                  value={approvals?.state === 'ready' ? approvals.value.items.length : null}
                  unavailable={approvals && approvals.state !== 'ready' ? approvals.message : null}
                  tone="attention"
                  href="/admin/queue"
                  hrefLabel="Approval queue"
                  note={approvals?.state === 'ready' ? approvals.value.note : null}
                />
                <StatCard
                  label="Queue items awaiting a decision"
                  value={queueOpenTotal}
                  unavailable={queueOpenTotal == null ? 'At least one editorial queue could not be read, so no total is offered — a partial sum presented as a total would understate the work outstanding.' : null}
                  tone="attention"
                  href="/admin/queue"
                  hrefLabel="Work the queues"
                  note="Membership applications, event entries and unit submissions, held in the editorial store rather than the register."
                />
                <StatCard
                  label="Officials' licences lapsed or lapsing within 90 days"
                  value={licences?.state === 'ready' ? licences.value.length : null}
                  unavailable={licences && licences.state !== 'ready' ? licences.message : null}
                  tone="attention"
                  note={lapsedCount != null ? `${lapsedCount} of these have already lapsed. A lapsed official still appearing on an appointment list is how an invalid act happens.` : null}
                />
                <StatCard
                  label="Events awaiting final results"
                  value={resultsPending.value}
                  unavailable={resultsPending.unavailable}
                  source={resultsPending.source}
                  tone="attention"
                  note="Counted as competition_events whose status is results_pending. An event whose results are still open cannot feed a ranking."
                />
              </div>

              <div class="cmd-tables">
                <DataTable
                  caption="Editorial queues"
                  columns={[
                    { key: 'label', label: 'Queue', min: '200px' },
                    { key: 'open', label: 'Awaiting a decision', numeric: true },
                    { key: 'total', label: 'In the register', numeric: true },
                    { key: 'error', label: 'Note', min: '160px' },
                  ]}
                  rows={queues.map((q) => ({ label: q.label, open: q.open, total: q.total, error: q.error }))}
                  emptyMessage="No queues are declared in src/lib/queue.ts."
                  note="Held in the editorial store (Redis), not in the federation register — which is why these counts carry no table-and-filter provenance."
                />

                <DataTable
                  caption="Approvals awaiting a second person"
                  state={approvals?.state ?? 'error'}
                  errorMessage={approvals?.state === 'error' ? approvals.message : null}
                  deniedMessage={approvals?.state === 'denied' ? approvals.message : null}
                  columns={[
                    { key: 'request', label: 'Request', min: '220px' },
                    { key: 'requires', label: 'Authority required' },
                    { key: 'requestedBy', label: 'Raised by', min: '140px' },
                    { key: 'requestedAt', label: 'Raised at' },
                    { key: 'agreed', label: 'Agreed' },
                    { key: 'expires', label: 'Expires', min: '180px' },
                  ]}
                  rows={approvalRows}
                  emptyMessage="No request is waiting on you. Requests you raised yourself are excluded by design — two-person control needs two people."
                  incompleteMessage={approvals?.state === 'ready' && !approvals.value.complete ? approvals.value.note : null}
                />

                <DataTable
                  caption="Officials' licences lapsed or lapsing within 90 days"
                  state={licences?.state ?? 'error'}
                  errorMessage={licences?.state === 'error' ? licences.message : null}
                  deniedMessage={licences?.state === 'denied' ? licences.message : null}
                  columns={[
                    { key: 'standing', label: 'Standing' },
                    { key: 'registry', label: 'Registry' },
                    { key: 'person', label: 'Person', min: '180px' },
                    { key: 'federationId', label: 'Federation ID', min: '140px' },
                    { key: 'level', label: 'Level' },
                    { key: 'expiresOn', label: 'Expires on' },
                    { key: 'daysRemaining', label: 'Days', numeric: true },
                  ]}
                  rows={licenceRows}
                  emptyMessage="No instructor, examiner or official licence lapses within the next 90 days."
                  note="Already-lapsed licences are listed first and deliberately included: those are the dangerous ones. This list is national — officials.expiringLicences() applies no unit filter."
                  source={{ table: 'instructor_quals, examiner_quals, official_quals', column: 'expires_on', filter: "status = 'active' and expires_on <= today + 90 days" }}
                />
              </div>
            </section>

            {/* ── DATA QUALITY ──────────────────────────────────────────── */}
            <section id="data-quality" class="admin-panel">
              <h2 class="admin-h">Data quality — how trustworthy are these numbers?</h2>
              <p class="admin-sub">
                The most valuable panel on this page, and the reason it sits above the totals rather
                than below them. Everything further down tells the federation what the register says;
                this tells it how much of the register is missing. A membership count means nothing
                if the people counted have no date of birth, because every age-gated figure derived
                from them is guesswork.
                <br />
                No percentage is offered. A percentage is a float, and this codebase does not put
                floats in front of federation decisions — each check reports the gap and the
                population it was measured against, so the reader can judge proportion themselves.
              </p>

              {topGaps.length > 0 && (
                <div class="cmd-grid" style="margin-top:22px">
                  {topGaps.map((g) => (
                    <StatCard
                      label={g.key.replace(/([A-Z])/g, ' $1').replace(/^./, (c) => c.toUpperCase())}
                      value={g.count}
                      outOf={g.total}
                      tone="attention"
                      note={g.description}
                      source={g.source}
                    />
                  ))}
                </div>
              )}

              <div class="cmd-tables">
                <DataTable
                  caption="Every data-quality check, national scope"
                  state={quality?.state ?? 'error'}
                  errorMessage={quality?.state === 'error' ? quality.message : null}
                  deniedMessage={quality?.state === 'denied' ? quality.message : null}
                  columns={[
                    { key: 'check', label: 'What is missing, and why it matters', min: '340px' },
                    { key: 'count', label: 'Rows with the gap', numeric: true },
                    { key: 'total', label: 'Rows examined', numeric: true },
                    { key: 'table', label: 'Table', min: '150px' },
                    { key: 'filter', label: 'Filter', min: '260px' },
                  ]}
                  rows={qualityRows}
                  emptyMessage="analytics.dataQuality() returned no checks for this scope."
                />
              </div>

              {quality?.state === 'ready' && quality.value.withheld.length > 0 && (
                <div class="cmd-tables">
                  <DataTable
                    caption="Checks that could not be run at this scope"
                    columns={[
                      { key: 'key', label: 'Check', min: '220px' },
                      { key: 'reason', label: 'Reason' },
                      { key: 'detail', label: 'Detail', min: '320px' },
                    ]}
                    rows={quality.value.withheld.map((w) => ({ key: w.key, reason: w.reason, detail: w.detail }))}
                  />
                </div>
              )}
            </section>

            {/* ── MEMBERSHIP ────────────────────────────────────────────── */}
            <section id="membership" class="admin-panel">
              <h2 class="admin-h">Membership</h2>
              <p class="admin-sub">People on the register, and the credentials they currently hold.</p>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="People on the register" {...figure(dash, 'people')} />
                <StatCard label="People with status active" {...figure(dash, 'peopleActive')} />
                <StatCard label="People holding an active membership" {...figure(dash, 'membersActive')} />
                <StatCard label="Athletes" {...figure(dash, 'athletes')} />
                <StatCard label="Instructors with a current licence" {...figure(dash, 'instructors')} />
                <StatCard label="Examiners with a current licence" {...figure(dash, 'examiners')} />
                <StatCard label="Officials with a current licence" {...figure(dash, 'officials')} />
              </div>
            </section>

            {/* ── UNITS ─────────────────────────────────────────────────── */}
            <section id="units" class="admin-panel">
              <h2 class="admin-h">Units and dojos</h2>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="State units" {...figure(dash, 'stateUnits')} />
                <StatCard label="State units active" {...figure(dash, 'stateUnitsActive')} />
                <StatCard label="District units" {...figure(dash, 'districtUnits')} />
                <StatCard label="District units active" {...figure(dash, 'districtUnitsActive')} />
                <StatCard label="Dojos" {...figure(dash, 'dojos')} />
              </div>

              <div class="cmd-tables">
                <DataTable
                  caption="Dojos by status"
                  columns={[
                    { key: 'status', label: 'Status', min: '160px' },
                    { key: 'count', label: 'Dojos', numeric: true },
                  ]}
                  rows={dojoStatusRows}
                  emptyMessage="No dojo status breakdown was produced for the national scope."
                  note="Every status the schema permits is listed, including those nobody currently holds — an explicit 0 is a measurement, a missing row is a gap the reader would fill in for themselves."
                  source={dash?.sources.dojosByStatus ?? null}
                />
              </div>
            </section>

            {/* ── GRADING ───────────────────────────────────────────────── */}
            <section id="grading" class="admin-panel">
              <h2 class="admin-h">Grading and certificates</h2>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="Grading events recorded" {...figure(dash, 'gradingEvents')} />
                <StatCard label="Gradings with results locked" {...figure(dash, 'gradingsHeld')} note="Locked is the only status that evidences a completed examination whose results can no longer change." />
                <StatCard label="Grading candidates" {...figure(dash, 'gradingCandidates')} />
                <StatCard label="Candidates passed" {...figure(dash, 'gradingCandidatesPassed')} />
                <StatCard label="Certificates" {...figure(dash, 'certificates')} />
                <StatCard label="Certificates in issue" {...figure(dash, 'certificatesInIssue')} />
                <StatCard label="Certificates revoked" {...figure(dash, 'certificatesRevoked')} tone="attention" />
              </div>
            </section>

            {/* ── COMPETITION ───────────────────────────────────────────── */}
            <section id="competition" class="admin-panel">
              <h2 class="admin-h">Competition</h2>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="Competition events" {...figure(dash, 'competitionEvents')} />
                <StatCard label="Entries" {...figure(dash, 'entries')} />
                <StatCard label="Entries confirmed" {...figure(dash, 'entriesConfirmed')} />
                <StatCard label="Matches" {...figure(dash, 'matches')} />
                <StatCard label="Matches completed" {...figure(dash, 'matchesCompleted')} />
                <StatCard label="Results final" {...figure(dash, 'resultsFinal')} />
              </div>

              <div class="cmd-tables">
                <DataTable
                  caption="Events by status"
                  columns={[
                    { key: 'status', label: 'Status', min: '190px' },
                    { key: 'count', label: 'Events', numeric: true },
                  ]}
                  rows={eventStatusRows}
                  emptyMessage="No event status breakdown was produced for the national scope."
                  note="The whole event lifecycle, zero-filled. Rows are not drawn as a chart: with an empty register a chart would be an empty axis, which reads as a measurement rather than as an absence."
                  source={dash?.sources.eventsByStatus ?? null}
                />
              </div>
            </section>

            {/* ── ACADEMY ───────────────────────────────────────────────── */}
            <section id="academy" class="admin-panel">
              <h2 class="admin-h">Academy</h2>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="Courses" {...figure(dash, 'courses')} />
                <StatCard label="Courses published" {...figure(dash, 'coursesPublished')} />
                <StatCard label="Enrolments" {...figure(dash, 'enrolments')} />
                <StatCard label="Enrolments active" {...figure(dash, 'enrolmentsActive')} />
                <StatCard label="Enrolments completed" {...figure(dash, 'enrolmentsCompleted')} />
              </div>
            </section>

            {/* ── CASEWORK ──────────────────────────────────────────────── */}
            <section id="casework" class="admin-panel">
              <h2 class="admin-h">Casework and member support</h2>
              <p class="admin-sub">
                Counted as cases with <strong>no recorded ending</strong>, not as "open cases". MMAKF
                has not defined which statuses close a case — the enum has decided, appealed and
                appeal-heard between the start and closed — and publishing one of the answers under
                the heading "open" would be reporting a rule nobody set as though it were a
                measurement. Each figure is separately gated: a count of cases in one small dojo can
                identify the individual as surely as the file does.
              </p>
              <div class="cmd-grid" style="margin-top:22px">
                <StatCard label="Disciplinary cases with no recorded ending" {...figure(dash, 'casesNotClosed.disciplinary')} tone="attention" />
                <StatCard label="Safeguarding cases with no recorded ending" {...figure(dash, 'casesNotClosed.safeguarding')} tone="attention" />
                <StatCard label="Support tickets not resolved or closed" {...figure(dash, 'supportTicketsNotClosed')} tone="attention" />
              </div>

              {dash && dash.withheld.length > 0 && (
                <div class="cmd-tables">
                  <DataTable
                    caption="Figures withheld from this credential"
                    columns={[
                      { key: 'key', label: 'Figure', min: '220px' },
                      { key: 'reason', label: 'Reason' },
                      { key: 'detail', label: 'Detail', min: '320px' },
                    ]}
                    rows={dash.withheld.map((w) => ({ key: w.key, reason: w.reason, detail: w.detail }))}
                    note="Withheld is not zero. These rows exist in the register; this credential may not count them."
                  />
                </div>
              )}
            </section>

            {/* ── SYSTEM HEALTH ─────────────────────────────────────────── */}
            <section id="health" class="admin-panel">
              <h2 class="admin-h">System health</h2>
              <p class="admin-sub">
                Probed live from <a href="/api/health" style="color:var(--gold-2)">/api/health</a> when
                this page opens. Until it answers the table below says so rather than showing a
                stale or assumed value.
              </p>
              <div class="cmd-tables">
                <DataTable
                  id="health-table"
                  caption="Live health probe"
                  state="loading"
                  loadingRows={3}
                  columns={[
                    { key: 'component', label: 'Component', min: '200px' },
                    { key: 'status', label: 'Reported status', min: '160px' },
                    { key: 'meaning', label: 'What that means', min: '300px' },
                  ]}
                />
                <noscript>
                  <p class="dt-state dt-incomplete">
                    The live probe needs JavaScript. Open
                    <a href="/api/health" style="color:var(--gold-2)"> /api/health</a> directly for
                    the same answer — it is a plain JSON response.
                  </p>
                </noscript>
              </div>
              <p class="admin-sub" style="margin-top:16px">
                Generated at {dash ? dash.generatedAt : ''}{dash ? `, credentials judged as at ${dash.asAt}.` : ''}
              </p>
            </section>
          </>
        )}
      </main>
    </div>
  )}
</Base>

<script>
  // Sign-in — only present when the caller is unauthenticated.
  const loginForm = document.getElementById('loginForm');
  if (loginForm instanceof HTMLFormElement) {
    const loginErr = document.getElementById('loginErr');
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginErr) loginErr.style.display = 'none';
      const btn = loginForm.querySelector('button[type=submit]');
      const fd = new FormData(loginForm);
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      if (btn instanceof HTMLButtonElement) { btn.disabled = true; btn.textContent = 'Signing in…'; }

      const r = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(email ? { email, password } : { password }),
      }).catch(() => null);

      if (btn instanceof HTMLButtonElement) { btn.disabled = false; btn.textContent = 'Sign in'; }
      if (r && r.ok) { location.reload(); return; }

      let message = 'Sign-in failed. Check your details and try again.';
      if (r) {
        const body = await r.json().catch(() => null);
        if (body && body.error) message = String(body.error);
        else if (r.status === 429) message = 'Too many attempts. Wait a minute and try again.';
      } else {
        message = 'Could not reach the server. Check your connection.';
      }
      if (loginErr) { loginErr.textContent = message; loginErr.style.display = 'block'; }
      const pw = loginForm.querySelector('input[name=password]');
      if (pw instanceof HTMLInputElement) pw.select();
    });
  }

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' }).catch(() => null);
    location.reload();
  });

  // ─── Live health probe ────────────────────────────────────────────────────
  //
  // The table renders in its loading state on the server and is filled here.
  // If the probe fails it is switched to the error state with the reason — it
  // is never left showing skeleton rows, and never quietly filled with "ok".
  const healthFigure = document.getElementById('health-table');
  if (healthFigure) {
    const table = healthFigure.querySelector('table');
    const tbody = healthFigure.querySelector('tbody');
    const loadingNote = healthFigure.querySelector('.dt-loading');

    const MEANING = {
      'redis:true': 'The editorial store is reachable. News, pages and the approval queues are durable.',
      'redis:false': 'The editorial store is NOT reachable. Anything saved through the content admin may be held in this server’s memory only and lost on restart.',
      'database:ok': 'The federation register is reachable. Every figure on this page was counted from it.',
      'database:error': 'DATABASE_URL is set but the register did not answer. The figures on this page may be from a connection that has since failed — reload before acting on them.',
      'database:not_configured': 'No federation register is configured for this deployment. This is a real state, not a failure.',
    };

    const cell = (text, cls) => {
      const td = document.createElement('td');
      td.textContent = text;
      if (cls) td.className = cls;
      return td;
    };

    const fail = (why) => {
      const scroll = healthFigure.querySelector('.dt-scroll');
      if (scroll instanceof HTMLElement) scroll.hidden = true;
      if (loadingNote instanceof HTMLElement) {
        loadingNote.className = 'dt-state dt-error';
        loadingNote.setAttribute('role', 'alert');
        loadingNote.textContent = why;
      }
    };

    fetch('/api/health', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
      .then((body) => {
        if (!tbody || !(table instanceof HTMLTableElement)) return;
        const rows = [
          ['Editorial store (Redis)', String(body.redis), MEANING['redis:' + String(body.redis)] || 'The probe returned a value this page does not recognise.'],
          ['Federation register (Postgres)', String(body.database), MEANING['database:' + String(body.database)] || 'The probe returned a value this page does not recognise.'],
          ['Deployed commit', String(body.version || 'unknown'), 'The build serving this page.'],
        ];
        tbody.replaceChildren(...rows.map((r) => {
          const tr = document.createElement('tr');
          tr.append(cell(r[0]), cell(r[1]), cell(r[2]));
          return tr;
        }));
        table.setAttribute('aria-busy', 'false');
        if (loadingNote instanceof HTMLElement) loadingNote.remove();
      })
      .catch((err) => {
        fail('The health probe could not be read (' + (err && err.message ? err.message : 'no response') +
             '). No status is shown rather than one that was assumed. Open /api/health directly.');
      });
  }
</script>

{/* Top level, not inside an expression: Astro only extracts and bundles a
    <style> tag that sits in the template proper. The admin chrome classes are
    duplicated from admin/queue.astro deliberately — src/pages/admin/index.astro
    is not this surface's to edit, and a shared stylesheet would be. */}
