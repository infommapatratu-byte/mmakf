  @media (max-width: 800px) { .admin-wrap { grid-template-columns: 1fr; } }

  .admin-side {
    background: var(--bg-2);
    border-right: 1px solid var(--border);
    padding: 24px 0;
    display: flex; flex-direction: column;
    position: sticky; top: 0; align-self: start;
    height: 100vh;
  }
  @media (max-width: 800px) { .admin-side { position: static; height: auto; } }
  .admin-brand { padding: 0 24px 24px; border-bottom: 1px solid var(--border); }
  .admin-brand-1 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 700; letter-spacing: 0.06em; }
  .admin-brand-2 { font-family: var(--font-display); font-size: 0.66rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-top: 4px; }
  .admin-nav { flex: 1; overflow-y: auto; padding: 16px 12px; display: flex; flex-direction: column; gap: 2px; }
  .admin-nav a {
    padding: 12px 14px;
    min-height: 44px;
    display: flex; align-items: center;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--off-white);
    border-radius: var(--radius);
    transition: all 0.18s;
  }
  .admin-nav a:hover, .admin-nav a.active { background: var(--card); color: var(--gold); }

  .admin-main { padding: 32px 36px 64px; max-width: 1180px; min-width: 0; }
  @media (max-width: 600px) { .admin-main { padding: 24px 18px 48px; } }

  .admin-panel { padding: 36px 0; border-bottom: 1px solid var(--border); scroll-margin-top: 20px; min-width: 0; }
  .admin-panel:first-of-type { padding-top: 0; }
  .admin-h { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; letter-spacing: 0.02em; }
  .admin-sub { color: var(--muted); font-size: 0.88rem; margin-top: 6px; line-height: 1.7; }
  .admin-sub code, .q-warn code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82em;
    overflow-wrap: anywhere;
  }

  .q-signed {
    margin-top: 14px;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--off-white);
    overflow-wrap: anywhere;
  }
  .q-warn {
    margin-top: 16px;
    background: rgba(142, 18, 18, 0.05);
    border: 1px solid var(--red-3);
    border-left: 3px solid var(--red);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--off-white);
  }
  .q-warn strong { color: var(--red-2); }

  /* Figures. auto-fit keeps a phone at one column without a media query and a
     laptop at four, and `minmax(0, 1fr)` is what stops a long unbroken value
     widening a track and pushing the page sideways. */
  .cmd-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    align-items: stretch;
  }
  .cmd-tables {
    margin-top: 26px;
    display: grid;
