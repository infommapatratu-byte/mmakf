---
// THE SCOPED DASHBOARD — §19, §41, §42.
//
// ─────────────────────────────────────────────────────────────────────────────
// ONE PAGE FOR EVERY LEVEL OF THE FEDERATION
// ─────────────────────────────────────────────────────────────────────────────
//
// A state secretary lands on their state, a district administrator on their
// district, a dojo administrator on their dojo, a national officer on the whole
// register — the same measurements, the same wording, the same provenance,
// narrowed by scope.
//
// That is an engineering decision, not a layout one. The obvious alternative —
// /admin/state, /admin/district, /admin/dojo — drifts apart within two releases:
// a figure gets fixed on one and not the others, and the federation ends up with
// three answers to one question depending on which page you opened. There is one
// page because there must be one answer.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT IS NEW HERE, AND WHY
// ─────────────────────────────────────────────────────────────────────────────
//
// The page used to open with the register: how many people, how many dojos.
// §42 asks the other question first — what does the person who just signed in
// have to DO about this unit — so WHAT NEEDS ATTENTION IN THIS SCOPE now comes
// first, and the register follows.
//
// Those figures come from src/lib/attention.ts, which is the same engine
// /admin/command uses. Written twice, the two pages would answer differently
// the first time somebody added a status. Which statuses count as waiting is
// decided once more, in the federation status dictionary, and read by the
// engine — this page re-decides nothing.
//
// ─────────────────────────────────────────────────────────────────────────────
// AUTHORITY IS NEVER TAKEN FROM THE URL
// ─────────────────────────────────────────────────────────────────────────────
//
// `?scope=state&id=7` is a REQUEST, not a permission. analytics.ts resolves the
// unit from the database and then authorises the caller against the placement
// the database reports — the check that stops someone reading another state's
// figures by editing the address bar. When it refuses, this page prints the
// refusal. The attention engine repeats the narrowing independently, as a SQL
// predicate built from visibleScopes(), so a figure here is inside BOTH the unit
// asked for and the units this credential may read.
//
// WHAT IS DELIBERATELY NOT HERE: officials.expiringLicences() applies no unit
// filter of its own, so it is a national list by construction and belongs on
// /admin/command. Showing it under a state heading would report the whole
// federation's lapsing licences as if they were that state's. The same is true
// of "what changed today": audit_events records no unit at all.

import AdminShell from '@/components/AdminShell.astro';
import PageHeader from '@/components/PageHeader.astro';
import StatCard from '@/components/StatCard.astro';
import Status from '@/components/Status.astro';
import Table from '@/components/DataTable/Table.astro';
import type { Column } from '@/components/DataTable/types';
import { identify } from '@/lib/session';
import { canAnywhere, visibleScopes, ForbiddenError } from '@/lib/rbac';
import { isConfigured, db, schema } from '@/db';
import { asc, eq, inArray } from 'drizzle-orm';
import {
  nationalDashboard, stateDashboard, districtDashboard, dojoDashboard, dataQuality,
  type Dashboard, type DataQualityReport, type ScopeInput, type ScopeKind,
  type ScopeRef, type Source,
} from '@/db/analytics';
import {
  attention, upcomingCompetitions, UNANSWERABLE,
  type AttentionReport, type DatedFigure,
} from '@/lib/attention';
import { href as surfaceHref, type Surface } from '@/lib/surface';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);

const identity = await identify(Astro.request.headers.get('cookie'));
const principal = identity?.principal ?? null;
const configured = isConfigured();

// AdminShell gates on 'dojo:read' — the narrowest authority that can produce a
// scope on this page, and the same action the command palette already uses for
// its "open this unit" entries, so the two agree about who may open it.
const permitted = !!principal && canAnywhere(principal, 'dojo:read');

// ─── What the caller asked for ──────────────────────────────────────────────
//
// Parsed, never trusted. A malformed parameter is reported as malformed rather
// than silently falling back to the national view, which would quietly show a
// scoped administrator a page they would then be refused anyway.

const KINDS: ScopeKind[] = ['national', 'state', 'district', 'dojo'];
const rawKind = Astro.url.searchParams.get('scope');
const rawId = Astro.url.searchParams.get('id');

let requested: ScopeInput | null = null;
let requestProblem: string | null = null;

if (rawKind !== null) {
  if (!KINDS.includes(rawKind as ScopeKind)) {
    requestProblem = `"${rawKind}" is not a scope. It must be one of: ${KINDS.join(', ')}.`;
  } else if (rawKind === 'national') {
    requested = { kind: 'national' };
  } else {
    const id = Number(rawId);
    if (!rawId || !Number.isInteger(id) || id <= 0) {
      requestProblem = `A ${rawKind} scope needs a positive whole-number id; "${rawId ?? ''}" is not one.`;
    } else {
      requested = { kind: rawKind as 'state' | 'district' | 'dojo', id };
    }
  }
}

// ─── Panel state ────────────────────────────────────────────────────────────

interface Option {
  kind: ScopeKind;
  id: number | null;
  label: string;
  level: string;
}

type Panel<T> =
  | { state: 'ready'; value: T; message: null }
  | { state: 'denied'; value: null; message: string }
  | { state: 'error'; value: null; message: string };

const SPEAKING_ERRORS = new Set(['AnalyticsError', 'OfficialsError', 'ApprovalError', 'QueueError']);

async function attempt<T>(what: string, fn: () => Promise<T>): Promise<Panel<T>> {
  try {
    return { state: 'ready', value: await fn(), message: null };
  } catch (err: any) {
    if (err instanceof ForbiddenError) {
      return {
        state: 'denied',
        value: null,
        message:
          `Reading ${what} at the scope you asked for requires the "${err.action}" authority INSIDE that ` +
          'scope, and your credential does not hold it there. The unit was resolved from the database and ' +
          'checked against your bindings — an id typed into the address bar confers nothing. Records may ' +
          'well exist here; they are simply not yours to read.',
      };
    }
    if (err && SPEAKING_ERRORS.has(String(err.name)) && typeof err.message === 'string') {
      return { state: 'error', value: null, message: err.message };
    }
    console.error(`[admin/dashboard] ${what} failed`, err);
    return {
      state: 'error',
      value: null,
      message:
        `${what} could not be read. Nothing is shown rather than a zero that would look like a ` +
        'measurement. The failure is in this deployment’s server log.',
    };
  }
}

const CHILD_CAP = 100;

let boundOptions: Option[] = [];
let childOptions: Option[] = [];
let childrenCapped = false;
let noScopeReason: string | null = null;
let dashboard: Panel<Dashboard> | null = null;
let quality: Panel<DataQualityReport> | null = null;
let work: AttentionReport | null = null;
let upcoming: DatedFigure | null = null;
let effective: ScopeInput | null = null;

if (permitted && principal && configured) {
  const conn = db();

  const unitView = visibleScopes(principal, 'unit:read');
  const dojoView = visibleScopes(principal, 'dojo:read');

  /** Names for a set of ids the policy module already approved. */
  async function names(table: any, ids: number[]): Promise<Array<{ id: number; name: string }>> {
    if (!ids.length) return [];
    const rows = await conn
      .select({ id: table.id, name: table.name })
      .from(table)
      .where(inArray(table.id, ids))
      .orderBy(asc(table.name));
    return rows.map((r: any) => ({ id: Number(r.id), name: String(r.name) }));
  }

  // 1. The scopes this credential is BOUND to.
  if (unitView.kind === 'all') {
    boundOptions.push({ kind: 'national', id: null, label: 'MMAKF (national)', level: 'National' });
  } else if (unitView.kind === 'scoped') {
    for (const u of await names(schema.stateUnits, unitView.states)) {
      boundOptions.push({ kind: 'state', id: u.id, label: u.name, level: 'State' });
    }
    for (const u of await names(schema.districtUnits, unitView.districts)) {
      boundOptions.push({ kind: 'district', id: u.id, label: u.name, level: 'District' });
    }
  }
  if (dojoView.kind === 'scoped') {
    for (const u of await names(schema.dojos, dojoView.dojos)) {
      boundOptions.push({ kind: 'dojo', id: u.id, label: u.name, level: 'Dojo' });
    }
  }

  // 2. Where to land when the URL says nothing: a person's own level, not the
  //    national view they would only be refused.
  const fallback: ScopeInput | null =
    boundOptions.length === 0
      ? null
      : boundOptions[0].kind === 'national'
        ? { kind: 'national' }
        : { kind: boundOptions[0].kind as 'state' | 'district' | 'dojo', id: boundOptions[0].id as number };

  effective = requested ?? fallback;

  if (!effective) {
    noScopeReason = identity?.shared
      ? 'This is a shared credential. The legacy unit access code carries no unit id — it names a level ' +
        'but not which state, district or dojo — so there is no scope to narrow a dashboard to. Sign in ' +
        'with a personal account bound to a unit.'
      : 'Your account holds no unit-read or dojo-read authority in any scope, so there is no dashboard to ' +
        'show you. Ask a federation administrator for a binding.';
  } else {
    const sc = effective;
    dashboard = await attempt('this dashboard', () =>
      sc.kind === 'national' ? nationalDashboard(conn, principal)
        : sc.kind === 'state' ? stateDashboard(conn, principal, sc.id)
          : sc.kind === 'district' ? districtDashboard(conn, principal, sc.id)
            : dojoDashboard(conn, principal, sc.id)
    );
    quality = await attempt('the data-quality report', () => dataQuality(conn, principal, sc));

    // 3. The work waiting in this scope, and the units inside it. Both are only
    //    read once the scope has been RESOLVED and authorised above: the
    //    ScopeRef that analytics.ts returns is the checked one, and passing the
    //    caller's requested ids straight to the attention engine would be
    //    trusting the address bar after taking the trouble not to.
    if (dashboard.state === 'ready') {
      const ref = dashboard.value.scope;

      work = await attention(conn, principal, { scope: ref, link: h });
      upcoming = await upcomingCompetitions(conn, principal, { scope: ref, link: h });

      const take = CHILD_CAP + 1;
      const push = (kind: ScopeKind, level: string, rows: any[]) => {
        for (const r of rows.slice(0, CHILD_CAP)) {
          childOptions.push({ kind, id: Number(r.id), label: String(r.name), level });
        }
        if (rows.length > CHILD_CAP) childrenCapped = true;
      };

      if (ref.kind === 'national') {
        push('state', 'State', await conn.select({ id: schema.stateUnits.id, name: schema.stateUnits.name })
          .from(schema.stateUnits).orderBy(asc(schema.stateUnits.name)).limit(take));
      } else if (ref.kind === 'state' && ref.stateUnitId != null) {
        push('district', 'District', await conn.select({ id: schema.districtUnits.id, name: schema.districtUnits.name })
          .from(schema.districtUnits).where(eq(schema.districtUnits.stateUnitId, ref.stateUnitId))
          .orderBy(asc(schema.districtUnits.name)).limit(take));
        push('dojo', 'Dojo', await conn.select({ id: schema.dojos.id, name: schema.dojos.name })
          .from(schema.dojos).where(eq(schema.dojos.stateUnitId, ref.stateUnitId))
          .orderBy(asc(schema.dojos.name)).limit(take));
      } else if (ref.kind === 'district' && ref.districtUnitId != null) {
        push('dojo', 'Dojo', await conn.select({ id: schema.dojos.id, name: schema.dojos.name })
          .from(schema.dojos).where(eq(schema.dojos.districtUnitId, ref.districtUnitId))
          .orderBy(asc(schema.dojos.name)).limit(take));
      }
    }
  }
}

// ─── Reading a figure ───────────────────────────────────────────────────────
//
// Deliberately duplicated from /admin/command rather than shared: it joins
// `counts` to `withheld` so a key that analytics.ts refused can never fall
// through and render as a 0. That join is the whole safety property, and it is
// five lines — cheaper to repeat than to indirect.

interface Figure {
  value: number | null;
  unavailable: string | null;
  source: Source | null;
}

function figure(d: Dashboard | null, key: string): Figure {
  if (!d) return { value: null, unavailable: 'The dashboard was not produced for this request.', source: null };
  const withheld = d.withheld.find((w) => w.key === key);
  if (withheld) return { value: null, unavailable: withheld.detail, source: null };
  if (!(key in d.counts)) {
    return {
      value: null,
      unavailable: `analytics.ts produced no figure called "${key}" and gave no reason. Report this.`,
      source: null,
    };
  }
  return { value: d.counts[key], unavailable: null, source: d.sources[key] ?? null };
}

const dash = dashboard?.state === 'ready' ? dashboard.value : null;
const scopeRef: ScopeRef | null = dash?.scope ?? null;

const LEVEL_WORD: Record<ScopeKind, string> = {
  national: 'the whole federation',
  state: 'this state unit',
  district: 'this district unit',
  dojo: 'this dojo',
};

// ─── What needs attention here ──────────────────────────────────────────────

const registers = work
  ? [...work.registers].sort((a, b) => {
      const av = a.total == null ? -1 : a.total;
      const bv = b.total == null ? -1 : b.total;
      return bv - av;
    })
  : [];

const waitingTotal = registers.every((r) => r.total != null)
  ? registers.reduce((n, r) => n + (r.total ?? 0), 0)
  : null;

/** Registers this credential may read but which cannot be narrowed to this unit. */
const notNarrowable = registers.filter((r) => r.unavailable != null);

const workRows = registers.flatMap((r) =>
  r.items.map((i) => ({
    register: r.label,
    status: i.status,
    domain: i.domain,
    waiting: i.count,
    href: i.href,
    hrefLabel: i.hrefFiltered ? 'Open this list' : 'Open the register',
    provenance: i.source
      ? `${i.source.table} — ${i.source.filter}`
      : (i.unavailable ?? 'No figure and no reason was recorded. Report this.'),
  }))
);

const workColumns: Column[] = [
  { key: 'register', header: 'Register', primary: true, sortable: true },
  {
    key: 'status',
    header: 'Status',
    // §102: Status.astro is the only place a database value becomes a word a
    // person reads. The domain travels per row because this table spans several
    // registers and `active` does not mean the same thing in all of them.
    component: Status,
    componentProps: (row) => ({ value: row.status, domain: row.domain, size: 'sm' }),
  },
  {
    key: 'waiting', header: 'Waiting', numeric: true, sortable: true, initialDir: 'desc',
    render: (row) => (row.waiting == null ? '—' : String(row.waiting)),
  },
  { key: 'hrefLabel', header: 'Where it is worked', href: (row) => (row.href as string) ?? null },
  {
    key: 'provenance', header: 'How this was counted, or why it was not',
    hint: 'The table and the WHERE clause, so a reader who doubts a figure can rebuild it.',
  },
];

// ─── The register ───────────────────────────────────────────────────────────

function statusRows(counts: Record<string, number>, domain: string) {
  return Object.entries(counts)
    .map(([status, count]) => ({ status, count, domain }))
    .sort((a, b) => Number(b.count) - Number(a.count) || String(a.status).localeCompare(String(b.status)));
}

const dojoStatusRows = dash ? statusRows(dash.dojosByStatus, 'unit') : [];
const eventStatusRows = dash ? statusRows(dash.eventsByStatus, 'event') : [];
const dojosWithheld = dash?.withheld.find((w) => w.key === 'dojosByStatus') ?? null;
const eventsWithheld = dash?.withheld.find((w) => w.key === 'eventsByStatus') ?? null;

/**
 * Name WHY a breakdown is missing before quoting the module's own detail.
 *
 * "Not authorised" and "not narrowable" look identical on a page if only the
 * detail is printed, and they are different facts: the first says the rows
 * exist and you may not count them, the second says no column in that table can
 * narrow the figure to this level at all. Neither is a zero, and the reader has
 * to be able to tell them apart.
 */
function withheldMessage(w: { reason: string; detail: string } | null): string | null {
  if (!w) return null;
  const head = w.reason === 'not_authorised' ? 'Withheld from this credential' : 'Not narrowable to this scope';
  return `${head}: ${w.detail}`;
}

const breakdownColumns = (noun: string): Column[] => [
  {
    key: 'status', header: 'Status', primary: true,
    component: Status,
    componentProps: (row) => ({ value: row.status, domain: row.domain, size: 'sm' }),
  },
  { key: 'count', header: noun, numeric: true, sortable: true, initialDir: 'desc' },
];

const qualityRows =
  quality?.state === 'ready'
    ? quality.value.items.map((i) => ({
        check: i.description,
        count: i.count,
        total: i.total,
        table: i.source.table,
        filter: i.source.filter,
      }))
    : [];

const qualityColumns: Column[] = [
  { key: 'check', header: 'What is missing, and why it matters', primary: true },
  { key: 'count', header: 'Rows with the gap', numeric: true, sortable: true, initialDir: 'desc' },
  { key: 'total', header: 'Rows examined', numeric: true },
  { key: 'table', header: 'Table' },
  { key: 'filter', header: 'Filter' },
];

const topGaps =
  quality?.state === 'ready' ? [...quality.value.items].sort((a, b) => b.count - a.count).slice(0, 4) : [];

const withheldRows = [
  ...(dash?.withheld ?? []).map((w) => ({ key: w.key, reason: w.reason, detail: w.detail })),
  ...(quality?.state === 'ready'
    ? quality.value.withheld.map((w) => ({ key: `dataQuality.${w.key}`, reason: w.reason, detail: w.detail }))
    : []),
  ...notNarrowable.map((r) => ({
    key: `attention.${r.key}`,
    reason: 'not_scopable',
    detail: r.unavailable as string,
  })),
];

const withheldColumns: Column[] = [
  { key: 'key', header: 'Figure', primary: true },
  { key: 'reason', header: 'Reason' },
  { key: 'detail', header: 'Detail' },
];

// ─── The scope picker ───────────────────────────────────────────────────────

/** A link that selects a scope. The only way this page changes what it shows. */
function scopeHref(o: Option): string {
  return o.kind === 'national'
    ? h('/admin/dashboard?scope=national')
    : h(`/admin/dashboard?scope=${o.kind}&id=${o.id}`);
}

function isCurrent(o: Option): boolean {
  if (!effective) return false;
  if (o.kind !== effective.kind) return false;
  return o.kind === 'national' ? true : o.id === (effective as { id: number }).id;
}

const signedInAs = identity
  ? identity.shared
    ? `${identity.principal.label} — shared credential (${identity.via}), not attributable to a person`
    : `${identity.principal.label} — personal account #${identity.userId}`
  : '';

const heading = scopeRef ? scopeRef.label : 'Scoped dashboard';
const NUM = new Intl.NumberFormat('en-IN');
---

<AdminShell
  title={heading}
  requires="dojo:read"
  intro={scopeRef
    ? `Every figure below is a count of rows in the federation register, narrowed to ${LEVEL_WORD[scopeRef.kind]} in SQL — not filtered after the fact. Where a figure cannot honestly be narrowed to this level it is withheld with the reason, never substituted with the national number.`
    : 'One dashboard for every level of the federation. It opens on the scope your credential is bound to.'}
>
  <p class="who">Signed in as {signedInAs}</p>

  {requestProblem && (
    <p class="warn" role="alert">
      <strong>That address could not be read.</strong> {requestProblem}{' '}
      {scopeRef
        ? `Nothing was guessed from it. What you are looking at is ${scopeRef.label} — the scope your own credential is bound to — and NOT what the address asked for.`
        : 'Nothing was guessed from it, and no dashboard is shown below.'}
    </p>
  )}

  {!configured ? (
    <section class="panel" aria-labelledby="unconfigured-h">
      <h2 class="sec-h" id="unconfigured-h">The federation database is not configured</h2>
      <div class="warn" role="alert">
        <p>
          <strong>There is nothing to count.</strong> <code>DATABASE_URL</code> is not set for this
          deployment, so the register this dashboard reads does not exist here. No figures are
          rendered at all: a zero drawn against an absent database cannot be told apart from a real
          measurement of an empty unit, and that difference matters more than having something on
          the screen.
        </p>
        <p>
          Live status is at <a href="/api/health">/api/health</a>; the provisioning runbook is
          <code>docs/FEDERATION-ARCHITECTURE.md §10.1</code>. The editorial queues do not depend on
          the register and are workable now at <a href={h('/admin/queue')}>the approval queue</a>.
        </p>
      </div>
    </section>
  ) : noScopeReason ? (
    <section class="panel" aria-labelledby="noscope-h">
      <h2 class="sec-h" id="noscope-h">No scope to show</h2>
      <p class="sec-p" role="alert">{noScopeReason}</p>
    </section>
  ) : (
    <Fragment>
      {/* ── SCOPE PICKER ───────────────────────────────────────────────── */}
      <section class="panel" aria-labelledby="scope-h">
        <h2 class="sec-h" id="scope-h">Scope</h2>
        <p class="sec-p">
          The same page at every level. Selecting a unit re-runs every figure below against that
          unit — the id in the address is only a request, and the unit is resolved from the database
          and re-checked against your bindings before a single row is read.
        </p>

        {boundOptions.length > 0 && (
          <nav class="scope-set" aria-label="Scopes your credential is bound to">
            <h3 class="scope-h">Bound to your credential</h3>
            <div class="scope-row">
              {boundOptions.map((o) => (
                <a href={scopeHref(o)} class="scope-chip" class:list={[{ 'is-current': isCurrent(o) }]}
                   aria-current={isCurrent(o) ? 'page' : undefined}>
                  <span class="scope-lvl">{o.level}</span>
                  <span class="scope-name">{o.label}</span>
                </a>
              ))}
            </div>
          </nav>
        )}

        {childOptions.length > 0 && (
          <nav class="scope-set" aria-label={`Units inside ${scopeRef ? scopeRef.label : 'this scope'}`}>
            <h3 class="scope-h">Inside {scopeRef ? scopeRef.label : 'this scope'}</h3>
            <div class="scope-row">
              {childOptions.map((o) => (
                <a href={scopeHref(o)} class="scope-chip" class:list={[{ 'is-current': isCurrent(o) }]}
                   aria-current={isCurrent(o) ? 'page' : undefined}>
                  <span class="scope-lvl">{o.level}</span>
                  <span class="scope-name">{o.label}</span>
                </a>
              ))}
            </div>
            {childrenCapped && (
              <p class="note">
                Only the first {CHILD_CAP} units of a kind are listed. That is a query bound in this
                page, not a federation rule — the hierarchy has more, and they are not shown here.
              </p>
            )}
          </nav>
        )}

        {dashboard && dashboard.state !== 'ready' && (
          <p class="warn" role="alert">
            <strong>{dashboard.state === 'denied' ? 'Refused.' : 'Not available.'}</strong>{' '}
            {dashboard.message}
          </p>
        )}
      </section>

      {dash && (
        <Fragment>
          {/* ── WHAT NEEDS ATTENTION IN THIS SCOPE ─────────────────────── */}
          <section class="panel" aria-label={`What needs attention in ${dash.scope.label}`}>
            <PageHeader
              title={`What needs attention in ${dash.scope.label}`}
              headingLevel="h2"
              sticky={false}
              description="Which statuses count as waiting is decided once, by the federation status dictionary, and read here — not re-decided per tile. Every tile links to the list that produced it, and each figure carries both the unit predicate and your own reach predicate."
              primary={{ label: 'Approval queue', href: h('/admin/queue') }}
              secondary={[
                { label: 'National command centre', href: h('/admin/command') },
                { label: 'Annual report', href: h('/admin/report') },
              ]}
            >
              <Fragment slot="meta">
                {waitingTotal != null && registers.length > 0 && (
                  <span class="meta-chip">{NUM.format(waitingTotal)} waiting here</span>
                )}
              </Fragment>
            </PageHeader>

            {registers.length === 0 ? (
              <p class="note">
                Your account holds none of the actions that carry work in a unit. That is a statement
                about your bindings, not about {dash.scope.label}: the work may well exist and is not
                yours to see.
              </p>
            ) : (
              <Fragment>
                <div class="grid">
                  {registers.map((r) => (
                    <StatCard
                      label={`${r.label} needing attention`}
                      value={r.total}
                      unavailable={r.unavailable}
                      tone="attention"
                      href={r.href}
                      hrefLabel={r.filterable ? `Open ${r.label.toLowerCase()}` : 'Open the register'}
                      note={[r.scopeCaveat, r.total === 0 ? `Nothing is waiting here. ${r.populatedBy}` : null].filter(Boolean).join(' ') || null}
                    />
                  ))}
                  <StatCard
                    label={upcoming?.label ?? 'Competitions dated today or later'}
                    value={upcoming?.count ?? null}
                    unavailable={upcoming?.unavailable ?? 'The competition calendar was not read for this request.'}
                    source={upcoming?.source ?? null}
                    href={upcoming?.href ?? null}
                    hrefLabel="Open the calendar"
                    note={dash.scope.kind === 'dojo'
                      ? 'At dojo level this counts events this dojo is recorded as ORGANISING. A competition_event names an organiser dojo and nothing else, so it cannot count the events this dojo entered.'
                      : (upcoming?.count === 0 ? `No event is dated today or later. ${upcoming.populatedBy}` : null)}
                  />
                </div>

                <Table
                  id="attention-detail"
                  caption={`Every actionable status in ${dash.scope.label}, with where it is worked`}
                  columns={workColumns}
                  rows={workRows}
                  paramPrefix="w"
                  pageSize={false}
                  savedViews={false}
                  note="A status appears here because the federation status dictionary marks it as waiting on somebody. Drafts are never counted: an unfinished application is the applicant's business until they send it."
                  emptyTitle="No register in reach carries an actionable status here."
                  emptyBody="Every register your credential can read at this scope uses a status vocabulary in which nothing is currently defined as waiting on a person."
                  emptyAction={{ label: 'Open the approval queue', href: h('/admin/queue') }}
                />

                {work && work.outOfReach.length > 0 && (
                  <p class="note">
                    Not shown, because your credential holds no authority over them:
                    {' '}{work.outOfReach.map((r) => `${r.label} (${r.action})`).join(', ')}. Work may
                    well be waiting there. Quoting the action is what whoever grants roles needs to
                    hear.
                  </p>
                )}

                <p class="note">
                  Two figures are deliberately absent from a scoped page and live on the
                  {' '}<a href={h('/admin/command')}>national command centre</a> instead: officials'
                  licences about to lapse, and what changed today. Neither table records a state,
                  district or dojo, so both are national by construction — printing either under this
                  heading would report the whole federation's figure as if it were this unit's.
                </p>
              </Fragment>
            )}
          </section>

          {/* ── DATA QUALITY ───────────────────────────────────────────────
              Above the totals on purpose. Everything below tells you what the
              register says about this unit; this tells you how much of it is
              missing. A count of members is worth nothing if those members have
              no date of birth, because every age-gated decision taken from them
              is guesswork. */}
          <section class="panel" aria-labelledby="quality-h">
            <h2 class="sec-h" id="quality-h">Data quality — how trustworthy are these numbers?</h2>
            <p class="sec-p">
              Each check reports the gap and the population it was measured against. No percentage is
              offered — a percentage is a float, and floats do not belong in front of federation
              decisions.
            </p>

            {topGaps.length > 0 && (
              <div class="grid">
                {topGaps.map((g) => (
                  <StatCard label={g.description} value={g.count} outOf={g.total} tone="attention" source={g.source} />
                ))}
              </div>
            )}

            <Table
              id="quality"
              caption={`Every data-quality check for ${dash.scope.label}`}
              columns={qualityColumns}
              rows={qualityRows}
              state={quality?.state === 'ready' ? 'ready' : quality?.state === 'denied' ? 'denied' : 'error'}
              deniedMessage={quality?.state === 'denied' ? quality.message : null}
              errorDetail={quality?.state === 'error' ? quality.message : null}
              paramPrefix="dq"
              pageSize={false}
              savedViews={false}
              emptyTitle="No data-quality check could be narrowed to this scope."
              emptyBody="analytics.dataQuality() returned no checks that can be measured against a single unit at this level."
              emptyAction={{ label: 'National command centre', href: h('/admin/command') }}
            />
          </section>

          {/* ── MEMBERSHIP ─────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="membership-h">
            <h2 class="sec-h" id="membership-h">Membership</h2>
            <p class="sec-p">
              People filed to {LEVEL_WORD[dash.scope.kind]}, and the credentials they hold as at
              {' '}{dash.asAt}. A licence counts as current only when its status says so and its
              dates agree.
            </p>
            <div class="grid">
              <StatCard label="People on the register" {...figure(dash, 'people')} />
              <StatCard label="People with status active" {...figure(dash, 'peopleActive')} />
              <StatCard label="People holding an active membership" {...figure(dash, 'membersActive')} href={h('/admin/membership')} hrefLabel="Renewals desk" />
              <StatCard label="Athletes" {...figure(dash, 'athletes')} />
              <StatCard label="Instructors with a current licence" {...figure(dash, 'instructors')} />
              <StatCard label="Examiners with a current licence" {...figure(dash, 'examiners')} />
              <StatCard label="Officials with a current licence" {...figure(dash, 'officials')} />
            </div>
          </section>

          {/* ── UNITS ──────────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="units-h">
            <h2 class="sec-h" id="units-h">Units and dojos</h2>
            <div class="grid">
              <StatCard label="State units" {...figure(dash, 'stateUnits')} />
              <StatCard label="State units active" {...figure(dash, 'stateUnitsActive')} />
              <StatCard label="District units" {...figure(dash, 'districtUnits')} />
              <StatCard label="District units active" {...figure(dash, 'districtUnitsActive')} />
              <StatCard label="Dojos" {...figure(dash, 'dojos')} href={h('/admin/governance')} hrefLabel="Governance" />
            </div>

            <Table
              id="dojo-status"
              caption="Dojos by status"
              columns={breakdownColumns('Dojos')}
              rows={dojoStatusRows}
              state={dojosWithheld ? 'denied' : 'ready'}
              deniedMessage={withheldMessage(dojosWithheld)}
              paramPrefix="ds"
              pageSize={false}
              savedViews={false}
              note="Every status the schema permits is listed, including those nobody currently holds — an explicit 0 is a measurement, a missing row is a gap the reader fills in for themselves."
              emptyTitle="No dojo status breakdown was produced for this scope."
              emptyBody="analytics.ts returned no grouped count that can be narrowed to this level."
              emptyAction={{ label: 'Governance', href: h('/admin/governance') }}
            />
          </section>

          {/* ── GRADING ────────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="grading-h">
            <h2 class="sec-h" id="grading-h">Grading and certificates</h2>
            <div class="grid">
              <StatCard label="Grading events recorded" {...figure(dash, 'gradingEvents')} href={h('/admin/grading')} hrefLabel="Grading" />
              <StatCard label="Gradings with results locked" {...figure(dash, 'gradingsHeld')} note="Locked is the only status that evidences a completed examination whose results can no longer change." />
              <StatCard label="Grading candidates" {...figure(dash, 'gradingCandidates')} />
              <StatCard label="Candidates passed" {...figure(dash, 'gradingCandidatesPassed')} />
              <StatCard label="Certificates" {...figure(dash, 'certificates')} />
              <StatCard label="Certificates in issue" {...figure(dash, 'certificatesInIssue')} />
              <StatCard label="Certificates revoked" {...figure(dash, 'certificatesRevoked')} tone="attention" />
            </div>
          </section>

          {/* ── COMPETITION ────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="competition-h">
            <h2 class="sec-h" id="competition-h">Competition</h2>
            <p class="sec-p">
              Entries are counted on what the entry itself declared — the state and dojo it was made
              for — not on where the athlete is filed today. A medal was won representing a unit, and
              a later transfer must not silently move it.
            </p>
            <div class="grid">
              <StatCard label="Competition events" {...figure(dash, 'competitionEvents')} href={h('/admin/competition')} hrefLabel="Competitions" />
              <StatCard label="Entries" {...figure(dash, 'entries')} />
              <StatCard label="Entries confirmed" {...figure(dash, 'entriesConfirmed')} />
              <StatCard label="Matches" {...figure(dash, 'matches')} />
              <StatCard label="Matches completed" {...figure(dash, 'matchesCompleted')} />
              <StatCard label="Results final" {...figure(dash, 'resultsFinal')} />
            </div>

            <Table
              id="event-status"
              caption="Events by status"
              columns={breakdownColumns('Events')}
              rows={eventStatusRows}
              state={eventsWithheld ? 'denied' : 'ready'}
              deniedMessage={withheldMessage(eventsWithheld)}
              paramPrefix="es"
              pageSize={false}
              savedViews={false}
              note="The whole event lifecycle, zero-filled. Not drawn as a chart: with no events a chart is an empty axis, which reads as a measurement rather than as an absence."
              emptyTitle="No event status breakdown was produced for this scope."
              emptyBody="analytics.ts returned no grouped count that can be narrowed to this level."
              emptyAction={{ label: 'Competitions', href: h('/admin/competition') }}
            />
          </section>

          {/* ── ACADEMY ────────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="academy-h">
            <h2 class="sec-h" id="academy-h">Academy</h2>
            <p class="sec-p">
              Courses belong to the federation rather than to a unit, so at any scope below national
              the course figures are withheld rather than reported — a national total printed under a
              state heading invites somebody to sum it across states.
            </p>
            <div class="grid">
              <StatCard label="Courses" {...figure(dash, 'courses')} />
              <StatCard label="Courses published" {...figure(dash, 'coursesPublished')} />
              <StatCard label="Enrolments" {...figure(dash, 'enrolments')} />
              <StatCard label="Enrolments active" {...figure(dash, 'enrolmentsActive')} />
              <StatCard label="Enrolments completed" {...figure(dash, 'enrolmentsCompleted')} />
            </div>
          </section>

          {/* ── CASEWORK ───────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="casework-h">
            <h2 class="sec-h" id="casework-h">Casework and member support</h2>
            <p class="sec-p">
              Counted as cases with <strong>no recorded ending</strong>, not as "open cases" — MMAKF
              has not defined which statuses close a case, and publishing one of the possible answers
              under the heading "open" would report a rule nobody set. Each figure is separately
              gated: "two of my four students are under investigation" names them as surely as the
              file does.
            </p>
            <div class="grid">
              <StatCard label="Disciplinary cases with no recorded ending" {...figure(dash, 'casesNotClosed.disciplinary')} tone="attention" href={h('/admin/cases')} hrefLabel="Cases" />
              <StatCard label="Safeguarding cases with no recorded ending" {...figure(dash, 'casesNotClosed.safeguarding')} tone="attention" href={h('/admin/cases')} hrefLabel="Cases" />
              <StatCard label="Support tickets not resolved or closed" {...figure(dash, 'supportTicketsNotClosed')} tone="attention" href={h('/admin/support')} hrefLabel="Support desk" />
            </div>
          </section>

          {/* ── WITHHELD ───────────────────────────────────────────────── */}
          <section class="panel" aria-labelledby="withheld-h">
            <h2 class="sec-h" id="withheld-h">Withheld, and not narrowable to this scope</h2>
            <p class="sec-p">
              Two different facts, both of which the reader is entitled to.
              <strong> Not authorised</strong> means the rows exist and this credential may not count
              them. <strong>Not scopable</strong> means the table records no column that can narrow
              the figure to this level — a district dashboard will not quietly report the whole
              federation's entries under a district heading. Neither is a zero, and neither is shown
              as one.
            </p>
            <Table
              id="withheld"
              caption="Figures not shown above, with the reason"
              columns={withheldColumns}
              rows={withheldRows}
              paramPrefix="wh"
              pageSize={false}
              savedViews={false}
              emptyTitle="Nothing was withheld."
              emptyBody="Every figure this dashboard offers was produced for this scope."
              emptyAction={{ label: 'National command centre', href: h('/admin/command') }}
            />

            <div class="refusals">
              {UNANSWERABLE.map((u) => (
                <div class="refusal">
                  <h3 class="refusal-h">{u.question}</h3>
                  <p class="refusal-p">{u.why}</p>
                </div>
              ))}
            </div>

            <p class="sec-p">
              Generated at {dash.generatedAt}, credentials judged as at {dash.asAt}.
            </p>
          </section>
        </Fragment>
      )}
    </Fragment>
  )}
</AdminShell>

<style>
  .who {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--off-white);
    overflow-wrap: anywhere;
    margin: 0 0 var(--space-6);
  }

  .panel {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border);
    min-width: 0;
  }
  .panel:first-of-type { border-top: 0; padding-top: 0; }

  .sec-h {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0;
  }
  .sec-p {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 74ch;
    margin: var(--space-3) 0 0;
  }
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 74ch;
    margin: var(--space-5) 0 0;
  }

  /* auto-fit keeps a phone at one column without a media query and a laptop at
     four; minmax(0, 1fr) stops a long unbroken value widening a track and
     pushing the page sideways (WCAG 1.4.10). */
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    align-items: stretch;
    margin: var(--space-6) 0;
  }

  .warn {
    margin: var(--space-5) 0 0;
    background: rgba(142, 18, 18, 0.05);
    border: 1px solid var(--red-3);
    border-left: 3px solid var(--red);
    border-radius: var(--radius);
    padding: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--off-white);
  }
  .warn strong { color: var(--red-2); }
  .warn p { margin: 0; }
  .warn p + p { margin-top: var(--space-3); }
  .warn code, .sec-p code, .note code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .refusals { display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .refusal {
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold-dim);
    border-radius: var(--radius);
    background: var(--card);
    padding: var(--space-4) var(--space-5);
  }
  .refusal-h {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
  }
  .refusal-p {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: var(--space-2) 0 0;
    max-width: 74ch;
  }

  /* ── Scope picker ───────────────────────────────────────────────────── */
  .scope-set { margin-top: var(--space-6); }
  .scope-h {
    font-family: var(--font-display);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 var(--space-3);
  }
  .scope-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .scope-chip {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 44px;
    padding: 7px 14px;
    max-width: 100%;
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .scope-chip:hover { border-color: var(--gold-dim); background: var(--card-2); }
  .scope-chip.is-current {
    border-color: var(--red);
    border-left-width: 3px;
    background: var(--card);
  }
  .scope-lvl {
    font-family: var(--font-display);
    font-size: 0.58rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }
  .scope-chip.is-current .scope-lvl { color: var(--red-2); }
  .scope-name { font-size: var(--text-sm); color: var(--white); overflow-wrap: anywhere; }
</style>
