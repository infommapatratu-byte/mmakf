---
/**
 * THE AFFILIATED UNITS DIRECTORY — /dojos
 *
 * The question this page exists to answer is a parent's: *is the club my child
 * trains at actually affiliated to this federation, today?*
 *
 * Three decisions follow from that question and none of them is cosmetic:
 *
 *  1. A LAPSED UNIT IS LISTED, NOT HIDDEN. The person most in need of this page
 *     is the parent of a child already training somewhere. If a lapsed charter
 *     simply vanished from the directory they would conclude they had mistyped
 *     the name, not that the affiliation had expired. `includeFormer` is
 *     therefore always on, and standing is stated in words on every row.
 *
 *  2. CHARTER VALIDITY TRAVELS WITH EVERY ROW. `affiliated` is a derived
 *     boolean from the module; the date it was derived from is printed beside
 *     it so a reader can check the federation's arithmetic instead of trusting
 *     a badge.
 *
 *  3. NOTHING IS COMPUTED HERE. Standing, the affiliated flag, the expiry
 *     comparison and the explanatory note all come from
 *     `publicDirectory()` in src/db/affiliation.ts. A second copy of that logic
 *     on a page would drift from the register it claims to describe, and the
 *     drift would show up as a club being told it is affiliated when it is not.
 *
 * The module already refuses to publish anything that never reached at least
 * provisional affiliation, and returns no address line, telephone number or
 * email.
 *
 *  4. ONE FIELD IS ADDED, AND IT IS NOT FROM THE REGISTER. A parent who finds
 *     their club here asks "when does it train?" next, and the register cannot
 *     answer: standing and charter validity are all it holds. Training timings
 *     therefore come from the federation's editable branch record — the same
 *     values /network and /affiliation publish, edited from /admin — matched to
 *     a register row BY EXACT NAME, normalised for case and punctuation only.
 *
 *     No fuzzy matching. A club whose branch record is named differently, or
 *     which has no branch record, shows "Not published" rather than borrowing
 *     another centre's clock. The row is labelled as a timing, never as a
 *     standing, so nothing here implies the federation has verified it the way
 *     it verifies a charter. Still no address, telephone number or email.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { isConfigured, db } from '@/db';
import { publicDirectory, type DirectoryEntry, type UnitKind } from '@/db/affiliation';
import { get } from '@/lib/storage';
import { centreTimings, hasTimings, type Timings } from '@/lib/timings';
import { todayIso } from '@/db/scheduling';
import { directoryDay, summariseDay, type DirectoryDay } from '@/db/schedule-directory';

export const prerender = false;

const KINDS: Array<{ key: UnitKind; label: string; singular: string; blurb: string }> = [
  {
    key: 'dojo',
    label: 'Dojos & clubs',
    singular: 'dojo',
    blurb:
      'Clubs, dojos and training centres chartered through their district or state unit. This is where training actually happens.',
  },
  {
    key: 'district',
    label: 'District associations',
    singular: 'district association',
    blurb:
      'District associations affiliated through their state association. A district unit charters the clubs beneath it.',
  },
  {
    key: 'state',
    label: 'State associations',
    singular: 'state association',
    blurb:
      'State associations affiliated directly to the national federation. A state unit charters the districts beneath it.',
  },
];

const q = Astro.url.searchParams;
const requested = (q.get('kind') || 'dojo').toLowerCase();
const kind: UnitKind = requested === 'district' || requested === 'state' ? requested : 'dojo';
const activeKind = KINDS.find((k) => k.key === kind)!;

/** Registry states are distinguished so an outage is never reported as "empty". */
type RegistryState = 'ready' | 'not_configured' | 'unavailable';

let entries: DirectoryEntry[] = [];
let state: RegistryState = 'not_configured';

if (isConfigured()) {
  try {
    // includeFormer is deliberately hard-coded on. See note 1 above.
    entries = await publicDirectory(db(), { kind, includeFormer: true, limit: 500 });
    state = 'ready';
  } catch (err) {
    // A read failure must never render as "no units are affiliated" — that is a
    // claim about the federation, made on the strength of a broken query.
    console.error('[dojos] directory read failed', err);
    state = 'unavailable';
  }
}

const currentCount = entries.filter((e) => e.affiliated).length;
const formerCount = entries.length - currentCount;

// ─── Training timings, from the editable branch record ──────────────────────
//
// Keyed by name, normalised for case and punctuation ONLY — no fuzzy match. Two
// different clubs must never collide onto one set of timings, so a name that
// does not match exactly simply does not match.
const fed = await get('federation');
const branches = (await get<any[]>('branches')) || [];
const nameKey = (v: unknown): string =>
  String(v ?? '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();

const timingsByName = new Map<string, Timings>();
for (const b of branches) {
  const key = nameKey(b?.name);
  if (!key) continue;
  const t = centreTimings(b, fed);
  // Only centres that have actually published timings enter the map, so a blank
  // record cannot shadow anything, and the absent case stays a single check.
  if (hasTimings(t)) timingsByName.set(key, t);
}

// ─── And, in preference to it, from the scheduling engine ───────────────────
//
// THE ENGINE OUTRANKS THE PROSE. A club that has published a real timetable —
// rows, with seasons that have dates — has answered this question properly, and
// the editorial string is a stand-in for clubs that have not. Where both exist
// the engine wins, because the engine is the one the club can change itself and
// the one that knows today is a public holiday.
//
// TODAY, NOT THE WEEK. A register row is a summary; a week per club is
// information the row has no space to show. A club's full week belongs on the
// club's own page.
//
// ONE CALL FOR THE WHOLE REGISTER. This used to resolve each club separately,
// which cost roughly six queries per club and forced a cap of sixty clubs with
// a note apologising for it. `directoryDay()` answers for every club in a fixed
// number of queries — twelve, whether the register holds two clubs or two
// thousand — so the cap is gone and every listed club gets a real answer.
// See src/db/schedule-directory.ts, and tests/schedule-directory.test.ts for
// the differential proof that it agrees with the canonical resolver.
let today = new Map<number, DirectoryDay>();

if (state === 'ready' && kind === 'dojo' && isConfigured()) {
  try {
    today = await directoryDay(db(), entries.map((e) => e.id), todayIso());
  } catch (err) {
    // An unreadable schedule service must not take the register down with it:
    // standing and charter validity are this page's subject and are already in
    // hand. Every row falls back to the editorial timing.
    console.warn('[dojos] schedule service read failed; falling back to the register', err);
  }
}

/**
 * The link a row puts on the club's name, or null for none.
 *
 * ONLY where an administrator SET a slug. Nothing here makes one up: a URL
 * derived from a name moves the next time somebody corrects a spelling, which
 * is why `publishableClubs()` refuses to mint them and why this page must not
 * either. A club with no slug stays plain text.
 *
 * And only while the unit is chartered or provisional, because that is exactly
 * what `clubProfile()` will serve — it returns null for every other standing.
 * A lapsed club is deliberately LISTED here (note 1 above); linking its name
 * would send the parent who most needs this page to a 404 instead of to the
 * standing that is stated, in words, on the row itself.
 */
const clubPageHref = (e: DirectoryEntry): string | null =>
  e.slug && (e.standing === 'chartered' || e.standing === 'provisional')
    ? `/clubs/${e.slug}`
    : null;

// Decorated once here rather than inside the template, so the register rows stay
// a plain map and the lookup cost is paid per centre instead of per render.
const rows = entries.map((e) => {
  const day = today.get(e.id) ?? null;
  return {
    e,
    // Only a club that has actually published counts as answered. `configured:
    // false` is the engine saying "they have not said", which is exactly when
    // the editorial fallback below should speak instead.
    day: day && day.configured ? day : null,
    timings: timingsByName.get(nameKey(e.name)) ?? null,
    clubHref: clubPageHref(e),
  };
});

const asAt = new Date();
const fmtDate = (iso: string | null): string => {
  if (!iso) return '';
  const d = new Date(`${iso}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
// RENAMED. Line 145 already declares a `today` (the schedule map), and two
// declarations of one name in a single frontmatter is a hard build failure. This
// one is the display date on the 'checked' line; the other is the opening-
// hours lookup. Different things, and now different names.
const checkedOnLabel = asAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const STANDING_LABEL: Record<DirectoryEntry['standing'], string> = {
  chartered: 'Chartered',
  provisional: 'Provisional',
  lapsed: 'Lapsed',
  suspended: 'Suspended',
  revoked: 'Revoked',
};

const where = (e: DirectoryEntry): string =>
  [e.city, e.district, e.state].filter(Boolean).join(' · ') || 'Location not recorded';

const pills: string[] =
  state === 'ready'
    ? entries.length
      ? [`${currentCount} currently affiliated`, `${formerCount} former or suspended`, `Checked ${checkedOnLabel}`]
      : ['Register open — no units recorded yet']
    : ['Register not available'];
---

<Base
  title={`${activeKind.label} — Affiliated Units Register — MMAKF`}
  description="The MMAKF register of affiliated dojos, district associations and state associations, showing the standing and charter validity of each. Units whose charter has lapsed remain listed and are shown as lapsed."
>
  <PageHero
    eyebrow="Public register"
    title={`Affiliated <em class="r">units</em>.`}
    lead="Every dojo, district association and state association the federation has chartered — with the standing of each, and the date its charter runs to. A unit whose charter has lapsed is not removed from this page; it is shown as lapsed, so a member training there can find that out."
    pills={pills}
  />

  {/* ═══════ HOW TO READ THIS DIRECTORY ═══════ */}
  <section>
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Read this first</div>
        <h2 class="display-2">What a listing <em class="r">does</em> and does not say.</h2>
        <div class="rule"></div>
      </div>

      <div class="dir-key fade">
        <div class="card dir-key-card dir-key-yes">
          <div class="card-eyebrow">What it means</div>
          <h3 class="card-title">A standing, on a date</h3>
          <p class="card-body">
            Each row states the unit’s affiliation standing as recorded in the federation’s register,
            and the date its charter or provisional term runs to. Both are read from the register at
            the moment you load this page. Where the federation has recorded no validity date, the
            row says so rather than implying an open-ended charter.
          </p>
        </div>
        <div class="card dir-key-card dir-key-no">
          <div class="card-eyebrow">What it does not mean</div>
          <h3 class="card-title">Not a quality rating, not a full list of clubs</h3>
          <p class="card-body">
            This register lists units the federation has chartered. It is not a rating of teaching, and
            a club’s absence from it is not a statement that the club is unaffiliated to anything — only
            that MMAKF has no affiliation recorded for it here. Applications that were never granted at
            least provisional affiliation are never listed. No address, telephone number or email
            appears on this page.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════ THE REGISTER ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">The register</div>
        <h2 class="display-2">{activeKind.label}.</h2>
        <div class="rule"></div>
        <p class="lead">{activeKind.blurb}</p>
      </div>

      <nav class="dir-tabs fade" aria-label="Choose a unit level">
        {KINDS.map((k) => (
          <a
            href={`/dojos?kind=${k.key}`}
            class="dir-tab"
            class:list={[{ active: k.key === kind }]}
            aria-current={k.key === kind ? 'page' : undefined}
          >
            {k.label}
          </a>
        ))}
      </nav>

      {state === 'not_configured' && (
        <div class="dir-state fade" role="note">
          <h3 class="dir-state-h">The affiliation register is not available in this environment</h3>
          <p class="body-txt">
            The federation records database is not configured for this deployment, so this page cannot
            read the affiliation register. <strong>This is a deployment state, not an empty
            register</strong> — nothing on this page should be read as a statement that no unit is
            affiliated. The federation office holds the register and can confirm the standing of any
            unit.
          </p>
          <div class="flex flex-wrap gap-3 mt-6">
            <a href="/contact" class="btn btn-gold">Ask the federation office</a>
            <a href="/affiliation" class="btn btn-ghost">How affiliation works</a>
          </div>
        </div>
      )}

      {state === 'unavailable' && (
        <div class="dir-state dir-state-err fade" role="alert">
          <h3 class="dir-state-h">The register could not be read just now</h3>
          <p class="body-txt">
            The federation records service did not answer this request.
            <strong> This is not a result about any unit</strong> — it is a fault on our side. Please
            try again shortly, or ask the federation office to confirm a unit’s standing directly.
          </p>
          <div class="flex flex-wrap gap-3 mt-6">
            <a href={`/dojos?kind=${kind}`} class="btn btn-primary">Try again</a>
            <a href="/contact" class="btn btn-ghost">Ask the federation office</a>
          </div>
        </div>
      )}

      {state === 'ready' && entries.length === 0 && (
        <div class="dir-state fade" role="note">
          <h3 class="dir-state-h">No {activeKind.singular} has been entered in this register yet</h3>
          <p class="body-txt">
            The federation is building this register. This page shows what MMAKF has recorded in this
            system and nothing else, so an empty table here means <strong>no {activeKind.singular} has
            yet been recorded</strong> — it is not a finding that none exists, and it is not a
            statement about any particular club. Units appear here as the office enters and charters
            them.
          </p>
          <div class="flex flex-wrap gap-3 mt-6">
            <a href="/affiliation" class="btn btn-gold">Apply to affiliate a unit</a>
            <a href="/contact" class="btn btn-ghost">Ask the federation office</a>
          </div>
        </div>
      )}

      {state === 'ready' && entries.length > 0 && (
        <div class="fade">
          <div class="dir-controls">
            <div class="dir-search">
              <label class="input-label" for="dir-q">Find a unit by name, code or town</label>
              <input
                id="dir-q"
                class="input"
                type="search"
                autocomplete="off"
                placeholder="e.g. Patratu, or MMAKF-DOJO"
                aria-describedby="dir-count"
              />
            </div>
            <fieldset class="dir-standing">
              <legend class="input-label">Show</legend>
              <div class="dir-chips">
                <button type="button" class="dir-chip active" data-show="all" aria-pressed="true">
                  All {entries.length}
                </button>
                <button type="button" class="dir-chip" data-show="current" aria-pressed="false">
                  Currently affiliated {currentCount}
                </button>
                <button type="button" class="dir-chip" data-show="former" aria-pressed="false">
                  Lapsed, suspended or revoked {formerCount}
                </button>
              </div>
            </fieldset>
          </div>

          <p class="dir-count" id="dir-count" role="status" aria-live="polite">
            Showing all {entries.length} recorded {entries.length === 1 ? 'unit' : 'units'}.
          </p>

          <ul class="dir-list" id="dir-list">
            {rows.map(({ e, day, timings, clubHref }) => (
              <li
                class="dir-row"
                data-search={`${e.name} ${e.code} ${where(e)}`.toLowerCase()}
                data-group={e.affiliated ? 'current' : 'former'}
              >
                <div class="dir-main">
                  <h3 class="dir-name">
                    {clubHref ? <a href={clubHref}>{e.name}</a> : e.name}
                  </h3>
                  <div class="dir-code">{e.code}</div>
                  <div class="dir-where">{where(e)}</div>
                </div>

                <div class="dir-standing-cell">
                  <span
                    class="pill dir-pill"
                    class:list={[`st-${e.standing}`]}
                  >
                    <span class="pill-dot"></span>{STANDING_LABEL[e.standing]}
                  </span>
                  <div class="dir-affil" class:list={[{ no: !e.affiliated }]}>
                    {e.affiliated ? 'Affiliated today' : 'Not affiliated today'}
                  </div>
                </div>

                <dl class="dir-meta">
                  <div class="dir-meta-row">
                    <dt>Affiliated since</dt>
                    <dd>{e.affiliatedSince ? fmtDate(e.affiliatedSince) : 'Not recorded'}</dd>
                  </div>
                  <div class="dir-meta-row">
                    <dt>Charter valid to</dt>
                    <dd>
                      {e.charterValidUntil ? (
                        <Fragment>
                          {fmtDate(e.charterValidUntil)}
                          {e.charterCurrent === false && <span class="dir-expired"> — passed</span>}
                        </Fragment>
                      ) : (
                        'No validity date recorded'
                      )}
                    </dd>
                  </div>
                  <div class="dir-meta-row">
                    <dt>Training timings</dt>
                    <dd>
                      {day ? (
                        <Fragment>
                          <div>{summariseDay(day)}</div>
                          {/* WHOSE hours these are, whenever they are not the
                              club's own. A club that appears to have confirmed
                              timings it has never seen is the failure this
                              engine exists to prevent. */}
                          {!day.isOwnSchedule && day.inheritedFromLabel && (
                            <div class="dir-untimed">Following {day.inheritedFromLabel}</div>
                          )}
                          {day.exceptionKinds.length > 0 && (
                            <div class="dir-untimed">Today: {day.exceptionKinds.join(', ').replace(/_/g, ' ')}</div>
                          )}
                        </Fragment>
                      ) : timings ? (
                        <Fragment>
                          {timings.hours && <div>{timings.hours}</div>}
                          {timings.sunday && <div>{timings.sunday}</div>}
                        </Fragment>
                      ) : (
                        <span class="dir-untimed">Not published — ask the centre</span>
                      )}
                    </dd>
                  </div>
                </dl>

                {e.note && <p class="dir-note">{e.note}</p>}
              </li>
            ))}
          </ul>
          <p class="dir-empty" id="dir-empty" hidden role="status">
            No recorded unit matches that search. Try part of the town name, or clear the filter — a
            club the federation has never chartered will not appear here at all.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* ═══════ WHAT TO DO WITH A LAPSED UNIT ═══════ */}
  {state === 'ready' && formerCount > 0 && (
    <section>
      <div class="container">
        <div class="dir-adv fade" role="note">
          <div class="eyebrow">If your club shows as lapsed</div>
          <h2 class="dir-adv-h">A lapsed charter is a renewal, not an accusation.</h2>
          <div class="rule"></div>
          <p class="body-txt">
            A charter runs to a date. When that date passes without a renewal being recorded, the unit
            shows here as lapsed — which is exactly what the register says and no more. It is not a
            finding of wrongdoing, and it does not say anything about the instruction at that club. It
            does mean the federation cannot presently confirm the unit as affiliated, and members
            training there should ask the club and the office where the renewal stands.
          </p>
          <div class="flex flex-wrap gap-3 mt-6">
            <a href="/affiliation" class="btn btn-gold">Affiliation &amp; renewal</a>
            <a href="/contact" class="btn btn-ghost">Contact the federation office</a>
          </div>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Client-side narrowing only. Every row was already rendered by the server, so
  // with JavaScript off the full register is still readable — the controls just
  // do nothing rather than hiding the page's content behind a script.
  const list = document.getElementById('dir-list');
  const box = document.getElementById('dir-q') as HTMLInputElement | null;
  const count = document.getElementById('dir-count');
  const empty = document.getElementById('dir-empty');

  if (list && count) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.dir-row'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.dir-chip'));
    let group = 'all';

    const apply = () => {
      const term = (box?.value || '').trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const matchesText = !term || (row.dataset.search || '').includes(term);
        const matchesGroup = group === 'all' || row.dataset.group === group;
        const visible = matchesText && matchesGroup;
        row.hidden = !visible;
        if (visible) shown++;
      }
      count.textContent =
        shown === rows.length
          ? `Showing all ${rows.length} recorded ${rows.length === 1 ? 'unit' : 'units'}.`
          : `Showing ${shown} of ${rows.length} recorded units.`;
      if (empty) empty.hidden = shown !== 0;
    };

    box?.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        group = chip.dataset.show || 'all';
        for (const c of chips) {
          const on = c === chip;
          c.classList.toggle('active', on);
          c.setAttribute('aria-pressed', String(on));
        }
        apply();
      });
    }
  }
</script>

<style>
  .bg2 { background: var(--bg-2); }

  /* ── Key cards ── */
  .dir-key { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 780px) { .dir-key { grid-template-columns: 1fr; } }
  .dir-key-card { border-top: 3px solid var(--border-2); }
  .dir-key-yes { border-top-color: var(--gold-dim); }
  .dir-key-no { border-top-color: var(--red); }

  /* ── Level tabs ── */
  .dir-tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .dir-tab {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 20px;
    border: 1px solid var(--border-2);
    background: var(--card);
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--off-white);
    border-radius: var(--radius);
  }
  .dir-tab:hover { border-color: var(--gold-dim); color: var(--gold-2); }
  .dir-tab.active { background: var(--red); border-color: var(--red); color: #fff; }

  /* ── State panels ── */
  .dir-state {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold-dim);
    padding: 28px 30px;
    max-width: 78ch;
  }
  .dir-state-err { border-left-color: var(--red); }
  @media (max-width: 520px) { .dir-state { padding: 22px 18px; } }
  .dir-state-h {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 10px;
  }

  /* ── Controls ── */
  .dir-controls {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: 18px 28px;
    align-items: end;
    margin-bottom: 18px;
  }
  @media (max-width: 780px) { .dir-controls { grid-template-columns: 1fr; align-items: stretch; } }
  .dir-standing { border: 0; padding: 0; margin: 0; min-width: 0; }
  .dir-standing legend { padding: 0; }
  .dir-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .dir-chip {
    min-height: 44px;
    padding: 8px 16px;
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--off-white);
  }
  .dir-chip:hover { border-color: var(--gold-dim); color: var(--gold-2); }
  .dir-chip.active { background: var(--red); border-color: var(--red); color: #fff; }

  .dir-count, .dir-empty {
    font-size: 0.84rem;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .dir-empty { margin-top: 18px; max-width: 70ch; }

  /* ── Rows ── */
  .dir-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .dir-row {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-2);
    padding: 20px 22px;
    display: grid;
