---
/**
 * Individual profile.
 *
 * The rule this page exists to enforce: a TITLE and a GRADE are different kinds
 * of credential, and a federation that prints them on one line reads as
 * inflation to exactly the audience it most wants to convince. Dan is a grade,
 * examined and awarded. Soke, Shihan, Renshi and Sensei are not grades at all.
 * Stated apart, with what each one means, they are stronger than stated
 * together — so this page never concatenates them.
 *
 * The second rule: nothing here is written by the page. Every line is a field
 * the federation recorded, and an honour renders WITH the source it was
 * recorded from. A field the federation has not recorded renders as absent —
 * never as a placeholder, an approximation, or a stock photograph.
 *
 * The third rule, and the most recently learned: AN ABSENCE IS NOT ANNOUNCED.
 * This page used to print "No photograph of X is held on the federation record"
 * under the monogram tile. That sentence was true and had no business on a
 * public page — it reads as the federation apologising for its own records to
 * the schools and parents it is trying to convince. Never invent a fact stands;
 * narrating the gap to a visitor does not follow from it. What is not held is
 * simply left out, and a section with nothing to show does not render at all.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { get } from '@/lib/storage';
import { slugify, initials } from '@/lib/people';
import { glossFor, hasDevanagari } from '@/lib/press-gloss';

export const prerender = false;

const { slug } = Astro.params;

const leadership = (await get<any[]>('leadership')) || [];
const person = leadership.find((p: any) => p?.name && slugify(p.name) === slug);

if (!person) {
  return new Response(null, { status: 404, statusText: 'No such profile' });
}

const schedule = (await get<any[]>('schedule')) || [];
const programs = (await get<any[]>('programs')) || [];
const press = (await get<any[]>('press')) || [];
const social = (await get<any[]>('social')) || [];
const branches = (await get<any[]>('branches')) || [];
const fed = await get<any>('federation');

/**
 * Devanagari forms of names, keyed on the EXACT recorded name. A press clipping
 * printed in Hindi names the person in Hindi; matching only the Latin spelling
 * would miss it. This is transliteration of a name the federation already
 * recorded — not a new fact about anybody. An unlisted name simply matches on
 * its Latin form alone.
 */
const DEVANAGARI: Record<string, string[]> = {
  'Shihan Pramod Kumar Pathak': ['प्रमोद'],
  'Sensei Vikas Pathak': ['विकास'],
};

/**
 * A clipping belongs on a profile only when it NAMES the person. Nothing is
 * inferred from a shared surname, a shared dojo or a shared date — three of the
 * six people on this platform are called Pathak, and guessing would attribute
 * one person's coverage to another.
 */
const mentions = (text: string, p: any): boolean => {
  const hay = (text || '').toLowerCase();
  const parts = (p.name || '').split(/\s+/).filter(Boolean);
  // Drop the honorific: 'Shihan Pramod Kumar Pathak' matches on Pramod + Pathak.
  const HONORIFICS = new Set(['shihan', 'sensei', 'senpai', 'soke', 'renshi', 'kyoshi', 'hanshi']);
  const names = parts.filter((w: string) => !HONORIFICS.has(w.toLowerCase())).map((w: string) => w.toLowerCase());
  if (names.length && names.every((n: string) => hay.includes(n))) return true;
  return (DEVANAGARI[p.name] || []).some((d) => (text || '').includes(d));
};

const clippings = press.filter(
  (c: any) => c && c.img && mentions(`${c.headline || ''} ${c.summary || ''}`, person)
);

/** Sessions this person teaches, taken from the published timetable. */
const teaches = schedule.filter((s: any) => s?.ins === person.name);

/** Programmes whose published description names this person as the authority. */
const leads = programs.filter((pr: any) => mentions(`${pr?.name || ''} ${pr?.desc || ''}`, person));

const titles: any[] = Array.isArray(person.titles) ? person.titles : [];

/**
 * IS THE RECORDED RANK AN EXAMINED DAN GRADE?
 *
 * This page printed the heading "Examined rank" and the sentence "A Dan grade
 * is awarded on examination..." over WHATEVER `rank` held. One person's rank is
 * recorded as "WKF Registered" — an international registration, not a grade
 * anybody examined him for — so his profile described a credential he does not
 * hold, in the same breath as a page whose whole point is that a title and a
 * grade are different things. The explanation is now shown only where it is
 * true; every other rank is printed exactly as recorded and left to stand.
 */
const isDan = /\bdan\b/i.test(person.rank || '');

/**
 * An honour renders only WITH the publication it was recorded from. `source` is
 * a field of its own precisely so this filter can exist: an honour with no
 * source is dropped here rather than published on the word of this site alone.
 */
const honours: any[] = (Array.isArray(person.honours) ? person.honours : []).filter(
  (h: any) => h && h.title && h.source
);

/**
 * A MASTER, NOT A LINEAGE.
 *
 * The federation states that his master, Grandmaster S N T Lee, awarded him the
 * name "Junior Tiger Lee". That is a person conferring a name on his student.
 * It is NOT the claim that MMAKF descends from a school of that name — a claim
 * this site once made in nine places and withdrew. The record models it as a
 * named relationship and this page renders it as one; neither ever converts it
 * into a school, a style or a chain of transmission.
 */
const master = person.master && person.master.name ? person.master : null;

/** Appointments the federation's own registers record against this person. */
const authority: any[] = Array.isArray(person.authority) ? person.authority : [];
const postings = branches.filter((b: any) => b?.incharge === person.name && b?.name);

/** Only the federation's own channels, and only where an address is recorded. */
const safeHref = (u: string): string | null => {
  const v = (u || '').trim();
  if (!v) return null;
  if (v.startsWith('/') && !v.startsWith('//')) return v;
  try {
    const proto = new URL(v).protocol;
    return proto === 'http:' || proto === 'https:' ? v : null;
  } catch {
    return null;
  }
};
/**
 * WHOSE CHANNEL IS WHOSE.
 *
 * This section used to render every `primary: 'Yes'` channel under the caption
 * "these are the federation's channels, not this person's personal accounts".
 * The only channel marked primary is Shihan Pathak's own teaching academy — so
 * on his page the caption denied that his channel was his, and on everybody
 * else's page it handed his channel to the federation. Both are misattribution.
 *
 * A channel is now claimed BY ADDRESS on a person's own record. A claimed
 * channel appears on that person's profile and on no other; an unclaimed
 * channel is the federation's and appears as such.
 */
const ownUrls: string[] = Array.isArray(person.ownChannels) ? person.ownChannels : [];
const claimed = new Set<string>(
  leadership.flatMap((p: any) => (Array.isArray(p?.ownChannels) ? p.ownChannels : []))
);
const ownChannels = social.filter((a: any) => a && safeHref(a.url) && ownUrls.includes(a.url));
const fedChannels = social.filter(
  (a: any) => a && safeHref(a.url) && a.primary === 'Yes' && !claimed.has(a.url)
);

const others = leadership.filter((p: any) => p?.name && p.name !== person.name);

/**
 * Structured data. Only fields the federation recorded are emitted — an empty
 * `image` is omitted rather than pointed at a placeholder, because a search
 * engine repeating a placeholder as this person's photograph is the same
 * misattribution as printing it on the page.
 */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  url: `https://www.mmakf.in/people/${slug}`,
  worksFor: { '@type': 'SportsOrganization', name: 'Modern Martial Arts Karate-Do Federation of India', url: 'https://www.mmakf.in' },
};
if (person.img) jsonLd.image = person.img;
if (person.addressedAs) jsonLd.honorificPrefix = person.addressedAs;
if (honours.length) jsonLd.award = honours.map((h: any) => (h.year ? `${h.title} (${h.year})` : h.title));
if (person.bio) jsonLd.description = person.bio;
---

<Base
  title={`${person.name} — ${person.role} · MMAKF`}
  description={person.bio || `${person.name}, ${person.role} of the Modern Martial Arts Karate-Do Federation of India.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* ═══════ IDENTITY ═══════ */}
  <section class="prof-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/governance">Governance</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{person.name}</span>
      </nav>

      <div class="prof-id">
        <div class="prof-portrait">
          {person.img
            ? <img src={person.img} alt={`Portrait of ${person.name}`} loading="eager" />
            : (
              /* The monogram stands on its own. Where no photograph is held,
                 nothing is said about it: the tile is decorative and the name
                 it stands for is the <h1> beside it. */
              <div class="prof-mono-lg" aria-hidden="true">{initials(person.name)}</div>
            )}
        </div>

        <div>
          <div class="eyebrow">{person.role}</div>
          <h1 class="display-1 prof-name">{person.name}</h1>
          {person.addressedAs && (
            <p class="prof-address">Addressed as {person.addressedAs}</p>
          )}
          {person.since && (
            <p class="prof-since">In the federation since {person.since}</p>
          )}
          {person.specialty && <p class="lead" style="max-width:52ch">{person.specialty}</p>}
        </div>
      </div>
    </div>
  </section>

  {/* ═══════ GRADE, AND TITLES, HELD APART ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="grid grid-2 gap-6">
        <div>
          <div class="section-head" style="margin-bottom:20px">
            <div class="eyebrow">{isDan ? 'Grade' : 'Standing'}</div>
            <h2 class="display-2" style="font-size:clamp(1.4rem,2.4vw,1.9rem)">
              {isDan ? <>Examined <em>rank</em>.</> : <>As <em>recorded</em>.</>}
            </h2>
            <div class="rule gold"></div>
          </div>
          <div class="card">
            <div class="card-title" style="color:var(--gold)">{person.rank}</div>
            {isDan && (
              <div class="card-body" style="font-size:.88rem">
                A Dan grade is awarded on examination and is recorded against the person in the
                federation's rank register, where every grade a person has ever held is retained —
                a promotion supersedes the previous grade, it does not erase it.
              </div>
            )}
          </div>
        </div>

        {titles.length > 0 && (
          <div>
            <div class="section-head" style="margin-bottom:20px">
              <div class="eyebrow">Titles</div>
              <h2 class="display-2" style="font-size:clamp(1.4rem,2.4vw,1.9rem)">Held <em class="r">separately</em>.</h2>
              <div class="rule"></div>
            </div>
            <dl class="title-list">
              {titles.map((t: any) => (
                <div class="title-row">
                  <dt>{t.title}</dt>
                  <dd>{t.meaning}</dd>
                </div>
              ))}
            </dl>
            <p class="text-muted" style="font-size:.8rem;margin-top:14px;max-width:56ch">
              None of these is a grade. They are forms of address and standing within the system,
              and the federation records them apart from rank for that reason.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* ═══════ HIS MASTER, AND THE NAME HIS MASTER GAVE HIM ═══════ */}
  {master && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Teacher</div>
          {/* No pronoun. The federation stated this about one man, but the
              section is data-driven and the next person recorded with a master
              may not be a man — a heading that hard-codes "him" would misname
              her on her own profile. */}
          <h2 class="display-2">The <em class="r">master</em>, and the name conferred.</h2>
          <div class="rule"></div>
        </div>
        <dl class="master-list">
          <div class="master-row">
            <dt>{master.relation || 'Master'}</dt>
            <dd class="master-name">{master.name}</dd>
          </div>
          {master.conferred && (
            <div class="master-row">
              <dt>Name conferred</dt>
              <dd>
                “{master.conferred}”{master.conferredShort && <> — {master.conferredShort}</>}
              </dd>
            </div>
          )}
          {person.addressedAs && (
            <div class="master-row">
              <dt>Addressed as</dt>
              <dd>{person.addressedAs}</dd>
            </div>
          )}
          {master.source && (
            <div class="master-row">
              <dt>Recorded from</dt>
              <dd class="text-muted">{master.source}</dd>
            </div>
          )}
        </dl>
      </div>
    </section>
  )}

  {/* ═══════ BIOGRAPHY ═══════ */}
  {person.bio && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Record</div>
          <h2 class="display-2">The <em>account</em>.</h2>
          <div class="rule"></div>
        </div>
        <p class="body-txt" style="font-size:1.02rem;max-width:68ch">{person.bio}</p>
      </div>
    </section>
  )}

  {/* ═══════ HONOURS, WITH THEIR SOURCES ═══════ */}
  {honours.length > 0 && (
    <section class="bg2">
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Honours</div>
          <h2 class="display-2">Conferred, and <em class="r">where it is recorded</em>.</h2>
          <div class="rule"></div>
          <p class="lead">
            Each entry carries the publication it was recorded from.
          </p>
        </div>
        <div class="grid grid-2">
          {honours.map((h: any) => (
            <div class="card fade">
              <div class="card-icon"><Icon name="medal" size={32} color="var(--gold)" /></div>
              <div class="card-title">{h.title}</div>
              {h.year && <div class="honour-year">{h.year}</div>}
              {h.note && <div class="card-body" style="font-size:.88rem">{h.note}</div>}
              <p class="honour-src">
                <span class="honour-src-k">Recorded in</span>
                <span>{h.source}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ═══════ WHAT THE REGISTERS RECORD AGAINST THIS PERSON ═══════ */}
  {(authority.length > 0 || postings.length > 0) && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Appointments</div>
          <h2 class="display-2">What the <em>registers</em> record.</h2>
          <div class="rule"></div>
        </div>

        {authority.length > 0 && (
          <div class="grid grid-2" style="margin-bottom:32px">
            {authority.map((a: any) => (
              <div class="card fade">
                <div class="card-icon"><Icon name="shield" size={30} color="var(--gold)" /></div>
                <div class="card-title" style="font-size:1rem">{a.role}</div>
                {a.detail && <div class="card-body" style="font-size:.88rem">{a.detail}</div>}
                {a.href && (
                  <div style="margin-top:14px">
                    <a class="text-gold" href={a.href} style="font-size:.82rem">The register &rarr;</a>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

        {postings.length > 0 && (
          <div class="tbl-scroll fade">
            <table class="doc-tbl">
              <caption class="sr-only">Branches of which {person.name} is officer-in-charge</caption>
              <thead>
                <tr><th scope="col">Centre</th><th scope="col">City</th><th scope="col">District</th><th scope="col">Standing</th></tr>
              </thead>
              <tbody>
                {postings.map((b: any) => (
                  <tr>
                    <td style="font-family:var(--font-display);font-weight:600">{b.name}</td>
                    <td>{b.city}</td>
                    <td class="text-muted">{b.district}</td>
                    <td><span class="pill">{b.status}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  )}

  {/* ═══════ CLIPPINGS THAT NAME THIS PERSON ═══════ */}
  {clippings.length > 0 && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Press archive</div>
          <h2 class="display-2">Clippings that <em>name</em> {person.name.split(/\s+/).slice(-1)[0]}.</h2>
          <div class="rule"></div>
          <p class="lead">
            Scans held by the federation office. A clipping appears on this page only where the
            printed text names this person — nothing is attributed by shared surname or shared date.
          </p>
        </div>
        <div class="grid grid-2">
          {clippings.map((c: any) => (
            <article class="card fade">
              <img class="clip-img" src={c.img} alt={`Newspaper clipping — ${c.outlet} · ${c.date}`} loading="lazy" />
              <div class="card-eyebrow">{c.outlet} · {c.date}</div>
              <div class="card-title" style="font-size:1rem" lang={hasDevanagari(c.headline) ? 'hi' : 'en'}>{c.headline}</div>
              {/* The printed headline, then its English gloss — the same table
                  /press reads, imported rather than copied. A headline with no
                  gloss recorded simply shows the headline. */}
              {glossFor(c.headline) && (
                <p class="clip-gloss">
                  “{glossFor(c.headline)}”
                  <span class="clip-gloss-k">English translation of the printed headline</span>
                </p>
              )}
              <div class="card-body" style="font-size:.86rem">{c.summary}</div>
              {c.verified && <div style="margin-top:14px"><span class="pill">{c.verified}</span></div>}
            </article>
          ))}
        </div>
        <div class="mt-6">
          <a href="/press" class="btn btn-ghost">The full press archive →</a>
        </div>
      </div>
    </section>
  )}

  {/* ═══════ WHAT THEY TEACH ═══════ */}
  {(teaches.length > 0 || leads.length > 0) && (
    <section class="bg2">
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">On the mat</div>
          <h2 class="display-2">What {person.name.split(/\s+/).slice(-1)[0]} <em class="r">teaches</em>.</h2>
          <div class="rule"></div>
        </div>

        {leads.length > 0 && (
          <div class="grid grid-2" style="margin-bottom:32px">
            {leads.map((pr: any) => (
              <div class="card fade">
                <div class="card-icon"><Icon name={pr.icon || 'star'} size={30} color="var(--gold)" /></div>
                <div class="card-title" style="font-size:1rem">{pr.name}</div>
                <div class="card-body" style="font-size:.86rem">{pr.desc}</div>
                {pr.lvl && <div style="margin-top:14px"><span class="pill">{pr.lvl}</span></div>}
              </div>
            ))}
          </div>
        )}

        {teaches.length > 0 && (
          <div class="tbl-scroll fade">
            <table class="doc-tbl">
              <caption class="sr-only">Timetable sessions taught by {person.name}</caption>
              <thead>
                <tr><th scope="col">Day</th><th scope="col">Time</th><th scope="col">Session</th><th scope="col">Level</th><th scope="col">Mode</th></tr>
              </thead>
              <tbody>
                {teaches.map((s: any) => (
                  <tr>
                    <td style="font-family:var(--font-display);font-weight:600">{s.day}</td>
                    <td>{s.t}</td>
                    <td>{s.d}</td>
                    <td class="text-muted">{s.lvl}</td>
                    <td><span class="pill">{s.mode === 'online' ? 'Online' : 'Dojo'}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/schedule" class="btn btn-ghost">Full timetable →</a>
          <a href="/programs" class="btn btn-ghost">All programmes →</a>
        </div>
      </div>
    </section>
  )}

  {/* ═══════ CHANNELS — HIS, AND THE FEDERATION'S, NOT MIXED ═══════ */}
  {(ownChannels.length > 0 || fedChannels.length > 0) && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">Channels</div>
          <h2 class="display-2">Where {person.name.split(/\s+/).slice(-1)[0]} <em>publishes</em>.</h2>
          <div class="rule"></div>
        </div>

        {ownChannels.length > 0 && (
          <div class="chan-block">
            {/* Named, not gendered: this heading renders for whoever claims a
                channel, and "His own" would have misnamed the first woman to. */}
            <h3 class="chan-head">{person.name.split(/\s+/).slice(-1)[0]}'s own</h3>
            <div class="chan-list">
              {ownChannels.map((a: any) => (
                <a class="card hoverable chan" href={safeHref(a.url)} target="_blank" rel="noopener">
                  <div class="card-eyebrow">{a.platform}</div>
                  <div class="card-title" style="font-size:.98rem">{a.name}</div>
                  {a.note && <div class="card-body" style="font-size:.84rem">{a.note}</div>}
                </a>
              ))}
            </div>
          </div>
        )}

        {fedChannels.length > 0 && (
          <div class="chan-block">
            <h3 class="chan-head">The federation's</h3>
            <div class="chan-list">
              {fedChannels.map((a: any) => (
                <a class="card hoverable chan" href={safeHref(a.url)} target="_blank" rel="noopener">
                  <div class="card-eyebrow">{a.platform}</div>
                  <div class="card-title" style="font-size:.98rem">{a.name}</div>
                  {a.note && <div class="card-body" style="font-size:.84rem">{a.note}</div>}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mt-6">
          <a href="/press#channels" class="btn btn-ghost">Every official channel →</a>
        </div>
      </div>
    </section>
  )}

  {/* ═══════ THE REST OF THE FACULTY ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Faculty</div>
        <h2 class="display-2">The rest of the <em class="r">senior faculty</em>.</h2>
        <div class="rule"></div>
      </div>
      <div class="grid grid-3">
        {others.map((p: any) => (
          <a class="card hoverable fade" href={`/people/${slugify(p.name)}`}>
            <div class="prof-head">
              {p.img
                ? <img class="prof-avatar" src={p.img} alt="" loading="lazy" />
                : <div class="prof-mono" aria-hidden="true">{initials(p.name)}</div>}
              <div>
                <div style="font-family:var(--font-display);font-weight:600;font-size:.98rem;color:var(--white)">{p.name}</div>
                <div style="font-family:var(--font-display);font-size:.64rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin-top:4px">{p.role}</div>
              </div>
            </div>
            <div style="margin:12px 0"><span class="pill">{p.rank}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════ PROVENANCE ═══════ */}
  <section>
    <div class="container">
      <div class="card" style="max-width:72ch">
        <div class="card-eyebrow">Provenance</div>
        {/* Each sentence is conditional on the section it describes. A page with
            no honours on it does not explain how its honours are sourced. */}
        <div class="card-body" style="font-size:.86rem">
          Everything on this page is a field held in the federation's own record.
          {honours.length > 0 && (
            <> Honours are shown with the publication they were recorded from.</>
          )}
          {clippings.length > 0 && (
