---
/**
 * THE HOMBU DOJO'S WEEK — /schedule
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * WHAT THIS PAGE USED TO CLAIM, AND WHY IT WAS WRONG
 * ─────────────────────────────────────────────────────────────────────────────
 *
 * It published one timetable under the heading "The weekly timetable" and
 * called it MMAKF's. It is the HEADQUARTERS' timetable. An affiliated club in
 * Bokaro that trains Monday to Friday, 18:00 to 21:00, was being represented on
 * the federation's own site as training at six in the morning — and a parent
 * who read this page and turned up at a club sixty miles away found a locked
 * door, with the federation's name over it.
 *
 * So the framing on this page is now explicit in three places: the title, the
 * lead, and a line above the table. This is ONE dojo's week. Every other club
 * publishes its own, and /dojos is how you find it.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * TWO SOURCES, AND THE ORDER MATTERS
 * ─────────────────────────────────────────────────────────────────────────────
 *
 * The federation's opening hours are moving out of two English sentences on the
 * editorial record and into the scheduling engine (migration 0032), where they
 * are days, windows, named seasons with dates, and versions nobody overwrites.
 * That migration is performed by an administrator, per club, and until it has
 * been done for a club the strings are still what the federation publishes.
 *
 * This page therefore reads the ENGINE FIRST and falls back to the editorial
 * strings, and it renders whichever it used without pretending. The alternative
 * — switching the page over on the day the migration ships — would blank the
 * timings of every club that has not been migrated yet, which is the failure
 * mode this project treats as unforgivable: a page that goes quiet rather than
 * one that says it does not know.
 *
 * Nothing here computes an hour. Every time on screen comes from a row.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import EnrollCTA from '@/components/EnrollCTA.astro';
import OpeningHours from '@/components/OpeningHours.astro';
import { get } from '@/lib/storage';
import { isConfigured, db } from '@/db';
import { headquartersDojo, publishedWeek, todayIso, addDays, type PublishedWeek } from '@/db/scheduling';

export const prerender = false;

const fed = await get('federation');
const schedule = await get<any[]>('schedule');
const programs = await get<any[]>('programs');

// ── The engine, when it has an answer ──────────────────────────────────────
//
// Wrapped because a public page must not 500 on a database that is unreachable
// or unmigrated: the editorial strings below are a complete answer on their own,
// and losing the register must not take the timetable off the internet.
let hqWeek: PublishedWeek | null = null;
let hqName = '';
if (isConfigured()) {
  try {
    const database = db();
    const hq = await headquartersDojo(database);
    if (hq) {
      hqName = hq.name;
      const from = todayIso();
      hqWeek = await publishedWeek(database, { dojoId: hq.id }, from, addDays(from, 6));
    }
  } catch (err) {
    console.warn('/schedule: the scheduling engine was unreachable; falling back to the published strings', err);
  }
}
const usingEngine = Boolean(hqWeek?.configured);

// HOW MANY DAYS THE DOJO IS OPEN IS A FACT ABOUT THE TIMETABLE, so it is counted
// from the schedule the federation edits at /admin and never typed here. The
// page used to assert "Twelve batches" and "seven days" as literals; delete a
// Sunday row from the admin console and the literals would have gone on
// claiming a week that no longer existed.
const DAY_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven'];
const openDays = new Set((schedule ?? []).map((s: any) => s.day).filter(Boolean)).size;
const openDaysLabel = DAY_WORDS[openDays] ?? String(openDays);
const onlineDays = [...new Set(
  (schedule ?? [])
    .filter((s: any) => String(s.mode).toLowerCase() === 'online')
    .map((s: any) => s.day)
    .filter(Boolean),
)];
// Both hour strings come from the editable federation record. hoursSunday is
// optional: a record saved before the field existed renders the weekday line alone.
const hoursLine = [fed.contact.hours, fed.contact.hoursSunday].filter(Boolean).join('. ');

const etiquette = [
  'Bow (rei) when entering and leaving the dojo floor.',
  'Arrive 10 minutes early; late entrants wait at the edge of the mat for the sensei\'s signal.',
  'Train barefoot — no shoes, jewellery or watches on the tatami.',
  'Keep your gi clean and your belt tied correctly.',
  'Address instructors as Sensei or Shihan; respond with "Oss".',
  'No free sparring without an instructor\'s supervision.',
];
---

<Base
  title="Headquarters Class Schedule — MMAKF"
  description="The weekly class timetable at the MMAKF headquarters dojo in Patratu — dojo and online batches. Affiliated clubs publish their own timings."
>
  <PageHero
    image="https://images.unsplash.com/photo-1599058917212-d750089bc07e?auto=format&fit=crop&w=1800&q=70"
    eyebrow="Headquarters Timetable"
    title={`The <em>hombu dojo</em> week.`}
    lead={`${schedule.length} batches a week across dojo and online, ${openDaysLabel} days. ${hoursLine}. Affiliated clubs set their own timings — find yours in the club directory.`}
    pills={['Dojo · Patratu', 'Online · Worldwide']}
  />

  {/* ═══════ WHOSE WEEK THIS IS ═══════
      Stated before the table, not after it. A reader who scrolls past a note at
      the foot has already decided what time to arrive. */}
  <section style="padding-bottom:0">
    <div class="container">
      <div class="whose fade">
        <div>
          <strong>These are the headquarters&rsquo; timings.</strong>
          They are not a federation-wide timetable and they are not the timings of any affiliated club.
          Every MMAKF club, dojo and training centre publishes its own — an evening club does not train
          when the hombu trains.
        </div>
        <a href="/dojos" class="btn btn-ghost">Find your club</a>
      </div>
    </div>
  </section>

  {/* ═══════ PUBLISHED OPENING HOURS ═══════
      From the scheduling engine when the headquarters has been migrated into
      it. Absent, this section does not render at all and the editorial strings
      below carry the answer, as they did before. */}
  {hqWeek && (
    <section>
      <div class="container">
        <div class="section-head fade">
          <div class="eyebrow">This week</div>
          <h2 class="display-2">When the <em class="r">mat</em> is open.</h2>
          <div class="rule"></div>
        </div>
        <div class="fade">
          <OpeningHours
            week={hqWeek}
            subject={hqName || 'The headquarters dojo'}
            unconfiguredNote="The headquarters' timings are published as the lines below until an administrator moves them into the schedule editor."
          />
        </div>
      </div>
    </section>
  )}

  {/* ═══════ TIMETABLE ═══════ */}
  <section>
    <div class="container">
      <div class="schedule-wrap tbl-scroll fade">
        <table class="schedule-tbl">
          <caption class="sr-only">Weekly class timetable</caption>
          <thead>
            <tr><th scope="col">Day</th><th scope="col">Time</th><th scope="col">Discipline</th><th scope="col">Level</th><th scope="col">Instructor</th><th scope="col">Mode</th></tr>
          </thead>
          <tbody>
            {schedule.map((s: any) => (
              <tr>
                <td><strong>{s.day}</strong></td>
                <td class="text-gold" style="font-family:var(--font-display)">{s.t}</td>
                <td>{s.d}</td>
                <td class="text-muted">{s.lvl}</td>
                <td class="text-muted">{s.ins}</td>
                <td><span class={`pill ${s.mode === 'online' ? 'live' : ''}`}>{s.mode}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 text-muted" style="font-size:.82rem">
        {/* Once the headquarters is in the schedule engine, the seasonal Sunday
            is rows with dates and is rendered above with the season named. The
            string is only repeated here while it is still the only record. */}
        {!usingEngine && fed.contact.hoursSunday && (
          <><strong>Sunday runs on seasonal timings.</strong> {fed.contact.hoursSunday}.<br /></>
        )}
        This table is the headquarters dojo at Patratu. <a href="/dojos" class="text-gold">Affiliated clubs</a>
        publish their own timings, which are not these.<br />
        Timings may shift on tournament and grading weekends — changes are posted in the
        <a href="/events" class="text-gold">events calendar</a> and announced in class.
      </div>
    </div>
  </section>

  {/* ═══════ DOJO ETIQUETTE ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="etq-grid">
        <div class="fade">
          <div class="eyebrow">Reigi</div>
          <h2 class="display-2" style="margin-top:14px">Dojo <em class="r">etiquette</em>.</h2>
          <div class="rule"></div>
          <p class="lead">
            Etiquette is the fifth pillar of the MMAKF system. These rules apply to every
            student, every batch, every belt — including black.
          </p>
        </div>
        <div class="fade">
          <ol class="etq-list">
            {etiquette.map((e, i) => (
              <li>
                <span class="etq-num">{String(i + 1).padStart(2, '0')}</span>
                <span>{e}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════ PLANNING ═══════ */}
  <section>
    <div class="container">
      <div class="grid grid-3">
        {[
          { icon: 'clock',  t: 'Morning batches',  d: 'Early morning sessions run on every day the dojo is open — including the long Sunday morning block — so school and college students can train before the day begins.' },
          { icon: 'monitor', t: 'Online sessions', d: `${onlineDays.join(' / ')} online sessions carry the same syllabus for remote students worldwide.` },
          { icon: 'users',  t: 'Weekend open batches', d: `Saturday open mat and the Sunday open batch — all levels, all instructors, grading prep and cross-batch sparring.${fed.contact.hoursSunday ? ' Sunday runs a morning and an afternoon block, on seasonal timings.' : ''}` },
        ].map((c) => (
          <div class="card fade">
            <div class="card-icon"><Icon name={c.icon} size={32} color="var(--gold)" /></div>
            <div class="card-title" style="font-size:1rem">{c.t}</div>
            <div class="card-body">{c.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <EnrollCTA programs={programs} />
</Base>

<style>
  .whose {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 18px 22px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    background: var(--card);
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .whose > div { flex: 1 1 420px; }
  .bg2 { background: var(--bg-2); }
  .schedule-wrap { overflow-x: auto; }
  .schedule-tbl {
    width: 100%;
    border-collapse: collapse;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 720px;
  }
  .schedule-tbl th, .schedule-tbl td {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .schedule-tbl th {
    background: var(--bg-2);
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 500;
  }
  .schedule-tbl tr:last-child td { border-bottom: 0; }

  .etq-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 800px) { .etq-grid { grid-template-columns: 1fr; } }
  .etq-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .etq-list li {
    display: flex;
    gap: 18px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--off-white);
    font-size: 0.94rem;
    line-height: 1.6;
  }
  .etq-list li:last-child { border-bottom: 0; }
  .etq-num {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--gold);
    flex-shrink: 0;
  }
</style>
