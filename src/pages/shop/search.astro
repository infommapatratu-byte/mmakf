---
// /shop/search — finding something in the marketplace, and the only page that
// can show the whole of it.
//
// ═════════════════════════════════════════════════════════════════════════════
// THE TWO HOLES THIS FILLS
// ═════════════════════════════════════════════════════════════════════════════
//
// THE FIRST IS SEARCH. There was none. The shop had a category tree and a
// per-item page, and a buyer who knew the words "shureido" or "12 oz" and not
// the taxonomy had nowhere to type them. /search — the federation's own global
// search — does not cover listings either: src/lib/global-search.ts searches
// twenty domains and the marketplace is not one of them, because it is a
// PUBLIC catalogue and every kind in that module is gated on an RBAC action.
//
// THE SECOND IS "EVERYTHING". browseCategory() needs a path and browseBrand()
// needs a slug, so until browseAll() there was no query in the codebase that
// returned the catalogue as a whole. That is why /shop/category renders a tree
// with counts and no items: at the root it has nothing to call. With no search
// term this page is that missing page, and the tree remains what it is — the
// way in for somebody who wants to be shown the shelves rather than to ask.
//
// ═════════════════════════════════════════════════════════════════════════════
// WHY THIS IS NOT IN THE SITEMAP, AND SETS noindex ON EVERY RESPONSE
// ═════════════════════════════════════════════════════════════════════════════
//
// A results page is NAVIGATION, NOT CONTENT — the same judgement the category
// page already makes when it noindexes its own filtered and paginated variants.
// The difference here is that there is no unfiltered form worth indexing: a
// search URL is generated by whoever typed into the box, so indexing it means
// offering a crawler an unbounded set of near-identical pages built from
// arbitrary strings, and a competitor can mint "mmakf.in/shop/search?q=<their
// slogan>" and have the federation host it. Categories and item pages are the
// indexable surfaces and both are linked from every result below.
//
// ═════════════════════════════════════════════════════════════════════════════
// NOTHING ON THIS PAGE FILTERS AFTER THE FETCH
// ═════════════════════════════════════════════════════════════════════════════
//
// searchListings() and browseAll() put publicListingPredicate() in the WHERE of
// the row query AND the count query, so the total under the heading is the real
// number of matching PUBLIC items — not the number of rows that happened to
// come back. An unapproved, quarantined, edited-since-approval item, or one
// belonging to a suspended seller or a closed shop, is absent from the number
// as well as from the grid. That is the rule the whole module is built on and
// this page adds no exception to it.

import Base from '@/layouts/Base.astro';
import { isConfigured, db } from '@/db';
import { isMarketplaceError } from '@/db/marketplace';
import {
  searchListings, browseAll, facets,
  DEFAULT_PAGE_SIZE, MIN_SEARCH_LENGTH, MAX_SEARCH_LENGTH,
  SEARCH_IS_NOT_CATEGORY_BROWSE, FACET_COUNTS_ARE_UNCONDITIONAL,
  type BrowseFilters, type BrowseSort,
} from '@/db/marketplace-browse';

export const prerender = false;

// Navigation, not content — see the header. Set before any early return so it
// holds on the "not configured" and error responses too.
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');

const configured = isConfigured();
const q = Astro.url.searchParams;

const rawQuery = (q.get('q') ?? '').trim().slice(0, MAX_SEARCH_LENGTH);
const hasQuery = rawQuery.length >= MIN_SEARCH_LENGTH;
// A one-character query is neither a search nor "show me everything". Saying so
// is better than silently answering a different question than the one asked.
const tooShort = rawQuery.length > 0 && !hasQuery;

const bandParam = q.get('price') ?? '';
const bandMatch = /^(\d+)-(\d+)$/.exec(bandParam);
const ageParam = q.get('age') ?? '';
const pageParam = Number(q.get('page') ?? '1');
const pageNo = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;

// PAISE, and no conversion anywhere on this page. The price options below are
// emitted from figures the database produced, exactly as on the category page:
// rupeesToPaise() in /api/marketplace is the marketplace's only conversion and
// a second one is a second rounding rule.
const filters: BrowseFilters = {
  sort: (q.get('sort') || 'newest') as BrowseSort,
  shotokan: q.get('shotokan') === '1',
  discipline: q.get('discipline') || null,
  sport: q.get('sport') || null,
  inStock: q.get('stock') === '1',
  age: /^\d{1,3}$/.test(ageParam) ? Number(ageParam) : null,
  priceMinMinor: bandMatch ? Number(bandMatch[1]) : null,
  priceMaxMinor: bandMatch ? Number(bandMatch[2]) : null,
};

const filtered = !!(filters.shotokan || filters.discipline || filters.sport
  || filters.inStock || filters.age != null || bandMatch);

let result: any = null;
let facetSet: any = null;
let refusal: string | null = null;
let loadError = false;

if (configured) {
  try {
    const paging = { limit: DEFAULT_PAGE_SIZE, offset: (pageNo - 1) * DEFAULT_PAGE_SIZE };
    result = hasQuery
      ? await searchListings(db(), { q: rawQuery, filters, ...paging })
      : await browseAll(db(), { filters, ...paging });
    // The whole catalogue's facets — facets(null) is what the root category
    // page already uses, so the controls here and there offer the same values.
    facetSet = await facets(db(), null);
  } catch (err: any) {
    if (isMarketplaceError(err)) {
      // The module's refusals are written for the person who hit them.
      refusal = String(err.message);
    } else {
      console.error('[shop/search]', err);
      loadError = true;
    }
  }
}

// ── Display helpers. Named functions, not ternaries in the markup — esbuild
//    mis-parses a template literal inside a chained ternary inside JSX.
const money = (m: number, currency = 'INR') =>
  `${currency === 'INR' ? '₹' : `${currency} `}${Math.floor(m / 100).toLocaleString('en-IN')}.${String(m % 100).padStart(2, '0')}`;

function bandLabel(b: { minMinor: number; maxMinor: number; count: number }): string {
  if (b.minMinor === b.maxMinor) return `${money(b.minMinor)} (${b.count})`;
  return `${money(b.minMinor)} to ${money(b.maxMinor)} (${b.count})`;
}

function priceLabel(item: any): string {
  const amount = money(item.priceMinor, item.currency);
  return item.variantCount > 1 ? `from ${amount}` : amount;
}

function stockLabel(item: any): string {
  return item.inStock ? '' : ' · out of stock';
}

/** Why this row is in the answer, in the buyer's words rather than a score. */
function matchLabel(item: any): string {
  if (!item.matchedOn) return '';
  const FIELD: Record<string, string> = {
    ref: 'item reference',
    title: 'name',
    seller: 'seller',
    brand: 'brand',
    description: 'description',
  };
  const field = FIELD[item.matchedOn.field] ?? item.matchedOn.field;
  return item.matchedOn.how === 'exact' ? `Exact ${field} match` : `Matched on ${field}`;
}

/** A link to this page with one thing changed. Keeps every other parameter. */
function urlWith(changes: Record<string, string | null>): string {
  const next = new URLSearchParams(q);
  for (const [k, v] of Object.entries(changes)) {
    if (v === null || v === '') next.delete(k);
    else next.set(k, v);
  }
  const str = next.toString();
  return str ? `${Astro.url.pathname}?${str}` : Astro.url.pathname;
}

const total: number = result?.total ?? 0;
const shown: any[] = result?.items ?? [];
const firstIndex = total === 0 ? 0 : (pageNo - 1) * DEFAULT_PAGE_SIZE + 1;
const lastIndex = (pageNo - 1) * DEFAULT_PAGE_SIZE + shown.length;
const lastPage = Math.max(1, Math.ceil(total / DEFAULT_PAGE_SIZE));

const heading = hasQuery ? `Results for “${rawQuery}”` : 'Everything on sale';
const documentTitle = hasQuery
  ? `${rawQuery} — MMAKF marketplace search`
  : 'Everything on sale — MMAKF marketplace';
const documentDescription = hasQuery
  ? `Marketplace items matching ${rawQuery}.`
  : 'Every item currently on public sale in the MMAKF marketplace.';
---

<Base title={documentTitle} description={documentDescription}>
  <section>
    <div class="container">

      <div class="eyebrow">MMAKF marketplace</div>
      <h1 class="display-1" style="margin-top:12px">{heading}</h1>

      {/* THE SEARCH BOX IS A PLAIN GET FORM. It works with scripting off,
          which matters more here than anywhere else in the shop: this is the
          page a buyer reaches for when browsing has not found the thing. */}
      <form class="card searchbar" method="get" action="/shop/search" role="search">
        <label for="q">Search the marketplace</label>
        <div class="searchrow">
          <input
            id="q" name="q" type="search" value={rawQuery}
            maxlength={MAX_SEARCH_LENGTH}
            placeholder="Gi, belt, mitts, a seller or a brand"
            autocomplete="off"
          />
          <button class="btn btn-primary" type="submit">Search</button>
        </div>
        <p class="hint">{SEARCH_IS_NOT_CATEGORY_BROWSE}</p>
      </form>

      {!configured && (
        <div class="card">
          <h2 class="h3">Not available on this deployment.</h2>
          <p>The federation database is not configured here, so there is no catalogue to search.</p>
        </div>
      )}

      {configured && tooShort && (
        <div class="card" role="status">
          <p>
            A search needs at least {MIN_SEARCH_LENGTH} characters. A single character matches most
            of the catalogue, and a list of everything is not a search result —
            <a href="/shop/search"> see everything on sale</a> instead, or
            <a href="/shop/category"> browse by category</a>.
          </p>
        </div>
      )}

      {configured && loadError && (
        <div class="card" role="alert">
          <h2 class="h3">The catalogue could not be searched just now.</h2>
          <p>The fault has been logged for the federation office. Please try again shortly.</p>
        </div>
      )}

      {configured && refusal && (
        <div class="card" role="alert">
          <h2 class="h3">That is not something this page can answer.</h2>
          <p>{refusal}</p>
          <p><a href="/shop/search">Start again</a>.</p>
        </div>
      )}

      {configured && !loadError && !refusal && !tooShort && (
        <>
          {/* ── Filters. Every control is present only when the catalogue can
                 answer it, on the category page's rule: a control that cannot
                 change the result teaches the buyer the filters are fake. ── */}
          {facetSet && facetSet.total > 0 && (
            <form class="card filters" method="get" action="/shop/search">
              {rawQuery && <input type="hidden" name="q" value={rawQuery} />}
              <h2 class="h4">Narrow this down</h2>
              <p class="hint">{FACET_COUNTS_ARE_UNCONDITIONAL}</p>

              <div class="grid">
                <div class="field">
                  <label for="sort">Order</label>
                  <select id="sort" name="sort">
                    <option value="newest" selected={filters.sort === 'newest'}>Most recently updated</option>
                    <option value="price_asc" selected={filters.sort === 'price_asc'}>Lowest price first</option>
                    <option value="price_desc" selected={filters.sort === 'price_desc'}>Highest price first</option>
                  </select>
                  {hasQuery && <span class="hint">Relevance decides first; this breaks the ties.</span>}
                </div>

                {facetSet.disciplines.length > 0 && (
                  <div class="field">
                    <label for="discipline">Discipline</label>
                    <select id="discipline" name="discipline">
                      <option value="">Any</option>
                      {facetSet.disciplines.map((d: any) => (
                        <option value={d.value} selected={filters.discipline === d.value}>
                          {d.value} ({d.count})
                        </option>
                      ))}
                    </select>
                  </div>
                )}

                {facetSet.sports.length > 0 && (
                  <div class="field">
                    <label for="sport">Sport</label>
                    <select id="sport" name="sport">
                      <option value="">Any</option>
                      {facetSet.sports.map((d: any) => (
                        <option value={d.value} selected={filters.sport === d.value}>
                          {d.value} ({d.count})
                        </option>
                      ))}
                    </select>
                  </div>
                )}

                {facetSet.priceBands.length > 1 && (
                  <div class="field">
                    <label for="price">Price</label>
                    <select id="price" name="price">
                      <option value="">Any</option>
                      {facetSet.priceBands.map((b: any) => (
                        <option
                          value={`${b.minMinor}-${b.maxMinor}`}
                          selected={bandParam === `${b.minMinor}-${b.maxMinor}`}
                        >{bandLabel(b)}</option>
                      ))}
                    </select>
                  </div>
                )}

                {facetSet.ageStated > 0 && (
                  <div class="field">
                    <label for="age">Suitable for age</label>
                    <input
                      id="age" name="age" type="number" inputmode="numeric"
                      min="0" max="120" value={filters.age == null ? '' : String(filters.age)}
                    />
                  </div>
                )}
              </div>

              <div class="checks">
                {facetSet.shotokanRelevant > 0 && (
                  <span class="check">
                    <input id="shotokan" name="shotokan" type="checkbox" value="1" checked={filters.shotokan} />
                    <label for="shotokan">Stated as relevant to Shotokan ({facetSet.shotokanRelevant})</label>
                  </span>
                )}
                {facetSet.inStock > 0 && facetSet.inStock < facetSet.total && (
                  <span class="check">
                    <input id="stock" name="stock" type="checkbox" value="1" checked={filters.inStock} />
                    <label for="stock">In stock only ({facetSet.inStock})</label>
                  </span>
                )}
              </div>

              <div class="actions">
                <button class="btn btn-primary" type="submit">Apply</button>
                {filtered && <a class="btn" href={urlWith({ sort: null, shotokan: null, discipline: null, sport: null, stock: null, age: null, price: null, page: null })}>Clear filters</a>}
              </div>
            </form>
          )}

          <h2 class="h3">
            {total === 0 ? 'Nothing matched' : `${total} item${total === 1 ? '' : 's'}`}
          </h2>

          {total === 0 && (
            <div class="card">
              <p class="muted">
                {hasQuery
                  ? 'Nothing on public sale matches those words.'
                  : 'Nothing is on public sale in the marketplace at the moment.'}
                {filtered ? ' Try clearing the filters, or ' : ' '}
                <a href="/shop/category">browse by category</a>.
              </p>
            </div>
          )}

          {result?.unexplained > 0 && (
            <p class="hint">
              {result.unexplained} further row{result.unexplained === 1 ? '' : 's'} matched in the
              database but could not be shown with the reason {result.unexplained === 1 ? 'it' : 'they'}
              {' '}matched, so {result.unexplained === 1 ? 'it was' : 'they were'} left out rather than
              presented without one.
            </p>
          )}

          {result?.excludedForUnstatedAge != null && result.excludedForUnstatedAge > 0 && (
            <div class="card">
              <p class="muted">
                {result.excludedForUnstatedAge} further item{result.excludedForUnstatedAge === 1 ? '' : 's'}
                {' '}{result.excludedForUnstatedAge === 1 ? 'is' : 'are'} not shown because
                {' '}{result.excludedForUnstatedAge === 1 ? 'its seller' : 'their sellers'} stated no age
                suitability. An unstated age is not “all ages”.
              </p>
            </div>
          )}

          {shown.length > 0 && (
            <div class="items">
              {shown.map((it: any) => (
                <article class="card item">
                  {it.image && <img src={it.image} alt={it.imageAlt ?? ''} width="240" height="240" loading="lazy" />}
                  <h3 class="h4"><a href={`/shop/product/${it.ref}`}>{it.title}</a></h3>
                  <p class="price">{priceLabel(it)}</p>
                  <p class="muted">
                    {it.sellerStoreSlug
                      ? <a href={`/shop/seller/${it.sellerStoreSlug}`}>{it.sellerTradingName}</a>
                      : it.sellerTradingName}
                    {stockLabel(it)}
                  </p>
                  {it.categoryPath && (
                    <p class="muted"><a href={`/shop/category/${it.categoryPath}`}>{it.categoryName}</a></p>
                  )}
                  {it.brandSlug && (
                    <p class="muted"><a href={`/shop/brand/${it.brandSlug}`}>{it.brandName}</a></p>
                  )}
                  {matchLabel(it) && <p class="hint">{matchLabel(it)}</p>}
                </article>
              ))}
            </div>
          )}

          {total > 0 && (
            <nav class="pager" aria-label="Pages">
              <p class="muted">Showing {firstIndex}–{lastIndex} of {total}</p>
              <div class="pagelinks">
                {pageNo > 1 && <a href={urlWith({ page: String(pageNo - 1) })} rel="prev">Previous</a>}
                <span class="muted">Page {pageNo} of {lastPage}</span>
                {pageNo < lastPage && <a href={urlWith({ page: String(pageNo + 1) })} rel="next">Next</a>}
              </div>
            </nav>
          )}

          <p class="muted">
            <a href="/shop">← Back to the shop</a> · <a href="/shop/category">Browse every category</a>
          </p>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .searchbar { margin-bottom: 18px; }
  .searchrow { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .searchrow input { flex: 1 1 260px; min-width: 0; }
  .filters .grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .filters .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .filters .grid { grid-template-columns: repeat(3, 1fr); } }
  .field { display: grid; gap: 4px; }
  .field select, .field input { width: 100%; }
  .checks { display: flex; flex-wrap: wrap; gap: 16px; margin: 14px 0; }
  .check { display: inline-flex; align-items: center; gap: 8px; }
  .actions { display: flex; gap: 10px; align-items: center; }
  .items { display: grid; gap: 14px; grid-template-columns: 1fr; margin-top: 14px; }
  @media (min-width: 640px) { .items { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .items { grid-template-columns: repeat(3, 1fr); } }
  .item img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
  .price { font-weight: 700; font-size: 1.1rem; margin: 6px 0; }
  .pager { margin: 22px 0; }
  .pagelinks { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .muted { opacity: 0.78; }
  .hint { font-size: 0.9em; opacity: 0.8; }
</style>
