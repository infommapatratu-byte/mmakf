---
// /portal/seller/import — a spreadsheet of products, staged.
//
// ─── WHY THIS PAGE IS FOUR STEPS AND NOT A BUTTON ───────────────────────────
//
// "NEVER DIRECTLY IMPORT INTO PRODUCTION CATALOGUE" is the instruction the
// schema itself quotes above `product_imports`, and a page with one "Import"
// button is how it gets broken with the best intentions. So the seller uploads,
// reads what every row was found to be, and only then submits — and what a
// submission produces is DRAFTS, which go through exactly the same two review
// gates as a listing typed by hand.
//
// The preview is not a courtesy. A seller who cannot see which row is wrong
// opens the spreadsheet and guesses, and a seller who guesses uploads the same
// file again with the same fault in it.
//
// ─── WHY THE CSV IS PARSED IN THE BROWSER ───────────────────────────────────
//
// The file never reaches the server as a file. It is turned into rows here and
// posted as JSON, for two reasons and the second is the one that matters:
//
//   · NO DEPENDENCY. A CSV parser worth trusting handles quoted commas,
//     embedded newlines, BOMs and several encodings. A hand-rolled one on the
//     server handles the first of those and quietly splits a product
//     description containing a comma into two columns.
//   · THE SERVER'S JOB IS MEANING, NOT FORMAT. Whether a price is a price,
//     whether a category exists, whether this seller may sell this brand —
//     those are federation questions and src/db/product-import.ts answers every
//     one of them. Where the cell boundaries were is a question about a text
//     file, and mixing the two would put a parsing bug and a policy bug in the
//     same module.
//
// The parser below is therefore allowed to be wrong in a way the seller can SEE
// — they read the preview before anything is created — which is a different
// class of risk from a server that mis-parses silently.
//
// ─── AND WHAT IS ABSENT (§70) ───────────────────────────────────────────────
//
// NO STOCK COLUMN. Stock in this system is received into a named location with
// a movement recorded behind it, and an import has no location to name. The
// template documents no stock column, the module warns by name about any it
// finds, and nothing here pretends otherwise — "imported, and every product
// shows zero in stock" is the confusion this prevents.
//
// NO UPLOAD CONTROL WHERE THERE IS NO TAXONOMY. Every row must name a category
// slug, and until MMAKF adopts a taxonomy there are no slugs, so every row of
// every file would fail. The file input is not rendered at all in that state,
// for the same reason /portal/seller/documents renders no upload button while
// object storage is unconfigured.

import Base from '@/layouts/Base.astro';
import { db } from '@/db';
import { categoryTree, TAXONOMY_NOT_ADOPTED } from '@/db/catalogue';
import {
  myImports, importPreview,
  MAX_IMPORT_ROWS, IMPORT_ROW_BOUND_NOTE, IMPORT_STOCK_NOT_TAKEN, IMPORT_TEMPLATE_COLUMNS,
} from '@/db/product-import';
import { sellerContext, readableError, money, fmtDateTime, titleCase, SELLER_TABS } from './_gate';

export const prerender = false;

const ctx = await sellerContext(Astro.request.headers.get('cookie'));

const requested = Number(Astro.url.searchParams.get('import') ?? '');
const selectedId = Number.isFinite(requested) && requested > 0 ? Math.trunc(requested) : null;

let imports: any[] = [];
let preview: any = null;
let categories: any[] = [];
let pageError: string | null = ctx.loadError;

if (ctx.gate === 'seller' && ctx.approved && !pageError) {
  try {
    // Neither takes a seller id. Both resolve the shop from the session.
    imports = await myImports(db(), ctx.identity!.principal);
    categories = await categoryTree(db());
    if (selectedId != null) {
      preview = await importPreview(db(), ctx.identity!.principal, selectedId);
    }
  } catch (err: any) {
    pageError = readableError(err, 'Your imports');
  }
}

// Only categories mapped to one of the four public sections can be imported
// into — see LEGACY_AXIS_UNMAPPED. Listing the others would invite rows that
// are refused for a reason the seller cannot act on.
const importable = categories.filter((c: any) => !!c.legacyCategory);
const taxonomyReady = importable.length > 0;

const headerLine = IMPORT_TEMPLATE_COLUMNS.map((c) => c.header).join(',');
const exampleLine = 'Karate-gi 170cm white,karate-gi,1799.00,GI-170-W,170cm,"Cotton gi, unbleached",,1200,,,,,India,Cotton,';

/**
 * The sentence describing an import's state.
 *
 * A NAMED HELPER IN THE FRONTMATTER, not a nested ternary in the markup:
 * esbuild mis-parses a nested ternary containing a template literal inside
 * JSX and fails the build. It also reads better here, where the five states can
 * be seen next to each other.
 */
function describeImport(imp: any): string {
  switch (imp.status) {
    case 'uploaded':
      return 'Received. Nothing has been checked yet.';
    case 'validating':
      return 'Being checked. If it stays here, the check stopped part way — start a new import.';
    case 'preview':
      return `${imp.validCount} ready, ${imp.errorCount} with faults, ${imp.duplicateCount} already listed.`;
    case 'submitted':
      return 'Submitted. Its rows became draft listings, which are waiting for you to submit them for review.';
    case 'cancelled':
      return imp.failureReason ? `Cancelled: ${imp.failureReason}` : 'Cancelled.';
    case 'failed':
      return imp.failureReason ? `Stopped: ${imp.failureReason}` : 'Stopped.';
    default:
      return titleCase(imp.status);
  }
}

/** What one previewed row became. Same reasoning as above — no nested ternary. */
function describeRowStatus(status: string): string {
  switch (status) {
    case 'pending': return 'Not checked yet';
    case 'valid': return 'Ready';
    case 'invalid': return 'Has faults';
    case 'duplicate': return 'Already listed';
    case 'created': return 'Draft created';
    case 'skipped': return 'Skipped';
    default: return titleCase(status);
  }
}

function describeDuplicate(dup: any): string {
  if (!dup) return '';
  if (dup.rowNo) return `Matches row ${dup.rowNo} of this same file, on ${dup.matchedOn}.`;
  return `Matches something you already list, on ${dup.matchedOn}.`;
}

const canSubmit = !!preview && preview.status === 'preview' && preview.validCount > 0;
const canValidate = !!preview && (preview.status === 'uploaded' || preview.status === 'preview');
const canCancel = !!preview && ['uploaded', 'validating', 'preview', 'failed'].includes(preview.status);
---

<Base
  title="Bulk product import — MMAKF marketplace"
  description="Upload a spreadsheet of products, read what every row was found to be, and create drafts from the rows that are ready."
>
  <section>
    <div class="container">

      {ctx.gate !== 'seller' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">Bulk import</h1>
        <p>Sign in with a personal account that holds an approved seller record.</p></div>
      )}

      {ctx.gate === 'seller' && (
        <>
          <div class="eyebrow">MMAKF marketplace</div>
          <h1 class="display-1" style="margin-top:14px">Bulk import</h1>

          <nav class="tabs" aria-label="Seller area">
            {SELLER_TABS.map((t) => (
              <a href={t.href} aria-current={t.href === '/portal/seller/import' ? 'page' : undefined}>{t.label}</a>
            ))}
          </nav>

          {pageError && <div class="card" role="alert"><p>{pageError}</p></div>}

          {!ctx.approved && (
            <div class="card"><p>MMAKF has not approved this seller account, so there is nothing to import into.</p></div>
          )}

          {ctx.approved && (
            <>
              <div class="card">
                <div class="eyebrow">How this works</div>
                <h2 class="h3">Nothing you upload goes into the shop.</h2>
                <p>
                  A file is staged, not imported. Every row is stored exactly as you sent it, checked
                  against the federation’s product policy, and shown back to you with whatever was found
                  wrong with it. Only when you submit does anything become a listing — and every listing
                  it makes is a <strong>draft</strong>, which you then submit for review one at a time
                  exactly as you would a product you typed in yourself.
                </p>
                <p class="muted">
                  Four steps: upload, check, read, submit. There is deliberately no single button that
                  does all four — a page that imported five hundred unread rows in one click is how a
                  prohibited item reaches the public catalogue.
                </p>
              </div>

              <div class="card tone-wait">
                <div class="eyebrow">Not included</div>
                <h2 class="h4">Stock is never imported.</h2>
                <p>{IMPORT_STOCK_NOT_TAKEN}</p>
                <p class="muted">
                  There is no stock column in the template below. If your file has one it is read and
                  reported against the row, and it is not applied — seeing “imported” and then finding
                  every product out of stock is worse than being told plainly.
                </p>
              </div>

              {!taxonomyReady && (
                <div class="card tone-wait">
                  <div class="eyebrow">Not available yet</div>
                  <h2 class="h4">There is no product taxonomy to import into.</h2>
                  <p>{TAXONOMY_NOT_ADOPTED}</p>
                  <p class="muted">
                    Every row must name a category, so until the federation adopts one there is nothing a
                    file could be checked against and every row of it would fail. There is no upload
                    control on this page while that is true, rather than one that would take your file
                    and reject all of it.
                  </p>
                </div>
              )}

              {taxonomyReady && (
                <>
                  {/* ── The template ─────────────────────────────────────── */}
                  <div class="card">
                    <div class="eyebrow">The file</div>
                    <h2 class="h3">Columns</h2>
                    <p class="muted">
                      A CSV with a header line. Column names are matched loosely — “Product Name”,
                      “product_name” and “title” are all read as the title — and any column not listed
                      here is kept with the row and not used.
                    </p>
                    <table>
                      <caption class="sr-only">Columns the import reads</caption>
                      <thead><tr>
                        <th scope="col">Column</th><th scope="col">Required</th><th scope="col">What it means</th>
                      </tr></thead>
                      <tbody>
                        {IMPORT_TEMPLATE_COLUMNS.map((c) => (
                          <tr>
                            <th scope="row"><code>{c.header}</code></th>
                            <td>{c.required ? 'Yes' : 'No'}</td>
                            <td>{c.note}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="hint">Copy this as your header line:</p>
                    <pre class="sample"><code>{headerLine}
{exampleLine}</code></pre>
                    <p class="hint">
                      Prices are in rupees, digits with at most two decimals. A third decimal is refused
                      rather than rounded — it is a typo or the wrong units, and rounding hides which.
                    </p>
                    <p class="hint">{IMPORT_ROW_BOUND_NOTE}</p>

                    <details>
                      <summary>The {importable.length} category slugs you may use</summary>
                      <ul class="slugs">
                        {importable.map((c: any) => (
                          <li><code>{c.slug}</code> — {c.name}</li>
                        ))}
                      </ul>
                    </details>
                  </div>

                  {/* ── Upload ───────────────────────────────────────────── */}
                  <div class="card">
                    <div class="eyebrow">Step one</div>
                    <h2 class="h3">Upload a file</h2>
                    <form id="upload-form">
                      <label for="csv-file">CSV file</label>
                      <input id="csv-file" name="file" type="file" accept=".csv,text/csv" required />
                      <p class="hint">
                        The file is read in this browser and its rows are sent as data. It is not stored
                        anywhere — what is kept is the rows themselves, exactly as they were read.
                        At most {MAX_IMPORT_ROWS} rows in one import; a larger file is refused whole
                        rather than partly loaded.
                      </p>
                      <p id="upload-status" role="status" class="muted"></p>
                      <p id="upload-error" class="error" role="alert" hidden></p>
                      <button class="btn btn-primary" type="submit">Read the file and stage it</button>
                    </form>
                  </div>
                </>
              )}

              {/* ── Existing imports ───────────────────────────────────── */}
              <h2 class="h3">Your imports ({imports.length})</h2>

              {imports.length === 0 && (
                <div class="card"><p class="muted">None yet.</p></div>
              )}

              {imports.length > 0 && (
                <table class="card">
                  <caption class="sr-only">Imports you have run</caption>
                  <thead><tr>
                    <th scope="col">Reference</th><th scope="col">File</th>
                    <th scope="col">Uploaded</th><th scope="col">Rows</th>
                    <th scope="col">State</th><th scope="col"></th>
                  </tr></thead>
                  <tbody>
                    {imports.map((imp: any) => (
                      <tr>
                        <th scope="row"><code>{imp.ref}</code></th>
                        <td>{imp.filename ?? '—'}</td>
                        <td>{fmtDateTime(imp.uploadedAt)}</td>
                        <td>{imp.rowCount}</td>
                        <td>{describeImport(imp)}</td>
                        <td><a href={`/portal/seller/import?import=${imp.id}`}>Open</a></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}

              {/* ── The preview ─────────────────────────────────────────── */}
              {preview && (
                <article class="card" id="preview">
                  <div class="eyebrow">Step two and three</div>
                  <h2 class="h3">{preview.ref}{preview.filename ? ` — ${preview.filename}` : ''}</h2>
                  <p>{describeImport(preview)}</p>

                  <dl class="counts">
                    <div><dt>Rows</dt><dd>{preview.rowCount}</dd></div>
                    <div><dt>Ready</dt><dd>{preview.validCount}</dd></div>
                    <div><dt>With faults</dt><dd>{preview.errorCount}</dd></div>
                    <div><dt>Already listed</dt><dd>{preview.duplicateCount}</dd></div>
                  </dl>

                  <div class="row">
                    {canValidate && (
                      <button class="btn" data-validate={preview.importId}>Check every row</button>
                    )}
                    {canSubmit && (
                      <button class="btn btn-primary" data-submit={preview.importId}>
                        Create {preview.validCount} draft{preview.validCount === 1 ? '' : 's'}
                      </button>
                    )}
                    {canCancel && (
                      <button class="btn" data-cancel={preview.importId}>Stop this import</button>
                    )}
                  </div>

                  {preview.status === 'preview' && preview.validCount === 0 && (
                    <p class="warn">
                      No row in this file is ready, so there is nothing to create. Fix the faults listed
                      below and upload the corrected file as a new import.
                    </p>
                  )}

                  {preview.status === 'submitted' && (
                    <p class="muted">
                      The drafts this made are in <a href="/portal/seller/products">your products</a>.
                      Nothing here has been published, and nothing was submitted for review on your
                      behalf — you decide which of them are ready.
                    </p>
                  )}

                  {preview.truncated && (
                    <p class="warn">
                      Only the first {preview.rows.length} rows are shown. Every row was checked; this
                      page is what is shortened, never the import.
                    </p>
                  )}

                  <table>
                    <caption class="sr-only">Rows in this import</caption>
                    <thead><tr>
                      <th scope="col">Row</th><th scope="col">Product</th>
                      <th scope="col">Price</th><th scope="col">Category</th>
                      <th scope="col">State</th><th scope="col">Findings</th>
                    </tr></thead>
                    <tbody>
                      {preview.rows.map((r: any) => (
                        <tr>
                          <th scope="row">{r.rowNo}</th>
                          <td>{r.resolved?.title || <span class="muted">No title</span>}</td>
                          <td>{r.resolved?.priceMinor == null ? '—' : money(r.resolved.priceMinor)}</td>
                          <td>{r.resolved?.categorySlug || '—'}</td>
                          <td>{describeRowStatus(r.status)}</td>
                          <td>
                            {Array.isArray(r.errors) && r.errors.length > 0 && (
                              <ul class="faults">{r.errors.map((e: string) => <li>{e}</li>)}</ul>
                            )}
                            {r.resolved?.duplicateOf && (
                              <p class="muted">{describeDuplicate(r.resolved.duplicateOf)}</p>
                            )}
                            {Array.isArray(r.resolved?.warnings) && r.resolved.warnings.length > 0 && (
                              <ul class="muted">{r.resolved.warnings.map((w: string) => <li>{w}</li>)}</ul>
                            )}
                            {Array.isArray(r.resolved?.reviewerMustConfirm) && r.resolved.reviewerMustConfirm.length > 0 && (
                              <ul class="muted">{r.resolved.reviewerMustConfirm.map((w: string) => <li>{w}</li>)}</ul>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </article>
              )}

              <p id="page-error" class="error" role="alert" hidden></p>
            </>
          )}
        </>
      )}

    </div>
  </section>
</Base>

<script>
  // The row bound and the request ceiling, restated where the browser can act
  // on them. Both are checked again on the server — this copy exists so a
  // seller is told before they wait for an upload, not so anything is trusted.
  const MAX_ROWS = 2000;
  const MAX_BODY_BYTES = 262144;

  const pageError = document.getElementById('page-error');
  const say = (el: HTMLElement | null, m: string) => {
    const target = el ?? pageError;
    if (!target) { window.alert(m); return; }
    target.textContent = m; target.hidden = false;
    target.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown> = {}) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }

  /**
   * A CSV reader that respects quotes.
   *
   * WHY IT IS HERE AND NOT ON THE SERVER: see the note at the head of this
   * file. What it must get right is the quoted field — a product description
   * reading `Cotton gi, unbleached` is one cell, and a split on commas turns it
   * into two and shifts every column after it. Doubled quotes ("") are an
   * escaped quote, per RFC 4180, and CRLF and a leading BOM are both stripped
   * because that is what a spreadsheet actually exports.
   *
   * It returns rows of {header: cell}. It does NOT interpret anything: no
   * trimming of values, no coercion, no renaming. The bytes the seller typed
   * are what reach `raw`, because `raw` is the evidence in any argument about
   * what was uploaded.
   */
  function parseCsv(text: string): Record<string, string>[] {
    const src = text.replace(/^﻿/, '');
    const rows: string[][] = [];
    let field = '';
    let record: string[] = [];
    let quoted = false;

    for (let i = 0; i < src.length; i++) {
      const ch = src[i];
      if (quoted) {
        if (ch === '"') {
          if (src[i + 1] === '"') { field += '"'; i++; }
          else quoted = false;
        } else field += ch;
        continue;
      }
      if (ch === '"') { quoted = true; continue; }
      if (ch === ',') { record.push(field); field = ''; continue; }
      if (ch === '\r') continue;
      if (ch === '\n') { record.push(field); rows.push(record); record = []; field = ''; continue; }
      field += ch;
    }
    if (field !== '' || record.length) { record.push(field); rows.push(record); }

    const nonEmpty = rows.filter((r) => r.some((c) => c.trim() !== ''));
    if (nonEmpty.length < 2) return [];

    const headers = nonEmpty[0].map((h) => h.trim());
    return nonEmpty.slice(1).map((cells) => {
      const out: Record<string, string> = {};
      headers.forEach((h, i) => {
        if (!h) return;
        // A repeated header keeps the FIRST column, so a file with two "price"
        // columns does not silently take whichever came last.
        if (!(h in out)) out[h] = cells[i] ?? '';
      });
      return out;
    });
  }

  document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('upload-error');
    const status = document.getElementById('upload-status');
    if (err) err.hidden = true;

    const input = document.getElementById('csv-file') as HTMLInputElement;
    const file = input?.files?.[0];
    if (!file) { say(err, 'Choose a CSV file first.'); return; }

    if (status) status.textContent = 'Reading the file…';
    let rows: Record<string, string>[];
    try {
      rows = parseCsv(await file.text());
    } catch {
      if (status) status.textContent = '';
      say(err, 'That file could not be read as text. Export it again as CSV.');
      return;
    }

    if (!rows.length) {
      if (status) status.textContent = '';
      say(err, 'No rows were found. The file needs a header line and at least one product under it.');
      return;
    }
    // REFUSED, NOT TRIMMED. Sending the first two thousand rows of a larger
    // file would report success over the products it dropped.
    if (rows.length > MAX_ROWS) {
      if (status) status.textContent = '';
      say(err, `That file has ${rows.length} rows and one import carries at most ${MAX_ROWS}. `
        + 'Nothing has been sent — split the file and upload it in parts, so that no row is lost silently.');
      return;
    }

    const body = JSON.stringify({ filename: file.name, rows });
    if (new Blob([body]).size > MAX_BODY_BYTES) {
      if (status) status.textContent = '';
      say(err, `Those ${rows.length} rows are too large for one request. Nothing has been sent. `
        + 'Split the file — shorter descriptions, or fewer rows at a time — rather than letting part of it through.');
      return;
    }

    if (status) status.textContent = `Sending ${rows.length} rows…`;
    const res = await post('import/start', { filename: file.name, rows });
    if (!res.ok) {
      if (status) status.textContent = '';
      say(err, res.body.error || 'The file could not be staged. Nothing has been recorded.');
      return;
    }
    window.location.href = `/portal/seller/import?import=${res.body.result.importId}`;
  });

  document.querySelectorAll('[data-validate]').forEach((b) => b.addEventListener('click', async () => {
    const id = Number((b as HTMLElement).dataset.validate);
    (b as HTMLButtonElement).disabled = true;
    (b as HTMLButtonElement).textContent = 'Checking…';
    const res = await post('import/validate', { importId: id });
    if (res.ok) { window.location.reload(); return; }
    (b as HTMLButtonElement).disabled = false;
    (b as HTMLButtonElement).textContent = 'Check every row';
    say(null, res.body.error || 'The rows could not be checked.');
  }));

  document.querySelectorAll('[data-submit]').forEach((b) => b.addEventListener('click', async () => {
    const id = Number((b as HTMLElement).dataset.submit);
    // Stated in the confirmation, because it is the thing sellers get wrong:
    // this makes drafts, and drafts are not on sale.
    const go = window.confirm(
      'This creates one DRAFT listing for every row that is ready. Nothing goes on sale: you submit '
      + 'each draft for review yourself, exactly as you would a product you typed in. Continue?'
    );
    if (!go) return;
    (b as HTMLButtonElement).disabled = true;
    (b as HTMLButtonElement).textContent = 'Creating drafts…';
    const res = await post('import/submit', { importId: id });
    if (res.ok) { window.location.reload(); return; }
    (b as HTMLButtonElement).disabled = false;
    say(null, res.body.error || 'The drafts could not be created.');
  }));

  document.querySelectorAll('[data-cancel]').forEach((b) => b.addEventListener('click', async () => {
    const id = Number((b as HTMLElement).dataset.cancel);
    const reason = window.prompt('Why are you stopping this import? The file and its rows are kept either way.');
    if (!reason) return;
    const res = await post('import/cancel', { importId: id, reason });
    if (res.ok) { window.location.reload(); return; }
    say(null, res.body.error || 'The import could not be stopped.');
  }));
</script>

<style>
  .tabs { display: flex; gap: 16px; margin: 18px 0; flex-wrap: wrap; }
  .tabs a { padding: 6px 0; border-bottom: 2px solid transparent; text-decoration: none; }
  .tabs a[aria-current='page'] { border-bottom-color: currentColor; font-weight: 600; }
  .row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin: 12px 0; }
  .muted { opacity: 0.75; }
  .warn { font-weight: 600; }
  .hint { font-size: 0.9em; opacity: 0.8; }
  .error { color: #b00020; font-weight: 600; }
  .faults { margin: 0; padding-left: 18px; }
  .faults li { margin-bottom: 4px; }
  .slugs { columns: 2; }
  @media (max-width: 640px) { .slugs { columns: 1; } }
  .sample { overflow-x: auto; padding: 10px; border: 1px solid rgba(128,128,128,0.3); border-radius: 8px; font-size: 0.85em; }
  .counts { display: flex; gap: 24px; flex-wrap: wrap; margin: 12px 0; }
  .counts dt { font-size: 0.85em; opacity: 0.75; }
  .counts dd { margin: 0; font-size: 1.4em; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; display: block; overflow-x: auto; }
