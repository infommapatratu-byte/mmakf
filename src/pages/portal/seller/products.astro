---
// /portal/seller/products — the catalogue, its variants and its stock.
//
// ─── THE TWO THINGS A SELLER MUST BE ABLE TO SEE HERE ───────────────────────
//
//   1. WHETHER AN ITEM IS ACTUALLY ON SALE, and if not, which of the five
//      conditions is failing. "Approved" is not the same as "visible": an
//      approved item whose seller is suspended, whose shop is closed, which has
//      been quarantined, or which has been edited since approval, is not on
//      sale — and a page that showed only the status would leave the seller
//      wondering why nobody is buying.
//
//   2. THAT EDITING RETURNS AN ITEM TO REVIEW, BEFORE THEY EDIT. Adding a
//      variant or changing a price is an edit to what MMAKF approved, and the
//      item leaves the shop until it is looked at again. A seller who is told
//      afterwards learns that saving is dangerous.
//
// STOCK IS THE EXCEPTION AND IS SHOWN AS ONE. Receiving stock, correcting a
// count and selling do NOT disturb an approval, because a count cannot mislead
// anybody about what the item is.

import Base from '@/layouts/Base.astro';
import { db } from '@/db';
import { and, asc, desc, eq, sql } from 'drizzle-orm';
import * as s from '@/db/schema';
import { myListings, LISTING_CATEGORIES } from '@/db/marketplace';
import { variantsForListings } from '@/db/catalogue';
import { myLocations, stockForSeller, lowStock } from '@/db/inventory';
import { sellerContext, readableError, money, fmtDate, titleCase, SELLER_TABS } from './_gate';

export const prerender = false;

const ctx = await sellerContext(Astro.request.headers.get('cookie'));

let listings: any[] = [];
let variantsBy = new Map<number, any[]>();
let locations: any[] = [];
let stock: any[] = [];
let low: any = { configured: false, rows: [] };
let pageError: string | null = ctx.loadError;

if (ctx.gate === 'seller' && ctx.approved && !pageError) {
  try {
    // No seller id passed. myListings() resolves the shop from the session
    // inside its own query, so reading another seller's catalogue is not
    // refused — it cannot be asked for.
    listings = await myListings(db(), ctx.identity!.principal, { limit: 200 });
    // ONE query for every listing's variants, not one per listing. This was a
    // `for … await` over up to two hundred rows — two hundred sequential round
    // trips to render a single page, each waiting on the one before it. The
    // cost is invisible on a test catalogue of three items and very visible to
    // a seller with a real one.
    variantsBy = await variantsForListings(db(), listings.map((l: any) => l.id));
    locations = await myLocations(db(), ctx.identity!.principal);
    stock = await stockForSeller(db(), ctx.identity!.principal);
    low = await lowStock(db(), ctx.identity!.principal);
  } catch (err: any) {
    pageError = readableError(err, 'Your catalogue');
  }
}

const stockFor = (variantId: number) => stock.filter((r: any) => r.variantId === variantId);

/**
 * Why an approved item is not on sale.
 *
 * Computed from the SAME five conditions publicListingPredicate() applies, and
 * stated one at a time — "not visible" without a reason sends the seller to
 * support, and support to the code.
 */
function invisibilityReason(l: any): string | null {
  if (l.publiclyVisible) return null;
  if (ctx.seller?.status !== 'approved') return `Your seller account is ${ctx.seller?.status}, so nothing of yours is on sale.`;
  if (ctx.seller?.storeStatus !== 'open') return 'Your shop is closed, so nothing of yours is on sale. Reopen it from the Overview.';
  if (l.quarantinedAt) return `MMAKF has quarantined this item while it is looked at. ${l.quarantineReason ?? ''}`.trim();
  if (l.status === 'draft') return 'Not submitted yet.';
  if (l.status === 'submitted') return 'With MMAKF for review.';
  if (l.status === 'rejected') return `MMAKF did not approve this item. ${l.decisionReason ?? ''}`.trim();
  if (l.status === 'withdrawn') return 'You withdrew this item.';
  if (l.status === 'delisted') return `MMAKF removed this item from sale. ${l.decisionReason ?? ''}`.trim();
  if (l.contentHash !== l.approvedContentHash) return 'Edited since it was approved, so it is back with MMAKF for review.';
  return 'Not currently on sale.';
}
---

<Base
  title="Your products — MMAKF marketplace"
  description="Your MMAKF seller catalogue: items, their variants, their stock, and whether each is actually on sale."
>
  <section>
    <div class="container">

      {ctx.gate !== 'seller' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">Your products</h1>
        <p>{ctx.gate === 'no_seller'
          ? 'You have not applied to sell.'
          : 'Sign in with a personal account that holds a seller record to see your catalogue.'}</p>
        {ctx.gate === 'no_seller' && <p><a class="btn btn-primary" href="/seller/apply">Apply to sell</a></p>}
        </div>
      )}

      {ctx.gate === 'seller' && (
        <>
          <div class="eyebrow">MMAKF marketplace</div>
          <h1 class="display-1" style="margin-top:14px">Products</h1>

          <nav class="tabs" aria-label="Seller area">
            {SELLER_TABS.map((t) => (
              <a href={t.href} aria-current={t.href === '/portal/seller/products' ? 'page' : undefined}>{t.label}</a>
            ))}
          </nav>

          {pageError && <div class="card" role="alert"><p>{pageError}</p></div>}

          {!ctx.approved && (
            <div class="card">
              <h2 class="h3">You cannot list yet.</h2>
              <p>
                MMAKF has not approved this seller account, so there is no create form on this page — not a
                disabled button that posts anyway. The server refuses the act regardless of what the page shows.
              </p>
            </div>
          )}

          {ctx.approved && (
            <>
              {locations.length === 0 && (
                <div class="card" role="alert">
                  <h2 class="h3">You have no stock location.</h2>
                  <p>
                    Stock is counted at a place. Until you name one, nothing you list can be reserved for a
                    buyer — an order would find nothing to hold.
                  </p>
                  <form id="loc-form" class="row">
                    <input name="code" placeholder="Code, e.g. W1" maxlength="20" required />
                    <input name="name" placeholder="Name, e.g. Main warehouse" maxlength="80" required />
                    <button class="btn btn-primary" type="submit">Add location</button>
                  </form>
                  <p id="loc-error" class="error" role="alert" hidden></p>
                </div>
              )}

              {/* ── New item ────────────────────────────────────────────── */}
              <details class="card">
                <summary><strong>Add an item</strong></summary>
                <form id="listing-form" style="margin-top:12px">
                  <label for="title">Title</label>
                  <input id="title" name="title" required maxlength="200" />

                  <label for="category">Category</label>
                  <select id="category" name="category" required>
                    {LISTING_CATEGORIES.map((c) => <option value={c}>{titleCase(c)}</option>)}
                  </select>

                  <label for="priceRupees">Price, in rupees</label>
                  <input id="priceRupees" name="priceRupees" required inputmode="decimal" placeholder="1799.00" />
                  <p class="hint">Digits and at most two decimal places. The conversion to paise happens once, on the server.</p>

                  <label for="description">Description</label>
                  <textarea id="description" name="description" rows="3" maxlength="4000"></textarea>

                  <p id="listing-error" class="error" role="alert" hidden></p>
                  <button class="btn btn-primary" type="submit">Create as a draft</button>
                  <p class="hint">
                    Created as a draft with no photographs. Photographs are added afterwards, on the item,
                    because changing what a reviewer looks at is an edit and is reported as one.
                  </p>
                </form>
              </details>

              {/* ── Low stock ───────────────────────────────────────────── */}
              {low.configured && low.rows.length > 0 && (
                <div class="card">
                  <div class="eyebrow">Running out</div>
                  <ul>
                    {low.rows.map((r: any) => (
                      <li>{r.listingTitle} — {r.label}: <strong>{r.available}</strong> left (your threshold: {r.threshold})</li>
                    ))}
                  </ul>
                </div>
              )}

              {/* ── The catalogue ───────────────────────────────────────── */}
              {listings.length === 0 ? (
                <div class="card"><p class="muted">Nothing listed yet.</p></div>
              ) : listings.map((l: any) => {
                const vs = variantsBy.get(l.id) ?? [];
                const why = invisibilityReason(l);
                return (
                  <article class="card" data-listing={l.id}>
                    <header class="row between">
                      <div>
                        <h2 class="h3" style="margin:0">{l.title}</h2>
                        <p class="muted" style="margin:4px 0">
                          {l.ref} · {titleCase(l.category)} · from {money(l.priceMinor)} · {l.variantCount} variant{l.variantCount === 1 ? '' : 's'}
                        </p>
                      </div>
                      <div>
                        {l.publiclyVisible
                          ? <span class="pill pill-good">On sale</span>
                          : <span class="pill pill-wait">{titleCase(l.status)}</span>}
                      </div>
                    </header>

                    {why && <p class="why">{why}</p>}

                    <table>
                      <caption class="sr-only">Variants of {l.title}</caption>
                      <thead><tr>
                        <th scope="col">Variant</th><th scope="col">SKU</th><th scope="col">Price</th>
                        <th scope="col">Available</th><th scope="col">Held</th><th scope="col">Add stock</th>
                      </tr></thead>
                      <tbody>
                        {vs.map((v: any) => {
                          const rows = stockFor(v.id);
                          const held = rows.reduce((n: number, r: any) => n + r.reserved + r.committed, 0);
                          return (
                            <tr>
                              <th scope="row">{v.label}{v.status !== 'active' ? ` (${titleCase(v.status)})` : ''}</th>
                              <td><code>{v.sku}</code></td>
                              <td>{money(v.priceMinor)}</td>
                              <td>{v.availableQty}</td>
                              <td>{held || '—'}</td>
                              <td>
                                {locations.length > 0 && (
                                  <form class="stock-form row" data-variant={v.id}>
                                    <label class="sr-only" for={`qty-${v.id}`}>Quantity to add for {v.label}</label>
                                    <input id={`qty-${v.id}`} name="qty" type="number" min="1" max="100000" placeholder="0" style="width:6em" />
                                    <label class="sr-only" for={`loc-${v.id}`}>Location</label>
                                    <select id={`loc-${v.id}`} name="locationId">
                                      {locations.map((loc: any) => <option value={loc.id}>{loc.code}</option>)}
                                    </select>
                                    <button class="btn btn-small" type="submit">Receive</button>
                                  </form>
                                )}
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>

                    <details>
                      <summary>Add a variant</summary>
                      <p class="hint warn">
                        Adding or repricing a variant changes what MMAKF approved, so this item goes back to
                        review and leaves the shop until it is looked at again. Selling one does not.
                      </p>
                      <form class="variant-form row" data-listing={l.id}>
                        <input name="label" placeholder="Size 170cm, white" maxlength="120" required />
                        <input name="priceRupees" inputmode="decimal" placeholder="1799.00" required />
                        <input name="sellerSku" placeholder="Your SKU (optional)" maxlength="60" />
                        <button class="btn btn-small" type="submit">Add variant</button>
                      </form>
                    </details>

                    <div class="row">
                      {l.status === 'draft' && <button class="btn btn-small" data-submit={l.id}>Submit for review</button>}
                      {l.status === 'approved' && <button class="btn btn-small" data-withdraw={l.id}>Withdraw from sale</button>}
                      <a class="btn btn-small" href={`/portal/listings/${l.id}`}>Edit &amp; photographs</a>
                    </div>
                  </article>
                );
              })}

              <p id="page-error" class="error" role="alert" hidden></p>
            </>
          )}
        </>
      )}

    </div>
  </section>
</Base>

<script>
  const pageError = document.getElementById('page-error');
  const say = (m: string) => {
    if (!pageError) { window.alert(m); return; }
    pageError.textContent = m; pageError.hidden = false;
    pageError.scrollIntoView({ block: 'center', behavior: 'smooth' });
  };

  async function post(action: string, body: Record<string, unknown>) {
    const r = await fetch(`/api/marketplace/${action}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });
    const b = await r.json().catch(() => ({}));
    return { ok: r.ok && b.ok, body: b };
  }

  const reloadOr = (res: any, fallback: string) => {
    if (res.ok) { window.location.reload(); return; }
    say(res.body.error || fallback);
  };

  document.getElementById('loc-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const res = await post('location/create', { code: f.get('code'), name: f.get('name') });
    if (res.ok) { window.location.reload(); return; }
    const el = document.getElementById('loc-error')!;
    el.textContent = res.body.error || 'Could not add the location.'; el.hidden = false;
  });

  document.getElementById('listing-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    const res = await post('listing/create', {
      title: f.get('title'), category: f.get('category'),
      priceRupees: f.get('priceRupees'), description: f.get('description') || null,
    });
    if (res.ok) { window.location.reload(); return; }
    const el = document.getElementById('listing-error')!;
    el.textContent = res.body.error || 'Could not create the item.'; el.hidden = false;
  });

  document.querySelectorAll('.variant-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form as HTMLFormElement);
      const res = await post('variant/add', {
        listingId: Number((form as HTMLElement).dataset.listing),
        label: f.get('label'), priceRupees: f.get('priceRupees'),
        sellerSku: f.get('sellerSku') || null,
      });
      if (res.ok && res.body.result?.returnedToReview) {
        window.alert('Variant added. This item has gone back to MMAKF for review, so it has left the shop until it is looked at again.');
      }
      reloadOr(res, 'Could not add the variant.');
    });
  });

  document.querySelectorAll('.stock-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form as HTMLFormElement);
      const qty = Number(f.get('qty'));
      if (!Number.isInteger(qty) || qty < 1) { say('Enter a whole number of items to receive.'); return; }
      const res = await post('stock/receive', {
        variantId: Number((form as HTMLElement).dataset.variant),
        locationId: Number(f.get('locationId')), qty,
        reason: 'Received into stock from the seller portal.',
      });
      reloadOr(res, 'Could not record the stock.');
    });
  });

  document.querySelectorAll('[data-submit]').forEach((b) => b.addEventListener('click', async () => {
    reloadOr(await post('listing/submit', { listingId: Number((b as HTMLElement).dataset.submit) }),
      'Could not submit the item.');
  }));

  document.querySelectorAll('[data-withdraw]').forEach((b) => b.addEventListener('click', async () => {
    const reason = window.prompt('Why are you withdrawing this item? (recorded, and reversible)');
    if (reason === null) return;
    reloadOr(await post('listing/withdraw', { listingId: Number((b as HTMLElement).dataset.withdraw), reason }),
      'Could not withdraw the item.');
  }));
</script>

<style>
  .tabs { display: flex; gap: 16px; margin: 18px 0; flex-wrap: wrap; }
  .tabs a { padding: 6px 0; border-bottom: 2px solid transparent; text-decoration: none; }
  .tabs a[aria-current='page'] { border-bottom-color: currentColor; font-weight: 600; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .row.between { justify-content: space-between; align-items: flex-start; }
  .pill { padding: 2px 10px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; white-space: nowrap; }
  .why { font-weight: 600; }
  .muted { opacity: 0.75; }
  .hint { font-size: 0.9em; opacity: 0.8; }
  .hint.warn { font-weight: 600; opacity: 1; }
  .error { color: #b00020; font-weight: 600; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); }
  .btn-small { padding: 4px 10px; font-size: 0.9em; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
