---
// /portal/seller — the seller's overview.
//
// Standing, verification, badges, the storefront, and the things MMAKF has not
// decided. It takes no identifier of any kind; see _gate.ts.
//
// TWO THINGS THIS PAGE IS CAREFUL ABOUT:
//
//   · THE BADGES ARE THE DERIVED ONES. They come from badgesFor(), which
//     computes them from current verification and authorisation rows every time
//     it runs. A seller cannot make one appear by typing, and this page renders
//     the BASIS beside each one so it is obvious where it came from.
//
//   · WHERE THE FEDERATION HAS DECIDED NOTHING, IT SAYS SO IN THE MODULE'S OWN
//     WORDS. There is no commission figure, no SLA and no return window
//     anywhere in this file, because MMAKF has published none of them.

import Base from '@/layouts/Base.astro';
import { db } from '@/db';
import { eq, sql } from 'drizzle-orm';
import * as s from '@/db/schema';
import { COMMISSION_NOT_SET } from '@/db/marketplace';
import { COMMISSION_NOT_CONFIGURED, SLA_NOT_SET, myAccount } from '@/db/marketplace-finance';
// A seller could be publicly criticised on the federation's own domain and had
// no way to answer: replyToReview() existed and no control anywhere called it.
// A marketplace that publishes the complaint and withholds the reply is not
// being neutral.
import { myPublishedReviews } from '@/db/marketplace-trust';
import { effectiveReturnPolicy } from '@/db/returns';
import { policiesForSeller, NO_MANDATORY_POLICIES } from '@/db/marketplace-policy';
import { slaFor } from '@/db/seller-orders';
import {
  sellerContext, readableError, money, fmtDate, titleCase,
  SELLER_TABS, SELLER_STANDING,
} from './_gate';

export const prerender = false;

const ctx = await sellerContext(Astro.request.headers.get('cookie'));

let counts = { listings: 0, live: 0, inReview: 0, openOrders: 0, openReturns: 0, disputes: 0 };
let account: any = null;
let reviews: any = { product: [], seller: [] };
let sla: any = null;
let returnPolicy: any = null;
let policies: any[] = [];
let pageError: string | null = ctx.loadError;

if (ctx.gate === 'seller' && ctx.seller && !pageError) {
  try {
    const one = async (q: any) => (await q)[0]?.n ?? 0;
    const sellerId = ctx.seller.id;

    counts.listings = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.listings).where(eq(s.listings.sellerId, sellerId)));
    counts.inReview = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.listings).where(sql`${s.listings.sellerId} = ${sellerId} and ${s.listings.status} = 'submitted'`));
    // The SAME five conditions the public shop uses, asked of this seller's rows
    // — so this page and the shop cannot disagree about what is on sale.
    counts.live = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.listings).innerJoin(s.sellers, eq(s.listings.sellerId, s.sellers.id))
      .where(sql`${s.listings.sellerId} = ${sellerId}
        and ${s.listings.status} = 'approved'
        and ${s.sellers.status} = 'approved'
        and ${s.listings.contentHash} = ${s.listings.approvedContentHash}
        and ${s.listings.quarantinedAt} is null
        and ${s.sellers.storeStatus} = 'open'`));
    counts.openOrders = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.sellerOrders).where(sql`${s.sellerOrders.sellerId} = ${sellerId}
        and ${s.sellerOrders.status} in ('paid','seller_accepted','processing','packed','shipped','in_transit')`));
    counts.openReturns = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.returnRequests).where(sql`${s.returnRequests.sellerId} = ${sellerId}
        and ${s.returnRequests.status} in ('requested','seller_reviewing','authorised','in_transit','received')`));
    counts.disputes = await one(db().select({ n: sql<number>`count(*)::int` })
      .from(s.marketplaceDisputes).where(sql`${s.marketplaceDisputes.sellerId} = ${sellerId}
        and ${s.marketplaceDisputes.status} in ('open','seller_responding','under_review','escalated')`));

    // Published reviews only. A seller must not read a PENDING one: it has not
    // been moderated yet, and a seller who knows what a buyer wrote before
    // MMAKF has decided whether to publish it can act on it.
    reviews = await myPublishedReviews(db(), sellerId, 50);

    account = await myAccount(db(), ctx.identity!.principal);
    sla = await slaFor(db(), sellerId);
    returnPolicy = await effectiveReturnPolicy(db(), sellerId);
    policies = await policiesForSeller(db(), ctx.identity!.principal);
  } catch (err: any) {
    pageError = readableError(err, 'Your seller overview');
  }
}

const standing = ctx.seller ? SELLER_STANDING[ctx.seller.status] : null;
const store = ctx.seller;
const storeOpen = store?.storeStatus === 'open';

/** The nine checks, in the order a reviewer works them. */
const CHECK_ORDER = [
  'identity', 'business', 'address', 'gst', 'pan', 'bank',
  'brand_authorisation', 'manufacturer_authorisation', 'product_authorisation',
];
const verifications = (ctx.profile?.verifications ?? [])
  .slice()
  .sort((a: any, b: any) => CHECK_ORDER.indexOf(a.check) - CHECK_ORDER.indexOf(b.check));
---

<Base
  title="Your seller area — MMAKF marketplace"
  description="Your MMAKF seller account: standing, verification, storefront and the decisions the federation has recorded."
>
  <section>
    <div class="container">

      {ctx.gate === 'no_database' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">Not available on this deployment.</h1>
        <p>The federation database is not configured here, so nothing can be read or recorded.</p></div>
      )}

      {ctx.gate === 'signed_out' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">Sign in to see your shop.</h1>
        <p>Your seller record belongs to your account. <a href="/join">Create an account</a> or sign in.</p></div>
      )}

      {ctx.gate === 'shared_credential' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">This credential cannot hold a seller record.</h1>
        <p>A shared office credential is attributable to no one person, so it holds no shop.</p></div>
      )}

      {ctx.gate === 'no_seller' && (
        <div class="card"><div class="eyebrow">Seller area</div>
        <h1 class="display-2" style="margin-top:14px">You have not applied to sell.</h1>
        <p>MMAKF reviews every application. Approval to sell is one decision; each item you list is reviewed separately.</p>
        <p><a class="btn btn-primary" href="/seller/apply">Apply to sell</a></p></div>
      )}

      {ctx.gate === 'seller' && (
        <>
          <div class="eyebrow">MMAKF marketplace</div>
          <h1 class="display-1" style="margin-top:14px">{store?.tradingName ?? 'Your shop'}</h1>

          <nav class="tabs" aria-label="Seller area">
            {SELLER_TABS.map((t) => (
              <a href={t.href} aria-current={t.href === '/portal/seller' ? 'page' : undefined}>{t.label}</a>
            ))}
          </nav>

          {pageError && <div class="card" role="alert"><p>{pageError}</p></div>}

          {standing && (
            <div class={`card tone-${standing.tone}`}>
              <div class="eyebrow">Standing</div>
              <h2 class="h3">{standing.label}</h2>
              <p>{standing.body}</p>
              {store?.decisionReason && <p><strong>MMAKF recorded:</strong> {store.decisionReason}</p>}
              {store?.suspendedReason && <p><strong>Reason for suspension:</strong> {store.suspendedReason}</p>}
              {store?.restrictedAt && (
                <p>
                  <strong>Restricted.</strong> You may keep trading, except in:
                  {' '}{(store.restrictedCategories ?? []).join(', ') || '—'}.
                  {store.restrictedReason ? ` ${store.restrictedReason}` : ''}
                  {' '}A restriction is not a suspension — the rest of your shop is unaffected.
                </p>
              )}
              <p class="muted">Seller reference <strong>{store?.ref}</strong> · {titleCase(store?.sellerType) || 'Kind not recorded'}</p>
            </div>
          )}

          {ctx.approved && (
            <div class="grid-4">
              <div class="card stat"><div class="n">{counts.live}</div><div class="k">On sale now</div></div>
              <div class="card stat"><div class="n">{counts.inReview}</div><div class="k">In review</div></div>
              <div class="card stat"><div class="n">{counts.openOrders}</div><div class="k">Orders to fulfil</div></div>
              <div class="card stat"><div class="n">{counts.openReturns + counts.disputes}</div><div class="k">Returns &amp; disputes</div></div>
            </div>
          )}

          {/* ── Verification ───────────────────────────────────────────── */}
          <div class="card">
            <div class="eyebrow">Verification</div>
            <h2 class="h3">What MMAKF has checked</h2>
            <p class="muted">
              Each check is recorded separately, so “identity confirmed, GST outstanding” is a state this
              register can actually hold. A single verified/unverified flag could not express it.
            </p>
            <table>
              <thead><tr><th scope="col">Check</th><th scope="col">Status</th><th scope="col">Recorded</th><th scope="col">Expires</th></tr></thead>
              <tbody>
                {verifications.map((v: any) => (
                  <tr>
                    <th scope="row">{titleCase(v.check)}</th>
                    <td><span class={`pill pill-${v.status}`}>{titleCase(v.status)}</span>
                      {v.status === 'documents_required' && v.reason && <div class="muted">{v.reason}</div>}
                      {v.status === 'rejected' && v.reason && <div class="muted">{v.reason}</div>}
                    </td>
                    <td>{fmtDate(v.decidedAt)}</td>
                    <td>{fmtDate(v.expiresAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="muted">{ctx.profile?.notes?.verification}</p>
          </div>

          {/* ── Badges ─────────────────────────────────────────────────── */}
          <div class="card">
            <div class="eyebrow">Trust</div>
            <h2 class="h3">Badges you hold</h2>
            {(ctx.profile?.badges ?? []).length === 0 ? (
              <p class="muted">
                None yet. A badge is a record, not a description — it appears when the evidence behind it
                exists, and disappears when that evidence lapses. Nothing you write in your store profile
                can produce one.
              </p>
            ) : (
              <ul class="badges">
                {(ctx.profile?.badges ?? []).map((b: any) => (
                  <li><strong>{b.label}</strong><br /><span class="muted">{b.basis}</span></li>
                ))}
              </ul>
            )}
          </div>

          {/* ── Storefront ─────────────────────────────────────────────── */}
          {ctx.approved && (
            <form id="store-form" class="card">
              <div class="eyebrow">Storefront</div>
              <h2 class="h3">Your public shop</h2>
              {store?.storeSlug
                ? <p>Live at <a href={`/shop/seller/${store.storeSlug}`}><code>/shop/seller/{store.storeSlug}</code></a>{storeOpen ? '' : ' — currently closed, so nothing of yours is on sale.'}</p>
                : <p class="muted">No public address yet.</p>}

              <label for="storeSlug">Shop address</label>
              <input id="storeSlug" name="storeSlug" value={store?.storeSlug ?? ''} maxlength="60" />
              <p class="hint">Letters, numbers and hyphens. Two shops cannot share an address.</p>

              <label for="storeTagline">Tagline</label>
              <input id="storeTagline" name="storeTagline" value={store?.storeTagline ?? ''} maxlength="160" />
              <p class="hint">
                Describes your shop. It is <strong>not</strong> a badge: writing “Official MMAKF supplier”
                here produces a tagline and nothing else, because a badge is a record MMAKF writes.
              </p>

              <label for="storeAbout">About your shop</label>
              <textarea id="storeAbout" name="storeAbout" rows="4" maxlength="4000">{store?.storeAbout ?? ''}</textarea>

              <p id="store-error" class="error" role="alert" hidden></p>
              <p id="store-ok" class="ok" role="status" hidden></p>
              <div class="row">
                <button class="btn btn-primary" type="submit">Save shop details</button>
                {storeOpen
                  ? <button class="btn" type="button" data-store="close">Close my shop</button>
                  : <button class="btn" type="button" data-store="open">Reopen my shop</button>}
              </div>
              <p class="hint">
                Closing your shop stops new orders and takes your items off the marketplace. It is
                <strong> not</strong> a suspension — nothing is recorded against you, and you reopen it yourself.
              </p>
            </form>
          )}

          {/* ── Reviews, and the right of reply ──────────────────────────
               PUBLISHED ONLY, so nothing here is a review MMAKF is still
               deciding about. A reply is public and permanent in the same way
               the review is, which is why it is written in a form with the
               review visible above it rather than from a notification. */}
          {ctx.approved && (reviews.product.length > 0 || reviews.seller.length > 0) && (
            <div class="card">
              <div class="eyebrow">Reviews</div>
              <h2 class="h3">What buyers have said</h2>
              <p class="hint">
                These are already public. You may reply once to each; the reply appears beneath the
                review on the shop. MMAKF does not remove a published review because a seller
                disagrees with it — the reply is the remedy.
              </p>

              {reviews.seller.map((r: any) => (
                <article class="review">
                  <p><strong>{r.ratingOverall} out of 5</strong> — your shop</p>
                  {r.body && <p>{r.body}</p>}
                  {r.sellerReply
                    ? <p class="muted"><strong>You replied:</strong> {r.sellerReply}</p>
                    : (
                      <form class="reply-form" data-kind="seller" data-id={r.id}>
                        <label class="sr-only" for={`sr-${r.id}`}>Your reply</label>
                        <textarea id={`sr-${r.id}`} name="reply" rows="2" required maxlength="4000"></textarea>
                        <button class="btn btn-small" type="submit">Reply publicly</button>
                      </form>
                    )}
                </article>
              ))}

              {reviews.product.map((r: any) => (
                <article class="review">
                  <p>
                    <strong>{r.review.rating} out of 5</strong> — {r.listingTitle}
                    {r.review.title ? ` — ${r.review.title}` : ''}
                  </p>
                  {r.review.body && <p>{r.review.body}</p>}
                  {r.review.sellerReply
                    ? <p class="muted"><strong>You replied:</strong> {r.review.sellerReply}</p>
                    : (
                      <form class="reply-form" data-kind="product" data-id={r.review.id}>
                        <label class="sr-only" for={`pr-${r.review.id}`}>Your reply</label>
                        <textarea id={`pr-${r.review.id}`} name="reply" rows="2" required maxlength="4000"></textarea>
                        <button class="btn btn-small" type="submit">Reply publicly</button>
                      </form>
                    )}
                </article>
              ))}
            </div>
          )}

          {/* ── What the federation has not decided ────────────────────── */}
          <div class="card">
            <div class="eyebrow">Terms</div>
            <h2 class="h3">What MMAKF has and has not set</h2>
            <dl>
              <dt>Commission</dt>
              <dd>{account?.heldForCommission ? COMMISSION_NOT_CONFIGURED : COMMISSION_NOT_SET}</dd>
              <dt>Service levels</dt>
              <dd>{sla?.configured
                ? `Accept within ${sla.acceptanceHours ?? '—'}h · dispatch within ${sla.dispatchHours ?? '—'}h.`
                : SLA_NOT_SET}</dd>
              <dt>Returns</dt>
              <dd>
                {returnPolicy?.windowDays != null
                  ? `${returnPolicy.windowDays} days, set by the ${titleCase(returnPolicy.source)}.`
                  : 'No return window is published.'}
                {(returnPolicy?.notes ?? []).map((n: string) => <div class="muted">{n}</div>)}
              </dd>
            </dl>
            {account?.heldForCommission > 0 && (
              <p class="warn">
                <strong>{account.heldForCommission} of your sales are held.</strong> MMAKF has not
                published a commission covering them, so nothing can be settled until it does. Your goods
                are sold and the money is safe — it is the payout that is waiting, not the sale.
              </p>
            )}
          </div>

          {/*
            THE DOCUMENTS THIS SELLER IS ASKED TO ACCEPT.
            Until this section existed, policiesForSeller() had no caller: MMAKF
            could mark a seller agreement mandatory and publish it, and the
            seller had no way to find out that anything was being asked of them,
            let alone accept it. An obligation nobody can see is not an
            obligation — it is a trap.
          */}
          <div class="card">
            <div class="eyebrow">Marketplace documents</div>
            <h2 class="h3">What you have been asked to accept</h2>

            {policies.length === 0 && (
              <p class="muted">
                MMAKF has registered no marketplace documents. Nothing is being asked of you.
              </p>
            )}

            {policies.length > 0 && !policies.some((p: any) => p.mandatory) && (
              <p class="muted">{NO_MANDATORY_POLICIES}</p>
            )}

            {policies.length > 0 && (
              <dl>
                {policies.map((p: any) => (
                  <>
                    <dt>{p.title}{p.mandatory ? ' — required' : ''}</dt>
                    <dd>
                      {/* THREE DISTINCT STATES, none of them collapsed into
                          "not accepted": no text published at all, published
                          and outstanding, and accepted. A seller reading
                          "outstanding" about a document with no text would go
                          looking for something that does not exist. */}
                      {!p.version && <span class="muted">{p.note}</span>}

                      {p.version && !p.accepted && (
                        <>
                          Version {p.version.version}, effective {p.version.effectiveFrom} —
                          <strong> not yet accepted</strong>.
                          <details>
                            <summary>Read it</summary>
                            <pre class="policy-body">{p.version.body}</pre>
                          </details>
                          <button
                            class="btn btn-small accept-policy"
                            data-version={p.version.id}
                            data-title={p.title}
                          >Accept this version</button>
                        </>
                      )}

                      {p.version && p.accepted && (
                        <>
                          Accepted {fmtDate(p.accepted.acceptedAt)}, version {p.version.version}.
                          {p.acceptanceStillValid === false && (
                            <div class="warn">
                              <strong>The published text has changed since you accepted it.</strong>
                              Raise this with MMAKF: what you agreed to and what is published are no
                              longer the same document.
                            </div>
                          )}
                        </>
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            )}
          </div>
        </>
      )}

    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('store-form') as HTMLFormElement | null;
  if (form) {
    const err = document.getElementById('store-error')!;
    const ok = document.getElementById('store-ok')!;
    const show = (el: HTMLElement, m: string) => { el.textContent = m; el.hidden = false; };
    const hide = () => { err.hidden = true; ok.hidden = true; };

    async function post(action: string, body: Record<string, unknown>) {
      const r = await fetch(`/api/marketplace/${action}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      });
      return { ok: r.ok, body: await r.json().catch(() => ({})) };
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hide();
      const f = new FormData(form);
      const v = (k: string) => { const x = f.get(k); return typeof x === 'string' ? x.trim() : ''; };
      const res = await post('store/update', {
        storeSlug: v('storeSlug') || null,
        storeTagline: v('storeTagline') || null,
        storeAbout: v('storeAbout') || null,
      });
      if (res.ok && res.body.ok) { show(ok, 'Saved.'); window.setTimeout(() => window.location.reload(), 700); }
      else show(err, res.body.error || 'Could not save. Nothing has been changed.');
    });

    form.querySelectorAll('[data-store]').forEach((b) => {
      b.addEventListener('click', async () => {
        hide();
        const which = (b as HTMLElement).dataset.store;
        const reason = which === 'close'
          ? window.prompt('Why are you closing the shop? (optional — recorded for your own reference)') ?? null
          : null;
        const res = await post(`store/${which}`, { reason });
        if (res.ok && res.body.ok) window.location.reload();
        else show(err, res.body.error || 'Could not change the shop. Nothing has been changed.');
      });
    });
  }

  // ── Accepting a marketplace document ──────────────────────────────────────
  //
  // Its own listener rather than reusing the store form’s helper, which is
  // scoped inside `if (form)` and does not exist on a page whose store panel is
  // hidden — which is exactly the page a seller awaiting approval sees.
  //
  // SENDS A VERSION ID, NEVER A POLICY CODE. Accepting “the seller agreement”
  // records nothing: the acceptance has to name the text that was on the screen.
  function acceptPolicyHandler() {
    document.querySelectorAll(".accept-policy").forEach((b) => {
      b.addEventListener("click", async () => {
        const el = b as HTMLElement;
        const title = el.dataset.title || "this document";
        if (!window.confirm(`Accept the published version of ${title}? This is recorded against your seller account with the date and the exact text.`)) return;

        const r = await fetch("/api/marketplace/policy/accept", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ policyVersionId: Number(el.dataset.version) }),
        });
        const body = await r.json().catch(() => ({}));
        if (r.ok && body.ok) { window.location.reload(); return; }
        window.alert(body.error || "It could not be recorded. Nothing has been accepted.");
      });
    });
  }
  acceptPolicyHandler();

  // ── Replying to a review ──────────────────────────────────────────────────
  //
  // Its own listener rather than reusing the store form's helper, which is
  // scoped inside `if (form)` and does not exist on a page whose store panel is
  // hidden — the same reasoning as the policy handler above.
  //
  // CONFIRMED BEFORE SENDING, because replyToReview() allows one reply and the
  // reply is public. A seller who typed in anger and pressed the button has no
  // second attempt, and finding that out afterwards is the wrong moment.
  document.querySelectorAll('.reply-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const el = form as HTMLFormElement;
      const text = (el.querySelector('textarea[name="reply"]') as HTMLTextAreaElement | null)?.value ?? '';
      if (!text.trim()) return;
      if (!window.confirm('This reply is published beneath the review and cannot be changed. Send it?')) return;

      const r = await fetch('/api/marketplace/review/reply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: (form as HTMLElement).dataset.kind,
          reviewId: Number((form as HTMLElement).dataset.id),
          reply: text.trim(),
        }),
      });
      const body = await r.json().catch(() => ({}));
      if (r.ok && body.ok) { window.location.reload(); return; }
      window.alert(body.error || 'The reply could not be sent. Nothing has been published.');
    });
  });
</script>

<style>
  .review { border-top: 1px solid rgba(128,128,128,0.3); padding: 12px 0; }
  .reply-form textarea { width: 100%; max-width: 640px; }

  .tabs { display: flex; gap: 16px; margin: 18px 0; flex-wrap: wrap; }
  .tabs a { padding: 6px 0; border-bottom: 2px solid transparent; text-decoration: none; }
  .tabs a[aria-current='page'] { border-bottom-color: currentColor; font-weight: 600; }
  .grid-4 { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; margin: 18px 0; }
  @media (min-width: 900px) { .grid-4 { grid-template-columns: repeat(4, 1fr); } }
  .stat .n { font-size: 2rem; font-weight: 700; line-height: 1; }
  .stat .k { opacity: 0.75; margin-top: 4px; }
  .pill { padding: 2px 8px; border-radius: 999px; border: 1px solid currentColor; font-size: 0.85em; }
  .badges { list-style: none; padding: 0; display: grid; gap: 10px; }
  .muted { opacity: 0.75; }
  .warn { font-weight: 600; }
  .hint { font-size: 0.9em; opacity: 0.75; margin-top: 4px; }
  .error { color: #b00020; font-weight: 600; }
  .ok { font-weight: 600; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(128,128,128,0.3); vertical-align: top; }
</style>
