---
/**
 * THE HEADQUARTERS DOJO — /facilities
 *
 * Everything on this page describes ONE BUILDING: the hombu dojo at Patratu.
 * The hours in the card at the foot are that building's hours, and they are
 * labelled as such — an affiliated club's facilities and opening times are its
 * own, and this page has never had them.
 *
 * The hours are read from the scheduling engine (migration 0032) when the
 * headquarters has been migrated into it, and from the editorial record when it
 * has not. See the long note in src/pages/schedule.astro for why the fallback
 * exists and why it is in that order.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import EnrollCTA from '@/components/EnrollCTA.astro';
import OpeningHours from '@/components/OpeningHours.astro';
import { get } from '@/lib/storage';
import { isConfigured, db } from '@/db';
import { headquartersDojo, publishedWeek, todayIso, addDays, type PublishedWeek } from '@/db/scheduling';

export const prerender = false;

const fed = await get('federation');
const facilities = await get<any[]>('facilities');
const programs = await get<any[]>('programs');
const schedule = (await get<any[]>('schedule')) || [];

let hqWeek: PublishedWeek | null = null;
let hqName = '';
if (isConfigured()) {
  try {
    const database = db();
    const hq = await headquartersDojo(database);
    if (hq) {
      hqName = hq.name;
      const from = todayIso();
      hqWeek = await publishedWeek(database, { dojoId: hq.id }, from, addDays(from, 6));
    }
  } catch (err) {
    console.warn('/facilities: the scheduling engine was unreachable; falling back to the published strings', err);
  }
}
const usingEngine = Boolean(hqWeek?.configured);

// The pill sits beside the headquarters address, so it is a claim about the
// PHYSICAL dojo — online batches are excluded or a worldwide Zoom room would
// count as the hombu being open. Counted, not typed, so the federation can
// change it by editing the timetable rather than by editing this file.
const DAY_WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven'];
const dojoDays = new Set(
  schedule.filter((s: any) => s.day && String(s.mode).toLowerCase() !== 'online').map((s: any) => s.day),
).size;
const openPill = dojoDays ? `Open ${DAY_WORDS[dojoDays] ?? dojoDays} day${dojoDays === 1 ? '' : 's'}` : '';
---

<Base
  title="Dojo Facilities — MMAKF"
  description="Inside the MMAKF headquarters dojo at Patratu, Jharkhand — training hall, impact bay, conditioning zone, changing rooms, first-aid, CCTV and more."
>
  <PageHero
    image="https://images.unsplash.com/photo-1571902943202-507ec2618e8f?auto=format&fit=crop&w=1800&q=70"
    eyebrow="The Dojo"
    title={`Inside the <em>hombu</em> dojo.`}
    lead={`Everything at ${fed.shortName} headquarters is built around one thing: serious, safe, structured training. These are the facilities every member trains with.`}
    pills={[`${fed.headquarters}`, openPill].filter(Boolean)}
  />

  {/* ═══════ FACILITIES GRID ═══════ */}
  <section>
    <div class="container">
      <div class="grid grid-3">
        {facilities.map((f: any) => (
          <div class="card hoverable fade">
            <div class="card-icon"><Icon name={f.icon || 'mat'} size={36} color="var(--gold)" /></div>
            <div class="card-title" style="font-size:1.05rem">{f.name}</div>
            <div class="card-body">{f.desc}</div>
            <div style="margin-top:18px"><span class="pill">{f.tag}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════ SAFETY STANDARDS ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Standards</div>
        <h2 class="display-2">Safety is a <em class="r">discipline</em> too.</h2>
        <div class="rule"></div>
      </div>
      <div class="grid grid-4">
        {[
          { icon: 'shield',    t: 'Supervised Training',  d: 'No student trains unsupervised. Every batch runs under a Dan-graded instructor.' },
          { icon: 'first-aid', t: 'First Response',       d: 'Senior instructors are trained in sports first aid; a stocked station is on the floor.' },
          { icon: 'users',     t: 'Age-Matched Batches',  d: 'Kids, teens, adults and women train in separate, level-appropriate batches.' },
          { icon: 'cctv',      t: 'Monitored Premises',   d: 'CCTV covers all training areas and entrances, reviewable by parents on request.' },
        ].map((s) => (
          <div class="card fade">
            <div class="card-icon"><Icon name={s.icon} size={32} color="var(--gold)" /></div>
            <div class="card-title" style="font-size:.98rem">{s.t}</div>
            <div class="card-body" style="font-size:.86rem">{s.d}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════ VISIT ═══════ */}
  <section>
    <div class="container">
      <div class="visit-grid">
        <div class="fade">
          <div class="eyebrow">Visit</div>
          <h2 class="display-2" style="margin-top:14px">See it in <em class="r">person</em>.</h2>
          <div class="rule"></div>
          <p class="lead">
            The best way to judge a dojo is to stand in it. Walk in during any open batch,
            watch a class, and talk to the senseis — no appointment needed.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact" class="btn btn-primary">Plan your visit</a>
            <a href="/schedule" class="btn btn-ghost">See class timings</a>
          </div>
        </div>
        <div class="card fade" style="align-self:center">
          <div class="card-eyebrow">Headquarters</div>
          <div class="card-title" style="font-size:1.05rem">{fed.shortName} Hombu Dojo</div>
          <div class="card-body">{fed.contact.address}</div>
          {/* The engine when it has these hours as data, the published strings
              when it does not. Never both — two renderings of the same fact are
              two places for it to drift. */}
          {usingEngine ? (
            <div style="margin-top:14px">
              <OpeningHours week={hqWeek!} subject={hqName || 'The hombu dojo'} compact={true} />
            </div>
          ) : (
            <>
              <div class="card-body" style="margin-top:12px"><span class="text-gold">{fed.contact.hours}</span></div>
              {fed.contact.hoursSunday && (
                <div class="card-body" style="margin-top:6px"><span class="text-gold">{fed.contact.hoursSunday}</span></div>
              )}
            </>
          )}
          <div class="card-body" style="margin-top:12px;font-size:.8rem">
            These are this building&rsquo;s hours. <a href="/dojos" class="text-gold">Affiliated clubs</a> publish their own.
          </div>
        </div>
      </div>
    </div>
  </section>

  <EnrollCTA programs={programs} />
</Base>

<style>
  .bg2 { background: var(--bg-2); }
  .visit-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
  }
  @media (max-width: 800px) { .visit-grid { grid-template-columns: 1fr; } }
</style>
