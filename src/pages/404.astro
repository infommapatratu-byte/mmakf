---
import Base from '@/layouts/Base.astro';

export const prerender = false;

// THIS PAGE SAYS THAT IT IS THIS PAGE, and src/middleware.ts is the reader.
//
// The learn and admin hosts serve everything through context.rewrite(), and a
// rewrite can land on a REAL page while the response still carries the 404
// status the platform chose for the un-prefixed path. The middleware corrects
// that — but a genuine miss must keep its 404, and the only thing that can
// tell the two apart is this file saying which one it is.
//
// Consumed by the middleware and stripped before the response leaves.
Astro.response.headers.set('X-MMAKF-Not-Found', '1');

---

<Base title="Page not found — MMAKF" description="The page you were looking for does not exist.">
  <section class="nf">

    <div class="container" style="position:relative;z-index:1;text-align:center">
      <div class="eyebrow center">404</div>
      <h1 class="display-1" style="margin-top:16px">Lost on the <em>mat</em>?</h1>
      <p class="lead" style="margin:20px auto 36px">
        The page you were looking for doesn't exist — it may have moved,
        or the address was mistyped. The dojo is this way.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/programs" class="btn btn-ghost">Training programs</a>
        <a href="/contact" class="btn btn-ghost">Contact the dojo</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    border-top: 0;
  }
  .nf::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(320px, 55vw, 640px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(142, 18, 18, 0.07), transparent 62%);
    pointer-events: none;
  }
</style>
