---
// The applicant's status page.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT OPENS IT
// ─────────────────────────────────────────────────────────────────────────────
//
// The reference AND the private key issued when the application was started.
// Not reference plus contact email: references are sequence-allocated, so the
// next one along is always guessable, and a school's contact address is usually
// printed on its own website — both halves of that pair are public and what
// they would unlock is the school's own submission.
//
// Changing the ref in the address bar therefore reaches nothing. The key is
// bound to one application, and applicantStatus() in src/db/applications.ts
// compares it in constant time against the row the reference selected. A wrong
// key and an unknown reference are the same answer here, deliberately: telling
// them apart would make this page an oracle for which references are real.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHAT IT SHOWS
// ─────────────────────────────────────────────────────────────────────────────
//
// The stage the case has reached, and every entry the federation marked visible
// — no routing, no lead score, no internal notes, no owner. The filter is a SQL
// predicate in applicantStatus(), not a pass over the rows here, so an internal
// note never reaches this process at all.
//
// The timeline is rendered by CaseTimeline, which also renders the
// administrator's view of the same case at /admin/applications/{id}. One
// renderer, two row sets, and the row sets differ only by the stored
// visible_to_applicant flag — so the two halves of a case cannot describe it
// differently.
//
// ─────────────────────────────────────────────────────────────────────────────
// NO DATE IS PROMISED
// ─────────────────────────────────────────────────────────────────────────────
//
// MMAKF has published no service standard for institutional applications, so
// slaDueAt is null on every row and the "respond by" line does not render. The
// page says what has happened. It never says when the next thing will, and it
// never marks anything late — there is no published deadline for anything here
// to be late against.

import Base from '@/layouts/Base.astro';
import Status from '@/components/Status.astro';
import CaseTimeline from '@/components/CaseTimeline.astro';
import { isConfigured, db } from '@/db';
import { applicantStatus, TOTAL_STEPS } from '@/db/applications';
import { href as surfaceHref, type Surface } from '@/lib/surface';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);

const ref = String(Astro.params.ref ?? '');
const token = Astro.url.searchParams.get('k') ?? '';
const justSent = Astro.url.searchParams.get('sent') === '1';

// The address of this page CONTAINS the key. Two consequences, both handled
// here rather than trusted to a default:
//
//   · no-store, because a shared or cached copy of this page is a copy of one
//     school's contact details and requirements;
//   · no-referrer, because every link a reader follows off this page would
//     otherwise carry the key to wherever they went, in the Referer header.
Astro.response.headers.set('Cache-Control', 'no-store, private');

let view: any = null;
let failure: string | null = null;

if (!isConfigured()) {
  failure = 'The federation’s database is not reachable from this deployment, so this application cannot be looked up.';
} else {
  try {
    view = await applicantStatus(db(), ref, token);
  } catch (err) {
    // Deliberately the same message for a wrong key and a reference that does
    // not exist. See the note at the top.
    failure = 'No application matches that link. Check the address, including the part after ?k=.';
  }
}

// A draft is not an application. It has been started and not sent, and the only
// useful thing this page can offer is the way back into the form.
const isDraft = !!view && view.status === 'draft';
const resumeStep = Math.min(Math.max(Number(view?.stepReached) || 1, 1), TOTAL_STEPS);
const resumeHref = view
  ? `${h('/learn/apply')}?ref=${encodeURIComponent(view.ref)}&k=${encodeURIComponent(token)}&step=${resumeStep}`
  : h('/learn/apply');

function when(v: unknown): string {
  if (!v) return '';
  const d = new Date(v as string);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Base
  title={`Application ${ref} — MMAKF`}
  description="The status of an MMAKF training application."
>
  {/* A private page. Never indexed, never cached by an intermediary, and never
      a source of a Referer header carrying the key in the address. */}
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <meta name="referrer" content="no-referrer" slot="head" />

  <div class="st">
    <div class="container st-inner">
      {failure ? (
        <>
          <p class="eyebrow">MMAKF training application</p>
          <h1 class="display-2">We cannot find that application.</h1>
          <p class="st-lede">{failure}</p>
          <p class="st-lede">
            If you have lost the link, write to
            {' '}<a href="mailto:admin@mmakf.in">admin@mmakf.in</a> with the name of
            your institution and MMAKF will resend it.
          </p>
          <a class="btn btn-ghost" href={h('/learn')}>Back to training</a>
        </>
      ) : (
        <>
          {justSent && (
            <div class="st-sent" role="status">
              <strong>Your application has been sent.</strong>
              Keep this page — the address contains the key that opens it. It is
              the only way back in.
            </div>
          )}

          <p class="eyebrow">MMAKF training application</p>
          <h1 class="display-2">{view.institutionName}</h1>

          {isDraft && (
            <div class="st-draft" role="status">
              <strong>This application has not been sent yet.</strong>
              You reached step {resumeStep} of {TOTAL_STEPS}. Nothing has gone to
              MMAKF, and nothing will until you finish the form.
              <p class="st-draft-act">
                <a class="btn btn-primary" href={resumeHref}>Continue the application</a>
              </p>
            </div>
          )}

          <dl class="st-facts">
            <div>
              <dt>Reference</dt>
              <dd><code>{view.ref}</code></dd>
            </div>
            <div>
              <dt>Stage</dt>
              {/* Drawn by Status and by nothing else, so `quoted` reads the
                  same word here as it does on the federation's own screens.
                  The dictionary's explanation is written for an administrator,
                  so it is not attached here — the timeline below carries the
                  sentence written for the applicant. */}
              <dd><Status value={view.status} domain="application" withMeaning={false} /></dd>
            </div>
            {view.submittedAt && (
              <div>
                <dt>Sent</dt>
                <dd>{when(view.submittedAt)}</dd>
              </div>
            )}
            {view.lastUpdateAt && (
              <div>
                <dt>Last update from MMAKF</dt>
                <dd>{when(view.lastUpdateAt)}</dd>
              </div>
            )}
            {/* Rendered ONLY when the federation has actually undertaken a
                response time. It has published none, so this row is normally
                absent — rather than showing an invented date. */}
            {view.respondBy && (
              <div>
                <dt>MMAKF has undertaken to respond by</dt>
                <dd>{when(view.respondBy)}</dd>
              </div>
            )}
          </dl>

          <section class="st-timeline">
            <h2 class="st-h2">Progress</h2>
            <CaseTimeline
              entries={view.timeline}
              domain="application"
              label={`Progress of application ${view.ref}`}
              empty={isDraft
                ? 'Nothing has been recorded yet. Your answers are saved, and this page will show each step once the application is sent.'
                : 'Nothing has been recorded against this application yet.'}
            />
            {!view.respondBy && !isDraft && (
              /* Said outright rather than left as an absence. A school that
                 sees no date assumes one exists and that this page is simply
                 not showing it, and then waits against a deadline nobody set.
                 MMAKF has published no response time, and that is the fact. */
              <p class="st-note">
                MMAKF has not published a response time for institutional
                applications, so this page shows no target date. Each step
                appears above once it has actually happened.
              </p>
            )}
          </section>

          <section class="st-help">
            <h2 class="st-h2">Something to add?</h2>
            <p class="st-lede">
              Write to <a href="mailto:admin@mmakf.in">admin@mmakf.in</a> quoting
              {' '}<code>{view.ref}</code>. It reaches the administrator handling
              your application.
            </p>
          </section>
        </>
      )}
    </div>
  </div>
</Base>

<style>
  .st { padding: 96px 0 80px; }
  .st-inner { max-width: 44rem; }
  .st-lede { color: var(--muted); line-height: var(--leading-relaxed); max-width: 58ch; margin: 14px 0; }
  .st-h2 { font-family: var(--font-display); font-size: var(--text-lg); margin: 0 0 14px; }
  code {
    font-family: var(--font-accent, monospace);
    background: var(--bg-2); padding: 2px 7px; border-radius: var(--radius-xs); font-size: .95em;
  }

  .st-sent, .st-draft {
    padding: var(--space-5); margin-bottom: var(--space-6);
    border-left: 3px solid var(--gold); background: var(--card);
    line-height: var(--leading-normal);
  }
  .st-sent strong, .st-draft strong { display: block; margin-bottom: var(--space-1); }
  .st-draft { margin-top: var(--space-6); }
  .st-draft-act { margin: var(--space-4) 0 0; }

  .st-facts { margin: var(--space-6) 0 0; display: grid; gap: 0; }
  .st-facts > div {
    display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 4px var(--space-5); padding: 13px 0; border-bottom: 1px solid var(--border);
    align-items: center;
  }
  .st-facts dt { color: var(--muted); font-size: .9rem; }
  .st-facts dd { margin: 0; }

  .st-timeline { margin-top: var(--space-12); }

  .st-note {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    font-size: var(--text-sm);
  }

  .st-help { margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--border); }

  @media (max-width: 640px) {
    .st { padding: 78px 0 60px; }
    .st-facts > div { grid-template-columns: 1fr; gap: 2px; align-items: start; }
    .st-facts dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
  }
</style>
