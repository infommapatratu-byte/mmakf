---
/**
 * The JKA kyu/dan grading guideline, published as REFERENCE.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * THE MISREADING THIS PAGE IS BUILT TO PREVENT
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * A student reads "7 Kyu — Kata: Heian Shodan" on a federation website and
 * concludes that MMAKF examines Heian Shodan at 7th Kyu. Nobody said so. The
 * page simply put another organisation's syllabus on an MMAKF domain and let
 * the reader supply the missing sentence.
 *
 * That reader then trains for the wrong examination. It is the single most
 * consequential error this whole technical library can make, because a syllabus
 * is the one thing members actually plan their year around.
 *
 * So: whose document this is appears above the table, in the table's own
 * heading, and in every grade card. The word MMAKF appears on this page only in
 * sentences saying what MMAKF has NOT done.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * WHY PUBLISH IT AT ALL
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Because instructors and students already read it, usually via a blog that
 * retyped it badly and dropped the qualifications. A faithful transcription
 * with the source attached is better for a reader than the alternative they
 * will otherwise find — and it is the honest way to show what the federation is
 * working from while its own syllabus is unpublished.
 *
 * ═══════════════════════════════════════════════════════════════════════════
 * TRANSCRIPTION
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Verbatim, including the document's own inconsistencies. It writes "10th Kyu",
 * "8 Kyu", "6th Kyu" and "3 Kyu"; it romanises "CHUUDAN JUNZUKI" and
 * "KOUKUTSU SHUTOU UKE" where MMAKF's own terminology uses different spellings.
 * Normalising any of that would be editing somebody else's published syllabus
 * and calling the result a quotation.
 *
 * Renders from src/data/technical-reference.ts — no database, for the same
 * reason as /shotokan/competition.
 */
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { JKA_GRADING_GUIDELINE, RETRIEVED_ON } from '@/data/technical-reference';
import { canonicalFor, href as surfaceHref, type Surface } from '@/lib/surface';

export const prerender = false;

const surface: Surface = (Astro.locals as any)?.surface ?? 'public';
const h = (p: string) => surfaceHref(surface, p);
const url = canonicalFor(surface, '/shotokan/grading-reference');

const DOCUMENT_URL =
  'https://www.jka.or.jp/wp/wp-content/uploads/2022/03/f421fec70fb6a7004d4e58a7cf567bb9.pdf';

/** Grades in the document's own order, each with its three components. */
const grades: {
  label: string;
  ordinal: number | null;
  kihon: typeof JKA_GRADING_GUIDELINE;
  kata: typeof JKA_GRADING_GUIDELINE;
  kumite: typeof JKA_GRADING_GUIDELINE;
}[] = [];

for (const item of JKA_GRADING_GUIDELINE) {
  let grade = grades.find((g) => g.label === item.gradeLabel);
  if (!grade) {
    grade = { label: item.gradeLabel, ordinal: item.gradeOrdinal ?? null, kihon: [] as any, kata: [] as any, kumite: [] as any };
    grades.push(grade);
  }
  (grade[item.component] as any).push(item);
}

const kyu = grades.filter((g) => /kyu/i.test(g.label));
const dan = grades.filter((g) => /dan/i.test(g.label));

const description =
  `The Japan Karate Association's published kyu and dan grading guideline, transcribed verbatim from `
  + `10th Kyu to 3rd Dan — the kihon, kata and kumite named at each grade. This is the JKA's syllabus, `
  + `reproduced as reference. It is not MMAKF's syllabus and MMAKF has not adopted it.`;

/**
 * `Article` with `citation`, not `Course`. Course markup would assert that
 * MMAKF offers this curriculum, which is the exact claim the page spends its
 * whole length denying.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'JKA kyu and dan grading guideline — reference transcription',
  url,
  description,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Modern Martial Arts Karate-Do Federation of India', url: 'https://www.mmakf.in' },
  about: { '@type': 'Thing', name: 'Karate grading syllabus' },
  citation: {
    '@type': 'CreativeWork',
    name: 'Kyu / Dan Grading Guideline',
    url: DOCUMENT_URL,
    publisher: { '@type': 'Organization', name: 'Japan Karate Association', url: 'https://www.jka.or.jp/en/' },
  },
  isBasedOn: DOCUMENT_URL,
  publisher: { '@type': 'Organization', name: 'Modern Martial Arts Karate-Do Federation of India' },
};
---

<Base
  title="JKA grading guideline — a reference transcription — MMAKF"
  description={description}
  breadcrumbs={[
    { name: 'Shotokan', url: '/shotokan' },
    { name: 'Grading reference', url: '/shotokan/grading-reference' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageHero
    eyebrow="Reference 参考資料"
    title={`Another federation&rsquo;s <em class="r">syllabus</em>, quoted.`}
    lead="The Japan Karate Association publishes what it examines at each kyu and dan grade. It is transcribed here verbatim, because instructors already work from it and a faithful copy with its source attached beats the retyped versions circulating elsewhere."
    pills={[`${grades.length} grades`, `${JKA_GRADING_GUIDELINE.length} requirements`, 'JKA, not MMAKF']}
  />

  {/* ── Whose syllabus this is ───────────────────────────────────────────── */}
  <section>
    <div class="container">
      <aside class="whose" aria-labelledby="whose-h">
        <h2 id="whose-h" class="whose-h">This is the JKA&rsquo;s syllabus. It is not MMAKF&rsquo;s.</h2>
        <p class="body-txt">
          Everything below is quoted from a document published by the
          <strong> Japan Karate Association</strong>. MMAKF has
          <strong> not adopted it</strong>, has not published a syllabus of its own,
          and does not examine against this one. Reading &ldquo;7 Kyu &mdash; Kata:
          HEIAN SHODAN&rdquo; here tells you what the JKA examines. It tells you
          nothing about what MMAKF will ask you for.
        </p>
        <p class="body-txt">
          When the MMAKF Technical Committee publishes its own syllabus it will be
          a versioned federation instrument with an approver and an effective date,
          and it will say so on its face. Until that exists, this page is the
          honest thing to show: somebody else&rsquo;s standard, labelled as theirs.
        </p>
        <p class="src">
          Source:
          <a href={DOCUMENT_URL} rel="noopener nofollow" target="_blank">Kyu / Dan Grading Guideline</a>
          &nbsp;&mdash; Japan Karate Association, retrieved {RETRIEVED_ON}. Linked, not rehosted.
          Transcribed verbatim, including the document&rsquo;s own inconsistent grade
          labels and romanisations.
        </p>
      </aside>
    </div>
  </section>

  {/* ── Kyu grades ───────────────────────────────────────────────────────── */}
  <section>
    <div class="container">
      <div class="eyebrow">Kyu grades &mdash; JKA</div>
      <h2 class="display-2" style="margin-top:16px">From <em class="r">10th Kyu</em> upward.</h2>
      <div class="rule"></div>
      <div class="grades">
        {kyu.map((g) => (
          <article class="grade">
            <h3>{g.label} <span class="whose-tag">JKA</span></h3>
            {g.kihon.length > 0 && (
              <div class="component">
                <h4>Kihon</h4>
                <ol>
                  {g.kihon.map((i) => (
                    <li>
                      <span class="req">{i.requirement}</span>
                      {i.detail && <span class="detail">{i.detail}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {g.kata.length > 0 && (
              <div class="component">
                <h4>Kata</h4>
                <ul>{g.kata.map((i) => <li><span class="req">{i.requirement}</span></li>)}</ul>
              </div>
            )}
            {g.kumite.length > 0 && (
              <div class="component">
                <h4>Kumite</h4>
                <ul>
                  {g.kumite.map((i) => (
                    <li>
                      <span class="req">{i.requirement}</span>
                      {i.detail && <span class="detail">{i.detail}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── Dan grades ───────────────────────────────────────────────────────── */}
  <section>
    <div class="container">
      <div class="eyebrow">Dan grades &mdash; JKA</div>
      <h2 class="display-2" style="margin-top:16px">Black belt, <em class="r">first</em> to third.</h2>
      <div class="rule"></div>
      <p class="body-txt">
        The published document continues to 5th Dan. Only the grades transcribed
        with confidence appear here &mdash; the later kihon lists were not fully
        legible when the document was extracted, and a half-transcribed
        requirement is worse than an absent one.
      </p>
      <div class="grades">
        {dan.map((g) => (
          <article class="grade">
            <h3>{g.label} <span class="whose-tag">JKA</span></h3>
            {g.kihon.length > 0 && (
              <div class="component">
                <h4>Kihon</h4>
                <ol>
                  {g.kihon.map((i) => (
                    <li>
                      <span class="req">{i.requirement}</span>
                      {i.detail && <span class="detail">{i.detail}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )}
            {g.kata.length > 0 && (
              <div class="component">
                <h4>Kata</h4>
                <ul>{g.kata.map((i) => <li><span class="req">{i.requirement}</span></li>)}</ul>
              </div>
            )}
            {g.kumite.length > 0 && (
              <div class="component">
                <h4>Kumite</h4>
                <ul>
                  {g.kumite.map((i) => (
                    <li>
                      <span class="req">{i.requirement}</span>
                      {i.detail && <span class="detail">{i.detail}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── Where MMAKF's own answer lives ───────────────────────────────────── */}
  <section>
    <div class="container">
      <div class="eyebrow">MMAKF</div>
      <h2 class="display-2" style="margin-top:16px">What the federation has <em class="r">actually</em> published.</h2>
      <div class="rule"></div>
      <p class="body-txt">
        How grading works at MMAKF &mdash; who may examine, how a result is recorded
        and how a certificate is verified &mdash; is federation policy and lives on
        its own page. The technical content of each grade is not yet published,
        and no page on this site pretends otherwise.
      </p>
      <div class="cta-row">
        <a class="btn btn-ghost" href={h('/belt-system')}>How grading works</a>
        <a class="btn btn-ghost" href={h('/shotokan/kihon')}>Kihon library</a>
        <a class="btn btn-ghost" href={h('/kata')}>Kata library</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .whose {
    border-left: 4px solid var(--c-warn, #b45309);
    background: var(--c-surface-2, rgba(180, 83, 9, .06));
    padding: 20px 24px;
    border-radius: 0 10px 10px 0;
    margin-block: 8px 24px;
  }
  .whose-h { font-size: 1.25rem; margin: 0 0 12px; }
  .whose p { max-width: 72ch; }
  .src { font-size: .9rem; opacity: .85; margin-top: 12px; }

  .grades {
    display: grid; gap: 20px; margin-top: 24px;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
  }
  .grade {
    border: 1px solid var(--c-border, #d4d4d8);
    border-radius: 10px; padding: 18px 20px;
  }
  .grade h3 {
    margin: 0 0 14px; font-size: 1.1rem;
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  /* The attribution repeats on every card. A reader who lands mid-page from a
     search result sees one grade and must still know whose it is. */
  .whose-tag {
    font-size: .65rem; letter-spacing: .08em; text-transform: uppercase;
    font-weight: 700; padding: 2px 7px; border-radius: 4px;
    background: var(--c-warn, #b45309); color: #fff;
  }
  .component { margin-top: 12px; }
  .component h4 {
    margin: 0 0 6px; font-size: .72rem; letter-spacing: .1em;
    text-transform: uppercase; opacity: .7;
  }
  .component ol, .component ul { margin: 0; padding-left: 1.25rem; display: grid; gap: 6px; }
  .req { display: block; font-size: .92rem; }
  .detail { display: block; font-size: .82rem; opacity: .72; margin-top: 2px; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
</style>
