---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { get } from '@/lib/storage';

export const prerender = false;

const fed = await get('federation');

/**
 * THE RULES & REGULATIONS REGISTER
 *
 * Two classes of document, deliberately never mixed:
 *
 *   external — rules published by OTHER bodies that MMAKF competes under. Every
 *              URL in this list was fetched and inspected before publication.
 *   own      — MMAKF's own instruments. NOTHING here is drafted, paraphrased or
 *              summarised. Each carries an honest state. A stated gap is
 *              credible; an invented constitution is fraud.
 *
 * ── HOW THESE LINKS WERE VERIFIED (and why a status code is not enough) ──
 *
 * wkf.net SOFT-404s. A request for a superseded rulebook —
 *   /files/pdf/documents/WKF_Competition_Rules_2024_EN.pdf
 * returns HTTP 200 with Content-Type: image/png and a 1,623-byte PNG body.
 * A status-code check calls that dead rulebook healthy and ships a link that
 * downloads a broken image to anyone who trusts this federation's register.
 *
 * So each entry records what the server ACTUALLY returned: content type and
 * body size, both shown on the page. Every PDF below was additionally
 * confirmed to begin with the %PDF- magic bytes. Re-verify with:
 *
 *   curl -sIL -o /dev/null -w '%{content_type} %{size_download}\n' "<url>"
 *
 * and reject anything that is not application/pdf at a plausible size.
 *
 * This register is admin-editable: it is served from the `regulations` storage
 * key when the office has saved one, and falls back to the literal below.
 */

type Entry = {
  title: string;
  body: string;        // issuing organisation
  edition: string;     // version or edition, as the PUBLISHER labels it
  effective: string;   // effective date — never guessed
  url: string;
  evidence: string;    // what the fetch actually returned
  note?: string;
  checked?: string;    // per-entry check date; falls back to the register date
};

type Area = { area: string; blurb: string; items: Entry[] };

// Date this register's links were last fetched and inspected.
const CHECKED = '12 August 2026';

const WKF = 'World Karate Federation (WKF)';
const NADA = 'National Anti-Doping Agency (NADA India)';
const WADA = 'World Anti-Doping Agency (WADA)';
const W = 'https://www.wkf.net/files/pdf/documents';

const EXTERNAL_FALLBACK: Area[] = [
  {
    area: 'Competition — kumite and kata',
    blurb:
      'The rules under which bouts and kata performances are scored. MMAKF does not author these; the federation applies them at its own events to the extent stated in its competition notices.',
    items: [
      {
        title: 'KUMITE Competition Rules',
        body: WKF,
        edition: '2026 · Master Copy V11',
        effective: '2026 edition',
        url: `${W}/WKF%202026%20Kumite%20Competition%20Rules%20MASTER%20COPY_V11.pdf`,
        evidence: 'application/pdf · 4.49 MB',
      },
      {
        title: 'KATA Competition Rules',
        body: WKF,
        edition: '2026 · Master Copy V2',
        effective: '2026 edition',
        url: `${W}/WKF%20Kata%20Competition%20Rules%202026%20MASTER%20COPY_V2.pdf`,
        evidence: 'application/pdf · 820 KB',
      },
      {
        title: 'Kata Sheet — kata name and order list',
        body: WKF,
        edition: '2026 · Karate 1',
        effective: '2026 edition',
        url: `${W}/KATA%20NAME%20ORDER%202026%20Karate%201.pdf`,
        evidence: 'application/pdf · 205 KB',
        note: 'This is the WKF’s approved kata name and order sheet, published on the WKF documents index under the heading "Kata Sheet".',
      },
      {
        title: 'Competition Rules Bulletin',
        body: WKF,
        edition: '2026 · V2',
        effective: '2026 edition',
        url: `${W}/WKF%20Competition%20Rules%20Bulletin%202026_V2.pdf`,
        evidence: 'application/pdf · 163 KB',
        note: 'Amendments and clarifications issued against the competition rules. Read alongside the kumite and kata rulebooks, not instead of them.',
      },
      {
        title: 'Organizing Rules',
        body: WKF,
        edition: '2024 (file dated 07.11.2024)',
        effective: '2024 edition',
        url: `${W}/WKF%20Organising%20Rules%202024_07112024.1.pdf`,
        evidence: 'application/pdf · 1.09 MB',
      },
      {
        title: 'WKF World Ranking Rules',
        body: WKF,
        edition: '2026',
        effective: '2026 edition',
        url: `${W}/wkf_worldranking_rules_2026.pdf`,
        evidence: 'application/pdf · 556 KB',
      },
    ],
  },
  {
    area: 'Refereeing and judging',
    blurb:
      'Who may officiate, how officials are licensed and ranked, and the conditions attached to a WKF refereeing appointment.',
    items: [
      {
        title: 'WKF Referee Rules',
        body: WKF,
        edition: '2025',
        effective: '2025 edition',
        url: `${W}/WKF_Referee_Rules_2025.pdf`,
        evidence: 'application/pdf · 355 KB',
      },
      {
        title: 'WKF Referees — Conditions and Requirements',
        body: WKF,
        edition: '2026',
        effective: '2026 edition',
        url: `${W}/2026_Referee_conditions_and_requirements.pdf`,
        evidence: 'application/pdf · 446 KB',
      },
      {
        title: 'WKF Referees — Conditions and Requirements',
        body: WKF,
        edition: '2027',
        effective: '2027 edition',
        url: `${W}/2027_Referee_conditions_and_requirements.pdf`,
        evidence: 'application/pdf · 1.17 MB',
        note: 'Published in advance of the 2027 cycle. Officials preparing for appointment should read the edition matching the year of the appointment.',
      },
    ],
  },
  {
    area: 'Governance and integrity',
    blurb:
      'The constitutional and conduct instruments of the world governing body. They bind the WKF and its members; they are reproduced here for reference only.',
    items: [
      {
        title: 'WKF Statutes',
        body: WKF,
        edition: 'Not stated on the WKF documents index',
        effective: 'Not published on the index page — see the document',
        url: `${W}/WKF_Statutes.pdf`,
        evidence: 'application/pdf · 372 KB',
      },
      {
        title: 'Disciplinary and Ethics Code',
        body: WKF,
        edition: 'English edition — undated in the WKF filename',
        effective: 'Parallel French and Spanish editions on the same index are dated 15 March 2016',
        url: `${W}/wkf-disciplinary-and-ethics-code-eng.pdf`,
        evidence: 'application/pdf · 356 KB',
        note: 'The English file carries no date in its name. We record what is observable rather than assert an effective date we cannot source.',
      },
      {
        title: 'WKF Safe Sport Policy',
        body: WKF,
        edition: 'Not stated on the WKF documents index',
        effective: 'Not published on the index page — see the document',
        url: `${W}/WKF_Safe_Sport_Policy.pdf`,
        evidence: 'application/pdf · 392 KB',
        note: 'The world body’s safeguarding instrument. MMAKF’s own safeguarding policy is a separate document and is listed below as not yet published.',
      },
    ],
  },
  {
    area: 'Medical, concussion and anti-doping',
    blurb:
      'Medical eligibility, head-injury management and the anti-doping rules of the world governing body. Anti-doping obligations inside India are additionally governed by NADA — see the section below.',
    items: [
      {
        title: 'WKF Anti-Doping Rules',
        body: WKF,
        edition: '2021, updated December 2025',
        effective: '2021 rules as updated December 2025',
        url: `${W}/WKF%20Anti%20Doping%20Rules%202021_Updated%20Dec25.pdf`,
        evidence: 'application/pdf · 1.07 MB',
      },
      {
        title: 'Medical Commission Rules',
        body: WKF,
        edition: '2026',
        effective: '2026 edition',
        url: `${W}/WKFMedical_Commission_Rules_2026.pdf`,
        evidence: 'application/pdf · 2.23 MB',
      },
      {
        title: 'Concussion Protocol',
        body: WKF,
        edition: 'Not stated on the WKF documents index',
        effective: 'Not published on the index page — see the document',
        url: `${W}/WKF%20Medical%20Commission_Concussion%20Protocol.pdf`,
        evidence: 'application/pdf · 2.37 MB',
      },
    ],
  },
  {
    area: 'Dan grades',
    blurb:
      'The world body’s regulation on Dan grade recognition. It governs WKF recognition only. It is not MMAKF’s grading syllabus, and it does not state MMAKF’s Dan requirements.',
    items: [
      {
        title: 'WKF Dan Grade Regulation',
        body: WKF,
        edition: 'Not stated on the WKF documents index',
        effective: 'Not published on the index page — see the document',
        url: `${W}/WKF_DAN_GRADE_REGULATION.pdf`,
        evidence: 'application/pdf · 208 KB',
      },
    ],
  },
  {
    area: 'Anti-doping in India — NADA',
    blurb:
      'Every athlete competing in India is bound by the National Anti-Doping Rules and the Prohibited List, independently of any karate rulebook. These are statutory instruments of the Government of India.',
    items: [
      {
        title: 'NADA India — official agency website',
        body: `${NADA}, Ministry of Youth Affairs & Sports`,
        edition: 'Live site',
        effective: 'Current',
        url: 'https://nadaindia.yas.gov.in/',
        evidence: 'text/html · 298 KB',
        note: 'The agency now publishes on the government yas.gov.in domain. See the warning below about the older address.',
      },
      {
        title: 'National Anti-Doping Rules 2021 (as amended)',
        body: NADA,
        edition: '2021, as amended',
        effective: '2021 rules as amended',
        url: 'https://nadaindia.yas.gov.in/wp-content/uploads/Amendment-to-NADA-Rules-2021.pdf',
        evidence: 'application/pdf · 1020 KB',
        note: 'Listed on NADA’s resources index as "NADA India Anti-Doping Rules 2021"; the file itself is named as an amendment to those rules. Both facts are recorded here rather than resolved by guesswork.',
      },
      {
        title: 'Prohibited List 2026',
        body: `${WADA}, republished by ${NADA}`,
        edition: '2026',
        effective: 'In force from 1 January 2026 (as stated on NADA’s resources index)',
        url: 'https://nadaindia.yas.gov.in/wp-content/uploads/2026list_en_final_clean_september_2025.pdf',
        evidence: 'application/pdf · 373 KB',
      },
      {
        title: 'Therapeutic Use Exemption (TUE) application form',
        body: NADA,
        edition: 'Current form on the NADA resources index',
        effective: 'Current',
        url: 'https://nadaindia.yas.gov.in/wp-content/uploads/TUE-Application-Form-1.pdf',
        evidence: 'application/pdf · 681 KB',
      },
      {
        title: 'NADA India — resources index',
        body: NADA,
        edition: 'Live index page',
        effective: 'Current',
        url: 'https://nadaindia.yas.gov.in/updated-resources/',
        evidence: 'text/html · 405 KB',
        note: 'The authoritative index. If any direct link above has been rotated by the agency, the current file will be found here.',
      },
      {
        title: 'World Anti-Doping Code',
        body: WADA,
        edition: '2021 Code (PDF)',
        effective: '1 January 2021',
        // The /en/resources/ path returns HTTP 202 with a ZERO-byte body — a
        // soft failure that a status-code check reports as healthy. Verified by
        // content type and size, not by status alone.
        url: 'https://www.wada-ama.org/sites/default/files/resources/files/2021_wada_code.pdf',
        evidence: 'application/pdf · 3.4 MB',
      },
    ],
  },
];

/**
 * MMAKF's OWN instruments.
 *
 * Every one of these is a document the federation itself must author, adopt and
 * publish. None has been drafted here — no summary, no paraphrase, no
 * placeholder text that could be mistaken for policy.
 *
 * Deliberately absent: the reference code and the publication state. Both are
 * read at render time from the federation's OWN document register (the
 * `documents` key that /governance renders), because a second hand-maintained
 * copy of that register would drift from it — and the drift is not cosmetic.
 * The day the office uploads the constitution, a hardcoded "Not yet published"
 * here becomes a false statement about the federation's own compliance. It also
 * means no reference code is ever invented on this page for a document the
 * federation has not actually registered.
 */
type Own = { title: string; covers: string };

const OWN_FALLBACK: Own[] = [
  { title: 'Constitution & Bye-Laws',
    covers: 'Legal form of the federation, membership classes, general body and executive, elections, powers of office bearers, amendment procedure.' },
  { title: 'Code of Conduct — Members & Officials',
    covers: 'Standards of behaviour expected of athletes, instructors, officials and office bearers, and the consequences of breach.' },
  { title: 'Athlete Safeguarding & Child Protection Policy',
    covers: 'Protection of minors and adults at risk, instructor screening, supervision and travel rules, reporting routes, and the designated safeguarding contact.' },
  { title: 'Anti-Doping Policy (NADA / WADA aligned)',
    covers: 'How MMAKF gives effect to the National Anti-Doping Rules within the federation — education, testing cooperation, and results-management responsibilities.' },
  { title: 'Grading Syllabus & Examination Regulations',
    covers: 'The kyu and Dan syllabus, examiner appointment, eligibility and time-in-grade requirements, examination conduct, and appeal against a grading result.' },
  { title: 'National Competition Regulations',
    covers: 'How the WKF competition rules are applied at MMAKF events — age and weight divisions, entry and eligibility, protest procedure, and sanctioning of events.' },
  { title: 'National Selection Policy',
    covers: 'Criteria and procedure for selecting athletes to represent a district, a state unit or the federation, and the route to challenge a selection decision.' },
  { title: 'Referee & Judge Certification Regulation',
    covers: 'Certification levels for judges and referees, examination and re-certification cycle, appointment to events, and the officials register.' },
  { title: 'Disciplinary & Appeals Procedure',
    covers: 'Complaint intake, investigation, hearing rights, sanctions available, and the independent appeal route.' },
  { title: 'Affiliation Regulations — dojo, district and state charters',
    covers: 'Requirements and procedure for chartering a dojo, a district association and a state association, and the grounds for suspension or withdrawal of a charter.' },
];

// Admin override: the office can maintain the whole register from the CMS
// without a deploy. Falls back to the literals above when the key is unset.
const stored = await get<any>('regulations');
const checked: string =
  typeof stored?.checked === 'string' && stored.checked.trim() ? stored.checked.trim() : CHECKED;

const txt = (v: unknown): string => (typeof v === 'string' && v.trim() ? v.trim() : '');

// Only ever emit an http(s) href. The register is admin-editable, so an
// unchecked value here would put whatever was saved — `javascript:` included —
// into a live link on a public page.
const httpUrl = (v: unknown): string => {
  const s = txt(v);
  const scheme = s.slice(0, 8).toLowerCase();
  return scheme.startsWith('https://') || scheme.startsWith('http://') ? s : '';
};

/**
 * Defensive rendering (MASTER-SPEC F1). storage.ts guards only the TOP-LEVEL
 * shape of a stored value, so a saved register whose areas were missing their
 * `items` array would throw inside the count below and 500 this public page.
 * Anything malformed is dropped; if nothing survives, the seed literal is served.
 */
function cleanAreas(raw: unknown): Area[] | null {
  if (!Array.isArray(raw)) return null;
  const areas: Area[] = raw
    .filter((a: any) => a && txt(a.area) && Array.isArray(a.items))
    .map((a: any) => ({
      area: txt(a.area),
      blurb: txt(a.blurb),
      items: a.items
        .filter((i: any) => i && txt(i.title) && httpUrl(i.url))
        .map((i: any) => ({
          title: txt(i.title),
          body: txt(i.body),
          edition: txt(i.edition),
          effective: txt(i.effective),
          url: httpUrl(i.url),
          evidence: txt(i.evidence),
          note: txt(i.note) || undefined,
          checked: txt(i.checked) || undefined,
        })),
    }))
    .filter((a: Area) => a.items.length > 0);
  return areas.length ? areas : null;
}

const external: Area[] = cleanAreas(stored?.external) ?? EXTERNAL_FALLBACK;

const externalCount = external.reduce((n, a) => n + a.items.length, 0);
// "Verified" is a claim about work actually done, so it is counted rather than
// asserted: only entries carrying the evidence of a fetch count as verified.
const verifiedCount = external.reduce(
  (n, a) => n + a.items.filter((i) => i.evidence).length,
  0,
);

const ownStored: Own[] = Array.isArray(stored?.own)
  ? stored.own
      .filter((d: any) => d && txt(d.title))
      .map((d: any) => ({ title: txt(d.title), covers: txt(d.covers) }))
  : [];
const own: Own[] = ownStored.length ? ownStored : OWN_FALLBACK;

/**
 * Reference code and publication state come from the federation's own document
 * register — the same `documents` key /governance renders — so this page can
 * never contradict it and can never invent a reference code.
 */
const registerRaw = await get<any[]>('documents');
const register: any[] = Array.isArray(registerRaw) ? registerRaw : [];
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '');
const ownRows = own.map((d) => {
  const entry = register.find((r: any) => r && txt(r.title) && norm(txt(r.title)) === norm(d.title));
  const url = httpUrl(entry?.url);
  return { title: d.title, covers: d.covers, ref: txt(entry?.ref), url, published: !!url };
});
const anyUnpublished = ownRows.some((d) => !d.published);

// No fabricated contact: if the office has cleared the address, the mailto
// buttons are replaced with the contact page rather than rendering a dead
// `mailto:` that opens an empty compose window.
const email = txt(fed?.contact?.email);
---

<Base
  title="Rules & Regulations — MMAKF"
  description="The rules MMAKF competes under and the register of the federation's own governing documents. Each external link records its issuing body, its edition and the date the federation last checked it."
>
  <PageHero
    eyebrow="Rules & Regulations"
    title={`The <em class="r">rulebook</em> register.`}
    lead="Two separate things live on this page: the rules published by other organisations that MMAKF competes under, and the register of MMAKF's own governing documents. They are never mixed, and nothing on this page is a summary of a rule — the rule is whatever the linked document says."
    pills={[
      `${externalCount} external documents`,
      verifiedCount === externalCount
        ? `Every link checked ${checked}`
        : `${verifiedCount} of ${externalCount} links checked ${checked}`,
    ]}
  />

  {/* ═══════ HOW TO READ THIS REGISTER ═══════ */}
  <section>
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Read this first</div>
        <h2 class="display-2">Whose rules are <em class="r">whose</em>.</h2>
        <div class="rule"></div>
      </div>

      <div class="reg-split fade">
        <div class="card reg-key reg-key-ext">
          <div class="card-eyebrow">Class A — other organisations</div>
          <h3 class="card-title">Rules MMAKF competes under</h3>
          <p class="card-body">
            Published and owned by the World Karate Federation, the National Anti-Doping Agency of
            India and the World Anti-Doping Agency. <strong>MMAKF did not write these documents and
            cannot amend them.</strong> They are listed here so members, instructors and officials can
            reach the current text from a source the federation has actually checked. Copyright and
            authority rest with the issuing body.
          </p>
        </div>

        <div class="card reg-key reg-key-own">
          <div class="card-eyebrow">Class B — MMAKF's own</div>
          <h3 class="card-title">Documents the federation must publish</h3>
          <p class="card-body">
            The federation's constitution, conduct, safeguarding, grading, selection and disciplinary
            instruments. These are MMAKF's to author and adopt.
            <strong>Where a document has not been published, this page says so.</strong>
            No draft, summary or specimen text appears here — a member must never mistake a website
            paragraph for an adopted federation rule.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════ MMAKF'S OWN DOCUMENTS ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Class B · MMAKF's own instruments</div>
        <h2 class="display-2">Federation <em class="r">documents</em>.</h2>
        <div class="rule"></div>
        <p class="lead">
          The register below lists every governing document a national karate federation is expected
          to hold, and the current publication state of each. The "covers" column describes the
          subject matter a document of that name addresses — it is not, and must not be read as,
          MMAKF policy.
        </p>
      </div>

      {/* The table is wider than a phone, so it scrolls inside its own box. A
          scrollable box must also be reachable by keyboard: role + tabindex make
          it a focus stop, and the label says what a screen reader has landed in. */}
      <div
        class="tbl-scroll fade"
        tabindex="0"
        role="region"
        aria-label="Register of MMAKF's own governing documents"
      >
        <table class="reg-tbl">
          <caption class="sr-only">
            MMAKF's own governing documents, with the subject each covers and its publication state.
          </caption>
          <thead>
            <tr>
              <th scope="col">Document</th>
              <th scope="col">Reference</th>
              <th scope="col">Subject matter</th>
              <th scope="col">State</th>
            </tr>
          </thead>
          <tbody>
            {ownRows.map((d) => (
              <tr>
                <th scope="row" class="reg-title">{d.title}</th>
                <td class="text-muted nowrap">{d.ref || 'Not assigned'}</td>
                <td class="reg-covers">{d.covers || '—'}</td>
                <td>
                  {d.published ? (
                    <a href={d.url} class="text-gold" target="_blank" rel="noopener noreferrer">
                      Published — open
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    <span class="pill reg-state">Not yet published</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="tbl-hint">Scroll the table sideways to see every column</div>

      <div class="reg-note fade mt-8">
        {anyUnpublished && (
          <Fragment>
            <h3 class="reg-note-h">What "Not yet published" means</h3>
            <p class="body-txt">
              Where a row above reads <strong>Not yet published</strong>, MMAKF has not published
              that document's text on this website. Rather than print a plausible-looking draft, the
              federation records the gap. Where a document exists in the federation office in signed
              form, a certified copy is issued on request — the office is the authority on what has
              been adopted, not this page. The reference code and publication state in the table are
              read from the federation's document register, the same register shown on the
              governance page.
            </p>
          </Fragment>
        )}
        <p class="body-txt" class:list={[{ 'mt-4': anyUnpublished }]}>
          Fee amounts, eligibility criteria, time-in-grade requirements, selection standards and
          syllabus content are <strong>not yet published by the federation</strong> and are therefore
          not stated anywhere on this page.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          {email ? (
            <a
              href={`mailto:${email}?subject=${encodeURIComponent('Request for a federation document')}`}
              class="btn btn-gold"
            >
              Request a document from the office
            </a>
          ) : (
            <a href="/contact" class="btn btn-gold">Contact the federation office</a>
          )}
          <a href="/governance#documents" class="btn btn-ghost">Documents &amp; forms register</a>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════ EXTERNAL RULES ═══════ */}
  <section>
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Class A · Published by other organisations</div>
        <h2 class="display-2">Rules we <em class="r">compete</em> under.</h2>
        <div class="rule"></div>
        <p class="lead">
          Each entry records the issuing body, the edition or version exactly as that body labels it,
          the effective date where the publisher states one, and what the link actually returned when
          it was last fetched. Every link below opens the publisher's own site.
        </p>
      </div>

      {external.map((group) => (
        <div class="reg-group fade">
          <h3 class="reg-group-h">{group.area}</h3>
          <p class="reg-group-blurb">{group.blurb}</p>

          <ul class="reg-list">
            {group.items.map((d) => (
              <li class="reg-item">
                <div class="reg-item-main">
                  <a href={d.url} class="reg-item-title" target="_blank" rel="noopener noreferrer">
                    {d.title}
                    <span class="reg-ext" aria-hidden="true">↗</span>
                    <span class="sr-only"> (opens on the publisher's site in a new tab)</span>
                  </a>
                  <div class="reg-issuer">{d.body || 'Issuing body not recorded'}</div>
                  {d.note && <p class="reg-item-note">{d.note}</p>}
                </div>

                <dl class="reg-meta">
                  <div class="reg-meta-row">
                    <dt>Edition / version</dt>
                    <dd>{d.edition || 'Not stated by the publisher'}</dd>
                  </div>
                  <div class="reg-meta-row">
                    <dt>Effective</dt>
                    <dd>{d.effective || 'Not stated by the publisher'}</dd>
                  </div>
                  <div class="reg-meta-row">
                    <dt>{d.evidence ? 'Link verified' : 'Link'}</dt>
                    <dd>
                      {d.evidence ? (
                        <Fragment>
                          {d.checked || checked} ·{' '}
                          <span class="reg-evidence">{d.evidence}</span>
                        </Fragment>
                      ) : (
                        'Not yet checked by the federation — confirm the edition on the document itself'
                      )}
                    </dd>
                  </div>
                </dl>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* ═══════ WHAT IS NOT LINKED, AND WHY ═══════ */}
  <section class="bg2">
    <div class="container">
      <div class="section-head fade">
        <div class="eyebrow">Honest gaps</div>
        <h2 class="display-2">What this page does <em class="r">not</em> link.</h2>
        <div class="rule"></div>
      </div>

      <div class="reg-warn fade" role="note">
        <h3 class="reg-warn-h">The old NADA India address is no longer the agency</h3>
        <p class="body-txt">
          <span class="reg-dead">nadaindia.org</span> is still printed on a great many Indian sports
          websites and circulars. On {checked} that address returned a 114-byte page whose entire
          content is a JavaScript redirect to a parked domain lander — not an anti-doping resource.
          MMAKF deliberately does not link it. The agency publishes at
          <a href="https://nadaindia.yas.gov.in/" target="_blank" rel="noopener noreferrer">nadaindia.yas.gov.in</a>,
          on the Government of India domain, and that is the address linked above.
        </p>
      </div>

      <div class="reg-warn fade" role="note">
        <h3 class="reg-warn-h">A live link is not the same as a live document</h3>
        <p class="body-txt">
          The WKF's document server answers requests for withdrawn rulebooks with
          <strong> HTTP 200 and a 1.6 KB image file</strong> rather than a 404. A superseded rulebook
          therefore looks perfectly healthy to any ordinary link checker, and a federation that ran
          one would publish a rulebook link that quietly downloads a broken image. Each link the
          federation has checked was checked on the content type and body size actually returned,
          not on the status code — that is what the "Link verified" line records. A row without that
          line has not been checked, and says so.
        </p>
      </div>

      <div class="reg-warn fade" role="note">
        <h3 class="reg-warn-h">Documents we could not verify are absent, not guessed</h3>
        <p class="body-txt">
          Where MMAKF could not confirm a current official URL for a document, no link is published
          and no substitute is offered. In particular, this page states no affiliation to, and links
          no rulebook of, any Indian national karate body other than as the federation has published
          elsewhere on this site. An unverified link on a rulebook page is worse than an empty row.
        </p>
      </div>
    </div>
  </section>

  {/* ═══════ MAINTENANCE ═══════ */}
  <section>
    <div class="container">
      <div class="reg-maint fade">
        <div class="eyebrow">Maintenance of this register</div>
        <h2 class="reg-maint-h">Checked {checked}</h2>
        <div class="rule"></div>
        <p class="body-txt">
          Governing bodies republish their rules — usually on an annual cycle, and often at the same
          filename with a new version suffix, or at a new filename that silently orphans the old one.
          A rules page is therefore only as good as the date on it. This register records when each
          link was last fetched so a reader can judge for themselves how much to trust it.
        </p>
        <p class="body-txt mt-4">
          If a link on this page is broken, has been superseded, or points at a document that is no
          longer current, please tell the federation office and it will be corrected.
          <strong> Always check the edition on the document itself</strong> before relying on it for a
          competition, a grading or an appeal: where this page and the issuing body disagree, the
          issuing body is right.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          {email ? (
            <a
              href={`mailto:${email}?subject=${encodeURIComponent('Broken or outdated link on the Rules & Regulations page')}`}
              class="btn btn-primary"
            >
              Report a broken link
            </a>
          ) : (
            <a href="/contact" class="btn btn-primary">Contact the federation office</a>
          )}
          <a href="/governance" class="btn btn-ghost">Governance &amp; officials</a>
        </div>
      </div>
    </div>
  </section>
</Base>

