---
export interface Field {
  n: string;       // field name
  l: string;       // label
  /**
   * 'bool' renders a three-state select and stores a real boolean, because the
   * pages that read these flags test `=== true` / `=== false` and a string
   * satisfies neither. 'json' renders a validated textarea for the fields whose
   * value is a list or an object — a leader's titles, honours and authority —
   * which had no control here at all and so could not be edited by anyone
   * without a commit. Both are parsed in src/pages/admin/index.astro:readField.
   */
  type?: 'number' | 'text' | 'bool' | 'json';
  full?: boolean;
  textarea?: boolean;
}

interface Props {
  id: string;
  title: string;
  subtitle: string;
  apiKey: string;
  rows: any[];
  fields: Field[];
}

const { id, title, subtitle, apiKey, rows, fields } = Astro.props;
---

<section
  id={id}
  class="admin-panel"
  data-key={apiKey}
  data-fields={JSON.stringify(fields)}
>
  <h2 class="admin-h">{title}</h2>
  <p class="admin-sub">{subtitle}</p>

  <form class="lp-form">
    <div style="font-family:var(--font-display);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Add new</div>
    <div class="lp-form-grid">
      {fields.map((f) => (
        <div class={f.full ? 'full' : ''}>
          {/* WCAG 1.3.1 / 4.1.2: the label used to carry no `for`, so none of
              these controls had an accessible name and clicking the label did
              not focus the field. The id is scoped by the panel id because one
              admin page renders ~20 of these panels and several share a field
              name (`name`, `type`, `title`), which would otherwise collide. */}
          <label class="input-label" for={`${id}-${f.n}`}>{f.l}</label>
          {f.type === 'bool' ? (
            <select class="input" id={`${id}-${f.n}`} name={f.n}>
              <option value="">Not stated</option>
              <option value="true">Yes</option>
              <option value="false">No</option>
            </select>
          ) : f.type === 'json' ? (
            <textarea class="input lp-json" id={`${id}-${f.n}`} name={f.n} rows="8" spellcheck="false"></textarea>
          ) : f.textarea ? (
            <textarea class="input" id={`${id}-${f.n}`} name={f.n} rows="3"></textarea>
          ) : (
            <input class="input" id={`${id}-${f.n}`} name={f.n} type={f.type || 'text'} />
          )}
        </div>
      ))}
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top:16px">Add</button>
  </form>

  <div class="lp-list"></div>
</section>
