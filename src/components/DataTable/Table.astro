    .dtx-table { display: block; }
    .dtx-table > caption { display: block; }
    .dtx-table > thead {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .dtx-table > tbody { display: block; }
    .dtx-table > tbody > tr {
      display: block;
      position: relative;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--card);
      padding: var(--space-4);
      /* Room for the absolutely positioned More button, which is 44px wide. */
      padding-right: var(--space-16);
      margin-bottom: var(--space-3);
    }
    .dtx-table > tbody > tr > td {
      display: block;
      width: auto;
      border-bottom: 0;
      padding: var(--space-2) 0;
      text-align: left;
    }
    .dtx-table > tbody > tr > td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: var(--space-1);
    }
    .dtx-table > tbody > tr > td.dtx-sel::before,
    .dtx-table > tbody > tr > td.dtx-more::before { content: none; }

    /* The record's title, and the one cell that reads as a heading. */
    .dtx-table > tbody > tr > td[data-keep]:not(.dtx-sel):not(.dtx-more) {
      font-size: var(--text-md);
      color: var(--white);
    }

    /* Collapsed: only what the row is called, and its status. Set by the
       script; without JavaScript every field stays on screen, which is the
       right failure — too much information rather than none. */
    .dtx-table > tbody > tr[data-collapsed] > td:not([data-keep]) { display: none; }

    .dtx-more {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      padding: 0;
      width: auto;
    }
    .dtx-sel { padding: 0 0 var(--space-2); }
    .dtx-sel .dtx-check { margin: 0; }

    .dtx-tools-row { gap: var(--space-4); }
    .dtx-field, .dtx-field-per, .dtx-field-go { flex: 1 1 100%; }
    .dtx-pager { justify-content: flex-start; }
  }
</style>

<script>
  // Everything below is an ACCELERATOR. The table already filters, sorts, pages
  // and posts a selection without any of it — see the header comment. What this
  // adds is the running count, the select-all, the record collapse on a phone,
  // and the saved views, and every control it operates is rendered `hidden` so
  // that a control which cannot work is never on screen.

  type El = HTMLElement;

  const BREAKPOINT = '(max-width: 760px)';
  const viewsKey = (id: string) => `mmakf.datatable.views.${id}`;

  function setup(root: El) {
    const id = root.getAttribute('data-dtx') || '';
    const totalAttr = root.getAttribute('data-total');
    const total = totalAttr === null ? null : Number(totalAttr);
    const one = root.getAttribute('data-noun-one') || 'row';
    const many = root.getAttribute('data-noun-many') || 'rows';

    // ── Selection (§82) ────────────────────────────────────────────────────
    const boxes = Array.from(
      root.querySelectorAll<HTMLInputElement>('input[data-dtx-row]'),
    );
    const all = root.querySelector<HTMLInputElement>('input[data-dtx-all]');
    const allWrap = root.querySelector<El>('[data-dtx-allwrap]');
    const count = root.querySelector<El>('[data-dtx-count]');
    const scope = root.querySelector<HTMLInputElement>('input[data-dtx-scope]');
    const matchAll = root.querySelector<HTMLButtonElement>('[data-dtx-matchall]');
    const matchWrap = root.querySelector<El>('[data-dtx-matchwrap]');
    const actions = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dtx-action]'));

    if (boxes.length) {
      if (allWrap) allWrap.hidden = false;
      if (matchWrap) matchWrap.hidden = false;
    }

    function everythingMatching(): boolean {
      return !!scope && scope.value === 'filtered';
    }

    function say() {
      const n = boxes.filter((b) => b.checked).length;
      if (all) {
        all.checked = n > 0 && n === boxes.length;
        // Neither ticked nor unticked is the truthful state for a partial
        // selection, and the tri-state box is the only control that can say so.
        all.indeterminate = n > 0 && n < boxes.length;
      }
      // An action that would post an empty selection is not offered. The button
      // is enabled again the moment there is something to act on, so this is a
      // JavaScript nicety and not the guard — the endpoint must refuse an empty
      // set as well, because none of this runs when the script does not.
      for (const b of actions) b.disabled = n === 0 && !everythingMatching();

      if (!count) return;

      let next: string;
      if (everythingMatching() && total !== null) {
        next = `All ${total} ${total === 1 ? one : many} matching the current filters are selected.`;
      } else if (n === 0) {
        next = `Tick ${many} below, then choose an action.`;
      } else if (total !== null && n === total) {
        // One page IS the whole filtered set here, so say that rather than
        // leaving the reader to wonder what is off screen.
        next = `All ${n} ${n === 1 ? one : many} matching the current filters are selected.`;
      } else {
        next = `${n} ${n === 1 ? one : many} selected on this page.`;
      }

      // Written only when it has actually changed. This is a role="status"
      // region, so every assignment is an announcement — and the first call
      // happens during setup, when the wording is already what the server
      // rendered. Assigning it anyway would interrupt a screen-reader user
      // reading the page to tell them nothing has happened yet.
      if (count.textContent?.trim() !== next) count.textContent = next;
    }

    function setMatchAll(on: boolean) {
      if (scope) scope.value = on ? 'filtered' : 'selection';
      if (matchAll) matchAll.setAttribute('aria-pressed', on ? 'true' : 'false');
      for (const b of boxes) b.checked = on;
      say();
    }

    for (const b of boxes) {
      b.addEventListener('change', () => {
        // Untick anything and the reader is no longer asking for "everything
        // matching" — the claim would stop being true the instant it was made.
        if (everythingMatching() && !b.checked) setMatchAll(false);
        else say();
      });
    }

    if (all) {
      all.addEventListener('change', () => {
        for (const b of boxes) b.checked = all.checked;
        if (!all.checked && everythingMatching()) setMatchAll(false);
        else say();
      });
    }

    if (matchAll) {
      matchAll.addEventListener('click', () => {
        setMatchAll(matchAll.getAttribute('aria-pressed') !== 'true');
      });
    }

    for (const b of actions) {
      const confirmText = b.getAttribute('data-confirm');
      if (!confirmText) continue;
      b.addEventListener('click', (e) => {
        if (!window.confirm(confirmText)) e.preventDefault();
      });
    }

    if (boxes.length) say();

    // ── §54: records collapse on a phone ───────────────────────────────────
    const rowEls = Array.from(root.querySelectorAll<El>('tr[data-dtx-row-el]'));
    const expanders = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dtx-expand]'));
    const narrow = window.matchMedia(BREAKPOINT);

    function label(btn: HTMLButtonElement, open: boolean) {
      const txt = btn.querySelector<El>('.dtx-expand-txt');
      const sr = btn.querySelector<El>('[data-dtx-expand-sr]');
      const name = btn.getAttribute('data-row-label') || 'this record';
      if (txt) txt.textContent = open ? 'Less' : 'More';
      if (sr) sr.textContent = `fields for ${name}`;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function applyLayout() {
      for (const btn of expanders) {
        btn.hidden = !narrow.matches;
        const tr = btn.closest('tr');
        if (!tr) continue;
        if (narrow.matches) {
          const open = tr.hasAttribute('data-open');
          if (!open) tr.setAttribute('data-collapsed', '');
          label(btn, open);
        } else {
          tr.removeAttribute('data-collapsed');
          btn.removeAttribute('aria-expanded');
        }
      }
      if (!narrow.matches) for (const tr of rowEls) tr.removeAttribute('data-collapsed');
    }

    for (const btn of expanders) {
      btn.addEventListener('click', () => {
        const tr = btn.closest('tr');
        if (!tr) return;
        const open = tr.hasAttribute('data-open');
        if (open) {
          tr.removeAttribute('data-open');
          tr.setAttribute('data-collapsed', '');
        } else {
          tr.setAttribute('data-open', '');
          tr.removeAttribute('data-collapsed');
        }
        label(btn, !open);
      });
    }

    if (expanders.length) {
      applyLayout();
      narrow.addEventListener('change', applyLayout);
    }

    // ── §83: saved views ───────────────────────────────────────────────────
    const saved = root.querySelector<El>('[data-dtx-saved]');
    if (!saved || !id) return;

    const list = saved.querySelector<El>('[data-dtx-saved-list]');
    const nameInput = saved.querySelector<HTMLInputElement>('[data-dtx-saved-name]');
    const addBtn = saved.querySelector<HTMLButtonElement>('[data-dtx-saved-add]');

    type View = { name: string; query: string };

    function read(): View[] {
      // localStorage throws outright in a locked-down browser profile and in
      // private mode on some engines. A saved view is a convenience; losing it
      // must not take the table down with it.
      try {
        const raw = window.localStorage.getItem(viewsKey(id));
        const parsed: unknown = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(parsed)) return [];
        return parsed.filter(
          (v): v is View =>
            !!v && typeof (v as View).name === 'string' && typeof (v as View).query === 'string',
        );
      } catch {
        return [];
      }
    }

    function write(views: View[]) {
      try {
        window.localStorage.setItem(viewsKey(id), JSON.stringify(views));
      } catch {
        /* Storage refused. The list on screen still reflects this session. */
      }
    }

    function draw() {
      if (!list) return;
      const views = read();
      list.textContent = '';
      if (views.length === 0) {
        const li = document.createElement('li');
        li.className = 'dtx-saved-none';
        li.textContent = 'No views saved yet.';
        list.appendChild(li);
        return;
      }
      for (const v of views) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = v.query || '?';
        a.textContent = v.name;
        const del = document.createElement('button');
        del.type = 'button';
        del.textContent = 'Remove';
        del.setAttribute('aria-label', `Remove saved view ${v.name}`);
        del.addEventListener('click', () => {
          write(read().filter((x) => x.name !== v.name));
          draw();
        });
        li.appendChild(a);
        li.appendChild(del);
        list.appendChild(li);
      }
    }

    if (addBtn) {
      addBtn.addEventListener('click', () => {
        const name = (nameInput?.value || '').trim().slice(0, 60);
        if (!name) {
          nameInput?.focus();
          return;
        }
        const views = read().filter((v) => v.name !== name);
        views.push({ name, query: window.location.search || '?' });
        write(views);
        if (nameInput) nameInput.value = '';
        draw();
      });
    }

    saved.hidden = false;
    draw();
  }

  for (const root of Array.from(document.querySelectorAll<El>('[data-dtx]'))) setup(root);
</script>
