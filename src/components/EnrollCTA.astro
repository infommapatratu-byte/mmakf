---
// The federation's enquiry CTA. Posts to /api/enroll.
//
// TWO CORRECTIONS LIVE IN THIS FILE, BOTH FROM THE FEDERATION.
//
// The first was a crash. A personal mobile number stood here as a DEFAULT
// PARAMETER — the worst possible place for one, because a default survives
// every attempt to remove the value from the data: nothing passes the prop, so
// nothing can override it. Removing the destructured `phone` without removing
// its three remaining uses took the HOMEPAGE DOWN with "phone is not defined".
// The lesson is in the change: a contact detail belongs in the federation
// record, read through `fed.contact`, never as a literal in a component.
//
// The second was positioning. This block said "Step onto the mat", "Your first
// class is on us", "Walk in", and "Book Free Trial" — the language of a single
// dojo selling monthly classes. MMAKF is a national federation, and the
// federation named these exact phrases as the thing to correct. The enquiry
// stays, because an individual wanting to train is a real and welcome visitor;
// it is now one pathway among several rather than the site's only door.

interface Props {
  programs: any[];
  /** The federation's own contact address, from the record. Never a person's. */
  email?: string;
}
const { programs, email = 'admin@mmakf.in' } = Astro.props;
---

<section id="enroll" class="cta-section">
  <div class="container">
    <div class="cta-box fade">
      <div class="eyebrow center">Train with MMAKF</div>
      <h2 class="display-2" style="margin-top:16px">Begin your <em class="r">Karate-Do</em>.</h2>
      <p class="lead" style="margin:18px auto 32px">
        From an individual student to a school training hundreds, MMAKF delivers
        structured Shotokan through a national network. Tell the federation what you
        need and the right unit will answer.
      </p>
      <form class="cta-form" data-enroll-form method="post" action="/api/enroll">
        <label class="sr-only" for="enroll-name">Full name</label>
        <input class="input" id="enroll-name" name="name" placeholder="Full name" required />
        <label class="sr-only" for="enroll-email">Email address</label>
        <input class="input" id="enroll-email" name="email" type="email" placeholder="Email address" required />
        <label class="sr-only" for="enroll-program">What you are looking for</label>
        <select class="input" id="enroll-program" name="program" required>
          <option value="">What are you looking for?</option>
          {programs.map((p: any) => <option value={p.name}>{p.name}</option>)}
        </select>
        <button type="submit" class="btn btn-gold">Send enquiry</button>
      </form>
      <div style="margin-top:12px;color:var(--muted);font-size:.74rem">
        {/* No turnaround time is promised. The federation has not set one, and a
            page that invents "we reply within 24 hours" makes a commitment
            nobody in the office agreed to. */}
        Used only to answer your enquiry. Fees depend on what you need — the
        federation quotes against your own requirements rather than a price list.
      </div>
      <div class="cta-paths">
        <a href="/affiliation" class="btn btn-ghost">Affiliate a dojo &rarr;</a>
        <a href="/registration" class="btn btn-ghost">Register as a member &rarr;</a>
        <a href="/calendar" class="btn btn-ghost">Federation calendar &rarr;</a>
      </div>
      <noscript>
        <div style="margin-top:12px;color:var(--off-white);font-size:.82rem">
          This form works without JavaScript. If it does not reach us, email
          <a href={`mailto:${email}`} class="text-gold">{email}</a>.
        </div>
      </noscript>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background:
      radial-gradient(ellipse 600px 300px at 50% 30%, rgba(142, 18, 18, 0.15), transparent),
      var(--bg-2);
    text-align: center;
  }
  .cta-box { max-width: 720px; margin: 0 auto; }
  .cta-form {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr auto;
    gap: 10px;
    margin-top: 32px;
  }
  @media (max-width: 700px) { .cta-form { grid-template-columns: 1fr; } }

  .cta-paths {
    display: flex; flex-wrap: wrap; gap: 12px;
    justify-content: center; margin-top: 26px;
  }

  /* Labels for every field. The inputs carried aria-label only, which a label
     element does better: it also makes the label clickable, and
     tests/accessibility.test.ts requires the for/id association. */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  document.querySelectorAll('form[data-enroll-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = form as HTMLFormElement;
      const btn = f.querySelector('button[type=submit]') as HTMLButtonElement | null;
      const fd = new FormData(f);
      const body = Object.fromEntries(fd.entries());
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      try {
        const res = await fetch('/api/enroll', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error('bad status');
        // NOT "we will call you shortly". Nobody has committed to a turnaround
        // time, and the federation's contact route is now email — promising a
        // telephone call was a commitment the office never made.
        (window as any).showNotif('Oss. Your enquiry has reached the federation.');
        f.reset();
      } catch {
        // Inputs are preserved so the visitor can retry (MASTER-SPEC F15).
        (window as any).showNotif('Could not submit. Please email admin@mmakf.in.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'Send enquiry'; }
      }
    });
  });
</script>
