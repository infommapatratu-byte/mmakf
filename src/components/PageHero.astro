---
// Shared header for dedicated pages: eyebrow, display title (HTML allowed for
// <em> emphasis — page-literal strings ONLY, never store content: XSS boundary
// per MASTER-SPEC §9.6), lead paragraph, optional pills, optional photograph.
//
// Light theme: photo heroes are dark bands with light text (federation
// convention — dark hero over a white page); heroes without a photo render
// as light bands using the global ink tokens.

interface Props {
  eyebrow: string;
  title: string;      // may contain <em> / <em class="r"> emphasis markup
  lead?: string;
  pills?: string[];
  image?: string;     // background photograph URL (dark-treated automatically)
}
const { eyebrow, title, lead, pills = [], image } = Astro.props;
---

<section class="page-hero" class:list={[{ 'has-img': !!image }]}>
  {image && (
    <div class="page-hero-photo" aria-hidden="true">
      <img src={image} alt="" loading="eager" fetchpriority="high" />
      <div class="page-hero-shade"></div>
    </div>
  )}
  <div class="container" style="position:relative;z-index:2">
    {pills.length > 0 && (
      <div class="flex flex-wrap gap-3" style="margin-bottom:20px">
        {pills.map((p) => <span class="pill featured"><span class="pill-dot"></span>{p}</span>)}
      </div>
    )}
    <div class="eyebrow">{eyebrow}</div>
    <h1 class="display-1" style="margin-top:16px" set:html={title} />
    <div class="rule"></div>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 96px 0 72px;
    overflow: hidden;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
  }
  .page-hero.has-img { padding: 128px 0 96px; background: #14120F; border-bottom: 0; }
  @media (max-width: 640px) {
    .page-hero { padding: 64px 0 48px; }
    .page-hero.has-img { padding: 88px 0 64px; }
  }
  .page-hero-photo {
    position: absolute; inset: 0;
    z-index: 0;
  }
  .page-hero-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) contrast(1.05) brightness(0.62);
  }
  .page-hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(16, 14, 11, 0.92) 0%, rgba(16, 14, 11, 0.78) 45%, rgba(16, 14, 11, 0.45) 100%),
      linear-gradient(180deg, rgba(16, 14, 11, 0.5) 0%, transparent 35%, rgba(16, 14, 11, 0.85) 100%);
  }

  /* Light text inside dark photo heroes */
  .page-hero.has-img :global(.display-1) { color: #F7F4EE; }
  .page-hero.has-img :global(.display-1 em) { color: #D9BC66; }
  .page-hero.has-img :global(.lead) { color: #D9D3C8; }
  .page-hero.has-img :global(.eyebrow) { color: #D9BC66; }
  .page-hero.has-img :global(.eyebrow)::before { background: rgba(217, 188, 102, 0.55); }
  .page-hero.has-img :global(.pill) { color: #E4DED2; border-color: rgba(255, 255, 255, 0.28); }
  .page-hero.has-img :global(.pill.featured) { color: #D9BC66; border-color: rgba(217, 188, 102, 0.45); }
</style>
